# Copy to .env on Railway or locally for leadsync jobs.
# This service is the Zoho / Airtable / Taalk worker (apps/leadsync), not necessarily LEAD_SYNC_URL.

# If you add HTTP callbacks into AOIrail that touch masterlead or dialer hot paths, call the DATA deploy:
# AOIRAIL_DATA_SERVICE_URL=https://aoirail-data-production.up.railway.app
# (alias) DATA_SERVICE_URL=https://aoirail-data-production.up.railway.app

# CCPro assignment-trigger lives on whatever host LEAD_SYNC_URL points at (often NOT this app).
# LEAD_SYNC_URL=https://your-ccpro-assignment-trigger-host.up.railway.app
