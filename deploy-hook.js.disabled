#!/usr/bin/env node
import { spawn } from 'child_process';
import fs from 'fs';

console.log('🚀 Deployment Hook: Auto-updating desktop applications...');

// Get current timestamp for version
const now = new Date();
const version = `1.0.${Math.floor(now.getTime() / 1000)}`;

console.log(`📦 Building version ${version}...`);

// Update version in package.json
const packageJson = JSON.parse(fs.readFileSync('package.json', 'utf8'));
packageJson.version = version;
fs.writeFileSync('package.json', JSON.stringify(packageJson, null, 2));

// Rebuild desktop applications with new version
const buildProcess = spawn('node', ['update-desktop-app.js'], {
  stdio: 'inherit',
  shell: true
});

buildProcess.on('close', (code) => {
  if (code === 0) {
    console.log(`✅ Desktop applications updated to version ${version}`);
    console.log('🌐 Deployment complete - agents will receive updates on next startup');
    
    // Update the auto-updater service
    updateAutoUpdaterService(version);
  } else {
    console.error('❌ Desktop application update failed');
    process.exit(1);
  }
});

function updateAutoUpdaterService(newVersion) {
  try {
    // Trigger version update via API (for when server is running)
    const https = require('https');
    const postData = JSON.stringify({ 
      version: newVersion, 
      forceUpdate: false 
    });
    
    // This would be called by the deployment system
    console.log(`🔄 Version ${newVersion} ready for distribution`);
    console.log('📱 Agents will automatically receive this update on next launch');
  } catch (error) {
    console.log('⚠️  Auto-updater service will be updated when server restarts');
  }
}