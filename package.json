    "prebuild": "node -e \"const v=process.version.match(/^v(\\d+)/)[1]; if(v<16) { console.error('Node.js 16+ required. You have:', process.version); process.exit(1); }\"",
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild server/entry-worker.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/worker.js && esbuild server/entry-auth.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/auth.js && esbuild server/entry-twilio.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/twilio.js && esbuild server/proxy-gateway.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/proxy-gateway.js && node -e \"const fs=require('fs');const p='dist/public';if(fs.existsSync(p+'/index.html'))fs.copyFileSync(p+'/index.html',p+'/spa-index.html');fs.copyFileSync('client/public/ao-precheck-onboarding.html',p+'/index.html');console.log('AO Precheck: spa-index preserved, onboarding -> index.html');\"",
    "build:shell": "vite build --config vite.shell.config.ts && esbuild server/entry-shell.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/shell.js",
