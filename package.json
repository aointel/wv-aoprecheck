    "build:production": "cross-env NODE_ENV=production vite build --mode production && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild server/entry-worker.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/worker.js && esbuild server/entry-auth.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/auth.js && node -e \"const fs=require('fs');const p='dist/public';if(fs.existsSync(p+'/index.html'))fs.copyFileSync(p+'/index.html',p+'/spa-index.html');fs.copyFileSync('client/public/ao-precheck-onboarding.html',p+'/index.html');console.log('AO Precheck: spa-index preserved, onboarding -> index.html');\"",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:auth": "node dist/auth.js",
    "inject-data-url": "node -e \"const fs=require('fs'),p='dist/public/index.html';try{if(!fs.existsSync(p)){console.log('Skip inject: index missing');process.exit(0);}let h=fs.readFileSync(p,'utf8');const u=process.env.AOIRAIL_DATA_SERVICE_URL||process.env.DATA_SERVICE_URL||(process.env.RAILWAY_SERVICE_AOIRAIL_DATA_URL?'https://'+process.env.RAILWAY_SERVICE_AOIRAIL_DATA_URL:'');if(u&&!h.includes('__AOIRAIL_DATA_SERVICE_URL__')){h=h.replace('</head>','<script>window.__AOIRAIL_DATA_SERVICE_URL__='+JSON.stringify(u)+';</script></head>');try{fs.writeFileSync(p,h);console.log('Injected data URL:',u);}catch(e){console.warn('Skip inject write (non-fatal):',e&&e.code?e.code:e);}}else{console.log('Skip inject: url='+u+' alreadySet='+h.includes('__AOIRAIL_DATA_SERVICE_URL__'));}}catch(e){console.warn('Skip inject (non-fatal):',e&&e.message?e.message:e);}\"",
    "start:staging": "npm run inject-data-url && cross-env NODE_ENV=staging node dist/index.js",
    "start:production": "cross-env NODE_ENV=production node dist/index.js",
