# Replit Deployment Configuration
deploymentTarget = "autoscale"

# Build command - simplified to prevent timeout
[[build]]
cmd = ["npm", "run", "build"]
ignorePaths = ["node_modules", ".git", "dist", "electron-dist", "uploads", "recordings"]

# Run command
[[run]]
cmd = ["npm", "run", "start"]

# Environment variables needed for deployment
[env]
NODE_ENV = "production"
PORT = "5000"

# Health check configuration
[healthCheck]
path = "/health"
port = 5000
timeoutSeconds = 10
periodSeconds = 5

