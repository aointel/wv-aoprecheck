{
  "appId": "com.aointelligence.connectnow",
  "productName": "AO Intelligence ConnectNow",
  "copyright": "Copyright © 2025 AO Intelligence",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "node_modules/**/*",
    "ConnectNow.png"
  ],
  "extraResources": [
    {
      "from": "ConnectNow.png",
      "to": "ConnectNow.png"
    }
  ],
  "publish": {
    "provider": "github",
    "owner": "mmandella",
    "repo": "PolicyVerify"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "ConnectNow.png",
    "publisherName": "AO Intelligence",
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "ConnectNow.png",
    "uninstallerIcon": "ConnectNow.png",
    "installerHeaderIcon": "ConnectNow.png",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ConnectNow"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "ConnectNow.png",
    "category": "public.app-category.business",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "entitlements.mac.plist",
    "entitlementsInherit": "entitlements.mac.plist"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "icon": "ConnectNow.png",
    "category": "Office"
  }
}