  // Get pending appointments that need review
  app.get("/api/appointments/pending-review", async (req, res) => {
    try {
      const agentEmail = req.query.agentEmail as string;
      
      if (!agentEmail) {
        return res.status(400).json({
          error: 'Agent email is required'
        });
      }

      console.log('🗓️ Fetching pending appointment reviews for:', agentEmail);

      // Get completed appointments that haven't been reviewed yet
      const pendingAppointments = await db
        .select({
          id: appointments.id,
          leadName: appointments.leadName,
          leadPhone: appointments.leadPhone,
          appointmentDate: appointments.appointmentDate,
          notes: appointments.notes,
          agentEmail: appointments.agentEmail,
          status: appointments.status,
          leadEmail: appointments.leadEmail,
          premium: appointments.premium,
        })
        .from(appointments)
        .leftJoin(appointmentReviews, eq(appointments.id, appointmentReviews.appointmentId))
        .where(
          and(
            eq(appointments.agentEmail, agentEmail),
            eq(appointments.status, 'completed'),
            isNull(appointmentReviews.id) // Not yet reviewed
          )
        )
        .orderBy(appointments.appointmentDate);

      console.log('🗓️ Found pending appointments:', pendingAppointments.length);

      res.json({
        success: true,
        appointments: pendingAppointments
      });
    } catch (error) {
      console.error('❌ Error fetching pending appointments:', error);
      res.status(500).json({ 
        error: 'Failed to fetch pending appointments' 
      });
    }
  });

  // Submit appointment review (disposition)
  app.post("/api/appointments/review", async (req, res) => {
    try {
      const { appointmentId, outcome, saleAmount, notes, followUpDate, followUpNotes } = req.body;
      const agentEmail = req.user?.email || req.body.agentEmail;

      if (!agentEmail || !appointmentId || !outcome) {
        return res.status(400).json({
          error: 'Agent email, appointment ID, and outcome are required'
        });
      }

      console.log('🗓️ Submitting appointment review:', {
        appointmentId,
        outcome,
        saleAmount,
        agentEmail
      });

      // Insert appointment review
      const review = await db
        .insert(appointmentReviews)
        .values({
          appointmentId,
          agentEmail,
          outcome,
          saleAmount: saleAmount ? parseFloat(saleAmount) : null,
          notes,
          followUpDate: followUpDate ? new Date(followUpDate) : null,
          followUpNotes,
        })
        .returning();

      // If it's a sale, also update any related war tracking
      if (outcome === 'sale' && saleAmount) {
        console.log('💰 Recording sale in AOI tracking:', saleAmount);
        // You could add additional sale tracking here if needed
      }

      console.log('✅ Appointment review submitted successfully');

      res.json({
        success: true,
        review: review[0]
      });
    } catch (error) {
      console.error('❌ Error submitting appointment review:', error);
      res.status(500).json({ 
        error: 'Failed to submit appointment review' 
      });
    }
  });

