  app.post('/api/vdp/call-accept', async (req, res) => {
    try {
      const { agentEmail, callId, leadData, callStartTime, callType = 'inbound_vdp' } = req.body;

      if (!agentEmail || !callId || !leadData) {
        return res.status(400).json({ 
          error: 'Missing required fields: agentEmail, callId, leadData' 
        });
      }

      console.log(`📞 VDP Call accepted by ${agentEmail} for lead: ${leadData.firstName} ${leadData.lastName}`);

      // Check if lead already exists in masterleads table  
      const { outboundCalls } = await import('@shared/schema');
      const { eq, and, desc } = await import('drizzle-orm');

      // For VDP calls, we'll create the outbound call record directly since masterleads table is handled via Supabase
      const leadId = `vdp_${Date.now()}_${agentEmail.split('@')[0]}`;
      console.log(`✅ Generated lead ID: ${leadId}`);

      // Create outbound call record for tracking
      const [callRecord] = await db
        .insert(outboundCalls)
        .values({
          leadId: leadId,
          agentEmail: agentEmail,
          leadPhone: leadData.phone,
          leadName: `${leadData.firstName} ${leadData.lastName}`,
          leadCity: leadData.city,
          leadState: leadData.state,
          callDirection: 'inbound',
          callStatus: 'connected',
          startTime: new Date(callStartTime),
          twilioCallSid: callId,
          createdAt: new Date()
        })
        .returning();

      console.log(`✅ Created call record for disposition: ${callRecord.id}`);

      const leadForDisplay = {
        id: leadId,
        firstName: leadData.firstName,
        lastName: leadData.lastName,
        phone: leadData.phone,
        email: leadData.email,
        city: leadData.city,
        state: leadData.state,
        callId: callRecord.id,
        requiresDisposition: true,
        callStartTime: callStartTime,
        callType: callType,
        priority: 'high',
        leadSource: 'VDP_Call'
      };

      res.json({
        success: true,
        lead: leadForDisplay,
        message: 'VDP call lead created successfully'
      });

    } catch (error) {
      console.error('❌ Error handling VDP call accept:', error);
      res.status(500).json({
        error: 'Failed to process VDP call',
        details: error instanceof Error ? error.message : 'Unknown error'
      });
    }
  });

