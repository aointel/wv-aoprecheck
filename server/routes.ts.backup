  // Admin toggle Call Connector Pro access endpoint
  app.post('/api/admin/toggle-call-connector-pro', async (req, res) => {
    try {
      const { email, access } = req.body;

      if (!email || typeof access !== 'boolean') {
        return res.status(400).json({ message: 'Email and access boolean are required' });
      }

      console.log(`🔧 Admin toggling Call Connector Pro access for ${email} to ${access ? 'ON' : 'OFF'}`);

      // First check if agent profile exists
      const { data: existingProfile } = await supabase
        .from('agent_profiles')
        .select('id, email')
        .eq('email', email)
        .single();

      let result;
      if (existingProfile) {
        // Update existing profile
        const { data: updatedAgent, error: updateError } = await supabase
          .from('agent_profiles')
          .update({ call_connector_pro_access: access })
          .eq('email', email)
          .select()
          .single();

        if (updateError) {
          console.error('❌ Failed to update Call Connector Pro access:', updateError);
          return res.status(500).json({ message: 'Failed to update Call Connector Pro access' });
        }
        result = updatedAgent;
      } else {
        // Create new profile with Call Connector Pro access
        console.log(`🆕 Creating new agent profile for ${email} with Call Connector Pro access`);
        const { data: newAgent, error: insertError } = await supabase
          .from('agent_profiles')
          .insert({ 
            email: email,
            call_connector_pro_access: access,
            first_name: '',
            last_name: '',
            phone: ''
          })
          .select()
          .single();

        if (insertError) {
          console.error('❌ Failed to create agent profile with Call Connector Pro access:', insertError);
          return res.status(500).json({ message: 'Failed to create agent profile' });
        }
        result = newAgent;
      }

      console.log(`✅ Call Connector Pro access ${access ? 'enabled' : 'disabled'} for ${email}`);
      res.json({ 
        success: true, 
        message: `Call Connector Pro access ${access ? 'enabled' : 'disabled'}`,
        user: result
      });

    } catch (error) {
      console.error('❌ Error toggling Call Connector Pro access:', error);
      res.status(500).json({ message: 'Failed to toggle Call Connector Pro access' });
    }
  });

