  // WebRTC conference join endpoint - generates TwiML for WebRTC calls
  app.post("/api/twilio/webrtc-conference", (req, res) => {
    try {
      const { conference = 'AO-Verification-Live' } = req.body;
      const currentDomain = req.get('host');
      const baseUrl = `https://${currentDomain}`;

      const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say voice="alice">Connecting you to AO Precheck conference via WebRTC.</Say>
  <Dial>
    <Conference 
      statusCallbackEvent="start join leave end"
      statusCallback="${baseUrl}/api/twilio/conference-status"
      startConferenceOnEnter="true"
      endConferenceOnExit="true"
      maxParticipants="2"
      beep="false">${conference}</Conference>
  </Dial>
</Response>`;

      res.type('text/xml');
      res.send(twiml);
    } catch (error) {
            console.error('WebRTC conference error:', error);
      // Return valid TwiML even on error
      const errorTwiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say voice="alice">Unable to connect to conference. Please try again.</Say>
</Response>`;
      res.type('text/xml');
      res.send(errorTwiml);
    }
  });

