  // Start live verification call endpoint
  app.post("/api/verification/session/:sessionId/start-live-call", async (req, res) => {
    try {
      const { sessionId } = req.params;

      const session = await storage.getVerificationSession(sessionId);
      if (!session) {
        return res.status(404).json({ message: "Verification session not found" });
      }

      // Prepare verification call data
      const callData = {
        sessionId: session.sessionId,
        clientName: `${session.firstName} ${session.lastName}`,
        clientPhone: session.phone,
        spouseName: session.spouseName,
        city: session.city,
        state: session.state,
        premium: session.premium,
        verificationMethod: session.verificationMethod || 'phone',
        agentPhone: agentPhone // Get from agent setup, not hardcoded
      };

      console.log('Starting live verification call for session:', sessionId);

      // Use simple call service for testing (bypasses Twilio URL issues)
      const callResult = await simpleCallService.initiateVerificationCall(callData);

      if (callResult.success) {
        // Update session status
        await storage.updateVerificationSession(sessionId, {
          status: 'live_call_initiated'
        });

        // Send comprehensive data to Zapier about live call
        const zapierPayload = {
          sessionId,
          eventType: 'live_call_initiated',
          clientName: callData.clientName,
          clientPhone: callData.clientPhone,
          verificationNumber: "+15032018470",
          callId: callResult.callSid,
          clientInfo: {
            firstName: session.firstName,
            lastName: session.lastName,
            spouseName: session.spouseName,
            city: session.city,
            state: session.state,
            premium: session.premium
          },
          verificationInstructions: {
            message: `Live call initiated to +15032018470 for ${callData.clientName} verification`,
            agentCallsClient: callData.clientPhone,
            verifyName: callData.clientName,
            verifySpouse: callData.spouseName,
            verifyLocation: `${callData.city}, ${callData.state}`,
            verifyPremium: callData.premium,
            requireSpeakerPhone: true,
            requireScreenshot: true
          },
          timestamp: new Date().toISOString()
        };

        console.log('Sending live call data to Zapier:', zapierPayload);

        await fetch('https://hooks.zapier.com/hooks/catch/2467580/uu5qnr4/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(zapierPayload)
        });

        res.json({
          success: true,
          message: "Live verification call initiated successfully via Twilio",
          callId: callResult.callSid,
          clientPhone: callData.clientPhone,
          sessionId
        });
      } else {
        res.status(500).json({
          success: false,
          message: "Failed to initiate live verification call",
          error: callResult.error
        });
      }
    } catch (error: any) {
      console.error('AI verification call error:', error);
      res.status(500).json({ message: "Failed to start AI verification call" });
    }
  });

  // AI verification call callback endpoint
  app.post("/api/verification/call-callback", async (req, res) => {
    try {
      console.log('AI verification call callback received:', req.body);

      const callbackResult = await aiVerificationService.processCallCallback(req.body);

      if (callbackResult.success && callbackResult.verificationResult) {
        const { sessionId, verified, status } = callbackResult.verificationResult;

        // Update verification session with call results
        await storage.updateVerificationSession(sessionId, {
          status: verified ? 'ai_verified' : 'ai_verification_failed'
        });

        // Send results to Zapier webhook for further processing
        const zapierPayload = {
          sessionId,
          eventType: 'ai_verification_complete',
          verified,
          callStatus: status,
          verificationResults: callbackResult.verificationResult,
          timestamp: new Date().toISOString()
        };

        // Notify via Zapier webhook
        await fetch('https://hooks.zapier.com/hooks/catch/2467580/uu5qnr4/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(zapierPayload)
        });

        console.log('AI verification completed for session:', sessionId, 'Verified:', verified);
      }

      res.json({ success: true, message: "Callback processed successfully" });
    } catch (error: any) {
      console.error('AI callback processing error:', error);
      res.status(500).json({ message: "Failed to process callback" });
    }
  });

  // Complete verification endpoint
  app.post("/api/verification/session/:sessionId/complete-verification", async (req, res) => {
    try {
      const { sessionId } = req.params;
      const { verified, callId, completedAt } = req.body;

      const session = await storage.getVerificationSession(sessionId);
      if (!session) {
        return res.status(404).json({ message: "Verification session not found" });
      }

      // Update session with completion data
      await storage.updateVerificationSession(sessionId, {
        status: verified ? 'verification_completed' : 'verification_failed',
        callCompleted: true,
        verificationResult: JSON.stringify({ verified, callId, completedAt })
      });

      // Send completion data to Zapier
      const zapierPayload = {
        sessionId,
        eventType: 'verification_completed',
        verified,
        callId,
        completedAt,
        clientName: `${session.firstName} ${session.lastName}`,
        clientPhone: session.phone,
        timestamp: new Date().toISOString()
      };

      await fetch('https://hooks.zapier.com/hooks/catch/2467580/uu5qnr4/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(zapierPayload)
      });

      // Send certificate email to agent if verification was successful
      if (verified) {
        try {
          // Get agent profile for email address
          const agentProfile = await storage.getAgentProfile();
          
          if (agentProfile?.email) {
            const certificateId = `AO-${sessionId.toUpperCase()}-${Date.now()}`;
            const clientName = `${session.firstName} ${session.lastName}`;
            const agentName = `${agentProfile.firstName} ${agentProfile.lastName}`;
            
            const emailHTML = generateCertificateEmailHTML(
              agentName,
              clientName,
              sessionId,
              completedAt || new Date().toISOString(),
              certificateId
            );

            const emailSuccess = await sendCertificateEmail({
              to: agentProfile.email,
              subject: `AO Precheck - Verification Certificate Complete (${clientName})`,
              html: emailHTML
            });

            if (emailSuccess) {
              console.log(`✅ Certificate email sent to agent: ${agentProfile.email}`);
            } else {
              console.log(`⚠️ Failed to send certificate email to: ${agentProfile.email}`);
            }
          } else {
            console.log('⚠️ No agent email configured for certificate delivery');
          }
        } catch (emailError) {
          console.error('❌ Error sending certificate email:', emailError);
        }
      }

      res.json({
        success: true,
        message: "Verification completed successfully",
        sessionId,
        verified
      });
    } catch (error: any) {
      console.error('Complete verification error:', error);
      res.status(500).json({ message: "Failed to complete verification" });
    }
  });

