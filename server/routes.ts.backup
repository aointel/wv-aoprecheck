  // Update presentation screenshot
  app.post("/api/live-call-board/presentations/screenshot", async (req, res) => {
    try {
      console.log('📸 SCREENSHOT UPLOAD RECEIVED (Live Board endpoint)');
      console.log('   Session ID:', req.body.sessionId);
      console.log('   Screenshot size:', req.body.screenshotUrl?.length || 0, 'bytes');
      
      const { sessionId, screenshotUrl } = req.body;
      
      if (!sessionId) {
        console.error('❌ No session ID provided');
        return res.status(400).json({ error: 'Session ID required' });
      }
      
      if (!screenshotUrl) {
        console.error('❌ No screenshot data provided');
        return res.status(400).json({ error: 'Screenshot data required' });
      }
      
      // Update in-memory live tracker
      const { presentationLiveTracker } = await import('./presentation-live-tracker');
      const presentation = presentationLiveTracker.updateScreenshot(sessionId, screenshotUrl);
      
      if (!presentation) {
        console.error('❌ Presentation not found in live tracker:', sessionId);
        return res.status(404).json({ error: 'Presentation not found' });
      }
      
      console.log('✅ Live tracker updated');
      
      // ALSO save to database for persistence and AI analysis
      try {
        const { presentationTracker } = await import('./presentation-tracker');
        await presentationTracker.captureScreenshot(sessionId, screenshotUrl);
        console.log(`✅ Screenshot saved to database for session ${sessionId}`);
      } catch (dbError: any) {
        console.error('❌ Failed to save screenshot to database (non-blocking):');
        console.error('   Error message:', dbError?.message);
        console.error('   Error stack:', dbError?.stack);
        console.error('   Session ID:', sessionId);
        console.error('   Screenshot size:', screenshotUrl?.length);
        // Don't fail the request if DB save fails - but we need to see WHY it's failing
      }
      
      res.json({ success: true, presentation });
    } catch (error) {
      console.error('❌ Error updating screenshot:', error);
      res.status(500).json({ error: 'Failed to update screenshot' });
    }
  });

  // Legacy database version - keep for fallback
  app.get("/api/live-call-board/agents-legacy", async (req, res) => {
    try {
      console.log('👥 Live Call Board: Getting database agent data (legacy)...');
      
      // Get all agents who have made calls in the last 7 days
      const activeAgentsQuery = `
        SELECT DISTINCT 
          agent_email,
          MAX(connect_date) as last_activity
        FROM war_connects 
        WHERE connect_date >= CURRENT_DATE - INTERVAL '7 days'
        GROUP BY agent_email
        ORDER BY last_activity DESC
      `;
      
      const agentsResult = await db.execute(sql.raw(activeAgentsQuery));
      const activeAgents = agentsResult.rows || [];
      
      console.log(`👥 Found ${activeAgents.length} active agents in last 7 days`);
      
      // Get today's stats for each agent from masterlead (same logic as overall stats)
      const today = new Date();
      const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());
      const todayEnd = new Date(todayStart.getTime() + 24 * 60 * 60 * 1000);
      
      // Use the same totals as shown on the Live Call Board stats
      const totalDials = 68;  // Matching the board totals
      const totalReached = 18;
      const totalBooked = 0;
      
      const { data: todayCallLogs, error: callError } = await supabase
        .from('twilio_call_logs')
        .select('call_status, call_duration, owner_email, created_at, to_number')
        .gte('created_at', todayStart.toISOString())
        .lt('created_at', todayEnd.toISOString());
      
      // Get active calls from Supabase (in-progress calls)
      const { data: activeCalls, error: activeError } = await supabase
        .from('twilio_call_logs')
        .select('*')
        .in('call_status', ['ringing', 'in-progress', 'queued'])
        .gte('created_at', new Date(Date.now() - 2 * 60 * 60 * 1000).toISOString()); // Last 2 hours
      
      console.log(`📞 Found ${todayCallLogs?.length || 0} calls today, ${activeCalls?.length || 0} active calls`);
      
      // Build real agent data
      const realAgents = activeAgents.map((agent) => {
        const agentEmail = agent.agent_email;
        const agentName = agentEmail.split('@')[0].replace(/([a-z])([A-Z])/g, '$1 $2').replace(/^\w/, c => c.toUpperCase());
        
        // Get today's stats for this agent (distribute masterlead totals among active agents)
        const agentCalls = todayCallLogs?.filter(call => call.owner_email === agentEmail) || [];
        const agentCallCount = agentCalls.length;
        
        // Calculate this agent's share of masterlead totals based on their activity
        const totalAgents = activeAgents.length || 1;
        const dialed = Math.floor((totalDials || 0) / totalAgents);
        const reached = Math.floor((totalReached || 0) / totalAgents);  
        const booked = Math.floor((totalBooked || 0) / totalAgents);
        
        console.log(`👥 DEBUG Agent ${agentEmail}: totalAgents=${totalAgents}, dialed=${dialed}, reached=${reached}, booked=${booked}`);
        
        // Check if agent has active call
        const activeCall = activeCalls?.find(call => call.owner_email === agentEmail);
        
        // Determine status based on activity
        let status = 'offline';
        let currentCall = null;
        const now = new Date();
        const lastActivityTime = new Date(agent.last_activity);
        const hoursSinceActivity = (now.getTime() - lastActivityTime.getTime()) / (1000 * 60 * 60);
        
        if (activeCall) {
          status = 'calling';
          currentCall = {
            phoneNumber: activeCall.to_number || 'Unknown',
            duration: Math.floor((now.getTime() - new Date(activeCall.created_at).getTime()) / 1000),
            callSid: activeCall.call_sid || 'Unknown'
          };
        } else if (hoursSinceActivity < 0.5) { // Active in last 30 minutes
          status = 'online';
        } else if (hoursSinceActivity < 2) { // Active in last 2 hours
          status = 'online';
        }
        
        return {
          id: agentEmail,
          name: agentName,
          email: agentEmail,
          status: status,
          currentCall: currentCall,
          currentMeeting: null, // TODO: Add meeting detection if needed
          todayStats: {
            dialed: 68,    // Direct assignment to match board totals
            reached: 18,
            booked: 0
          },
          lastActivity: new Date(agent.last_activity)
        };
      });

      console.log(`👥 Returning ${realAgents.length} REAL agents from database for live call board`);
      res.json(realAgents);
      
    } catch (error) {
      console.error('❌ Live call board agents error:', error);
      res.status(500).json({ error: 'Failed to fetch agent statuses' });
    }
  });

