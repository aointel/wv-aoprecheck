  // End only the lead's call (keep agent in conference)
  app.post("/api/end-lead", async (req, res) => {
    try {
      const { conferenceName, leadCallSid } = req.body;
      
      if (!conferenceName && !leadCallSid) {
        return res.status(400).json({ error: "Missing conferenceName or leadCallSid" });
      }
      
      let callSidToEnd = leadCallSid;
      
      // If we have conferenceName but no leadCallSid, look it up
      if (conferenceName && !leadCallSid) {
        if (!global.activeCalls || !global.activeCalls[conferenceName]) {
          return res.status(404).json({ error: "No active call found for this conference" });
        }
        callSidToEnd = global.activeCalls[conferenceName].leadCallSid;
      }
      
      if (!callSidToEnd) {
        return res.status(400).json({ error: "No lead CallSid found" });
      }
      
      console.log(`📞 Ending lead call: ${callSidToEnd}`);
      await twilioClient.calls(callSidToEnd).update({ status: "completed" });
      
      console.log(`✅ Lead call ended successfully: ${callSidToEnd}`);
      res.json({ success: true, message: "Lead call ended", callSid: callSidToEnd });
      
    } catch (err: any) {
      console.error("❌ Failed to end lead call:", err.message);
      res.status(500).json({ error: err.message });
    }
  });

  // End entire conference (both agent and lead)
  app.post("/api/end-conference", async (req, res) => {
    try {
      const { conferenceName, conferenceSid } = req.body;
      
      if (!conferenceName && !conferenceSid) {
        return res.status(400).json({ error: "Missing conferenceName or conferenceSid" });
      }
      
      let confSidToEnd = conferenceSid;
      
      // If we have conferenceName but no conferenceSid, look it up
      if (conferenceName && !conferenceSid) {
        const conferences = await twilioClient.conferences.list({
          friendlyName: conferenceName,
          status: 'in-progress'
        });
        
        if (conferences.length === 0) {
          return res.status(404).json({ error: "No active conference found" });
        }
        confSidToEnd = conferences[0].sid;
      }
      
      console.log(`☠️ Ending entire conference: ${confSidToEnd}`);
      await twilioClient.conferences(confSidToEnd).update({ status: "completed" });
      
      console.log(`✅ Conference ended successfully: ${confSidToEnd}`);
      res.json({ success: true, message: "Conference ended", conferenceSid: confSidToEnd });
      
    } catch (err: any) {
      console.error("❌ Failed to end conference:", err.message);
      res.status(500).json({ error: err.message });
    }
  });

