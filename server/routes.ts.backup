        const digits = formattedClientPhone.replace(/\D/g, '');
        if (digits.length === 10) {
          formattedClientPhone = `+1${digits}`;
        } else if (digits.length === 11 && digits.startsWith('1')) {
          formattedClientPhone = `+${digits}`;
        } else {
          formattedClientPhone = `+1${digits}`;
        }
      }

      // Clean phone number for Taalk API (remove + and spaces)
      const cleanAgentPhone = formattedAgentPhone.replace(/[^0-9]/g, '');
      
      const callParams = {
        name: `${session.firstName} ${session.lastName}`,
        phone: cleanAgentPhone, // CONFERENCE CALL: Direct phone call to agent
        agent: taalkAgentId,
        retryMethod: 0,
        force: true,
        webhookUrl: "https://policy-verify-mmandella.replit.app/api/taalk/webhook",
        params: {
          // Agent Information
          Taalk_AgentFirstName: agentFirstName,
          Taalk_AgentLastName: agentLastName,
          Taalk_AgentPhone: formattedAgentPhone || '',
          Taalk_AgentEmail: agentEmail, // Use the authenticated agent's email
          
          // Client Information
          Taalk_MemberFirstName: session.firstName,
          Taalk_MemberFiirstName: session.firstName, // Typo version for script compatibility
          Taalk_MemberPhone: session.phone,
          Taalk_PMemberFirstName: session.firstName,
          MemberFirstName: session.firstName, // Without Taalk_ prefix
          Taalk_ClientName: `${session.firstName} ${session.lastName}`,
          Taalk_ClientPhone: session.phone,
          
