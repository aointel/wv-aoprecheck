  // VDP Events to Supabase Webhook
  app.post("/api/webhook/vdp-events", async (req, res) => {
    try {
      console.log('📞 Received VDP event webhook:', req.body);
      
      // Handle multiple data formats
      let eventDate, eventTime, eventType, phoneNumber, agentId, params, leadId;
      
      // Format 1: Direct fields (Zapier format)
      if (req.body.Date && req.body.Time && req.body.Event) {
        eventDate = req.body.Date;
        eventTime = req.body.Time;
        eventType = req.body.Event;
        phoneNumber = req.body.Phone;
        agentId = req.body.Agent;
        params = req.body.Params;
        leadId = null; // Zapier format doesn't have leadId in task params
      }
      // Format 2: VDP system format
      else if (req.body.event && req.body.agent) {
        eventDate = new Date().toISOString().split('T')[0]; // Current date
        eventTime = new Date().toTimeString().split(' ')[0]; // Current time
        eventType = req.body.event;
        phoneNumber = req.body.task?.phone || req.body.phone || null;
        agentId = req.body.agent.id || req.body.agent;
        leadId = req.body.task?.params?.Leadid ? String(req.body.task.params.Leadid) : null; // Extract Lead ID from task params
        console.log('🔍 Lead ID extraction debug:', {
          hasTask: !!req.body.task,
          hasParams: !!req.body.task?.params,
          hasLeadid: !!req.body.task?.params?.Leadid,
          rawLeadid: req.body.task?.params?.Leadid,
          extractedLeadId: leadId
        });
        params = JSON.stringify(req.body.agent.params || req.body);
      }
      // Format 3: Try to extract from any nested structure
      else {
        // Auto-generate missing fields for any webhook data
        eventDate = req.body.date || new Date().toISOString().split('T')[0];
        eventTime = req.body.time || new Date().toTimeString().split(' ')[0];
        eventType = req.body.event || req.body.Event || 'WEBHOOK_EVENT';
        phoneNumber = req.body.phone || req.body.Phone || null;
        agentId = req.body.agent || req.body.Agent || 'unknown';
        leadId = null; // Generic format doesn't have leadId
        params = JSON.stringify(req.body);
      }
      
      // Always accept webhook data - don't reject
      if (!eventType) {
        eventType = 'WEBHOOK_RECEIVED';
      }

      // Store VDP event in local PostgreSQL database
      const vdpEventData = {
        Date: eventDate,
        Time: eventTime,
        Event: eventType,
        Phone: phoneNumber || null,
        Agent: agentId || null,
        Params: params || null
      };

      await db.insert(schema.vdpCalls).values(vdpEventData);
      console.log('✅ VDP event stored in PostgreSQL');

      // Store in Supabase (your trusted database) - store as JSON in masterlead table
      if (supabase) {
        const vdpEventData = {
          event_date: eventDate,
          event_time: eventTime,
          event_type: eventType,
          phone_number: phoneNumber || '',
          agent_id: agentId || '',
          event_params: params || '',
          raw_webhook_data: JSON.stringify(req.body),
          created_at: new Date().toISOString()
        };

        // Store in the dedicated VDP webhook events table
        const { data, error } = await supabase
          .from('vdp_webhook_events')
          .insert({
            event_date: eventDate,
            event_time: eventTime,
            event_type: eventType,
            phone_number: phoneNumber || null,
            agent_id: agentId || null,
            leadid: leadId || null,
            event_params: params || null,
            raw_webhook_data: req.body,
            created_at: new Date().toISOString()
          })
          .select()
          .single();

        if (error) {
          console.error('❌ Supabase insertion failed:', error);
          // Don't fail webhook - log the issue and continue
          console.log('⚠️ Continuing without Supabase storage - webhook still successful');
        } else {
          console.log('✅ VDP event stored in Supabase:', data?.id || 'success');
        }
      }

      // 💳 Process credit transactions for CONNECT events (real-time billing)
      if (eventType === 'CONNECT' && agentId) {
        try {
          // Extract client info from VDP event structure
          let clientName = 'Unknown Client';
          let market = 'Unknown';
          let actualPhoneNumber = phoneNumber || 'Unknown Phone';
          let firstName = '';
          let lastName = '';
          
          // Extract from agent.params (VDP format)
          if (req.body.agent?.params) {
            const agentParams = req.body.agent.params;
            
            // Get client name from first_name/last_name
            firstName = agentParams.first_name || '';
            lastName = agentParams.last_name || '';
            if (firstName || lastName) {
              clientName = `${firstName} ${lastName}`.trim();
            }
            
            // Get market info
            if (agentParams.market) {
              market = Array.isArray(agentParams.market) ? agentParams.market.join(', ') : agentParams.market;
            }
          }
          
          // Try task.phone for phone number
          if (req.body.task?.phone) {
            actualPhoneNumber = req.body.task.phone;
          }
          
          // Determine service type based on campaign - ALL VDP CONNECTS ARE AOI_CONNECT
          let serviceType = 'aoi_connect'; // All VDP connects are $8.00 AOI Connect
          const campaign = req.body.agent?.params?.campaign || '';
          
          // VDP connects are ALWAYS AOI Connect regardless of market
          // The market "aorecruit" doesn't mean it's a recruit service - it's still a connect
          serviceType = 'aoi_connect'; // Force to AOI Connect for all VDP events
          
          // 🚀 CRITICAL: Auto-create recruit candidate if market is "aorecruit"
          if (market && market.toLowerCase().includes('recruit')) {
            console.log(`🎯 AO RECRUIT CALL DETECTED! Auto-creating candidate...`);
            
            try {
              // Get agent email from associate_id
              const { data: agentData } = await supabaseAdmin
                .from('customers')
                .select('customer_email')
                .eq('associate_id', parseInt(agentId))
                .single();
              
              const agentEmail = agentData?.customer_email || 'unknown@aoglobelife.com';
              
              // Check if candidate already exists with this phone
              const { data: existingCandidate } = await supabaseAdmin
                .from('recruit_candidates')
                .select('id')
                .eq('phone', actualPhoneNumber)
                .single();
              
              if (!existingCandidate && firstName && lastName) {
                // Create new recruit candidate
                const { data: newCandidate, error: candidateError } = await supabaseAdmin
                  .from('recruit_candidates')
                  .insert({
                    first_name: firstName,
                    last_name: lastName,
                    phone: actualPhoneNumber,
                    email: '', // Will be filled in later
                    status: 'contacted',
                    current_stage_id: 1, // AO Recruit stage
                    stage_entered_at: new Date().toISOString(),
                    agent_id: agentEmail,
                    agent_email: agentEmail,
                    notes: `Auto-created from inbound VDP call on ${eventDate} at ${eventTime}`,
                    created_at: new Date().toISOString(),
                    updated_at: new Date().toISOString()
                  })
                  .select()
                  .single();
                
                if (candidateError) {
                  console.error('❌ Failed to auto-create recruit candidate:', candidateError);
                } else {
                  console.log(`✅ AUTO-CREATED RECRUIT CANDIDATE: ${newCandidate.id} - ${firstName} ${lastName} for agent ${agentEmail}`);
                }
              } else if (existingCandidate) {
                console.log(`ℹ️ Candidate already exists for phone ${actualPhoneNumber}, skipping creation`);
              } else {
                console.log(`⚠️ Missing first/last name, cannot auto-create candidate`);
              }
            } catch (recruitError) {
              console.error('❌ Error in recruit candidate auto-creation:', recruitError);
            }
          }

          console.log(`💳 Processing ${serviceType.toUpperCase()} billing for agent ${agentId}`);
          console.log(`📞 Client: ${clientName} | Phone: ${actualPhoneNumber} | Market: ${market}`);
          
          // Extract client data from task params if available
          let leadid = '';
          let firstname = '';
          let lastname = '';
          
          if (req.body.task?.params) {
            const taskParams = req.body.task.params;
            leadid = String(taskParams.Leadid || '');
            firstname = taskParams['First Name'] || '';
            lastname = taskParams['Last Name'] || '';
          }

          // Create VDP connect record to link the transaction
          const tempConnectResult = await db.insert(schema.vdpConnects).values({
            agentId: agentId,
            phone: actualPhoneNumber,
            durationSeconds: 60, // Estimated duration for real-time connects
            clientName: clientName.substring(0, 100),
            leadid: leadid,
            firstname: firstname, 
            lastname: lastname,
            market: market.substring(0, 50),
            connectDate: eventDate,
            pickupTime: new Date().toISOString(),
            endTime: new Date(Date.now() + 60000).toISOString(), // 1 minute estimated
          }).returning({ id: schema.vdpConnects.id });

          const vdpConnectId = tempConnectResult[0].id;

          // Process credit deduction with correct service type and rates
          const creditResult = await creditService.deductCreditsForConnect(
            vdpConnectId,
            agentId,
            actualPhoneNumber,
            clientName,
            60, // Estimated duration
            market,
            serviceType // THIS IS THE KEY FIX - Pass service type for correct billing
          );

          if (creditResult.success) {
            const rates = {
              aoi_connect: '$8.00',
              aoi_missed: '$4.00', 
              aoi_recruit: '$5.00',
              aoi_precheck: '$3.00'
            };
            const rate = rates[serviceType as keyof typeof rates] || '$8.00';
            console.log(`✅ ${serviceType.toUpperCase()} billing successful for agent ${agentId}: ${rate} deducted, new balance: $${creditResult.newBalance.toFixed(2)}`);
          } else {
            console.log(`⚠️ Credit deduction failed for agent ${agentId}: ${creditResult.message}`);
          }

        } catch (creditError) {
          console.error(`❌ Error processing credits for CONNECT event:`, creditError);
          // Don't fail the webhook if credit processing fails
        }
      }

      // Always return success since PostgreSQL storage worked
      res.json({
        success: true,
        message: 'VDP event processed and stored in PostgreSQL successfully',
        eventType,
        timestamp: new Date().toISOString()
      });

    } catch (error) {
      console.error('❌ VDP webhook error:', error);
      res.status(500).json({ 
        error: 'Failed to process VDP event',
        details: error instanceof Error ? error.message : 'Unknown error'
      });
    }
  });

