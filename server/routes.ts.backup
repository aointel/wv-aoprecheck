  // Debug endpoint to check Supabase masterlead counts
  app.get("/api/debug/supabase-count", async (req, res) => {
    try {
      // Get total count of all leads
      const { count: totalCount } = await supabase
        .from('masterlead')
        .select('*', { count: 'exact', head: true });

      // Get count of pending leads
      const { count: pendingCount } = await supabase
        .from('masterlead')
        .select('*', { count: 'exact', head: true })
        .eq('cnresolution', 'pending');

      // Get count of plus leads with pending resolution
      const { count: plusLeadsCount } = await supabase
        .from('masterlead')
        .select('*', { count: 'exact', head: true })
        .eq('cnresolution', 'pending')
        .eq('taalk_market', 'Plus Lead');

      // Get count of hotleads with pending resolution
      const { count: hotleadsCount } = await supabase
        .from('masterlead')
        .select('*', { count: 'exact', head: true })
        .eq('cnresolution', 'pending')
        .eq('isHotLead', true);

      // Get count of our query (plus leads OR hotleads with pending)
      const { count: ourQueryCount } = await supabase
        .from('masterlead')
        .select('*', { count: 'exact', head: true })
        .eq('cnresolution', 'pending')
        .or('taalk_market.eq.Plus Lead,isHotLead.eq.true');

      res.json({
        total_leads: totalCount,
        pending_leads: pendingCount,
        plus_leads_pending: plusLeadsCount,
        hotleads_pending: hotleadsCount,
        our_query_result: ourQueryCount,
        query_used: "cnresolution=pending AND (taalk_market='Plus Lead' OR isHotLead=true)"
      });
    } catch (error) {
      console.error('❌ Debug count error:', error);
      res.status(500).json({ error: error.message });
    }
  });

  // RBAC Page Permissions API Endpoints
  
  // Get current user's permissions and allowed pages (SECURE DEFAULT-DENY)
  app.get("/api/rbac/user-permissions", async (req, res) => {
    try {
      const { getUserPermissions } = await import('./rbac-helper');
      const { getAllowedPages } = await import('./secure-rbac');
      const userEmail = req.query.userEmail as string || (req.session as any)?.user?.email || 'cnsysop@aoglobelife.com';
      
      console.log(`🔐 RBAC API called for: ${userEmail}`);

      // Get user's role and permissions
      const userPermissions = await getUserPermissions(userEmail);
      
      // SECURE: Use default-deny resolver (no fallback to DEFAULT_PAGE_PERMISSIONS)
      const allowedPages = await getAllowedPages(userPermissions.role);
      
      res.json({
        role: userPermissions.role,
        allowedPages,
        canViewAll: userPermissions.canViewAll
      });
    } catch (error) {
      console.error('❌ Error fetching user permissions:', error);
      res.status(500).json({ error: 'Failed to fetch user permissions' });
    }
  });

  // Get all role-page permissions (SECURE DEFAULT-DENY MATRIX)
  app.get("/api/rbac/permissions", async (req, res) => {
    try {
      const { getUserPermissions } = await import('./rbac-helper');
      const { buildPermissionsMatrix } = await import('./secure-rbac');
      const userEmail = req.query.userEmail as string || (req.session as any)?.user?.email || 'cnsysop@aoglobelife.com';

      // Check if user has admin access
      const userPermissions = await getUserPermissions(userEmail);
      if (!userPermissions.canViewAll && userPermissions.role !== 'system_admin') {
        return res.status(403).json({ error: 'Access denied. Admin privileges required.' });
      }

      // SECURE: Use default-deny matrix builder (no fallback to DEFAULT_PAGE_PERMISSIONS)
      const permissionsMatrix = await buildPermissionsMatrix();
      
      res.json(permissionsMatrix);
    } catch (error) {
      console.error('❌ Error fetching permissions:', error);
      res.status(500).json({ error: 'Failed to fetch permissions' });
    }
  });

  // Update role-page permissions (accepts { [role]: PageKey[] } format)
  app.put("/api/rbac/permissions", async (req, res) => {
    try {
      const { getUserPermissions } = await import('./rbac-helper');
      const { rolePagePermissions, ROLES, PAGE_KEYS } = await import('@shared/schema');
      const userEmail = (req.session as any)?.user?.email || req.headers['user-email'] as string || 'cnsysop@aoglobelife.com';
      
      if (!userEmail) {
        return res.status(401).json({ error: 'Not authenticated' });
      }

      // Check if user has admin access
      const userPermissions = await getUserPermissions(userEmail);
      if (!userPermissions.canViewAll && userPermissions.role !== 'system_admin') {
        return res.status(403).json({ error: 'Access denied. Admin privileges required.' });
      }

      const permissionsData = req.body;
      
      // Validate input
      if (!permissionsData || typeof permissionsData !== 'object') {
        return res.status(400).json({ error: 'Invalid permissions data' });
      }
      
      // Validate roles and pages
      for (const role of Object.keys(permissionsData)) {
        if (!ROLES.includes(role as any)) {
          return res.status(400).json({ error: `Invalid role: ${role}` });
        }
        
        for (const page of permissionsData[role]) {
          if (!PAGE_KEYS.includes(page as any)) {
            return res.status(400).json({ error: `Invalid page: ${page}` });
          }
        }
      }
      
      // Clear existing permissions and insert new ones
      await db.delete(rolePagePermissions);
      
      const insertData = [];
      for (const role of Object.keys(permissionsData)) {
        for (const page of PAGE_KEYS) {
          const hasPermission = permissionsData[role].includes(page);
          insertData.push({
            role,
            page,
            allowed: hasPermission
          });
        }
      }
      
      if (insertData.length > 0) {
        await db.insert(rolePagePermissions).values(insertData);
      }
      
      // CRITICAL: Invalidate permission cache so changes take effect immediately
      const { invalidatePermissionCache } = await import('./secure-rbac');
      invalidatePermissionCache();
      
      console.log(`✅ Updated role permissions for ${Object.keys(permissionsData).length} roles by ${userEmail}`);
      res.json({ success: true, message: 'Permissions updated successfully' });
    } catch (error) {
      console.error('❌ Error updating permissions:', error);
      res.status(500).json({ error: 'Failed to update permissions' });
    }
  });

  // DEBUG: Check specific verification session
  app.get("/api/admin/check-session/:id", async (req, res) => {
    try {
      const sessionId = req.params.id;
      const { data, error } = await supabaseAdmin
        .from('verification_sessions')
        .select('id, session_id, taalk_call_id, first_name, last_name')
        .eq('id', sessionId);
      
      if (error) {
        return res.status(500).json({ error: error.message });
      }
      
      if (!data || data.length === 0) {
        return res.status(404).json({ error: 'Session not found', id: sessionId });
      }
      
      const session = data[0];
      res.json({
        found: data.length,
        ...session,
        is_corrupted: session.taalk_call_id === session.session_id,
        comparison: {
          session_id: session.session_id,
          taalk_call_id: session.taalk_call_id,
          are_equal: session.taalk_call_id === session.session_id
        }
      });
    } catch (error: any) {
      res.status(500).json({ error: error.message });
    }
  });

  // FIX CORRUPTED TAALK_CALL_ID DATA - Admin endpoint to clean up verification_sessions
  app.post("/api/admin/fix-taalk-call-ids", async (req, res) => {
    try {
      console.log('🔧 ADMIN: Starting Taalk call ID cleanup...');
      
      // Find all records where taalk_call_id equals session_id (corrupted data)
      const { data: corruptedRecords, error: fetchError } = await supabaseAdmin
        .from('verification_sessions')
        .select('id, session_id, taalk_call_id')
        .not('taalk_call_id', 'is', null);
      
      if (fetchError) {
        console.error('❌ Error fetching records:', fetchError);
        return res.status(500).json({ error: fetchError.message });
      }

      console.log(`📊 Found ${corruptedRecords?.length || 0} records with taalk_call_id`);

      // Filter to find corrupted ones where taalk_call_id = session_id
      const corrupted = corruptedRecords?.filter(r => r.taalk_call_id === r.session_id) || [];
      
      console.log(`🔍 Found ${corrupted.length} CORRUPTED records where taalk_call_id = session_id`);
      
      if (corrupted.length === 0) {
        return res.json({ 
          success: true, 
          message: 'No corrupted records found',
          fixed: 0,
          total: corruptedRecords?.length || 0
        });
      }

      // Fix corrupted records by setting taalk_call_id to NULL
      const idsToFix = corrupted.map(r => r.id);
      
      const { error: updateError } = await supabaseAdmin
        .from('verification_sessions')
        .update({ taalk_call_id: null })
        .in('id', idsToFix);
      
      if (updateError) {
        console.error('❌ Error updating records:', updateError);
        return res.status(500).json({ error: updateError.message });
      }

      console.log(`✅ Fixed ${corrupted.length} corrupted records`);
      
      res.json({
        success: true,
        message: `Successfully cleaned ${corrupted.length} corrupted records`,
        fixed: corrupted.length,
        total: corruptedRecords?.length || 0,
        corruptedRecords: corrupted.map(r => ({
          id: r.id,
          session_id: r.session_id,
          bad_taalk_call_id: r.taalk_call_id
        }))
      });
    } catch (error: any) {
      console.error('❌ Cleanup failed:', error);
      res.status(500).json({ error: error.message });
    }
  });

  // ============================================
