  app.post("/api/recruit/simulate-vdp-call", async (req, res) => {
    try {
      const { firstName, lastName, phone, agentId, market } = req.body;
      
      if (!firstName || !lastName || !phone || !agentId) {
        return res.status(400).json({ success: false, message: 'Missing required fields' });
      }
      
      console.log(`🎬 SIMULATING VDP CALL: ${firstName} ${lastName} → Agent ${agentId}`);
      
      // Insert into vdp_calls_BLASTPICK - the poller will pick it up
      const { data: insertedCall, error: insertError } = await supabaseAdmin
        .from('vdp_calls_BLASTPICK')
        .insert({
          time: new Date().toISOString(),
          event: 'PICK_UP',
          phone: phone,
          agent: agentId,
          leadid: null,
          market: market || 'aorecruit',
          firstName: firstName,
          lastName: lastName,
          duration: null,
          sessionid: `sim-${Date.now()}`
        })
        .select()
        .single();
      
      if (insertError) {
        console.error('❌ Failed to insert VDP call:', insertError);
        return res.status(500).json({ success: false, message: 'Failed to simulate call', error: insertError });
      }
      
      console.log(`✅ VDP call simulated - poller will process in ~10 seconds`);
      res.json({ 
        success: true, 
        message: 'VDP call simulated - recruit poller will create candidate in ~10 seconds',
        vdpCall: insertedCall
      });
    } catch (error) {
      console.error('❌ Error simulating VDP call:', error);
      res.status(500).json({ success: false, message: 'Failed to simulate VDP call' });
    }
  });
  
  // Get all candidates for authenticated agent
  app.get("/api/recruit/candidates", async (req, res) => {
    try {
      const agentEmail = req.query.email as string || (req as any).user?.email;
      if (!agentEmail) {
        return res.status(400).json({ success: false, message: 'Agent email required' });
      }
      console.log('🔍 Fetching recruit candidates for:', agentEmail);
      const candidates = await storage.getRecruitCandidates(agentEmail);
      
      // Enrich each candidate with journey progress
      const candidatesWithProgress = await Promise.all(
        candidates.map(async (candidate) => {
          const { data: journeySession } = await supabaseAdmin
            .from('candidate_journey_sessions')
            .select('*')
            .eq('candidate_id', candidate.id)
            .single();
          
          return {
            ...candidate,
            journeyProgress: journeySession ? {
              video_section_1_watched: journeySession.video_section_1_watched || false,
              video_section_2_watched: journeySession.video_section_2_watched || false,
              question_1_answered: journeySession.question_1_answered || false,
              question_2_answered: journeySession.question_2_answered || false,
              question_3_answered: journeySession.question_3_answered || false,
              current_video_chapter: journeySession.current_video_chapter || 0,
              video_progress_percent: journeySession.video_progress_percent || 0,
              questionnaire_stood_out: journeySession.questionnaire_stood_out || '',
              questionnaire_good_fit: journeySession.questionnaire_good_fit || '',
              questionnaire_licensing_investment: journeySession.questionnaire_licensing_investment || '',
            } : null
          };
        })
      );
      
      console.log(`✅ Found ${candidatesWithProgress.length} recruit candidates with journey progress`);
      res.json({ success: true, candidates: candidatesWithProgress });
    } catch (error) {
      console.error('Failed to get candidates:', error);
      res.status(500).json({ success: false, message: 'Failed to retrieve candidates' });
    }
  });

  // Get single candidate by ID (for journey page)
  app.get("/api/recruit/candidates/:id", async (req, res) => {
    try {
      const { id } = req.params;
      console.log(`🔍 Fetching candidate ${id} for journey page`);
      
      const candidate = await storage.getRecruitCandidateById(parseInt(id));
      if (!candidate) {
        return res.status(404).json({ success: false, message: 'Candidate not found' });
      }
      
      console.log(`✅ Found candidate: ${candidate.firstName} ${candidate.lastName}, agent: ${candidate.agentEmail}`);
      res.json({ success: true, candidate });
    } catch (error) {
      console.error('Failed to get candidate:', error);
      res.status(500).json({ success: false, message: 'Failed to retrieve candidate' });
    }
  });

  // Get recruitment pipeline stages
  app.get("/api/recruit/stages", async (req, res) => {
    // ALWAYS return default stages for now (database table not set up yet)
    const defaultStages = [
      { id: 1, name: 'AO Recruit', order_index: 1, isTerminal: false },
      { id: 2, name: '1st Interview', order_index: 2, isTerminal: false },
      { id: 3, name: 'Virtual Overview', order_index: 3, isTerminal: false },
      { id: 4, name: 'Debrief', order_index: 4, isTerminal: false },
      { id: 5, name: 'Group Final', order_index: 5, isTerminal: false },
      { id: 6, name: 'Final Interview', order_index: 6, isTerminal: false },
      { id: 7, name: 'Hired', order_index: 7, isTerminal: true },
      { id: 8, name: 'Not Interested', order_index: 8, isTerminal: true },
    ];
    
    res.json({ success: true, stages: defaultStages });
  });

  // Create new candidate
  app.post("/api/recruit/candidates", async (req, res) => {
    try {
      // Get user email from headers (JWT auth) OR session (fallback)
      const headerEmail = req.headers['x-user-email'] as string || req.headers['user-email'] as string;
      const sessionEmail = (req.session as any)?.user?.email;
      const agentEmail = headerEmail || sessionEmail;
      
      console.log('🔍 CREATE CANDIDATE - Auth check:');
      console.log('   Headers x-user-email:', req.headers['x-user-email']);
      console.log('   Headers user-email:', req.headers['user-email']);
      console.log('   Session email:', sessionEmail);
      console.log('   Final agentEmail:', agentEmail);
      
      if (!agentEmail) {
        console.error('❌ No user email found for create candidate');
        console.error('   All headers:', JSON.stringify(req.headers, null, 2));
        return res.status(401).json({ success: false, message: 'Authentication required - no user email found' });
      }
      
      console.log(`👤 Creating candidate for agent: ${agentEmail}`);
      console.log(`📝 Candidate data:`, JSON.stringify(req.body, null, 2));
      
      // Get agent profile for agentId
      const agentProfile = await storage.getAgentProfileByEmail(agentEmail);
      const agentId = agentProfile?.supabaseUserId || agentEmail;
      
      const candidateData = {
        ...req.body,
        agentId,
        agentEmail,
      };

      // Validate the candidate data
      const parsedData = insertRecruitCandidateSchema.parse(candidateData);
      console.log(`✅ Validated candidate data, calling storage.createRecruitCandidate...`);
      
      const candidate = await storage.createRecruitCandidate(parsedData);
      
      console.log('✅ Created recruit candidate:', candidate.id, candidate.firstName, candidate.lastName);
      res.json({ success: true, candidate });
    } catch (error) {
      console.error('❌ Failed to create candidate:', error);
      if (error instanceof z.ZodError) {
        return res.status(400).json({ success: false, message: 'Invalid candidate data', errors: error.errors });
      }
      res.status(500).json({ success: false, message: 'Failed to create candidate' });
    }
  });

  // Update candidate
  app.patch("/api/recruit/candidates/:id", async (req, res) => {
    try {
      // Get user email from headers (JWT auth) OR session (fallback)
      const headerEmail = req.headers['x-user-email'] as string || req.headers['user-email'] as string;
      const sessionEmail = (req.session as any)?.user?.email;
      const agentEmail = headerEmail || sessionEmail;
      
      if (!agentEmail) {
        console.error('❌ No user email found for update candidate');
        return res.status(401).json({ success: false, message: 'Authentication required' });
      }
      
      const { id } = req.params;
      const updates = req.body;
      
      console.log(`✏️ Updating candidate ${id} by agent: ${agentEmail}`);
      
      // Validate the update data
      const parsedUpdates = updateRecruitCandidateSchema.parse(updates);
      const updatedCandidate = await storage.updateRecruitCandidate(parseInt(id), parsedUpdates);
      
      if (!updatedCandidate) {
        return res.status(404).json({ success: false, message: 'Candidate not found' });
      }
      
      console.log('✅ Updated recruit candidate:', updatedCandidate.id, updatedCandidate.firstName);
      res.json({ success: true, candidate: updatedCandidate });
    } catch (error) {
      console.error('❌ Failed to update candidate:', error);
      if (error instanceof z.ZodError) {
        return res.status(400).json({ success: false, message: 'Invalid update data', errors: error.errors });
      }
      res.status(500).json({ success: false, message: 'Failed to update candidate' });
    }
  });

  // Delete candidate
  app.delete("/api/recruit/candidates/:id", async (req, res) => {
    try {
      // Get user email from headers (JWT auth) OR session (fallback)
      const headerEmail = req.headers['x-user-email'] as string || req.headers['user-email'] as string;
      const sessionEmail = (req.session as any)?.user?.email;
      const agentEmail = headerEmail || sessionEmail;
      
      if (!agentEmail) {
        console.error('❌ No user email found for delete candidate');
        return res.status(401).json({ success: false, message: 'Authentication required' });
      }
      
      const { id } = req.params;
      
      console.log(`🗑️ Deleting candidate ${id} by agent: ${agentEmail}`);
      
      const success = await storage.deleteRecruitCandidate(parseInt(id));
      
      if (!success) {
        return res.status(404).json({ success: false, message: 'Candidate not found' });
      }
      
      console.log('✅ Deleted recruit candidate:', id);
      res.json({ success: true, message: 'Candidate deleted' });
    } catch (error) {
      console.error('❌ Failed to delete candidate:', error);
      res.status(500).json({ success: false, message: 'Failed to delete candidate' });
    }
  });

  // Move candidate to different stage
  app.post("/api/recruit/candidates/:id/move-stage", async (req, res) => {
    try {
      const { id } = req.params;
      const { toStageId } = req.body;
      
      if (!toStageId) {
        return res.status(400).json({ success: false, message: 'toStageId is required' });
      }
      
      // Convert toStageId to integer (frontend might send as string)
      const stageId = typeof toStageId === 'string' ? parseInt(toStageId) : toStageId;
      
      console.log(`🔄 Moving candidate ${id} to stage ${stageId}`);
      
      // Get candidate first to check phone number
      const candidate = await storage.getRecruitCandidateById(parseInt(id));
      if (!candidate) {
        return res.status(404).json({ success: false, message: 'Candidate not found' });
      }
      
      // Update the candidate's current stage
      const updatedCandidate = await storage.updateRecruitCandidate(parseInt(id), {
        currentStageId: stageId,
        stageEnteredAt: new Date()
      });
      
      if (!updatedCandidate) {
        return res.status(404).json({ success: false, message: 'Candidate not found' });
      }
      
      // If moving to Virtual Overview (stage 3), create journey session and send SMS
      if (stageId === 3 && candidate.phone) {
        // Create or update journey session
        const { data: existingSession } = await supabaseAdmin
          .from('candidate_journey_sessions')
          .select('*')
          .eq('candidate_id', candidate.id)
          .single();
        
        if (!existingSession) {
          console.log(`🎬 Creating new journey session for candidate ${candidate.id}`);
          const { error: sessionError } = await supabaseAdmin
            .from('candidate_journey_sessions')
            .insert({
              candidate_id: candidate.id,
              video_section_1_watched: false,
              video_section_2_watched: false,
              question_1_answered: false,
              question_2_answered: false,
              question_3_answered: false,
              created_at: new Date().toISOString()
            });
          
          if (sessionError) {
            console.error('❌ Failed to create journey session:', sessionError);
          } else {
            console.log('✅ Journey session created');
          }
        } else {
          console.log(`✅ Journey session already exists for candidate ${candidate.id}`);
        }
        
        // Send journey SMS with all required params
        const journeyUrl = `${PRODUCTION_URL}/recruit-journey?candidate=${candidate.id}&agent=${encodeURIComponent(candidate.agentEmail)}&name=${encodeURIComponent(candidate.firstName + ' ' + candidate.lastName)}&phone=${encodeURIComponent(candidate.phone)}`;
        const message = `Hi ${candidate.firstName}, this is AO Recruit! Click here to watch our Virtual Overview and connect with us: ${journeyUrl}`;
        
        console.log(`📱 Sending journey SMS to ${candidate.firstName} ${candidate.lastName} at ${candidate.phone}`);
        console.log(`🔗 Journey URL: ${journeyUrl}`);
        const smsSent = await smsService.sendSMS(candidate.phone, message);
        
        if (smsSent) {
          console.log(`✅ Journey SMS sent to ${candidate.phone}`);
        } else {
          console.warn(`⚠️ Failed to send journey SMS to ${candidate.phone}`);
        }
      }
      
      console.log(`✅ Moved candidate ${id} to stage ${stageId}`);
      res.json({ success: true, message: 'Candidate stage updated', candidate: updatedCandidate });
    } catch (error) {
      console.error('❌ Failed to move candidate stage:', error);
      console.error('   Error details:', error);
      res.status(500).json({ success: false, message: 'Failed to move candidate stage', error: error instanceof Error ? error.message : 'Unknown error' });
    }
  });

  // Get recruit stats for dashboard
  app.get("/api/recruit/stats", async (req, res) => {
    try {
      const agentEmail = req.query.email as string || (req as any).user?.email;
      if (!agentEmail) {
        return res.status(400).json({ success: false, message: 'Agent email required' });
      }
      const candidates = await storage.getRecruitCandidates(agentEmail);
      
      const stats = {
        totalCandidates: candidates.length,
        newCandidates: candidates.filter(c => c.status === 'new').length,
        contactedCandidates: candidates.filter(c => c.status === 'contacted').length,
        interviewCandidates: candidates.filter(c => c.status === 'interview').length,
        pendingCandidates: candidates.filter(c => c.status === 'pending').length,
        hiredCandidates: candidates.filter(c => c.status === 'hired').length,
        rejectedCandidates: candidates.filter(c => c.status === 'rejected').length,
        upcomingAppointments: candidates.filter(c => c.appointmentDate && new Date(c.appointmentDate) > new Date()).length,
      };
      
      res.json({ success: true, stats });
    } catch (error) {
      console.error('Failed to get recruit stats:', error);
      res.status(500).json({ success: false, message: 'Failed to retrieve stats' });
    }
  });

  // REMOVED: recruit_connections endpoints - system now uses recruit_candidates table only

  // Get journey session for a candidate
  app.get("/api/recruit/journey-session/:candidateId", async (req, res) => {
    try {
      const { candidateId } = req.params;
      
      const { data: session, error } = await supabaseAdmin
        .from('candidate_journey_sessions')
        .select('*')
        .eq('candidate_id', candidateId)
        .single();
      
      if (error && error.code !== 'PGRST116') {
        throw error;
      }
      
      res.json({ success: true, session: session || null });
    } catch (error) {
      console.error('Failed to get journey session:', error);
      res.status(500).json({ success: false, message: 'Failed to get journey session' });
    }
  });
  
  // Update journey session progress
  app.patch("/api/recruit/journey-session/:candidateId", async (req, res) => {
    try {
      const { candidateId } = req.params;
      const updates = req.body;
      
      const { data, error } = await supabaseAdmin
        .from('candidate_journey_sessions')
        .update(updates)
        .eq('candidate_id', candidateId)
        .select()
        .single();
      
      if (error) {
        throw error;
      }
      
      res.json({ success: true, session: data });
    } catch (error) {
      console.error('Failed to update journey session:', error);
      res.status(500).json({ success: false, message: 'Failed to update journey session' });
    }
  });

  // Get Virtual Overview candidates with journey progress
  app.get("/api/recruit/virtual-overview-progress", async (req, res) => {
    try {
      const agentEmail = req.query.email as string || (req as any).user?.email;
      
      if (!agentEmail) {
        return res.status(400).json({ success: false, message: 'Agent email required' });
      }
      
      console.log('🔍 Fetching Virtual Overview candidates for:', agentEmail);
      
      // Get Virtual Overview stage ID
      const { data: virtualStage } = await supabaseAdmin
        .from('recruit_stages')
        .select('*')
        .ilike('name', 'Virtual Overview')
        .single();
      
      if (!virtualStage) {
        console.log('⚠️ No Virtual Overview stage found');
        return res.json({ success: true, candidates: [] });
      }
      
      console.log('✅ Virtual Overview stage ID:', virtualStage.id);
      
      // Get candidates in Virtual Overview stage for this agent
      const { data: candidates, error } = await supabaseAdmin
        .from('recruit_candidates')
        .select('*')
        .eq('agent_email', agentEmail)
        .eq('current_stage_id', virtualStage.id);
      
      if (error) throw error;
      
      console.log(`✅ Found ${candidates?.length || 0} candidates in Virtual Overview for ${agentEmail}`);
      
      // For each candidate, get their journey progress
      const candidatesWithProgress = await Promise.all(
        (candidates || []).map(async (candidate) => {
          const { data: journeySession } = await supabaseAdmin
            .from('candidate_journey_sessions')
            .select('*')
            .eq('candidate_id', candidate.id)
            .single();
          
          console.log(`  📊 Candidate ${candidate.id} (${candidate.first_name} ${candidate.last_name}): Journey session exists:`, !!journeySession);
          
          return {
            ...candidate,
            journeyProgress: journeySession || {
              video_section_1_watched: false,
              video_section_2_watched: false,
              question_1_answered: false,
              question_2_answered: false,
              question_3_answered: false,
            }
          };
        })
      );
      
      console.log('✅ Returning candidates with progress:', candidatesWithProgress.length);
      res.json({ success: true, candidates: candidatesWithProgress });
    } catch (error) {
      console.error('❌ Error fetching virtual overview candidates:', error);
      res.status(500).json({ success: false, message: 'Failed to fetch candidates' });
    }
  });

  // Request connection endpoint - Creates a Whereby room and notifies agent
  app.post("/api/recruit/request-connection", async (req, res) => {
    try {
      const { candidateId, candidateName, candidatePhone, agentEmail, questionnaireData } = req.body;
      
      console.log('📞 Creating connection request:', {  candidateName, agentEmail });
      
      // Create a Whereby room
      const wherebyResponse = await fetch('https://api.whereby.dev/v1/meetings', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${WHEREBY_API_KEY}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          endDate: new Date(Date.now() + 2 * 60 * 60 * 1000).toISOString(), // 2 hours from now
          fields: ['hostRoomUrl']
        })
      });
      
      const wherebyData = await wherebyResponse.json();
      
      if (!wherebyData.roomUrl) {
        throw new Error('Failed to create Whereby room');
      }
      
      // Insert connection request into database
      const { data, error } = await supabaseAdmin
        .from('recruit_connection_requests')
        .insert({
          candidate_id: candidateId ? parseInt(candidateId) : null,
          candidate_name: candidateName,
          candidate_phone: candidatePhone,
          agent_email: agentEmail,
          whereby_host_url: wherebyData.hostRoomUrl,
          whereby_room_url: wherebyData.roomUrl,
          questionnaire_answers: JSON.stringify(questionnaireData),
          status: 'waiting',
          created_at: new Date().toISOString()
        })
        .select()
        .single();
      
      if (error) throw error;
      
      console.log('✅ Connection request created:', data.id);
      
      res.json({ 
        success: true, 
        connectionId: data.id,
        roomUrl: wherebyData.roomUrl
      });
      
    } catch (error) {
      console.error('❌ Error creating connection request:', error);
      res.status(500).json({ success: false, message: 'Failed to create connection request' });
    }
  });

  // Check connection status - Polls for when agent is ready
  app.get("/api/recruit/connection-status/:id", async (req, res) => {
    try {
      const { id } = req.params;
      
      const { data, error } = await supabaseAdmin
        .from('recruit_connection_requests')
        .select('*')
        .eq('id', id)
        .single();
      
      if (error) throw error;
      
      res.json({ 
        success: true, 
        status: data.status,
        // Return room URL when accepted or ready so candidate can auto-join
        roomUrl: (data.status === 'accepted' || data.status === 'ready') ? data.whereby_room_url : null
      });
      
    } catch (error) {
      console.error('❌ Error checking connection status:', error);
      res.status(500).json({ success: false, message: 'Failed to check connection status' });
    }
  });

  // Get pending connections for an agent - Shows waiting candidates in queue
  app.get("/api/recruit/pending-connections/:agentEmail", async (req, res) => {
    try {
      const { agentEmail } = req.params;
      
      console.log('📋 Fetching pending connections for:', agentEmail);
      
      const { data, error } = await supabaseAdmin
        .from('recruit_connection_requests')
        .select('*')
        .eq('agent_email', agentEmail)
        .eq('status', 'waiting')
        .order('created_at', { ascending: true });
      
      if (error) throw error;
      
      // Get journey progress for each candidate
      const connectionsWithProgress = await Promise.all(
        (data || []).map(async (connection: any) => {
          if (!connection.candidate_id) {
            return {
              id: connection.id,
              candidateId: connection.candidate_id,
              candidateName: connection.candidate_name,
              candidatePhone: connection.candidate_phone,
              wherebyHostUrl: connection.whereby_host_url,
              wherebyRoomUrl: connection.whereby_room_url,
              questionnaireAnswers: connection.questionnaire_answers,
              createdAt: connection.created_at,
              status: connection.status,
            };
          }
          
          const { data: journeySession } = await supabaseAdmin
            .from('candidate_journey_sessions')
            .select('*')
            .eq('candidate_id', connection.candidate_id)
            .single();
          
          return {
            id: connection.id,
            candidateId: connection.candidate_id,
            candidateName: connection.candidate_name,
            candidatePhone: connection.candidate_phone,
            wherebyHostUrl: connection.whereby_host_url,
            wherebyRoomUrl: connection.whereby_room_url,
            questionnaireAnswers: connection.questionnaire_answers,
            createdAt: connection.created_at,
            status: connection.status,
            videoSection1Watched: journeySession?.video_section_1_watched || false,
            videoSection2Watched: journeySession?.video_section_2_watched || false,
            question1Answered: journeySession?.question_1_answered || false,
            question2Answered: journeySession?.question_2_answered || false,
            question3Answered: journeySession?.question_3_answered || false,
            currentVideoChapter: journeySession?.current_video_chapter || 0,
            videoProgressPercent: journeySession?.video_progress_percent || 0,
          };
        })
      );
      
      console.log(`✅ Found ${connectionsWithProgress.length} pending connections for ${agentEmail}`);
      
      res.json({ 
        success: true, 
        connections: connectionsWithProgress
      });
      
    } catch (error) {
      console.error('❌ Error fetching pending connections:', error);
      res.status(500).json({ success: false, message: 'Failed to fetch pending connections' });
    }
  });

  // Update connection status endpoint - Agent accepts or declines
  app.post("/api/recruit/update-connection-status", async (req, res) => {
    try {
      const { id, status } = req.body;
      
      console.log('🔄 Updating connection status:', { id, status });
      
      if (!id || !status) {
        return res.status(400).json({ success: false, message: 'Missing id or status' });
      }
      
      // First check if the record exists
      const { data: existingRecord, error: fetchError } = await supabaseAdmin
        .from('recruit_connection_requests')
        .select('*')
        .eq('id', id)
        .single();
      
      if (fetchError) {
        console.error('❌ Error fetching connection request:', fetchError);
        return res.status(404).json({ success: false, message: 'Connection request not found', error: fetchError.message });
      }
      
      console.log('✅ Found connection request:', existingRecord);
      
      // If accepting, change status to 'accepted' so candidate's waiting room shows "Join" button
      const { data, error } = await supabaseAdmin
        .from('recruit_connection_requests')
        .update({ 
          status,
          updated_at: new Date().toISOString()
        })
        .eq('id', id)
        .select()
        .single();
      
      if (error) {
        console.error('❌ Supabase update error:', error);
        throw error;
      }
      
      console.log('✅ Connection status updated to:', status);
      
      res.json({ 
        success: true,
        candidateId: data.candidate_id
      });
      
    } catch (error: any) {
      console.error('❌ Error updating connection status:', error);
      res.status(500).json({ 
        success: false, 
        message: 'Failed to update status',
        error: error.message || String(error)
      });
    }
  });

  // CSV Database Webhook for Lead Ingestion
  app.post("/api/webhook/csv-leads", async (req, res) => {
    try {
      console.log('📥 CSV Lead webhook received:', req.body);
      
      const leadData = req.body;
      
      // Map CSV webhook data to our database schema
      const mappedLead = {
        firstName: leadData["First Name"] || leadData.firstName,
        lastName: leadData["Last Name"] || leadData.lastName,
        referrer: leadData["Referrer"] || leadData.referrer,
        phone: leadData["Phone"] || leadData.phone,
        email: leadData["Email"] || leadData.email,
        address1: leadData["Address 1"] || leadData.address1,
        city: leadData["City"] || leadData.city,
        state: leadData["State"] || leadData.state,
        postalCode: leadData["Postal Code"] || leadData.postalCode,
        language: leadData["Language"] || leadData.language || "1",
        cost: leadData["Cost"] ? leadData["Cost"].toString() : null,
        gender: leadData["Gender"] || leadData.gender,
        querystring: leadData["querystring"] || leadData.querystring,
        status: "new",
      };

      // Validate the lead data
      const validatedLead = insertIncomingLeadSchema.parse(mappedLead);
      
      // Save to database
      const savedLead = await storage.createIncomingLead(validatedLead);
      
      console.log(`✅ CSV Lead saved: ${savedLead.firstName} ${savedLead.lastName} (${savedLead.phone})`);
      console.log(`📍 Location: ${savedLead.city}, ${savedLead.state} | Cost: $${savedLead.cost} | Referrer: ${savedLead.referrer}`);
      
      res.json({
        success: true,
        message: "Lead successfully ingested",
        leadId: savedLead.id,
        leadDetails: {
          name: `${savedLead.firstName} ${savedLead.lastName}`,
          phone: savedLead.phone,
          location: `${savedLead.city}, ${savedLead.state}`,
          cost: savedLead.cost,
          referrer: savedLead.referrer
        }
      });

    } catch (error) {
      console.error('❌ CSV Lead webhook error:', error);
      
      if (error instanceof z.ZodError) {
        return res.status(400).json({
          success: false,
          message: "Invalid lead data format",
          errors: error.errors.map(e => ({
            field: e.path.join('.'),
            message: e.message,
            received: (e as any).received
          }))
        });
      }
      
      res.status(500).json({
        success: false,
        message: "Failed to process CSV lead",
        error: error instanceof Error ? error.message : String(error)
      });
    }
  });

