  // Video Meeting System API Routes
  
  // Store video session admission status in memory for now
  const videoSessions: Map<string, { admitted: boolean; agentName?: string }> = new Map();
  
  // Check if client is admitted to video session
  app.get("/api/video/check-access", async (req, res) => {
    try {
      const sessionId = String(req.query.sessionId || '');
      console.log('[SERVER] check-access', { sessionId });
      
      if (!sessionId) {
        return res.status(400).json({ error: 'Session ID required' });
      }
      
      const session = videoSessions.get(sessionId);
      const admitted = session?.admitted || false;
      
      console.log(`🔍 Video access check for session ${sessionId}: ${admitted ? 'admitted' : 'waiting'}`);
      
      res.json({ admitted: !!admitted });
    } catch (error) {
      console.error('❌ Video access check error:', error);
      res.status(500).json({ error: 'Failed to check access' });
    }
  });
  
  // Admit client to video session (called by agent)
  app.post("/api/video/admit", async (req, res) => {
    try {
      const { sessionId } = req.body || {};
      console.log('🎯 [SERVER] ADMIT REQUEST RECEIVED:', { 
        sessionId, 
        bodyKeys: Object.keys(req.body || {}),
        contentType: req.headers['content-type']
      });
      
      if (!sessionId) {
        console.error('❌ [SERVER] Missing sessionId in admit request');
        return res.status(400).json({ ok:false, error:'missing sessionId' });
      }
      
      // Check current state before admitting
      const beforeState = videoSessions.get(sessionId);
      console.log('📋 [SERVER] Before admit state:', { sessionId, beforeState, mapSize: videoSessions.size });
      
      // Admit the client to this session
      videoSessions.set(sessionId, { admitted: true });
      
      // Check state after admitting
      const afterState = videoSessions.get(sessionId);
      console.log('✅ [SERVER] After admit state:', { sessionId, afterState, mapSize: videoSessions.size });
      
      // List all current sessions for debugging
      console.log('🗂️ [SERVER] All video sessions:', Array.from(videoSessions.entries()));
      
      res.json({ ok:true, sessionId });
    } catch (error) {
      console.error('❌ Video admit error:', error);
      res.status(500).json({ error: 'Failed to admit client' });
    }
  });
  
  // Generate Twilio Video access token
  app.post("/api/video/token", async (req, res) => {
    try {
      const { identity, roomName } = req.body;
      
      if (!identity || !roomName) {
        return res.status(400).json({ error: 'Identity and roomName required' });
      }
      
      // Create unique identities as specified
      const timestamp = Date.now().toString();
      const uniqueIdentity = identity.includes('Agent') 
        ? `Agent-${identity.replace('Agent ', '').replace(/\s+/g, '-')}-${timestamp}`
        : `${identity.replace(/\s+/g, '-')}-${timestamp}`;
      
      console.log(`🎥 Generating Twilio Video token for ${uniqueIdentity} in room ${roomName}`);
      
      // Import Twilio AccessToken
      const AccessToken = twilio.jwt.AccessToken;
      const VideoGrant = AccessToken.VideoGrant;
      
      // Create access token
      const token = new AccessToken(
        TWILIO_ACCOUNT_SID,        // Account SID (sub)
        TWILIO_API_KEY,            // API Key SID (iss)
        TWILIO_API_SECRET,         // API Secret
        { identity: uniqueIdentity }
      );
      
      // Add video grant with exact room name
      const videoGrant = new VideoGrant({
        room: roomName
      });
      token.addGrant(videoGrant);
      
      // Set token TTL to 1 hour
      token.ttl = 3600;
      
      const jwtToken = token.toJwt();
      
      // Log token details as specified
      console.log(`✅ Generated Twilio Video token:`, {
        room: roomName,
        iss: TWILIO_API_KEY,      // API Key SID
        sub: TWILIO_ACCOUNT_SID,  // Account SID
        identity: uniqueIdentity
      });
      
      res.json({ token: jwtToken });
    } catch (error) {
      console.error('❌ Video token generation error:', error);
      res.status(500).json({ error: 'Failed to generate video token' });
    }
  });

