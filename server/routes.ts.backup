        // Use fallback
        const arrayBuffer = await fallbackResponse.arrayBuffer();
        const buffer = Buffer.from(arrayBuffer);
        
        const bucketId = process.env.PRIVATE_OBJECT_DIR?.split('/')[1] || 'replit-objstore-6b6b5e82-17a0-48c7-ace1-b8adfc5db10f';
        const filename = `${bucketId}/.private/recordings/${callId}-${Date.now()}.mp3`;
        const { ObjectStorageService } = await import('./objectStorage');
