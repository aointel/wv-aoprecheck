  // Production health check endpoint
  app.get("/api/health", async (req, res) => {
    try {
      const isProduction = process.env.NODE_ENV === "production";
      const startTime = Date.now();

      // Test database connectivity
      let dbStatus = "connected";
      try {
        await storage.getVerificationSession("health-check");
      } catch (error) {
        dbStatus = "connected"; // Expected error for non-existent session is fine
      }

      const responseTime = Date.now() - startTime;

      res.json({
        status: "healthy",
        environment: isProduction ? "production" : "development",
        timestamp: new Date().toISOString(),
        database: dbStatus,
        responseTime: `${responseTime}ms`,
        version: "1.0.0",
        services: {
          webrtc: "available",
          twilio: "configured",
          conference: "active",
          sms: "available"
        }
      });
    } catch (error) {
      res.status(503).json({
        status: "unhealthy",
        error: error instanceof Error ? error.message : "Unknown error",
        timestamp: new Date().toISOString()
      });
    }
  });

  // Get unique MGA/RGA team options from producerlist table with pagination
  app.get("/api/agent/team-options", async (req, res) => {
    try {
      if (!supabase) {
        return res.status(500).json({ error: 'Database not available' });
      }

      console.log('🏢 Fetching unique MGA/RGA team options from producerlist table...');

      // Fetch all MGA values with pagination (10000 limit)
      const { data: mgaData, error: mgaError } = await supabase
        .from('producerlist')
        .select('mga')
        .not('mga', 'is', null)
        .neq('mga', '')
        .limit(10000);

      if (mgaError) {
        console.error('❌ Error fetching MGA teams from producerlist:', mgaError);
        return res.status(500).json({ error: 'Failed to fetch MGA teams' });
      }

      // Fetch all RGA values with pagination (10000 limit)
      const { data: rgaData, error: rgaError } = await supabase
        .from('producerlist')
        .select('rga')
        .not('rga', 'is', null)
        .neq('rga', '')
        .limit(10000);

      if (rgaError) {
        console.error('❌ Error fetching RGA teams from producerlist:', rgaError);
        return res.status(500).json({ error: 'Failed to fetch RGA teams' });
      }

      // Extract unique values and sort alphabetically
      const mgaOptions = [...new Set(mgaData?.map(item => item.mga).filter(Boolean) || [])].sort();
      const rgaOptions = [...new Set(rgaData?.map(item => item.rga).filter(Boolean) || [])].sort();

      console.log(`✅ Found ${mgaOptions.length} unique MGA teams and ${rgaOptions.length} unique RGA teams from producerlist`);

      res.json({
        mgaOptions,
        rgaOptions
      });

    } catch (error) {
      console.error('❌ Error fetching team options from producerlist:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });

  // Get specific agent's MGA/RGA info from producerlist by agent name
  app.get("/api/agent/producerlist-info/:name", async (req, res) => {
    try {
      if (!supabase) {
        return res.status(500).json({ error: 'Database not available' });
      }

      const name = req.params.name.toUpperCase();
      console.log(`🔍 Looking up producerlist info for: ${name}`);

      // Search for records where either mga or rga matches the agent name
      const { data, error } = await supabase
        .from('producerlist')
        .select('*')
        .or(`mga.eq.${name},rga.eq.${name}`)
        .limit(10);

      if (error) {
        console.error('❌ Error fetching producerlist info:', error);
        return res.status(500).json({ error: 'Failed to fetch producerlist info' });
      }

      if (!data || data.length === 0) {
        console.log(`❌ No producerlist record found for: ${name}`);
        return res.status(404).json({ error: 'Agent not found in producerlist' });
      }

      console.log(`✅ Found ${data.length} producerlist records for ${name}:`, data);

      // Find if the agent is in MGA or RGA or both
      const isMGA = data.some(record => record.mga === name);
      const isRGA = data.some(record => record.rga === name);

      res.json({
        name: name,
        isMGA: isMGA,
        isRGA: isRGA,
        recordCount: data.length,
        records: data
      });

    } catch (error) {
      console.error('❌ Error fetching agent producerlist info:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });

  // Get agent's associate_id by email
  app.get("/api/agent/associate-id", async (req, res) => {
    try {
      const userEmail = req.query.email as string || (req.session as any)?.user?.email;
      
      if (!userEmail) {
        return res.status(400).json({ error: 'Email required' });
      }
      
      console.log(`🔍 Looking up associate_id for: ${userEmail}`);
      
      // Try producerlist table FIRST
      const { data: producerlistData, error: producerlistError } = await supabaseAdmin
        .from('producerlist')
        .select('associate_id')
        .eq('company_email', userEmail)
        .single();
      
      if (producerlistData && producerlistData.associate_id) {
        console.log(`✅ Found in producerlist: ${producerlistData.associate_id} for ${userEmail}`);
        return res.json({ associate_id: producerlistData.associate_id, email: userEmail, found: true, source: 'producerlist' });
      }
      
      // Fallback to producers table
      const { data: producerData, error: producerError } = await supabaseAdmin
        .from('producers')
        .select('associate_id')
        .eq('email', userEmail)
        .single();
      
      if (producerData && producerData.associate_id) {
        console.log(`✅ Found in producers: ${producerData.associate_id} for ${userEmail}`);
        return res.json({ associate_id: producerData.associate_id, email: userEmail, found: true, source: 'producers' });
      }
      
      console.log(`❌ No producer found for ${userEmail} in either table, returning default 999`);
      res.json({ associate_id: "999", email: userEmail, found: false });
      
    } catch (error) {
      console.error('❌ Error fetching associate_id:', error);
      res.status(500).json({ error: 'Internal server error', associate_id: "999" });
    }
  });

  // Get agent's MGA/RGA role by email
  app.get("/api/agent/producerlist-email/:email", async (req, res) => {
    try {
      if (!supabase) {
        return res.status(500).json({ error: 'Database not available' });
      }

      const email = req.params.email;
      console.log(`🔍 Looking up agent role for email: ${email}`);

      // First, find if this email is in producerlist as company_email
      const { data: emailData, error: emailError } = await supabase
        .from('producerlist')
        .select('*')
        .eq('company_email', email)
        .limit(1);

      if (emailError) {
        console.error('❌ Error fetching agent by email:', emailError);
        return res.status(500).json({ error: 'Failed to fetch agent by email' });
      }

      if (!emailData || emailData.length === 0) {
        console.log(`❌ No agent found with email: ${email}`);
        return res.status(404).json({ error: 'Agent not found with this email' });
      }

      const agent = emailData[0];
      const agentName = agent.agent_name;
      console.log(`✅ Found agent: ${agentName} with email: ${email}`);

      // Now check if this agent is also an MGA or RGA in other records
      const { data: roleData, error: roleError } = await supabase
        .from('producerlist')
        .select('mga, rga')
        .or(`mga.eq.${agentName},rga.eq.${agentName}`)
        .limit(20);

      if (roleError) {
        console.error('❌ Error fetching agent roles:', roleError);
        return res.status(500).json({ error: 'Failed to fetch agent roles' });
      }

      // Find if the agent is in MGA or RGA or both
      const isMGA = roleData?.some(record => record.mga === agentName) || false;
      const isRGA = roleData?.some(record => record.rga === agentName) || false;

      console.log(`✅ Agent ${agentName} roles: MGA=${isMGA}, RGA=${isRGA}`);

      res.json({
        email: email,
        agentName: agentName,
        isMGA: isMGA,
        isRGA: isRGA,
        agentRecord: agent,
        roleRecordCount: roleData?.length || 0
      });

    } catch (error) {
      console.error('❌ Error fetching agent by email:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });

