  // Live Call Priority System - API Hook for External Systems
  app.post("/api/live-call/inject", async (req, res) => {
    try {
      const { agentEmail, callerName, callerPhone, source, metadata } = req.body;
      
      if (!agentEmail || !callerName || !callerPhone) {
        return res.status(400).json({ 
          error: 'Required fields: agentEmail, callerName, callerPhone' 
        });
      }

      console.log(`🔥 LIVE CALL INJECTED for ${agentEmail}:`, { callerName, callerPhone, source });

      // Step 1: Mark agent as busy with live call
      await db.execute(sql`
        INSERT INTO agent_live_call_status (agent_email, caller_name, caller_phone, source, metadata, started_at)
        VALUES (${agentEmail}, ${callerName}, ${callerPhone}, ${source || 'external'}, ${JSON.stringify(metadata || {})}, CURRENT_TIMESTAMP)
        ON CONFLICT (agent_email) 
        DO UPDATE SET 
          caller_name = EXCLUDED.caller_name,
          caller_phone = EXCLUDED.caller_phone,
          source = EXCLUDED.source,
          metadata = EXCLUDED.metadata,
          started_at = CURRENT_TIMESTAMP,
          is_active = true
      `);

      // Step 2: Create masterlead entry with MAXIMUM priority (999999) - USE PHONE AS LEAD ID
      const leadId = `live_${callerPhone.replace(/\D/g, '')}`; // Use actual phone number as identifier
      
      await db.execute(sql`
        INSERT INTO masterlead (
          first_name, last_name, phone, email, state, city, zip,
          status, cn_email, is_live_call, live_call_priority, 
          assigned_agent_email, created_at, updated_at
        ) VALUES (
          ${callerName.split(' ')[0] || callerName}, ${callerName.split(' ').slice(1).join(' ') || ''}, 
          ${callerPhone}, ${'live_call@system.internal'}, ${'XX'}, ${'Live Call'}, ${'00000'},
          ${'NEW'}, ${agentEmail}, ${true}, ${999999},
          ${agentEmail}, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP
        )
      `);

      // Step 3: Notify frontend to disconnect Taalk VDP during live call
      console.log(`📞 TAALK VDP CONTROL: Agent ${agentEmail} should disconnect from VDP during live call`);
      // The frontend will handle: TaalkVDP.disconnect() when call starts

      console.log(`✅ Live call injected successfully: Lead ID ${leadId}`);
      
      res.json({
        success: true,
        leadId,
        message: `Live call injected for ${agentEmail}`,
        priority: 999999,
        agentStatus: 'busy_with_live_call'
      });

    } catch (error) {
      console.error('❌ Live call injection error:', error);
      res.status(500).json({ error: 'Failed to inject live call' });
    }
  });

