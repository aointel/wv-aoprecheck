  // Get agent schedule for a specific date
  app.get('/api/appointments/schedule/:email', async (req, res) => {
    try {
      const { email } = req.params;
      const { date } = req.query;
      
      if (!email || !date) {
        return res.status(400).json({ error: 'Email and date are required' });
      }

      // Query appointments table for the specific agent and date
      const result = await db
        .select()
        .from(schema.appointments)
        .where(
          and(
            eq(schema.appointments.agentEmail, email),
            sql`DATE(${schema.appointments.startTime}) = ${date}`
          )
        );

      // Format appointments for frontend
      const formattedAppointments = result.map(appointment => ({
        time: new Date(appointment.startTime).toLocaleTimeString('en-US', { 
          hour: 'numeric', 
          minute: '2-digit', 
          hour12: true 
        }),
        client: appointment.leadName,
        leadName: appointment.leadName,
        leadPhone: appointment.leadPhone,
        status: 'booked',
        type: appointment.appointmentType
      }));

      res.json({
        success: true,
        appointments: formattedAppointments,
        date: date,
        agentEmail: email
      });

    } catch (error) {
      console.error('❌ Error fetching agent schedule:', error);
      res.status(500).json({ 
        error: 'Failed to fetch agent schedule',
        appointments: [] // Fallback to empty schedule
      });
    }
  });

