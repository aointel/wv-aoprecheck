  // Sync RGA data from PostgreSQL to Supabase customers table
  app.post('/api/teams/sync-rga-to-supabase', async (req, res) => {
    try {
      console.log('🔄 Syncing RGA data from PostgreSQL to Supabase customers table');
      
      if (!supabase) {
        return res.status(500).json({ error: 'Supabase not configured' });
      }
      
      // Get all agent profiles with RGA assignments
      const profiles = await storage.getAllAgentProfiles();
      const mgaToRgaMap = new Map<string, string>();
      
      // Build MGA -> RGA mapping
      profiles.forEach(profile => {
        if (profile.mgaTeam && profile.rgaTeam) {
          mgaToRgaMap.set(profile.mgaTeam, profile.rgaTeam);
        }
      });
      
      console.log(`📊 Found ${mgaToRgaMap.size} MGA -> RGA mappings to sync`);
      
      let updateCount = 0;
      
      // Update Supabase customers table with RGA data based on MGA
      for (const [mgaTeam, rgaTeam] of mgaToRgaMap.entries()) {
        const { data, error } = await supabase
          .from('customers')
          .update({ rga: rgaTeam })
          .eq('mga', mgaTeam);
          
        if (error) {
          console.error(`❌ Error updating RGA for MGA ${mgaTeam}:`, error);
        } else {
          updateCount++;
          console.log(`✅ Updated RGA "${rgaTeam}" for MGA "${mgaTeam}"`);
        }
      }
      
      res.json({
        success: true,
        message: `Synced RGA data for ${updateCount} MGA teams`,
        updatedMGAs: updateCount
      });
      
    } catch (error) {
      console.error('❌ Error in RGA sync endpoint:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });
  
  // Sync all user data from Supabase to PostgreSQL
  app.post('/api/teams/sync-users-from-supabase', async (req, res) => {
    try {
      console.log('🔄 Syncing all user data from Supabase to PostgreSQL agentProfiles table');
      
      if (!supabaseAdmin) {
        return res.status(500).json({ error: 'Supabase admin not configured' });
      }
      
      // Get all users from Supabase customers table using admin client with pagination
      console.log('🔍 Querying Supabase customers table with pagination...');
      
      let allUsers = [];
      let page = 0;
      const pageSize = 1000; // Large page size to get most users in one go
      let hasMore = true;
      
      while (hasMore) {
        const { data: pageUsers, error: fetchError } = await supabaseAdmin
          .from('customers')
          .select('*')
          .not('associate_id', 'is', null)
          .not('first_name', 'is', null)
          .order('created_at', { ascending: false })
          .range(page * pageSize, (page + 1) * pageSize - 1);
          
        if (fetchError) {
          console.error('❌ Error fetching users from Supabase:', fetchError);
          return res.status(500).json({ error: 'Failed to fetch users from Supabase' });
        }
        
        if (!pageUsers || pageUsers.length === 0) {
          hasMore = false;
        } else {
          allUsers.push(...pageUsers);
          console.log(`📄 Page ${page + 1}: Found ${pageUsers.length} users (Total: ${allUsers.length})`);
          
          if (pageUsers.length < pageSize) {
            hasMore = false; // Last page
          } else {
            page++;
          }
        }
      }
      
      const supabaseUsers = allUsers;
      const fetchError = null;
      
      console.log('📊 Raw Supabase query result:', { 
        dataLength: supabaseUsers?.length || 0, 
        error: fetchError,
        sampleData: supabaseUsers?.slice(0, 2)
      });
        
      if (fetchError) {
        console.error('❌ Error fetching users from Supabase:', fetchError);
        return res.status(500).json({ error: 'Failed to fetch users from Supabase' });
      }
      
      if (!supabaseUsers || supabaseUsers.length === 0) {
        return res.json({
          success: true,
          message: 'No users found in Supabase to sync',
          syncedUsers: 0
        });
      }
      
      console.log(`📊 Found ${supabaseUsers.length} users in Supabase to sync`);
      
      let syncedCount = 0;
      let updatedCount = 0;
      
      // Process each user
      for (const user of supabaseUsers) {
        try {
          // Check if agent profile already exists
          const existingProfile = await storage.getAgentProfile(user.company_email);
          
          const profileData = {
            email: user.company_email,
            firstName: user.first_name || '',
            lastName: user.last_name || '',
            phone: user.phone || '',
            mgaTeam: user.team || '',
            rgaTeam: user.rga || '', // Use lowercase 'rga' field from Supabase
            teamRole: user.agenttype || 'agent',
            region: user.region || '',
            state: user.state || '',
            market: user.market || '',
            associateId: user.associate_id ? parseInt(user.associate_id) : undefined,
            status: user.status || 'active',
            managerEmail: user.manager_email || ''
          };
          
          if (existingProfile) {
            // Update existing profile using supabase user ID
            await storage.updateAgentProfileBySupabaseId(existingProfile.supabaseUserId!, profileData);
            updatedCount++;
            console.log(`🔄 Updated profile for ${user.company_email}`);
          } else {
            // Create new profile with supabase user ID
            const profileWithSupabaseId = {
              ...profileData,
              supabaseUserId: user.id // Use the ID from Supabase customers table
            };
            await storage.createAgentProfileWithSupabaseId(profileWithSupabaseId);
            syncedCount++;
            console.log(`✅ Created new profile for ${user.company_email}`);
          }
          
        } catch (profileError) {
          console.error(`❌ Error syncing profile for ${user.company_email}:`, profileError);
        }
      }
      
      console.log(`✅ Sync complete: ${syncedCount} new profiles, ${updatedCount} updated profiles`);
      
      res.json({
        success: true,
        message: `Synced ${syncedCount + updatedCount} user profiles from Supabase`,
        syncedUsers: syncedCount,
        updatedUsers: updatedCount,
        totalProcessed: syncedCount + updatedCount
      });
      
    } catch (error) {
      console.error('❌ Error in user sync endpoint:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });
  
  // Get team-based stats with RGA hierarchy support
  app.get('/api/stats/teams', async (req, res) => {
    try {
      const { rgaTeam, mgaTeam } = req.query;
      
      console.log(`📊 Fetching team stats - RGA: ${rgaTeam || 'All'}, MGA: ${mgaTeam || 'All'}`);
      
      // Get all agent profiles to build filter list
      const profiles = await storage.getAllAgentProfiles();
      let targetAgents: string[] = [];
      
      if (rgaTeam) {
        // Filter by RGA - get all agents under this RGA (including their MGAs)
        targetAgents = profiles
          .filter(p => p.rgaTeam === rgaTeam)
          .map(p => p.email)
          .filter(Boolean);
      } else if (mgaTeam) {
        // Filter by MGA only
        targetAgents = profiles
          .filter(p => p.mgaTeam === mgaTeam)
          .map(p => p.email)
          .filter(Boolean);
      } else {
        // All agents
        targetAgents = profiles.map(p => p.email).filter(Boolean);
      }
      
      console.log(`🎯 Filtering stats for ${targetAgents.length} agents in scope`);
      
      // Get call stats from PostgreSQL for filtered agents
      const callResults = await db
        .select({
          agentEmail: outboundCallHistory.agentEmail,
          callCount: sql<number>`count(*)`,
          totalDuration: sql<number>`sum(${outboundCallHistory.callDuration})`,
          completedCalls: sql<number>`sum(case when ${outboundCallHistory.callStatus} = 'completed' then 1 else 0 end)`,
          bookedCalls: sql<number>`sum(case when ${outboundCallHistory.reached} = true and ${outboundCallHistory.booked} = true then 1 else 0 end)`
        })
        .from(outboundCallHistory)
        .where(sql`${outboundCallHistory.agentEmail} = ANY(${targetAgents})`)
        .groupBy(outboundCallHistory.agentEmail);
      
      // Get appointment stats for filtered agents
      const appointmentResults = await db
        .select({
          agentId: appointments.agentId,
          appointmentCount: sql<number>`count(*)`,
          todayAppointments: sql<number>`sum(case when date(${appointments.appointmentDate}) = current_date then 1 else 0 end)`
        })
        .from(appointments)
        .where(sql`${appointments.agentId} = ANY(${targetAgents})`)
        .groupBy(appointments.agentId);
      
      const teamStats = {
        totalAgents: targetAgents.length,
        totalCalls: callResults.reduce((sum, r) => sum + r.callCount, 0),
        totalDuration: callResults.reduce((sum, r) => sum + (r.totalDuration || 0), 0),
        completedCalls: callResults.reduce((sum, r) => sum + r.completedCalls, 0),
        bookedCalls: callResults.reduce((sum, r) => sum + r.bookedCalls, 0),
        totalAppointments: appointmentResults.reduce((sum, r) => sum + r.appointmentCount, 0),
        todayAppointments: appointmentResults.reduce((sum, r) => sum + r.todayAppointments, 0),
        agentBreakdown: callResults.map(call => {
          const agent = profiles.find(p => p.email === call.agentEmail);
          const appointments = appointmentResults.find(a => a.agentId === call.agentEmail);
          return {
            email: call.agentEmail,
            name: agent ? `${agent.firstName || ''} ${agent.lastName || ''}`.trim() : 'Unknown',
            mgaTeam: agent?.mgaTeam || 'Unassigned',
            rgaTeam: agent?.rgaTeam || 'Unassigned',
            callCount: call.callCount,
            completedCalls: call.completedCalls,
            bookedCalls: call.bookedCalls,
            appointmentCount: appointments?.appointmentCount || 0
          };
        })
      };
      
      res.json({
        success: true,
        stats: teamStats,
        filterApplied: {
          rgaTeam: rgaTeam || null,
          mgaTeam: mgaTeam || null
        }
      });
      
    } catch (error) {
      console.error('❌ Error in team stats endpoint:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });

  // MISSED CALL BILLING ENDPOINTS
  
