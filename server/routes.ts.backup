        console.error(`❌ Session not found: ${sessionId}`, error);
        return res.status(404).json({ error: 'Session not found' });
      }

      console.log(`🎵 Session data:`, {
        hasRecordingUrl: !!session.recording_url,
        hasTaalkCallUrl: !!session.taalk_call_url,
        hasTaalkCallId: !!session.taalk_call_id,
        method: session.verification_method
      });

      // Priority: recording_url (Supabase signed URL) > taalk_call_url > constructed taalk URL
      let recordingUrl = session.recording_url || session.taalk_call_url || null;
      
      // If no direct URL but we have taalk_call_id, construct the Taalk API URL
      if (!recordingUrl && session.taalk_call_id) {
        recordingUrl = `https://api.taalk.ai/api/calls/${session.taalk_call_id}/recording?db=michaelmandella`;
        console.log(`🎵 Constructed Taalk URL from call ID: ${session.taalk_call_id}`);
      }
      
      if (!recordingUrl) {
        console.error(`❌ No recording URL found for session ${sessionId}`);
        return res.status(404).json({ error: 'Recording not found - no URL available' });
      }

      console.log(`🎵 Using recording URL: ${recordingUrl.substring(0, 100)}...`);

      // For Taalk recordings (api.taalk.ai or api.taalk.io), proxy with auth
      if (recordingUrl.includes('taalk.ai') || recordingUrl.includes('taalk.io')) {
        try {
          const TAALK_API_KEY = process.env.TAALK_API_KEY || 'your-taalk-api-key';
          console.log(`🎵 Fetching Taalk recording with API key...`);
          
          const response = await fetch(recordingUrl, {
            headers: {
              'Authorization': `Bearer ${TAALK_API_KEY}`
            }
          });

          if (!response.ok) {
            console.error(`❌ Taalk API error: ${response.status} ${response.statusText}`);
            return res.status(404).json({ error: `Recording not available: ${response.statusText}` });
          }

          const clientName = `${session.first_name || ''} ${session.last_name || ''}`.trim();
          const filename = `recording-${clientName || sessionId}-${new Date().toISOString().split('T')[0]}.mp3`;
          
          // Set headers for INLINE PLAYBACK (not download!)
          res.setHeader('Content-Type', response.headers.get('content-type') || 'audio/mpeg');
          res.setHeader('Content-Length', response.headers.get('content-length') || '');
          res.setHeader('Accept-Ranges', 'bytes');
          res.setHeader('Cache-Control', 'public, max-age=3600');
          res.setHeader('Content-Disposition', 'inline'); // PLAY INLINE, DON'T DOWNLOAD
          res.setHeader('Access-Control-Allow-Origin', '*'); // Allow CORS
          
          // Get the buffer and send it - node-fetch has .buffer() method
          const buffer = await (response as any).buffer();
          console.log(`✅ Fetched recording: ${buffer.length} bytes`);
          res.send(buffer);
        } catch (fetchError: any) {
          console.error('❌ Error fetching Taalk recording:', fetchError.message);
          return res.status(500).json({ error: `Failed to download recording: ${fetchError.message}` });
        }
      } else {
        // Direct file URL (Supabase signed URL or other) - proxy it
        try {
          console.log(`🎵 Fetching direct recording URL...`);
          const response = await fetch(recordingUrl);
          
          if (!response.ok) {
            console.error(`❌ Direct URL fetch error: ${response.status} ${response.statusText}`);
            return res.status(404).json({ error: `Recording not available: ${response.statusText}` });
          }

          // Set headers for audio playback
          res.setHeader('Content-Type', response.headers.get('content-type') || 'audio/mpeg');
          res.setHeader('Content-Length', response.headers.get('content-length') || '');
          res.setHeader('Accept-Ranges', 'bytes');
          res.setHeader('Cache-Control', 'public, max-age=3600');
          
          // Get the buffer and send it
          const buffer = await response.buffer();
          console.log(`✅ Fetched direct recording: ${buffer.length} bytes`);
          res.send(buffer);
        } catch (fetchError: any) {
          console.error('❌ Error fetching direct recording:', fetchError.message);
          return res.status(500).json({ error: `Failed to download recording: ${fetchError.message}` });
        }
      }
    } catch (error: any) {
      console.error('❌ Recording download error:', error.message);
      res.status(500).json({ error: `Download failed: ${error.message}` });
    }
  });

  // Force run screenshot analysis for AOI Precheck  // Analyzer endpoint removed – AI verification scheduler deprecated.\r\n    } catch (error: any) {
      console.error('❌ Manual analysis error:', error);
      res.status(500).json({ 
        error: 'Analysis failed', 
        message: error.message 
      });
    }
  });

  app.get("/api/aoi-precheck/download/certificate/:sessionId", async (req, res) => {
    try {
      const { sessionId } = req.params;
      
      // Get session data with all relevant fields
      const { data: session, error } = await supabaseAdmin
        .from('verification_sessions')
        .select('session_id, first_name, last_name, phone, client_ip_address, verification_method, created_at, completed_at, verification_result, call_duration')
        .eq('id', sessionId)
        .single();

      if (error || !session) {
        return res.status(404).json({ error: 'Session not found' });
      }

      const clientName = `${session.first_name || ''} ${session.last_name || ''}`.trim();
      const certificateId = `AO-${session.session_id?.toUpperCase() || sessionId}`;
      const verificationDate = new Date(session.created_at);
      const completedDate = session.completed_at ? new Date(session.completed_at) : verificationDate;
      
      // Generate beautiful HTML certificate
      const certificateHTML = `
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AO Precheck Verification Certificate - ${clientName}</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 2rem;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .certificate {
      background: white;
      max-width: 900px;
      width: 100%;
      padding: 3rem;
      border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      position: relative;
      overflow: hidden;
    }
    
    .certificate::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 8px;
      background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
    }
    
    .header {
      text-align: center;
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 2px solid #f1f5f9;
    }
    
    .header h1 {
      color: #1e293b;
      font-size: 2rem;
      margin-bottom: 0.5rem;
      font-weight: 700;
    }
    
    .header .subtitle {
      color: #64748b;
      font-size: 1rem;
    }
    
    .seal {
      width: 80px;
      height: 80px;
      margin: 0 auto 1rem;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 2rem;
      font-weight: bold;
    }
    
    .certificate-id {
      text-align: center;
      color: #475569;
      font-size: 0.875rem;
      margin-bottom: 2rem;
      font-family: monospace;
      letter-spacing: 1px;
    }
    
    .section {
      margin-bottom: 2rem;
    }
    
    .section-title {
      color: #1e293b;
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #e2e8f0;
    }
    
    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
    
    .info-item {
      padding: 0.75rem;
      background: #f8fafc;
      border-radius: 8px;
    }
    
    .info-label {
      color: #64748b;
      font-size: 0.875rem;
      margin-bottom: 0.25rem;
    }
    
    .info-value {
      color: #1e293b;
      font-size: 1rem;
      font-weight: 600;
    }
    
    .status-badge {
      display: inline-block;
      padding: 0.5rem 1rem;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: white;
      border-radius: 9999px;
      font-size: 0.875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .verification-result {
      background: #f0fdf4;
      border-left: 4px solid #10b981;
      padding: 1rem;
      border-radius: 8px;
      color: #166534;
      margin-top: 1rem;
    }
    
    .footer {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 2px solid #f1f5f9;
      text-align: center;
      color: #64748b;
      font-size: 0.875rem;
    }
    
    .footer p {
      margin-bottom: 0.5rem;
    }
    
    .timestamp {
      color: #94a3b8;
      font-size: 0.75rem;
      margin-top: 1rem;
    }
    
    @media print {
      body {
        background: white;
        padding: 0;
      }
      
      .certificate {
        box-shadow: none;
        max-width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="certificate">
    <div class="seal">✓</div>
    <div class="header">
      <h1>Verification Certificate</h1>
      <p class="subtitle">AO Precheck Insurance Verification System</p>
    </div>
    
    <div class="certificate-id">Certificate ID: ${certificateId}</div>
    
    <div class="section">
      <h2 class="section-title">Client Information</h2>
      <div class="info-grid">
        <div class="info-item">
          <div class="info-label">Client Name</div>
          <div class="info-value">${clientName || 'N/A'}</div>
        </div>
        <div class="info-item">
          <div class="info-label">Phone Number</div>
          <div class="info-value">${session.phone || 'N/A'}</div>
        </div>
        <div class="info-item">
          <div class="info-label">Client IP Address</div>
          <div class="info-value">${session.client_ip_address || 'Not Recorded'}</div>
        </div>
        <div class="info-item">
          <div class="info-label">Verification Method</div>
          <div class="info-value">${session.verification_method?.toUpperCase() || 'N/A'}</div>
        </div>
      </div>
    </div>
    
    <div class="section">
      <h2 class="section-title">Verification Details</h2>
      <div class="info-grid">
        <div class="info-item">
          <div class="info-label">Status</div>
          <div class="info-value"><span class="status-badge">✓ Completed</span></div>
        </div>
        <div class="info-item">
          <div class="info-label">Verification Date</div>
          <div class="info-value">${verificationDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
        </div>
        <div class="info-item">
          <div class="info-label">Completion Time</div>
          <div class="info-value">${completedDate.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })}</div>
        </div>
        ${session.call_duration ? `
        <div class="info-item">
          <div class="info-label">Call Duration</div>
          <div class="info-value">${Math.round(session.call_duration / 60)} minutes</div>
        </div>
        ` : ''}
      </div>
      
      ${session.verification_result ? `
      <div class="verification-result">
        <strong>Verification Result:</strong><br>
        ${session.verification_result}
      </div>
      ` : ''}
    </div>
    
    <div class="footer">
      <p><strong>This certificate confirms that the insurance policy verification was completed successfully</strong></p>
      <p>according to enterprise security standards and compliance requirements.</p>
      <p class="timestamp">Document authenticated and timestamped by AO Precheck System<br>Generated on: ${new Date().toLocaleString('en-US', { dateStyle: 'full', timeStyle: 'long' })}</p>
    </div>
  </div>
</body>
</html>
      `.trim();

      const filename = `AO-Precheck-Certificate-${clientName.replace(/\s+/g, '-') || sessionId}-${new Date().toISOString().split('T')[0]}.html`;
      
      res.setHeader('Content-Disposition', `inline; filename="${filename}"`);
      res.setHeader('Content-Type', 'text/html');
      
      res.send(certificateHTML);
    } catch (error) {
      console.error('Certificate download error:', error);
      res.status(500).json({ error: 'Download failed' });
    }
