  // Force reset password endpoint for problematic users
  app.post('/api/admin/force-reset-password', async (req, res) => {
    try {
      const { email, password } = req.body;
      
      if (!email || !password || password.length < 8) {
        return res.status(400).json({ message: 'Invalid email or password (minimum 8 characters)' });
      }
      
      console.log(`🔐 Force resetting password for: ${email}`);
      
      // Try to get all users with pagination to find the user
      let allUsers = [];
      let page = 1;
      const perPage = 1000;
      
      while (true) {
        const { data: userData, error: userError } = await supabaseAdmin.auth.admin.listUsers({
          page: page,
          perPage: perPage
        });
        
        if (userError) {
          console.error('❌ Failed to list users:', userError);
          break;
        }
        
        allUsers = allUsers.concat(userData.users);
        
        if (userData.users.length < perPage) {
          break; // Last page
        }
        page++;
      }
      
      console.log(`🔍 Searched through ${allUsers.length} total users`);
      
      let targetUser = allUsers.find(user => user.email === email);
      
      if (!targetUser) {
        // User doesn't exist, try to create them first
        console.log(`🔧 User not found, attempting to create: ${email}`);
        
        try {
          const { data: createData, error: createError } = await supabaseAdmin.auth.admin.createUser({
            email: email,
            password: password,
            email_confirm: true
          });
          
          if (createError) {
            // If creation fails because user exists, try to find them again
            if (createError.code === 'email_exists') {
              console.log('🔄 User exists but hidden, trying direct password update...');
              
              // Try to find the user ID in a different way
              const { data: signInData, error: signInError } = await supabaseAdmin.auth.signInWithPassword({
                email: email,
                password: 'temporary_wrong_password'
              });
              
              // Even if sign in fails, we might get useful info
              console.log('📧 SignIn attempt result:', signInError);
              
              return res.status(400).json({ 
                message: 'User exists but is in an inconsistent state. Please contact system administrator.' 
              });
            }
            
            throw createError;
          }
          
          console.log(`✅ User created and password set: ${email}`);
          return res.json({ 
            success: true, 
            message: 'User created and password set successfully',
            action: 'created'
          });
          
        } catch (createErr) {
          console.error('❌ Failed to create user:', createErr);
          return res.status(400).json({ message: `Failed to create user: ${createErr.message}` });
        }
      }
      
      // User exists, reset password
      const { data: resetData, error: resetError } = await supabaseAdmin.auth.admin.updateUserById(
        targetUser.id,
        { password: password }
      );
      
      if (resetError) {
        console.error(`❌ Failed to reset password for ${email}:`, resetError);
        return res.status(400).json({ message: `Failed to reset password: ${resetError.message}` });
      }
      
      console.log(`✅ Password reset successful for: ${email}`);
      res.json({ 
        success: true, 
        message: 'Password reset successfully',
        action: 'reset'
      });
      
    } catch (error) {
      console.error('❌ Error in force password reset:', error);
      res.status(500).json({ message: 'Failed to reset password' });
    }
  });

