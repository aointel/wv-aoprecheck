  app.get("/api/feedback/reports", async (req, res) => {
    try {
      const { status, reportType, limit = 50 } = req.query;
      
      let query = db.select().from(schema.feedbackReports);
      
      // Add filters if provided
      const conditions = [];
      if (status) conditions.push(eq(schema.feedbackReports.status, status as string));
      if (reportType) conditions.push(eq(schema.feedbackReports.reportType, reportType as string));
      
      if (conditions.length > 0) {
        query = query.where(and(...conditions));
      }
      
      const reports = await query
        .orderBy(desc(schema.feedbackReports.createdAt))
        .limit(Number(limit));

      res.json({
        success: true,
        reports,
        count: reports.length
      });
    } catch (error) {
      console.error('❌ Get feedback reports error:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to fetch feedback reports',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

  app.patch("/api/feedback/reports/:id/status", async (req, res) => {
    try {
      const { id } = req.params;
      const { status, adminNotes, assignedTo } = req.body;

      const updateData: any = { status, updatedAt: new Date() };
      if (adminNotes) updateData.adminNotes = adminNotes;
      if (assignedTo) updateData.assignedTo = assignedTo;
      if (status === 'resolved') updateData.resolvedAt = new Date();

      await db.update(schema.feedbackReports)
        .set(updateData)
        .where(eq(schema.feedbackReports.id, Number(id)));

      res.json({
        success: true,
        message: "Report status updated successfully"
      });
    } catch (error) {
      console.error('❌ Update feedback status error:', error);
      res.status(500).json({
        success: false,
