  // Conference cleanup endpoint - forcefully disconnect all participants
  app.post("/api/twilio/cleanup-conference", async (req, res) => {
    try {
      const { conferenceSid, conferenceName } = req.body;

      let targetConference = conferenceSid;

      // If conference name provided instead of SID, find the active conference
      if (!targetConference && conferenceName) {
        try {
          const conferences = await twilioClient.conferences.list({
            friendlyName: conferenceName,
            status: 'in-progress'
          });
          
          if (conferences.length > 0) {
            targetConference = conferences[0].sid;
            console.log(`Found active conference: ${conferenceName} (${targetConference})`);
          } else {
            return res.json({
              success: false,
              message: `No active conference found with name: ${conferenceName}`,
              participantsDisconnected: 0
            });
          }
        } catch (error) {
          console.error('Error finding conference by name:', error);
          return res.status(500).json({
            success: false,
            message: 'Failed to find conference',
            error: error instanceof Error ? error.message : String(error)
          });
        }
      }

      // Default to AO-Verification-Live if no conference specified
      if (!targetConference) {
        const conferences = await twilioClient.conferences.list({
          friendlyName: 'AO-Verification-Live',
          status: 'in-progress'
        });
        
        if (conferences.length > 0) {
          targetConference = conferences[0].sid;
          console.log(`Using default conference: AO-Verification-Live (${targetConference})`);
        }
      }

      if (!targetConference) {
        return res.json({
          success: false,
          message: 'No active conference found to clean up',
          participantsDisconnected: 0
        });
      }

      console.log(`🧹 Cleaning up conference: ${targetConference}`);

      // Get all participants in the conference
      const participants = await twilioClient.conferences(targetConference).participants.list();

      console.log(`Found ${participants.length} participants to disconnect`);

      // Disconnect all participants by updating their call status to completed
      const disconnectPromises = participants.map(async (participant) => {
        try {
          await twilioClient.calls(participant.callSid).update({ status: 'completed' });
          console.log(`Disconnected participant: ${participant.callSid}`);
          return { callSid: participant.callSid, success: true };
        } catch (error) {
          console.error(`Failed to disconnect ${participant.callSid}:`, error);
          return { callSid: participant.callSid, success: false, error };
        }
      });

      const results = await Promise.all(disconnectPromises);
      const successCount = results.filter(r => r.success).length;
      const failedCount = results.filter(r => !r.success).length;

      console.log(`✅ Conference cleanup complete: ${successCount} disconnected, ${failedCount} failed`);

      res.json({
        success: true,
        message: `Conference cleanup completed`,
        conferenceSid: targetConference,
        participantsDisconnected: successCount,
        participantsFailed: failedCount,
        results: results
      });

    } catch (error) {
      console.error('❌ Error cleaning up conference:', error);
      res.status(500).json({
        success: false,
        message: 'Failed to clean up conference',
        error: error instanceof Error ? error.message : String(error)
      });
    }
  });

  // Track active calls globally
