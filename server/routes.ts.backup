  // Call Connector Pro WebRTC Agent Connection
  app.post("/api/call-connector-pro/agent-connect", async (req, res) => {
    try {
      const { agentEmail } = req.body;
      console.log(`🎯 Call Connector Pro - Agent ${agentEmail} requesting WebRTC connection`);
      
      if (!agentEmail) {
        return res.status(400).json({ error: 'Agent email is required' });
      }

      // Validate all required Twilio credentials to prevent Socket 4500 errors
      const accountSid = process.env.TWILIO_ACCOUNT_SID;
      const apiKey = process.env.TWILIO_API_KEY;
      const apiSecret = process.env.TWILIO_API_SECRET;
      const appSid = process.env.TWILIO_TWIML_APP_SID;

      console.log('🔍 Validating Twilio credentials for Call Connector Pro...');
      console.log(`Account SID: ${accountSid ? accountSid.substring(0, 10) + '...' : 'MISSING'}`);
      console.log(`API Key: ${apiKey ? apiKey.substring(0, 10) + '...' : 'MISSING'}`);
      console.log(`API Secret: ${apiSecret ? 'SET' : 'MISSING'}`);
      console.log(`TwiML App SID: ${appSid ? appSid.substring(0, 10) + '...' : 'MISSING'}`);

      if (!accountSid || !apiKey || !apiSecret || !appSid) {
        throw new Error('Missing required Twilio credentials for WebRTC: TWILIO_ACCOUNT_SID, TWILIO_API_KEY, TWILIO_API_SECRET, TWILIO_TWIML_APP_SID');
      }

      // Generate agent identity for WebRTC
      const identity = `callconnector-agent-${agentEmail.split('@')[0]}-${Date.now()}`;

      // Generate Twilio access token with proper error handling
      const AccessToken = twilio.jwt.AccessToken;
      const VoiceGrant = AccessToken.VoiceGrant;

      // Use our NEW TwiML app that points to the correct endpoint
      const newTwimlAppSid = 'APdd0ebe5931ea260875a434094f20f827'; // Our new ConnectNow-WebRTC-App
      console.log(`🔥 Using NEW TwiML App: ${newTwimlAppSid} (points to /api/twilio/webrtc)`);
      
      const voiceGrant = new VoiceGrant({
        outgoingApplicationSid: newTwimlAppSid,
        incomingAllow: true,
      });

      const accessToken = new AccessToken(accountSid, apiKey, apiSecret, {
        identity: identity,
        ttl: 3600 // 1 hour expiration
      });

      accessToken.addGrant(voiceGrant);
      const token = accessToken.toJwt();

      console.log(`✅ Generated WebRTC token for Call Connector Pro agent: ${identity}`);
      console.log(`🔑 Token length: ${token.length}, expires in 1 hour`);

      res.json({
        success: true,
        token: token,
        identity: identity,
        message: 'WebRTC token generated - will use dynamic conference names'
      });

    } catch (error) {
      console.error('❌ Call Connector Pro WebRTC connection error:', error);
      res.status(500).json({ 
        error: 'Failed to generate WebRTC token',
        details: error instanceof Error ? error.message : String(error),
        requiredCredentials: [
          'TWILIO_ACCOUNT_SID',
          'TWILIO_API_KEY', 
          'TWILIO_API_SECRET',
          'TWILIO_TWIML_APP_SID'
        ]
      });
    }
  });

