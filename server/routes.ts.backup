    try {
      const twimlAppSid = TWILIO_TWIML_APP_SID;
      if (!twimlAppSid) {
        return res.status(500).json({ error: 'TWILIO_TWIML_APP_SID not configured' });
      }

      const currentDomain = req.get('host');
      const expectedVoiceUrl = `https://${currentDomain}/api/twilio/agent-webrtc-twiml`;
      
      try {
        const application = await twilioClient.applications(twimlAppSid).fetch();
        
        res.json({
          appSid: twimlAppSid,
          currentDomain: currentDomain,
          expectedVoiceUrl: expectedVoiceUrl,
          configuredVoiceUrl: application.voiceUrl,
          configuredStatusCallback: application.statusCallback,
          isCorrect: application.voiceUrl === expectedVoiceUrl,
          friendlyName: application.friendlyName
        });
      } catch (error) {
        res.status(500).json({ 
          error: 'Failed to fetch TWIML App details',
          details: error instanceof Error ? error.message : String(error),
          appSid: twimlAppSid,
          currentDomain: currentDomain,
          expectedVoiceUrl: expectedVoiceUrl
        });
      }
    } catch (error) {
      console.error('TWIML App check error:', error);
      res.status(500).json({ error: 'Failed to check TWIML App configuration' });
    }
  });

  // Update TWIML App configuration
  app.post("/api/twilio/update-twiml-app", async (req, res) => {
    try {
      const twimlAppSid = TWILIO_TWIML_APP_SID;
      if (!twimlAppSid) {
        return res.status(500).json({ error: 'TWILIO_TWIML_APP_SID not configured' });
      }

      // Use the external domain, not localhost
      const currentDomain = req.get('host')?.includes('localhost') ? 'aoirail-production.up.railway.app' : req.get('host');
      const voiceUrl = `https://${currentDomain}/webhook/webrtc`;
      
      console.log(`🔧 Updating TwiML App ${twimlAppSid} with voiceUrl: ${voiceUrl}`);
      
      const application = await twilioClient.applications(twimlAppSid).update({
        voiceUrl: voiceUrl,
        voiceMethod: 'POST',
        statusCallback: `https://${currentDomain}/api/twilio/call-status`,
        statusCallbackMethod: 'POST'
      });
      
      console.log(`✅ TwiML App updated successfully. Current voiceUrl: ${application.voiceUrl}`);

      res.json({
        success: true,
        appSid: twimlAppSid,
        updatedVoiceUrl: application.voiceUrl,
        updatedStatusCallback: application.statusCallback,
        message: 'TWIML App updated successfully'
      });
    } catch (error) {
      console.error('TWIML App update error:', error);
      res.status(500).json({ 
