          <div style="background: #f5f5f5; padding: 15px; border-radius: 5px; margin: 10px 0;">
            <strong>Message:</strong><br>
            ${message.replace(/\n/g, '<br>')}
          </div>
          <p><strong>User Agent:</strong> ${userAgent || 'Unknown'}</p>
          <p><strong>Timestamp:</strong> ${timestamp}</p>
          <p><strong>User ID:</strong> ${userId}</p>
        `;

        const emailSent = await sendEmail({
          to: 'aointel@aoglobelife.com',
          subject: `🆘 Support Request: ${subject} [${urgency.toUpperCase()}]`,
          html: emailHtml
        });

        if (emailSent) {
          console.log('✅ Support notification email sent successfully');
        } else {
          console.log('⚠️ Support notification email failed to send, but request was saved');
        }
      } catch (emailError) {
        console.error('❌ Email notification error:', emailError);
        // Don't fail the request if email fails
      }

      res.json({
        success: true,
        message: 'Support request saved successfully',
        requestId: data.id
      });

    } catch (error) {
      console.error('❌ Help form submission error:', error);
      res.status(500).json({ 
        error: 'Failed to process support request',
