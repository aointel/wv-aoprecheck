  // Capture screenshot
  app.post("/api/presentations/screenshot", async (req, res) => {
    const screenshotRequestId = Math.random().toString(36).substr(2, 9);
    try {
      const { session_id, screenshot_data } = req.body;
      const screenshotSize = screenshot_data?.length || 0;
      
      console.log(`\n📸 [${screenshotRequestId}] ===== SCREENSHOT UPLOAD REQUEST =====`);
      console.log(`   Session ID: ${session_id}`);
      console.log(`   Screenshot size: ${screenshotSize} bytes (${(screenshotSize / 1024).toFixed(2)} KB)`);
      console.log(`   Timestamp: ${new Date().toISOString()}`);
      
      if (!session_id) {
        console.error(`❌ [${screenshotRequestId}] REJECTED: No session_id provided`);
        return res.status(400).json({ error: 'session_id required' });
      }
      
      if (!screenshot_data) {
        console.error(`❌ [${screenshotRequestId}] REJECTED: No screenshot_data provided`);
        return res.status(400).json({ error: 'screenshot_data required' });
      }
      
      console.log(`📂 [${screenshotRequestId}] STEP 1: Saving screenshot to database...`);
      const { presentationTracker } = await import('./presentation-tracker');
      const screenshotId = await presentationTracker.captureScreenshot(session_id, screenshot_data);
      console.log(`✅ [${screenshotRequestId}] STEP 1 COMPLETE: Screenshot saved, ID: ${screenshotId}`);
      
      // Update live tracker with screenshot (increments count, auto-confirms after 3 screenshots)
      console.log(`📂 [${screenshotRequestId}] STEP 2: Updating live tracker...`);
      const { presentationLiveTracker } = await import('./presentation-live-tracker');
      const updateResult = presentationLiveTracker.updateScreenshot(session_id, screenshotId);
      
      if (updateResult) {
        console.log(`✅ [${screenshotRequestId}] STEP 2 COMPLETE: Live tracker updated (screenshot count: ${updateResult.screenshotCount})`);
      } else {
        console.error(`⚠️ [${screenshotRequestId}] STEP 2 WARNING: Live tracker returned null (session not found in memory)`);
        console.error(`   This means the session ${session_id} was not registered with the live tracker!`);
      }
      
      // Analyze screenshot with AI for HPPRO presentations IN REALTIME
      console.log(`📂 [${screenshotRequestId}] STEP 3: Starting REALTIME AI analysis...`);
      const { hpproAnalyzer } = await import('./hppro-analyzer');
      
      // Start analysis asynchronously but with detailed error logging
      hpproAnalyzer.processScreenshot(session_id, screenshotId, screenshot_data)
        .then(analysis => {
          console.log(`✅ [${screenshotRequestId}] REALTIME AI ANALYSIS COMPLETE:`);
          console.log(`   Milestone: ${analysis.milestone} - ${analysis.milestoneName}`);
          console.log(`   Confidence: ${(analysis.confidence * 100).toFixed(1)}%`);
          if (analysis.leadData) {
            console.log(`   Lead Data: ${analysis.leadData.firstName || 'N/A'} ${analysis.leadData.lastName || 'N/A'}`);
          }
        })
        .catch(err => {
          console.error(`\n❌❌❌ [${screenshotRequestId}] REALTIME AI ANALYSIS FAILED:`);
          console.error(`   Error Type: ${err.name}`);
          console.error(`   Error Message: ${err.message}`);
          console.error(`   Error Stack: ${err.stack}`);
          console.error(`   Screenshot ID: ${screenshotId}`);
          console.error(`   Session ID: ${session_id}`);
          console.error(`   Screenshot data length: ${screenshot_data?.length || 0} bytes\n`);
        });
      
      console.log(`✅ [${screenshotRequestId}] ===== SCREENSHOT UPLOAD COMPLETE (AI analysis running in background) =====\n`);
      res.json({ success: true, screenshotId });
    } catch (error: any) {
      console.error(`❌❌❌ [${screenshotRequestId}] FATAL ERROR in screenshot upload:`);
      console.error(`   Error message: ${error.message}`);
      console.error(`   Error stack: ${error.stack}`);
      res.status(500).json({ error: error.message });
    }
  });
  
