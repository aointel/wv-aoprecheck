  // Appointment Conflict Checking - inline implementation
  app.post('/api/appointments/check-conflicts', async (req, res) => {
    try {
      const { agentEmail, startTime, endTime, excludeAppointmentId } = req.body;

      if (!agentEmail || !startTime || !endTime) {
        return res.status(400).json({ 
          error: 'Missing required fields: agentEmail, startTime, endTime' 
        });
      }

      // Build the where conditions using Drizzle
      const { appointments } = await import('@shared/schema');
      const { and, gte, lte, eq, ne } = await import('drizzle-orm');

      let whereConditions = [
        eq(appointments.agentEmail, agentEmail),
        // Check for time overlaps
        and(
          lte(appointments.startTime, new Date(endTime)),
          gte(appointments.endTime, new Date(startTime))
        ),
        // Only check non-cancelled appointments
        ne(appointments.status, 'cancelled')
      ];

      if (excludeAppointmentId) {
        whereConditions.push(ne(appointments.id, excludeAppointmentId));
      }

      const conflictingAppointments = await db
        .select()
        .from(appointments)
        .where(and(...whereConditions))
        .limit(10);

      const hasConflicts = conflictingAppointments.length > 0;

      res.json({
        hasConflicts,
        conflicts: conflictingAppointments.map(apt => ({
          id: apt.id,
          title: apt.title,
          startTime: apt.startTime,
          endTime: apt.endTime,
          leadName: apt.leadName,
          appointmentType: apt.appointmentType,
          status: apt.status
        }))
      });

    } catch (error) {
      console.error('Error checking appointment conflicts:', error);
      res.status(500).json({ 
        error: 'Failed to check appointment conflicts',
        details: error instanceof Error ? error.message : 'Unknown error'
      });
    }
  });

  // Twilio webhook for automatic VDP call detection
  app.post('/api/twilio/vdp-webhook', async (req, res) => {
    try {
      console.log('📞 VDP Webhook received:', req.body);
      
      const { CallSid, From, To, Direction, CallStatus, CallDuration } = req.body;
      
      // Only process inbound calls that are answered
      if (Direction === 'inbound' && CallStatus === 'completed') {
        // Extract lead information from caller ID or call parameters
        const leadData = {
          firstName: req.body.CallerName?.split(' ')[0] || 'Unknown',
          lastName: req.body.CallerName?.split(' ')[1] || 'Client',
          phone: From,
          city: req.body.CallerCity || '',
          state: req.body.CallerState || '',
          zip: req.body.CallerZip || '',
          email: req.body.CallerEmail || ''
        };

        // Get agent email from To number (you may need to map this)
        const agentEmail = getAgentEmailFromNumber(To);
        
        if (agentEmail) {
          // Automatically create VDP lead
          const vdpPayload = {
            agentEmail,
            callId: CallSid,
            leadData,
            callStartTime: new Date().toISOString(),
            callType: 'inbound_vdp'
          };

          // Call the VDP acceptance endpoint internally
          const vdpResponse = await fetch(`${req.protocol}://${req.get('host')}/api/vdp/call-accept`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(vdpPayload)
          });

          if (vdpResponse.ok) {
            console.log('✅ VDP lead automatically created for call:', CallSid);
          }
        }
      }

      // Return TwiML response
      res.type('text/xml');
      res.send(`<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say>Thank you for your call. You are being connected to an agent.</Say>
</Response>`);

    } catch (error) {
      console.error('❌ Error in VDP webhook:', error);
      res.status(500).send('Webhook error');
    }
  });

