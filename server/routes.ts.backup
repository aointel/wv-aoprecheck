  // Check for active inbound calls for agent
  app.get("/api/inbound-calls/active/:agentEmail", async (req, res) => {
    try {
      const { agentEmail } = req.params;
      console.log(`🔔 Checking active inbound calls for agent: ${agentEmail}`);

      // Query SUPABASE for active inbound calls (not local Neon database)
      const todayStart = new Date();
      todayStart.setHours(0, 0, 0, 0);
      
      console.log(`🔍 FILTERING: Only showing calls from TODAY (${todayStart.toISOString()}) onwards for ${agentEmail}`);
      
      const { data: result, error } = await supabaseAdmin
        .from('incoming_calls')
        .select('*')
        .in('status', ['ringing', 'connected', 'answered'])
        .eq('assigned_agent_email', agentEmail)
        .gte('created_at', todayStart.toISOString())
        .order('created_at', { ascending: false })
        .limit(1);

      if (error) {
        console.error('❌ Supabase error getting incoming calls:', error);
        res.json({ inboundCall: null });
        return;
      }

      if (result && result.length > 0) {
        const inboundCall = result[0];
        console.log(`🔔 Found active inbound call:`, inboundCall);
        
        res.json({ 
          inboundCall: {
            id: inboundCall.id,
            callSid: inboundCall.twilio_call_sid,
            callerNumber: inboundCall.caller_number,
            leadName: inboundCall.lead_name || 'Unknown Lead',
            leadCity: inboundCall.lead_city,
            leadState: inboundCall.lead_state,
            callStartedAt: inboundCall.created_at,
            callType: inboundCall.call_type || 'VDP',
            notes: inboundCall.notes,
            timestamp: new Date().toISOString()
          }
        });
      } else {
        res.json({ inboundCall: null });
      }

    } catch (error) {
      console.error('❌ Failed to check active inbound calls:', error);
      res.json({ inboundCall: null });
    }
  });

  // Terminate VDP call directly using the same database approach as the active call retrieval
  app.post("/api/inbound-calls/terminate-vdp", async (req, res) => {
    try {
      const { callId, callSid, agentEmail, reason } = req.body;
      console.log(`🚫 TERMINATING VDP CALL: ID=${callId}, SID=${callSid}, Agent=${agentEmail}`);

      if (!callId && !callSid) {
        return res.status(400).json({ error: 'Either callId or callSid is required' });
      }

      const terminationReason = reason || 'Manually terminated - Stale VDP call cleanup';
      
      // Use the same database connection as the active call retrieval
      // Build the where condition based on available parameters
      const whereConditions = [];
      if (callId) {
        whereConditions.push(eq(schema.incomingCalls.id, callId));
      }
      if (callSid) {
        whereConditions.push(eq(schema.incomingCalls.twilioCallSid, callSid));
      }
      if (agentEmail) {
        whereConditions.push(eq(schema.incomingCalls.assignedAgentEmail, agentEmail));
      }

      // First get the current call to preserve existing notes
      const currentCall = await db
        .select()
        .from(schema.incomingCalls)
        .where(and(...whereConditions))
        .limit(1);

      if (currentCall.length === 0) {
        console.log(`❌ No VDP call found with ID=${callId}, SID=${callSid} for ${agentEmail}`);
        return res.status(404).json({ error: 'VDP call not found' });
      }

      const existingNotes = currentCall[0].notes || '';
      const updatedNotes = existingNotes + ` | Disposition: ${terminationReason}`;
      
      // Update the call to ended status with disposition
      const updateResult = await db
        .update(schema.incomingCalls)
        .set({
          status: 'ended',
          endedAt: new Date(),
          notes: updatedNotes
        })
        .where(and(...whereConditions));

      console.log(`✅ VDP CALL TERMINATED: Updated ${updateResult.rowCount || 0} records`);
      console.log(`📝 Added disposition: ${terminationReason}`);
      
      res.json({ 
        success: true, 
        message: 'VDP call terminated successfully',
        callId: callId || callSid,
        terminationReason,
        recordsUpdated: updateResult.rowCount || 0
      });

    } catch (error) {
      console.error('❌ ERROR TERMINATING VDP CALL:', error);
      res.status(500).json({ 
        error: 'Failed to terminate VDP call',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

  // Answer inbound call
  app.post("/api/inbound-calls/answer", async (req, res) => {
    try {
      const { callSid, agentEmail } = req.body;
      console.log(`📞 Agent ${agentEmail} answering call ${callSid}`);

      // Update call status to answered
      await db
        .update(schema.incomingCalls)
        .set({
          status: 'answered',
          assignedAgentEmail: agentEmail,
          answeredAt: new Date()
        })
        .where(eq(schema.incomingCalls.twilioCallSid, callSid));

      // Use Twilio to connect the agent to the call
      // This would require additional Twilio call modification
      console.log(`✅ Call ${callSid} marked as answered by ${agentEmail}`);
      
      res.json({ success: true, message: 'Call answered successfully' });

    } catch (error) {
      console.error('❌ Failed to answer inbound call:', error);
      res.status(500).json({ error: 'Failed to answer call' });
    }
  });

