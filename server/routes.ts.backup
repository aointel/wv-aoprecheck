  // ===== QUALITY MANAGER SYSTEM =====
  
  // Middleware to load user context and roles
  async function loadUserContext(req: any) {
    const userEmail = req.query.userEmail || req.body.userEmail || req.headers['user-email'];
    
    if (!userEmail) {
      return { email: null, roles: [], isAdmin: false, assignedTeams: [] };
    }

    try {
      // Check if user is admin
      const isAdmin = userEmail === 'admin@aoprecheck.net'; // Adjust as needed
      
      // Check if user is Quality Manager
      const qmQuery = `
        SELECT * FROM quality_manager_roles 
        WHERE email = '${userEmail}' AND is_active = true
      `;
      const qmResult = await db.execute(sql.raw(qmQuery));
      const isQualityManager = qmResult.rows.length > 0;
      
      let assignedTeams: string[] = [];
      if (isQualityManager) {
        // Get assigned MGA teams for Quality Manager
        const teamsQuery = `
          SELECT mt.name FROM quality_manager_assignments qma
          JOIN mga_teams mt ON qma.mga_team_id = mt.id
          WHERE qma.qm_email = '${userEmail}' AND mt.is_active = true
        `;
        const teamsResult = await db.execute(sql.raw(teamsQuery));
        assignedTeams = teamsResult.rows.map((row: any) => row.name);
      }

      const roles = [];
      if (isAdmin) roles.push('ADMIN');
      if (isQualityManager) roles.push('QUALITY_MANAGER');
      
      return {
        email: userEmail,
        roles,
        isAdmin,
        isQualityManager,
        assignedTeams
      };
    } catch (error) {
      console.error('Error loading user context:', error);
      return { email: userEmail, roles: [], isAdmin: false, assignedTeams: [] };
    }
  }

  // Helper function to apply team-based data scoping
  function applyTeamScope(baseQuery: string, userContext: any, teamColumn: string) {
    if (userContext.isAdmin) {
      return baseQuery; // Admins see everything
    }
    
    if (userContext.isQualityManager && userContext.assignedTeams.length > 0) {
      const teamFilter = userContext.assignedTeams.map((team: string) => `'${team}'`).join(',');
      return `${baseQuery} AND ${teamColumn} IN (${teamFilter})`;
    }
    
    return `${baseQuery} AND 1=0`; // No access if no teams assigned
  }

  // ===== ADMIN APIS FOR QUALITY MANAGER MANAGEMENT =====
  
  // Get all quality managers with their assigned teams
  app.get('/api/admin/quality-managers', async (req, res) => {
    try {
      const userContext = await loadUserContext(req);
      
      if (!userContext.isAdmin) {
        return res.status(403).json({ error: 'Admin access required' });
      }

      const query = `
        SELECT 
          qmr.email,
          qmr.is_active,
          qmr.assigned_by,
          qmr.created_at,
          COALESCE(
            JSON_AGG(
              CASE WHEN mt.id IS NOT NULL 
              THEN JSON_BUILD_OBJECT('id', mt.id, 'name', mt.name) 
              END
            ) FILTER (WHERE mt.id IS NOT NULL), 
            '[]'::json
          ) as assigned_teams
        FROM quality_manager_roles qmr
        LEFT JOIN quality_manager_assignments qma ON qmr.email = qma.qm_email
        LEFT JOIN mga_teams mt ON qma.mga_team_id = mt.id AND mt.is_active = true
        WHERE qmr.is_active = true
        GROUP BY qmr.email, qmr.is_active, qmr.assigned_by, qmr.created_at
        ORDER BY qmr.created_at DESC
      `;
      
      const result = await db.execute(sql.raw(query));
      res.json({ success: true, qualityManagers: result.rows });
      
    } catch (error) {
      console.error('Error fetching quality managers:', error);
      res.status(500).json({ error: 'Failed to fetch quality managers' });
    }
  });

  // Grant Quality Manager role to a user
  app.post('/api/admin/quality-managers/:email', async (req, res) => {
    try {
      const userContext = await loadUserContext(req);
      
      if (!userContext.isAdmin) {
        return res.status(403).json({ error: 'Admin access required' });
      }

      const { email } = req.params;
      const assignedBy = userContext.email;

      const insertQuery = `
        INSERT INTO quality_manager_roles (email, is_active, assigned_by)
        VALUES ('${email}', true, '${assignedBy}')
        ON CONFLICT (email) DO UPDATE SET
          is_active = true,
          assigned_by = '${assignedBy}',
          updated_at = NOW()
      `;
      
      await db.execute(sql.raw(insertQuery));
      res.json({ success: true, message: 'Quality Manager role granted successfully' });
      
    } catch (error) {
      console.error('Error granting Quality Manager role:', error);
      res.status(500).json({ error: 'Failed to grant Quality Manager role' });
    }
  });

