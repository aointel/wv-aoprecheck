  // Zoom verification screenshot upload with AI validation
  app.post("/api/zoom-verification/upload-screenshot", upload.single('screenshot'), async (req, res) => {
    try {
      const { sessionId } = req.body;
      
      console.log('🎥 ZOOM SCREENSHOT UPLOAD:', {
        sessionId,
        hasFile: !!req.file,
        contentType: req.headers['content-type']
      });

      if (!req.file) {
        return res.status(400).json({ message: "No screenshot file provided" });
      }

      if (!sessionId) {
        return res.status(400).json({ message: "Session ID is required" });
      }

      // Get session data
      const session = await storage.getVerificationSession(sessionId);
      if (!session) {
        return res.status(404).json({ message: "Verification session not found" });
      }

      // Read file buffer for upload and AI validation
      const fileBuffer = fsSync.readFileSync(req.file.path);
      
      // AI VALIDATION: Validate screenshot content (FLAG ONLY, don't reject)
      let validationResult = null;
      try {
        console.log('🤖 Starting AI validation of Zoom screenshot...');
        const base64Screenshot = fileBuffer.toString('base64');
        const { verificationScreenshotValidator } = await import('./verification-screenshot-validator');
        
        validationResult = await verificationScreenshotValidator.validateScreenshot(
          base64Screenshot,
          'zoom'
        );
        
        console.log(`🤖 AI Validation Result: ${validationResult.isValid ? '✅ VALID' : '⚠️ FLAGGED'}`);
        console.log(`   Confidence: ${validationResult.confidence}`);
        console.log(`   Reason: ${validationResult.reason}`);
        
        // Just flag it - don't reject!
        if (!validationResult.isValid) {
          console.log(`🚩 Zoom screenshot FLAGGED for admin review (${(validationResult.confidence * 100).toFixed(0)}% confidence)`);
        }
        
      } catch (validationError: any) {
        console.error('⚠️ AI validation error (proceeding with upload):', validationError.message);
        // Continue with upload even if validation fails due to technical error
      }

      // Upload to Supabase Storage
      let screenshotUrl = null;
      try {
        const fileName = `ZOOM-${sessionId}-${Date.now()}.png`;
        
        const { data, error } = await supabaseAdmin.storage
          .from(S3_BUCKET)
          .upload(fileName, fileBuffer, {
            contentType: 'image/png',
            cacheControl: '3600',
            upsert: false
          });

        if (error) {
          console.error('❌ Supabase upload error:', error);
          throw error;
        }

        // Generate 2-year signed URL
        const { data: signedUrlData, error: signUrlError } = await supabaseAdmin.storage
          .from(S3_BUCKET)
          .createSignedUrl(fileName, 63072000); // 2 years

        if (signUrlError) {
          console.error('❌ Signed URL error:', signUrlError);
          throw signUrlError;
        }

        screenshotUrl = signedUrlData.signedUrl;
        console.log('✅ Zoom screenshot uploaded with 2-year signed URL');
        
        // Clean up local file
        try {
          fsSync.unlinkSync(req.file.path);
        } catch (cleanupError) {
          console.warn('Could not delete local file:', cleanupError);
        }
      } catch (uploadError: any) {
        console.error('❌ Upload failed:', uploadError);
        throw uploadError;
      }

      // Store the signed URL and validation results in database
      const updateData: any = {
        screenshotPath: screenshotUrl,
      };
      
      // Add validation data to session if available
      if (validationResult) {
        updateData.screenshot_validation = {
          isValid: validationResult.isValid,
          confidence: validationResult.confidence,
          validationType: validationResult.validationType,
          reason: validationResult.reason,
          detectedElements: validationResult.detectedElements,
          issues: validationResult.issues,
          validatedAt: new Date().toISOString()
        };
      }
      
      const updatedSession = await storage.updateVerificationSession(sessionId, updateData);

      if (!updatedSession) {
        return res.status(404).json({ message: "Verification session not found" });
      }

      res.json({ 
        message: "Zoom screenshot uploaded successfully", 
        session: updatedSession,
        screenshotUrl: screenshotUrl,
        validation: validationResult ? {
          isValid: validationResult.isValid,
          confidence: validationResult.confidence,
          reason: validationResult.reason
        } : null
      });
    } catch (error) {
      console.error('Zoom screenshot upload error:', error);
      res.status(500).json({ message: "Failed to upload Zoom screenshot" });
    }
  });

  // TwiML endpoint for verification calls
  app.get('/api/verification/twiml/:sessionId', async (req, res) => {
    const { sessionId } = req.params;
    
    const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
    <Say voice="alice">Hello! This is AO Intelligence calling for policy verification. Please hold while we connect you to your client.</Say>
    <Pause length="2"/>
    <Say voice="alice">Thank you for participating in the verification process.</Say>
    <Hangup/>
</Response>`;

    res.type('text/xml');
    res.send(twiml);
  });

  // Call status callback for verification calls  
  app.post('/api/verification/call-status/:sessionId', async (req, res) => {
    const { sessionId } = req.params;
    const { CallStatus, CallSid } = req.body;
    
    console.log(`📞 Verification call ${CallSid} status: ${CallStatus} for session ${sessionId}`);
    
    try {
      await storage.updateVerificationSession(sessionId, {
        taalkCallStatus: CallStatus,
        ...(CallStatus === 'completed' && { 
          callCompleted: true,
          taalkCallCompletedAt: new Date().toISOString()
        })
      });
    } catch (error) {
      console.error('Error updating verification call status:', error);
    }
    
    res.json({ success: true });
  });

  // Initiate Twilio conference call to verification number
  app.post("/api/verification/session/:sessionId/initiate-call", async (req, res) => {
    try {
      const { sessionId } = req.params;

      const session = await storage.getVerificationSession(sessionId);
      if (!session) {
        return res.status(404).json({ message: "Verification session not found" });
      }

      // Prepare call data
      const callData = {
        sessionId: session.sessionId,
        clientName: `${session.firstName} ${session.lastName}`,
        clientPhone: session.phone,
        spouseName: session.spouseName,
        city: session.city,
        state: session.state,
        premium: session.premium,
        verificationMethod: session.verificationMethod || 'phone'
      };

      console.log('Initiating verification call for session:', sessionId);

      // Initiate call using Twilio service
      const callResult = await twilioCallService.initiateVerificationCall(callData);

      if (callResult.success) {
        // Update session with call information
        await storage.updateVerificationSession(sessionId, {
          callCompleted: false, // Call initiated but not completed yet
        });

        // Send call initiation webhook to Zapier
        const replitDomain = process.env.REPLIT_DEV_DOMAIN;
        const host = req.get('host');
        const baseUrl = replitDomain 
          ? `https://${replitDomain}` 
          : host && host.includes('replit.dev') 
            ? `https://${host}` 
            : `https://${host}`;
        const agentVerificationUrl = `${baseUrl}/agent-verify/${session.sessionId}`;
        const clientVerificationUrl = `${baseUrl}/client-verify/${session.sessionId}`;

        const zapierPayload = {
          sessionId: session.sessionId,
          eventType: 'verification_call_initiated',
          callSid: callResult.callSid,
          verificationNumber: '+15032018470',
          clientInfo: {
            firstName: session.firstName,
            lastName: session.lastName,
            spouseName: session.spouseName,
            phone: session.phone,
            city: session.city,
            state: session.state,
            premium: session.premium,
            verificationMethod: session.verificationMethod
          },
          verificationLinks: {
            agentUrl: agentVerificationUrl,
            clientUrl: clientVerificationUrl
          },
          callInstructions: {
            verificationNumber: '+15032018470',
            clientName: callData.clientName,
            clientPhone: callData.clientPhone,
            verificationMethod: session.verificationMethod,
            notes: 'Conference call initiated for client verification process'
          },
          timestamp: new Date().toISOString()
        };

        try {
          await fetch('https://hooks.zapier.com/hooks/catch/2467580/uu5qnr4/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(zapierPayload)
          });
          console.log('Call initiation webhook sent to Zapier successfully');
        } catch (webhookError) {
          console.error('Failed to send call webhook to Zapier:', webhookError);
        }

        res.json({ 
          message: "Verification call initiated successfully",
          callSid: callResult.callSid,
          verificationNumber: '+15032018470'
        });
      } else {
        console.error('Call initiation failed:', callResult.error);
        res.status(500).json({ 
          message: "Failed to initiate verification call",
          error: callResult.error 
        });
      }
    } catch (error: any) {
      console.error('Call initiation error:', error);
      res.status(500).json({ 
        message: "Failed to initiate verification call",
        error: error.message 
      });
    }
  });

  // Mark verification call as completed
  app.post("/api/verification/session/:sessionId/complete-call", async (req, res) => {
    try {
      const { sessionId } = req.params;

      const session = await storage.getVerificationSession(sessionId);
      if (!session) {
        return res.status(404).json({ message: "Verification session not found" });
      }

      // Update session to mark call as completed
      const updatedSession = await storage.updateVerificationSession(sessionId, {
        callCompleted: true,
        verificationResult: 'verified'
      });

      res.json({ 
        message: "Verification call marked as completed",
        session: updatedSession
      });
    } catch (error: any) {
      console.error('Call completion error:', error);
      res.status(500).json({ 
        message: "Failed to mark call as completed",
        error: error.message 
      });
    }
  });

  // TwiML endpoint for call handling
  app.get("/api/twilio/twiml", (req, res) => {
    const { sessionId, clientName, clientPhone } = req.query;

    const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
    <Say voice="alice">Hello, this is AO Precheck verification system. You are now connected to the verification call for ${clientName || 'the client'}. Please proceed with the verification process.</Say>
    <Pause length="2"/>
    <Say voice="alice">The client phone number is ${clientPhone || 'not available'}. Session ID is ${sessionId || 'not available'}.</Say>
    <Pause length="1"/>
    <Say voice="alice">Please conduct your verification and hang up when complete. Thank you.</Say>
</Response>`;

    res.set('Content-Type', 'text/xml');
    res.send(twiml);
  });

  // Global call status tracking for real-time updates
  const activeCallStatus = new Map();

  // Twilio call status webhook
  app.post("/api/twilio/call-status", async (req, res) => {
    const { CallSid, CallStatus, CallDuration, From, To } = req.body;
    
    // Extract agent email from Twilio call metadata (sent as custom parameters)
    const agentEmail = req.body['metadata[agent_email]'] || req.body.agent_email || req.body.AgentEmail;

    console.log('🔔 TWILIO WEBHOOK RECEIVED:', {
      callSid: CallSid,
      status: CallStatus,
      duration: CallDuration,
      from: From,
      to: To,
      agentEmail: agentEmail,
      fullBody: JSON.stringify(req.body)
    });

    // Update Call Connector Tracker for Live Board
    try {
      const { callConnectorTracker } = await import('./call-connector-tracker');
      
      // Map Twilio status to our status
      const statusMap: { [key: string]: 'ringing' | 'answered' | 'completed' | 'failed' } = {
        'ringing': 'ringing',
        'in-progress': 'answered',
        'answered': 'answered',
        'completed': 'completed',
        'failed': 'failed',
        'busy': 'failed',
        'no-answer': 'failed',
        'canceled': 'failed'
      };
      
      const mappedStatus = statusMap[CallStatus];
      if (mappedStatus) {
        callConnectorTracker.updateCallStatus(CallSid, mappedStatus, parseInt(CallDuration) || undefined);
        console.log(`📊 Updated Call Connector Tracker: ${CallSid} -> ${mappedStatus}`);
      }
    } catch (error) {
      console.error('❌ Error updating Call Connector Tracker:', error);
    }

    // Track real call status for frontend polling - use multiple keys for better matching
    if (CallSid && CallStatus && To) {
      const cleanToNumber = To.replace(/\D/g, '');
      
      // Store under multiple keys to ensure we can find it
      const statusData = {
        callSid: CallSid,
        status: CallStatus,
        to: To,
        cleanTo: cleanToNumber,
        from: From,
        timestamp: Date.now()
      };
      
      // Store under original number and cleaned number
      activeCallStatus.set(To, statusData);
      activeCallStatus.set(cleanToNumber, statusData);
      
      if (CallStatus === 'answered') {
        console.log(`🎉 CLIENT ANSWERED! Phone: ${To}, CallSid: ${CallSid}`);
        console.log(`🎯 STORED UNDER KEYS: ${To} and ${cleanToNumber}`);
      } else if (CallStatus === 'completed' || CallStatus === 'failed') {
        console.log(`📞 CALL ENDED: ${CallStatus} for ${To}`);
      }
      
      // Clean up old entries (older than 5 minutes)
      const fiveMinutesAgo = Date.now() - (5 * 60 * 1000);
      for (const [phone, status] of activeCallStatus.entries()) {
        if (status.timestamp < fiveMinutesAgo) {
          activeCallStatus.delete(phone);
        }
      }
    }

    try {
      // Save ALL call data to Supabase twilio_call_logs table for Live Call Board
      if (CallSid && CallStatus) {
        // Get agent email from multiple sources (priority order)
        let ownerEmail = 'system@aoglobelife.com'; // Default system agent
        
        try {
          // First try to get from database (outbound_call_history table)
          const { data: dbCall } = await supabase
            .from('outbound_call_history')
            .select('agent_email')
            .eq('call_sid', CallSid)
            .order('created_at', { ascending: false })
            .limit(1)
            .maybeSingle();
          
          // Check if we got data back
          const agentFromDb = dbCall?.agent_email;
          
          if (agentFromDb) {
            ownerEmail = agentFromDb;
            console.log(`✅ Found agent from database: ${ownerEmail} for CallSid: ${CallSid}`);
          } else {
            // Fallback to webhook metadata (sent when call was created)
            if (agentEmail && agentEmail !== 'unknown@aoglobelife.com') {
              ownerEmail = agentEmail;
              console.log(`✅ Found agent from webhook metadata: ${ownerEmail} for CallSid: ${CallSid}`);
            } else {
              // Fallback to Call Connector Tracker (in-memory tracking)
              const { callConnectorTracker } = await import('./call-connector-tracker');
              const call = callConnectorTracker.getCallByCallSid(CallSid);
              if (call && call.agentEmail) {
                ownerEmail = call.agentEmail;
                console.log(`✅ Found agent from tracker: ${ownerEmail} for CallSid: ${CallSid}`);
              } else {
                console.log(`⚠️ CallSid ${CallSid} not found anywhere, using default: ${ownerEmail}`);
              }
            }
          }
        } catch (error) {
          console.error('❌ Error getting agent email:', error);
        }

        // Save ALL calls for Live Call Board to show real data
        const callData = {
          twilio_call_sid: CallSid,
          call_direction: 'outbound',
          from_number: From || '',
          to_number: To || '',
          call_status: CallStatus,
          call_duration: parseInt(CallDuration) || 0,
          owner_email: ownerEmail,
          agent_identity: ownerEmail,
          call_started_at: new Date().toISOString(),
          call_ended_at: CallStatus === 'completed' || CallStatus === 'failed' ? new Date().toISOString() : null,
          call_source: 'twilio_webhook',
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        };

        console.log('💾 Saving call to Supabase for Live Call Board:', {
          callSid: CallSid,
          status: CallStatus,
          from: From,
          to: To,
          duration: CallDuration
        });

        const { error } = await supabase
          .from('twilio_call_logs')
          .insert(callData);

        if (error) {
          console.error('❌ Failed to save call to Supabase:', error);
        } else {
          console.log('✅ Call saved to Supabase successfully - Live Call Board will now show real data');
        }

        // Trigger hotlead assignment webhook when outbound call is completed (from second handler)
        if (CallStatus === 'completed' && From) {
          console.log(`🔥 OUTBOUND CALL COMPLETED: Checking agent for hotlead assignment`);
          
          try {
            // Find agent email from phone number via customers table
            const { data: customer } = await supabase
              .from('customers')
              .select('company_email, first_name, last_name')
              .eq('phone', From.replace(/[^\d]/g, ''))
              .maybeSingle();
            
            if (customer?.company_email) {
              console.log(`👤 Found agent: ${customer.company_email} for phone ${From}`);
              
              // Get agent's total completed calls from today
              const { data: todaysCalls } = await supabase
                .from('twilio_call_logs')
                .select('*', { count: 'exact' })
                .eq('from_number', From)
                .eq('call_status', 'completed')
                .gte('created_at', new Date().toISOString().split('T')[0]); // Today's calls
              
              const todaysCallCount = todaysCalls?.length || 0;
              console.log(`📊 Agent ${customer.company_email} has ${todaysCallCount} completed calls today`);
              
              // Check for hotlead eligibility (trigger webhook if needed)
              // Note: checkAgentForHotleadAssignment function should be imported or defined
              try {
                const { checkAgentForHotleadAssignment } = await import('./hotlead-scheduler');
                await checkAgentForHotleadAssignment(customer.company_email, todaysCallCount);
              } catch (importError) {
                console.error('⚠️ Could not import checkAgentForHotleadAssignment:', importError);
              }
              
            } else {
              console.log(`❓ No agent found for phone number: ${From}`);
            }
            
          } catch (webhookError) {
            console.error('❌ Hotlead webhook trigger error:', webhookError);
          }
        }
      }
    } catch (error) {
      console.error('❌ Error processing call status webhook:', error);
    }

    res.status(200).send('OK');
  });

  // Endpoint for frontend to check real call status
  app.get("/api/twilio/call-status/:phone", (req, res) => {
    const { phone } = req.params;
    const cleanPhone = phone.replace(/\D/g, '');
    
    console.log(`🔍 CHECKING CALL STATUS for ${phone} (cleaned: ${cleanPhone})`);
    console.log(`🗂️ Available statuses (${activeCallStatus.size}): ${Array.from(activeCallStatus.keys()).join(', ')}`);
    
    // Look for status by exact match first, then partial match
    let status = activeCallStatus.get(phone) || activeCallStatus.get(cleanPhone);
    
    if (!status) {
      // Try partial matching as fallback
      for (const [callPhone, callStatus] of activeCallStatus.entries()) {
        const cleanCallPhone = callPhone.replace(/\D/g, '');
        if (cleanCallPhone.includes(cleanPhone) || cleanPhone.includes(cleanCallPhone)) {
          status = callStatus;
          console.log(`🎯 FOUND MATCH: ${callPhone} matches ${phone}`);
          break;
        }
      }
    }
    
    const result = {
      phone: phone,
      cleanPhone: cleanPhone,
      status: status ? status.status : null,
      callSid: status ? status.callSid : null,
      timestamp: status ? status.timestamp : null,
      found: !!status,
      availableKeys: Array.from(activeCallStatus.keys())
    };
    
    console.log(`📋 RETURNING STATUS:`, result);
    res.json(result);
  });

  // Taalk webhook for call completion notifications
  app.post('/api/taalk/webhook', async (req, res) => {
    try {
      console.log('🔔 Taalk webhook received:', req.body);
      
      const { type, call_id, status, session_id, duration, result, recording_url } = req.body;
      
      // Handle call completion events
      if (type === 'call.completed' || type === 'call.finished' || status === 'completed') {
        console.log(`📞 Taalk call completed - ID: ${call_id}, Status: ${status}, Duration: ${duration}s`);
        
        // Update session with completion data
        if (session_id) {
            let storedRecordingUrl = null;
            
            // ALWAYS try to download recording immediately (using session_id)
            const taalkCallId = call_id || session_id;
            const taalkRecordingUrl = recording_url || `https://api.taalk.ai/api/calls/${taalkCallId}/recording?db=michaelmandella`;
            const taalkApiKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJrZXkiOiJ0YWFsay4zN2RhMGU2NS1kMGVjLTQxYWYtOGQzYi03MWRjNTJiNGNiMmYiLCJuYW1lIjoidGFhbGsiLCJleHAiOjIwNTUwMzU2OTJ9.Ywh89Z0PvELHylJReZo8KPOiL7xX21BoBYe16OZfJw4";
            
            try {
              console.log(`🎵 IMMEDIATELY downloading recording: ${taalkRecordingUrl}`);
              
              // Try with API key first
              let response = await fetch(taalkRecordingUrl, {
                headers: {
                  'Authorization': `Bearer ${taalkApiKey}`,
                  'Accept': 'audio/mpeg, audio/mp3, audio/*, */*'
                }
              });
              
              // Fallback to basic auth if bearer fails
              if (!response.ok) {
                console.log(`⚠️ Bearer auth failed (${response.status}), trying basic auth...`);
                const basicAuth = Buffer.from('michaelmandella@aoglobelife.com:Aoletsgrow24!').toString('base64');
                response = await fetch(taalkRecordingUrl, {
                  headers: {
                    'Authorization': `Basic ${basicAuth}`,
                    'Accept': 'audio/mpeg'
                  }
                });
              }
              
              if (response.ok) {
                const arrayBuffer = await response.arrayBuffer();
                const buffer = Buffer.from(arrayBuffer);
                
              // Upload to Supabase Storage using native API
              const { supabaseAdmin } = await import('./supabase');
              const fileName = `recordings/${taalkCallId}.mp3`;
              
              const { data: uploadData, error: uploadError } = await supabaseAdmin.storage
                .from('verify_agent_screenshot')
                .upload(fileName, buffer, {
                  contentType: 'audio/mpeg',
                  upsert: true
                });
              
              if (uploadError) {
                console.error(`❌ Supabase Storage upload failed:`, uploadError);
              } else {
              // Generate signed URL (requires authentication, 1 hour expiry)
              const { data: urlData } = supabaseAdmin.storage
                .from('verify_agent_screenshot')
                .createSignedUrl(fileName, 3600); // 1 hour
              
              storedRecordingUrl = urlData.signedUrl;
                console.log(`✅ RECORDING SAVED TO SUPABASE STORAGE: ${fileName} (${buffer.length} bytes)`);
                console.log(`🔗 Public URL: ${storedRecordingUrl}`);
              }
              } else {
                console.error(`❌ Recording download failed: ${response.status} ${response.statusText}`);
                console.error(`💀 Recording may already be deleted from Taalk (happens after 48hrs)`);
              }
            } catch (downloadError) {
              console.error(`❌ Error downloading/storing recording:`, downloadError);
            }
            
          // Update Supabase directly instead of local storage
          const { error: updateError } = await supabaseAdmin
            .from('verification_sessions')
            .update({
              taalk_call_status: 'completed',
              taalk_call_completed_at: new Date().toISOString(),
              taalk_call_duration: duration || 0,
              taalk_call_data: JSON.stringify(req.body),
              taalk_call_url: storedRecordingUrl || null,
              status: 'completed',
              completed_at: new Date().toISOString()
            })
            .eq('session_id', session_id);
          
          if (updateError) {
            console.error(`❌ Failed to update session ${session_id}:`, updateError);
          } else {
            console.log(`✅ Updated session ${session_id} in Supabase - ${storedRecordingUrl ? 'RECORDING STORED' : 'NO RECORDING'}`);
            
            // 🤖 AUTOMATICALLY ANALYZE AUDIO if recording was stored
            if (storedRecordingUrl) {
              console.log(`🤖 Triggering automatic audio analysis for session ${session_id}...`);
              
              // Run audio analysis in background (don't await to avoid blocking webhook)
              (async () => {
                try {
                  const { verificationAudioAnalyzer } = await import('./verification-audio-analyzer');
                  const audioAnalysis = await verificationAudioAnalyzer.analyzeAudioFromUrl(
                    storedRecordingUrl,
                    (type as any) || 'phone'
                  );
                  
                  // Update session with audio analysis
                  await supabaseAdmin
                    .from('verification_sessions')
                    .update({ audio_analysis: audioAnalysis })
                    .eq('session_id', session_id);
                  
                  console.log(`✅ Audio analysis completed for session ${session_id}: ${audioAnalysis.validation.isValid ? 'VALID' : 'FLAGGED'} (${(audioAnalysis.validation.confidence * 100).toFixed(0)}%)`);
                } catch (analysisError) {
                  console.error(`❌ Audio analysis failed for session ${session_id}:`, analysisError);
                }
              })();
            }
          }
        }
        
        // Broadcast call completion to any connected clients
        console.log(`🎉 Call ${call_id} completed successfully after ${duration || 0} seconds`);
      }
      
      // Handle other call events - Update Supabase directly
      if (type === 'call.started' || status === 'ringing') {
        console.log(`📱 Taalk call started/ringing - ID: ${call_id}`);
        if (session_id) {
          await supabaseAdmin
            .from('verification_sessions')
            .update({ taalk_call_status: 'ringing', status: 'in_progress' })
            .eq('session_id', session_id);
        }
      }
      
      if (type === 'call.answered' || status === 'answered') {
        console.log(`✅ Taalk call answered - ID: ${call_id}`);
        if (session_id) {
          await supabaseAdmin
            .from('verification_sessions')
            .update({ taalk_call_status: 'answered', status: 'in_progress' })
            .eq('session_id', session_id);
        }
      }
      
      if (type === 'call.failed' || status === 'failed') {
        console.log(`❌ Taalk call failed - ID: ${call_id}`);
        if (session_id) {
          await supabaseAdmin
            .from('verification_sessions')
            .update({ 
              taalk_call_status: 'failed',
              taalk_call_completed_at: new Date().toISOString(),
              status: 'failed'
            })
            .eq('session_id', session_id);
        }
      }
      
      res.json({ success: true, message: 'Webhook processed successfully' });
      
    } catch (error) {
      console.error('❌ Error processing Taalk webhook:', error);
      res.status(500).json({ error: 'Webhook processing failed' });
    }
  });

  // Get Taalk call status - this endpoint was removed due to conflicts with the main endpoint

  // Reset verification session call
  app.post('/api/verification/session/:sessionId/reset-call', async (req, res) => {
    try {
      const { sessionId } = req.params;
      const session = await storage.getVerificationSession(sessionId);
      
      if (!session) {
        return res.status(404).json({ message: "Session not found" });
      }

      // Reset call-related fields
      const updatedSession = await storage.updateVerificationSession(sessionId, {
        taalkCallId: null,
        taalkCallStatus: 'not_initiated',
        taalkCallInitiatedAt: null,
        taalkCallCompletedAt: null,
        taalkCallDuration: null,
        status: 'pending'
      });

      console.log(`Verification session ${sessionId} call has been reset`);
      
      res.json({ 
        success: true, 
        message: "Call reset successfully"
      });
    } catch (error) {
      console.error('Error resetting verification call:', error);
      res.status(500).json({ message: "Failed to reset verification call" });
    }
  });

  // Webhook endpoint for SMS text events (for Zapier integration)
  app.post("/api/webhook/sms-events", async (req, res) => {
    try {
      console.log('SMS Event Webhook received:', req.body);

      const { 
        sessionId, 
        phone, 
        message, 
        status, 
        timestamp,
        direction, // 'inbound' or 'outbound'
        eventType, // 'received', 'delivered', 'read', 'verification_complete', 'client_response'
        metadata
      } = req.body;

      // Log the event for debugging
      console.log(`SMS Event: ${eventType} - Session: ${sessionId}, Phone: ${phone}, Status: ${status}`);

      // If this is a verification completion event, update the session
      if (sessionId && eventType === 'verification_complete') {
        const session = await storage.getVerificationSession(sessionId);
        if (session) {
          await storage.updateVerificationSession(sessionId, {
            status: 'completed',
            completedAt: new Date()
          });
          console.log(`Verification completed for session ${sessionId} via SMS webhook`);
        }
      }

      // If this is a client response to verification
      if (sessionId && eventType === 'client_response' && message) {
        const session = await storage.getVerificationSession(sessionId);
        if (session) {
          // Check if client confirmed verification
          const isConfirmed = message.toLowerCase().includes('yes') || 
                             message.toLowerCase().includes('confirm') ||
                             message.toLowerCase().includes('verified') ||
                             message.toLowerCase().includes('complete');

          if (isConfirmed) {
            await storage.updateVerificationSession(sessionId, {
              status: 'completed',
              completedAt: new Date()
            });
            console.log(`Client confirmed verification for session ${sessionId} via SMS: "${message}"`);
          }
        }
      }

      // If this is a delivery confirmation for outbound SMS
      if (sessionId && eventType === 'delivered' && direction === 'outbound') {
        const session = await storage.getVerificationSession(sessionId);
        if (session) {
          console.log(`SMS delivered for session ${sessionId} to ${phone}`);
        }
      }

      res.json({ 
        success: true, 
        message: "SMS event processed successfully",
        eventType,
        sessionId: sessionId || null,
        timestamp: new Date().toISOString()
      });

    } catch (error: any) {
      console.error('SMS webhook error:', error);
      res.status(500).json({ 
        success: false, 
        message: "Failed to process SMS event", 
        error: error.message 
      });
    }
  });

