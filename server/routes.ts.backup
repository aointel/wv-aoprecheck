  // Bulk sync all appointments to Google Calendar
  app.post("/api/google-calendar/sync-all", async (req, res) => {
    try {
      const { agentEmail, tokens } = req.body;
      
      if (!agentEmail || !tokens) {
        return res.status(400).json({
          success: false,
          error: 'agentEmail and tokens are required'
        });
      }

      // Get all appointments for the agent
      const appointments = await getAppointments({ agentEmail });
      
      if (!appointments || appointments.length === 0) {
        return res.json({
          success: true,
          message: 'No appointments to sync',
          syncedCount: 0
        });
      }

      // Sync all appointments
      const results = await googleCalendarService.syncAppointments(appointments, tokens);
      
      const successCount = results.filter(r => r.success).length;
      const errorCount = results.filter(r => !r.success).length;
      
      res.json({
        success: true,
        message: `Synced ${successCount} appointments to Google Calendar`,
        syncedCount: successCount,
        errorCount: errorCount,
        results: results
      });

    } catch (error) {
      console.error('Error bulk syncing appointments:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to sync appointments',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

  // Get appointments with enhanced Google Calendar sync status
  app.get("/api/appointments/sync-status", async (req, res) => {
    try {
      const { agentEmail } = req.query;
      
      if (!agentEmail) {
        return res.status(400).json({ error: 'Agent email required' });
      }

      console.log(`🗓️ Fetching appointments with sync status for agent: ${agentEmail}`);

      // Get appointments with sync info
      const { data: appointmentsData, error } = await supabase
        .from('appointments')
        .select(`
          *,
          google_calendar_event_id,
          google_calendar_sync_status,
          google_calendar_synced_at,
          google_calendar_html_link,
          google_calendar_sync_error
        `)
        .eq('agent_email', agentEmail)
        .order('start_time', { ascending: true });

      if (error) {
        console.error('❌ Supabase appointments sync status error:', error);
        return res.status(500).json({ error: 'Failed to fetch appointments sync status' });
      }

      // Enhance with sync information
      const enhancedAppointments = (appointmentsData || []).map(appointment => ({
        ...appointment,
        syncStatus: {
          isSynced: appointment.google_calendar_sync_status === 'synced',
          status: appointment.google_calendar_sync_status || 'pending',
          lastSynced: appointment.google_calendar_synced_at,
          hasError: appointment.google_calendar_sync_error,
          googleCalendarLink: appointment.google_calendar_html_link,
          eventId: appointment.google_calendar_event_id
        },
        syncActions: {
          canSync: appointment.google_calendar_sync_status !== 'synced' || !appointment.google_calendar_event_id,
          canResync: appointment.google_calendar_sync_status === 'synced' && appointment.google_calendar_event_id,
          canViewInGoogle: appointment.google_calendar_html_link ? true : false
        }
      }));

      // Calculate sync statistics
      const syncStats = {
        total: enhancedAppointments.length,
        synced: enhancedAppointments.filter(a => a.syncStatus.isSynced).length,
        pending: enhancedAppointments.filter(a => a.syncStatus.status === 'pending').length,
        failed: enhancedAppointments.filter(a => a.syncStatus.status === 'failed').length,
        withErrors: enhancedAppointments.filter(a => a.syncStatus.hasError).length
      };

      console.log(`✅ Enhanced appointments with sync status: ${enhancedAppointments.length} appointments`);
      console.log(`📊 Sync stats:`, syncStats);
      
      res.json({
        appointments: enhancedAppointments,
        syncStats,
        lastUpdated: new Date().toISOString()
      });

    } catch (error: any) {
      console.error('❌ Error fetching appointments sync status:', error);
      res.status(500).json({ 
        error: 'Failed to fetch appointments sync status',
        details: error.message 
      });
    }
  });

  // Manual sync trigger for specific appointment
  app.post("/api/appointments/sync/:appointmentId", async (req, res) => {
    try {
      const { appointmentId } = req.params;
      const { agentEmail } = req.body;
      
      if (!agentEmail) {
        return res.status(400).json({ error: 'Agent email required' });
      }

      console.log(`🔄 Manual sync request for appointment ${appointmentId} by agent ${agentEmail}`);

      // Get the appointment details
      const { data: appointment, error: appointmentError } = await supabase
        .from('appointments')
        .select('*')
        .eq('id', appointmentId)
        .eq('agent_email', agentEmail)
        .single();

      if (appointmentError || !appointment) {
        console.error('❌ Appointment not found:', appointmentError);
        return res.status(404).json({ error: 'Appointment not found' });
      }

      // Get user's Google Calendar tokens
      const userTokens = null; // TODO: Implement getUserTokens function
      if (!userTokens) {
        return res.status(400).json({
          success: false,
          error: 'User not authenticated with Google Calendar. Please complete OAuth flow first.'
        });
      }

      // Create event data for Google Calendar
      const eventData = {
        summary: appointment.title || `Appointment with ${appointment.lead_name || 'Lead'}`,
        description: appointment.description || `ConnectNow Appointment\n\nLead: ${appointment.lead_name || 'N/A'}\nNotes: ${appointment.notes || 'N/A'}`,
        startTime: appointment.start_time,
        endTime: appointment.end_time,
        attendeeEmail: appointment.lead_email,
        location: appointment.location || 'ConnectNow Virtual Meeting Room'
      };

      // Sync with Google Calendar
      googleCalendarService.setTokens(userTokens);
      const googleEvent = await googleCalendarService.createEvent(eventData);
      
      // Update appointment with sync info
      const { error: updateError } = await supabase
        .from('appointments')
        .update({
          google_calendar_event_id: googleEvent.id,
          google_calendar_sync_status: 'synced',
          google_calendar_synced_at: new Date().toISOString(),
          google_calendar_html_link: googleEvent.htmlLink,
          google_calendar_sync_error: null
        })
        .eq('id', appointmentId);

      if (updateError) {
        console.error('❌ Failed to update appointment sync status:', updateError);
        return res.status(500).json({
          success: false,
          error: 'Appointment synced but failed to update sync status'
        });
      }

      console.log('✅ Appointment manually synced to Google Calendar:', googleEvent.htmlLink);
      
      res.json({
        success: true,
        message: 'Appointment synced to Google Calendar',
        googleEventId: googleEvent.id,
        googleEventLink: googleEvent.htmlLink,
        appointmentId: appointmentId,
        syncStatus: 'synced'
      });

    } catch (error: any) {
      console.error('❌ Error manually syncing appointment:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to sync appointment',
        details: error.message
      });
    }
  });

  // FETCH Google Calendar events for display (no CRM import)
  app.get("/api/google-calendar/events", async (req, res) => {
    try {
      const { agentEmail, startDate, endDate } = req.query;
      
      console.log(`🔍 DEBUG: Endpoint called with agentEmail: ${agentEmail}`);
      
      if (!agentEmail) {
        console.log('❌ DEBUG: No agentEmail provided');
        return res.status(400).json({ error: 'Agent email required' });
      }

      console.log(`📅 Fetching Google Calendar events for display - agent: ${agentEmail}`);

      // Get user's Google Calendar tokens
      console.log('🔍 DEBUG: Calling getUserTokens...');
      const userTokens = null; // TODO: Implement getUserTokens function
      console.log('🔍 DEBUG: getUserTokens result:', userTokens ? 'Tokens found' : 'No tokens');
      
      if (!userTokens) {
        console.log('❌ DEBUG: No user tokens found, returning error');
        return res.status(400).json({
          success: false,
          error: 'User not authenticated with Google Calendar. Please complete OAuth flow first.'
        });
      }

      // Set date range (default to next 30 days if not specified)
      const start = startDate ? new Date(startDate as string) : new Date();
      const end = endDate ? new Date(endDate as string) : new Date(start.getTime() + (30 * 24 * 60 * 60 * 1000));

      console.log(`📅 Fetching events from ${start.toISOString()} to ${end.toISOString()}`);

      // Fetch events from Google Calendar
      console.log('🔍 DEBUG: Setting tokens and calling listEvents...');
      googleCalendarService.setTokens(userTokens);
      const events = await googleCalendarService.listEvents(start, end);
      console.log('🔍 DEBUG: listEvents returned:', events ? `${events.length} events` : 'No events');
      
      if (!events || events.length === 0) {
        console.log('🔍 DEBUG: No events found, returning empty response');
        return res.json({
          success: true,
          message: 'No events found in Google Calendar for the specified date range',
          events: [],
          totalEvents: 0
        });
      }

      console.log(`📅 Found ${events.length} events in Google Calendar for display`);

      // Format events for calendar display (don't create CRM records)
      console.log('🔍 DEBUG: Formatting events...');
      const formattedEvents = events.map(event => ({
        id: `google-${event.id}`,
        title: event.summary || 'Google Calendar Event',
        description: event.description || '',
        startTime: event.start.dateTime || event.start.date,
        endTime: event.end.dateTime || event.end.date,
        duration: event.start.dateTime && event.end.dateTime ? 
          Math.round((new Date(event.end.dateTime).getTime() - new Date(event.start.dateTime).getTime()) / (1000 * 60)) : 60,
        source: 'google_calendar',
        googleEventId: event.id,
        googleEventLink: event.htmlLink,
        attendees: event.attendees || [],
        location: event.location || '',
        isGoogleEvent: true,
        // Don't include CRM-specific fields
        status: 'confirmed',
        agentEmail: agentEmail,
        meetingPlatform: 'google_calendar'
      }));

      console.log('🔍 DEBUG: Sending formatted response with', formattedEvents.length, 'events');
      res.json({
        success: true,
        message: `Successfully fetched ${events.length} Google Calendar events for display`,
        events: formattedEvents,
        totalEvents: events.length,
        dateRange: { start: start.toISOString(), end: end.toISOString() }
      });

    } catch (error: any) {
      console.error('❌ Error fetching Google Calendar events:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to fetch Google Calendar events',
        details: error.message
      });
    }
  });



