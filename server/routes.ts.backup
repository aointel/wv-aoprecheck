  // Get pending WAR cards count for header notification
  app.get("/api/war/pending-count", async (req, res) => {
    try {
      const agentEmail = req.query.agentEmail as string;
      
      if (!agentEmail) {
        return res.status(400).json({
          error: 'Agent email is required'
        });
      }

      // Count pending connects that need review
      const connects = await db
        .select()
        .from(warConnects)
        .where(
          and(
            eq(warConnects.agentEmail, agentEmail),
            or(
              isNull(warConnects.disposition),
              eq(warConnects.disposition, 'pending')
            )
          )
        );

      res.json({
        pending_count: connects.length,
        has_pending: connects.length > 0
      });
    } catch (error) {
      console.error('Error fetching pending WAR cards count:', error);
      res.status(500).json({ 
        error: 'Failed to fetch pending cards count' 
      });
    }
  });

