// Check if agent should be taken offline based on current activities
async function checkAgentVDPStatus(agentEmail: string) {
  try {
    // Check for active inbound calls (agents already connected to VDP calls)
    const activeInboundCalls = await db
      .select()
      .from(schema.incomingCalls)
      .where(
        and(
          eq(schema.incomingCalls.assignedAgentEmail, agentEmail),
          or(
            eq(schema.incomingCalls.status, 'answered'),
            eq(schema.incomingCalls.status, 'connected')
          )
        )
      );
    
    // Simple check - if agent has active VDP calls, should be offline from new VDP calls
    const shouldBeOffline = activeInboundCalls.length > 0;
    
    if (shouldBeOffline) {
      await setVDPAgentStatus(agentEmail, 'offline', 'Active VDP call in progress');
      return { shouldBeOffline: true, reason: 'Active VDP call in progress' };
    } else {
      await setVDPAgentStatus(agentEmail, 'online', 'Available for VDP calls');
      return { shouldBeOffline: false, reason: 'Available for VDP calls' };
    }
    
  } catch (error) {
    console.error(`❌ Failed to check VDP status for ${agentEmail}:`, error);
    return { shouldBeOffline: false, reason: 'Error checking status' };
  }
}

