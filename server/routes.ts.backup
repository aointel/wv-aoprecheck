  // Get Zoom OAuth URL for authorization and redirect directly
  app.get("/api/zoom/auth-url", async (req, res) => {
    try {
      const clientId = process.env.ZOOM_CLIENT_ID || 'your_zoom_client_id';
      const redirectUri = `${process.env.REPLIT_URL || 'http://localhost:5000'}/auth/zoom/callback`;
      
      const authUrl = ZoomService.generateAuthUrl(clientId, redirectUri);
      
      // Redirect directly to Zoom OAuth
      res.redirect(authUrl);
    } catch (error) {
      console.error('Error generating Zoom auth URL:', error);
      res.status(500).send('Failed to generate authorization URL');
    }
  });

  // Handle Zoom OAuth callback
  app.get("/auth/zoom/callback", async (req, res) => {
    try {
      const { code, state } = req.query;
      
      console.log('Zoom OAuth callback received:', { code: !!code, state });
      
      if (!code) {
        console.error('No authorization code provided');
        return res.send(`
          <html>
            <body>
              <h2>Authorization Failed</h2>
              <p>No authorization code received from Zoom.</p>
              <script>window.close();</script>
            </body>
          </html>
        `);
      }

      const clientId = process.env.ZOOM_CLIENT_ID!;
      const clientSecret = process.env.ZOOM_CLIENT_SECRET!;
      const redirectUri = `${process.env.REPLIT_URL || 'http://localhost:5000'}/auth/zoom/callback`;
      
      const tokens = await ZoomService.getTokens(code as string, clientId, clientSecret, redirectUri);
      console.log('Zoom tokens received:', { hasAccessToken: !!tokens.access_token, hasRefreshToken: !!tokens.refresh_token });
      
      // Send tokens back to parent window and close popup
      res.send(`
        <html>
          <body>
            <h2>Authorization Successful!</h2>
            <p>Zoom access granted. You can close this window.</p>
            <script>
              // Store tokens in localStorage and notify parent window
              localStorage.setItem('zoomTokens', JSON.stringify(${JSON.stringify(tokens)}));
              if (window.opener) {
                window.opener.postMessage({ 
                  type: 'ZOOM_AUTH_SUCCESS', 
                  tokens: ${JSON.stringify(tokens)} 
                }, '*');
              }
              setTimeout(() => window.close(), 2000);
            </script>
          </body>
        </html>
      `);
    } catch (error) {
      console.error('Zoom OAuth callback error:', error);
      res.send(`
        <html>
          <body>
            <h2>Authorization Failed</h2>
            <p>Error: ${error instanceof Error ? error.message : 'Unknown error'}</p>
            <script>
              if (window.opener) {
                window.opener.postMessage({ 
                  type: 'ZOOM_AUTH_ERROR', 
                  error: '${error instanceof Error ? error.message : 'Authorization failed'}' 
                }, '*');
              }
              setTimeout(() => window.close(), 3000);
            </script>
          </body>
        </html>
      `);
    }
  });

  // Create Zoom meeting for appointment
  app.post("/api/zoom/create-meeting", async (req, res) => {
    try {
      const { appointmentData, tokens } = req.body;
      
      if (!appointmentData || !tokens) {
        return res.status(400).json({
          success: false,
          error: 'appointmentData and tokens are required'
        });
      }

      const zoomService = new ZoomService(tokens.access_token);
      
      const meetingRequest = {
        topic: appointmentData.title || `Meeting with ${appointmentData.leadName}`,
        start_time: new Date(appointmentData.startTime).toISOString(),
        duration: appointmentData.duration || 60,
        timezone: appointmentData.timezone || 'America/New_York',
        agenda: appointmentData.description || appointmentData.notes,
        settings: {
          host_video: true,
          participant_video: true,
          join_before_host: true,
          mute_upon_entry: true,
          waiting_room: true,
          auto_recording: 'cloud'
        }
      };

      const meeting = await zoomService.createMeeting(meetingRequest);
      
      res.json({
        success: true,
        meeting: {
          id: meeting.id,
          join_url: meeting.join_url,
          password: meeting.password,
          start_time: meeting.start_time,
          duration: meeting.duration
        },
        message: 'Zoom meeting created successfully'
      });

    } catch (error) {
      console.error('Error creating Zoom meeting:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to create Zoom meeting',
        details: error instanceof Error ? error.message : String(error)
      });
