  // Zapier webhook for client video room notifications
  app.post("/api/zapier/video-room", async (req, res) => {
    try {
      const { phoneNumber, clientName, role, roomId, meetingUrl } = req.body;
      
      if (!phoneNumber || !roomId) {
        return res.status(400).json({
          success: false,
          error: "Phone number and room ID required"
        });
      }

      // Basic phone number validation
      const cleanPhone = phoneNumber.replace(/\D/g, '');
      if (cleanPhone.length < 10 || cleanPhone.length > 15) {
        return res.status(400).json({
          success: false,
          error: "Invalid phone number format. Must be 10-15 digits."
        });
      }

      // Check if trying to send to same number as sender (prevents Twilio error)
      if (phoneNumber === TWILIO_PHONE_NUMBER) {
        return res.status(400).json({
          success: false,
          error: "Cannot send SMS to same number as sender"
        });
      }

      // Use direct Whereby meeting URL - no server routing needed
      const videoUrl = meetingUrl; // This should already be the direct roomUrl from Whereby
      
      // Create SMS message with direct Whereby URL
      const smsMessage = `Hi ${clientName || 'there'}, please join our secure video meeting: ${videoUrl}`;
      
      // Send ONLY to Zapier webhook - let Zapier handle SMS delivery
      const zapierWebhook = 'https://hooks.zapier.com/hooks/catch/2467580/u4rzckx/';
      const webhookPayload = {
        phoneNumber,
        clientName: clientName || 'Client',
        role: role || 'client',
        roomId,
        videoUrl,
        smsMessage,
        timestamp: new Date().toISOString(),
        source: 'ao-intelligence-whereby',
        action: 'send_sms'
      };

      const webhookResponse = await fetch(zapierWebhook, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(webhookPayload)
      });

      if (!webhookResponse.ok) {
        throw new Error(`Zapier webhook failed: ${webhookResponse.status}`);
      }

      console.log(`📨 SMS request sent to Zapier webhook for ${phoneNumber} - room: ${roomId}`);
      
      res.json({
        success: true,
        phoneNumber,
        roomId,
        videoUrl,
        smsMessage,
        webhookSent: true,
        message: 'SMS request sent to Zapier for delivery'
      });

    } catch (error) {
      console.error('❌ Zapier video webhook error:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to send Zapier webhook',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

