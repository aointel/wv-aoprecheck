          voiceUrl: number.voiceUrl,
          statusCallback: number.statusCallback,
          friendlyName: number.friendlyName
        };
        results.push(config);
        
        console.log(`📞 Phone: ${number.phoneNumber} - Voice URL: ${number.voiceUrl}`);
