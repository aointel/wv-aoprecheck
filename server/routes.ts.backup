  // Save call disposition for outbound calls
  app.post("/api/outbound-dialer/save-disposition", async (req, res) => {
    try {
      console.log(`🔍 EXACT WEBHOOK DATA RECEIVED:`, JSON.stringify(req.body, null, 2));
      console.log(`🔍 REQUEST HEADERS:`, JSON.stringify(req.headers, null, 2));
      
      const { leadId, disposition, notes, agentEmail, associateId, callDuration, leadPhone, leadName, saleData } = req.body;
      
      if (!leadId || !disposition) {
        return res.status(400).json({ error: 'Lead ID and disposition are required' });
      }

      console.log(`💾 Saving call disposition for lead ${leadId}: ${disposition} by ${agentEmail || 'unknown'}`);
      
      // ONLY use Supabase masterlead table
      let lead: any = null;
      
      try {
        console.log(`🔍 DISPOSITION: Looking up lead by ID ${leadId} in Supabase masterlead table...`);
        
        // Try to find the lead - use .single() to avoid the "multiple rows" error
        let masterLead = null;
        let queryError = null;
        
        try {
          // First try as primary database ID (number)
          const numericId = typeof leadId === 'string' ? parseInt(leadId) : leadId;
          console.log(`🔍 Trying leadId "${leadId}" as database primary ID: ${numericId}`);
          
          let { data, error } = await supabaseAdmin
            .from('masterlead')
            .select('*')
            .eq('id', numericId)
            .single();
            
          if (!error && data) {
            masterLead = data;
            console.log(`✅ Found lead by primary ID: ${data.first_name} ${data.last_name}`);
          } else {
            // If not found by ID, try by taalk_lead_id
            console.log(`🔍 Not found by ID, trying as taalk_lead_id: ${leadId}`);
            let { data: talkData, error: talkError } = await supabaseAdmin
              .from('masterlead')
              .select('*')
              .eq('taalk_lead_id', leadId)
              .single();
              
            if (!talkError && talkData) {
              masterLead = talkData;
              console.log(`✅ Found lead by taalk_lead_id: ${talkData.first_name} ${talkData.last_name}`);
            } else {
              console.log(`❌ Not found by either ID or taalk_lead_id: ${leadId}`);
            }
          }
        } catch (e) {
          console.log(`❌ Query failed for leadId: ${leadId}`, e);
        }
          
        if (masterLead) {
          lead = masterLead;
          console.log(`✅ Found lead in Supabase masterlead table: ${lead.first_name} ${lead.last_name}`);
          
          // Update masterlead with disposition in Supabase
          const { error: updateError } = await supabaseAdmin
            .from('masterlead')
            .update({
              cnresolution: disposition,
              last_contacted: new Date().toISOString(),
              updated_at: new Date().toISOString()
            })
            .eq('id', lead.id); // Use the primary key from the found lead
            
          if (updateError) {
            console.error('❌ Error updating masterlead disposition:', updateError);
          } else {
            console.log(`✅ Updated masterlead ${leadId} with disposition: ${disposition}`);
          }
        } else {
          console.log(`❌ Lead ${leadId} not found in Supabase masterlead table`);
          return res.status(404).json({ error: 'Lead not found in masterlead table' });
        }
      } catch (supabaseError) {
        console.error('❌ Error looking up lead in masterlead:', supabaseError);
        return res.status(500).json({ error: 'Database error looking up lead' });
      }

      // REMOVED: PostgreSQL logging for hotlead dispositions - they should only go to Supabase masterlead table
      // Set up lead data for war_connects stats logging only
      const trackingPhone = leadPhone || lead.phone || lead.phone_number;
      const trackingName = `${lead.first_name || ''} ${lead.last_name || ''}`.trim() || lead.name || 'Unknown Lead';
      const leadState = lead.state || 'Unknown';
      
      console.log(`✅ Hotlead disposition saved to Supabase masterlead table only (PostgreSQL logging removed)`);

      // ALSO log to war_connects table for daily stats tracking
      try {
        const callId = `disp-${leadId}-${Date.now()}`;
        
        // Prepare log data with sale information if applicable
        const logData = {
          connectId: callId,
          agentEmail: agentEmail || 'system@connectnow.com',
          leadName: trackingName,
          leadPhone: trackingPhone,
          connectDate: new Date(),
          connectTime: new Date().toLocaleTimeString(),
          duration: callDuration || 0,
          leadSource: 'supabase_masterlead',
          market: lead?.market || lead?.taalk_groupname || 'Unknown',
          state: leadState,
          connectType: 'outbound_call',
          immediateOutcome: disposition,
          productionStatus: ['booked', 'sale', 'appointment'].includes(disposition) ? 'success' : 'completed',
          disposition: disposition
        };

        // Add sale data if disposition is 'sale' and saleData is provided
        if (disposition === 'sale' && saleData && saleData.alp) {
          logData.saleAmount = parseFloat(saleData.alp);
          logData.notes = notes || `Sale completed - ALP: $${saleData.alp}`;
        }
        
        await warService.logConnect(logData);
        console.log(`✅ Call disposition logged to war_connects for stats tracking: ${disposition}`);
      } catch (warError) {
        console.warn('⚠️ Failed to log disposition to war_connects (non-blocking):', warError);
      }

      // Perform disposition-specific actions
      switch (disposition) {
        case 'booked':
          console.log(`📅 BOOKED: Lead ${trackingName} scheduled for appointment`);
          // Future: Create appointment record, send confirmation SMS, add to calendar
          break;
        
        case 'call_back':
          console.log(`🔄 CALLBACK REQUESTED: Lead ${trackingName} requesting callback`);
          // The outbound call tracking will now enable intelligent callback routing
          break;
          
        case 'instant_presentation':
          console.log(`⚡ INSTANT PRESENTATION: Immediate presentation scheduled for ${trackingName}`);
          // Future: Trigger immediate presentation workflow, notify managers
          break;
          
        case 'sale':
          if (saleData && saleData.alp) {
            console.log(`💰 SALE COMPLETED: Lead ${trackingName} sold with ALP: $${saleData.alp}`);
            // Future: Trigger commission calculation, notify sales team
          } else {
            console.log(`💰 SALE COMPLETED: Lead ${trackingName} sold (no ALP provided)`);
          }
          break;
          
        case 'not_interested':
          console.log(`❌ NOT INTERESTED: Lead ${trackingName} marked as not interested`);
          // Future: Add to suppression list, update lead scoring
          break;
          
        case 'do_not_call':
          console.log(`🚫 DO NOT CALL: Lead ${trackingName} added to DNC list`);
          // Future: Add to federal DNC compliance system
          break;
          
        default:
          console.log(`📞 DISPOSITION: ${disposition} recorded for ${trackingName}`);
      }

      // Update watchdog with lead status change - disposition means lead is no longer pending
      callWatchdog.updateLeadStatus(leadId.toString(), disposition);
      console.log(`⏱️ Updated watchdog lead ${leadId} status to: ${disposition}`);

      // Send to Planet ALTIG when Meet or booked disposition is selected
      if (disposition === 'Meet' || disposition === 'booked') {
        try {
          // Use associate_id from request (agent is logged in and has it)
          // DO NOT USE 999 - must have valid associate ID from logged in user
          const finalAssociateId = associateId || lead.associate_id || null;

          // Check if we have a valid associate ID - DO NOT USE 999
          if (!finalAssociateId) {
            console.error(`❌ Cannot send ${disposition} webhook: No associate_id found for agent ${agentEmail} - LEAD WILL NOT BE SENT`);
            // Continue with disposition save but skip webhook
          } else {
            const webhookPayload = {
              lead_id: lead.taalk_lead_id || leadId,
              associate_id: finalAssociateId
            };

            console.log(`📤 Sending ${disposition} lead to Planet ALTIG: ${trackingName} (lead_id: ${webhookPayload.lead_id})`);

            // Send to Zapier webhook (Zapier forwards to Planet) - this is what works!
            const webhookResponse = await fetch('https://hooks.zapier.com/hooks/catch/2467580/uifcmkd/', {
              method: 'POST',
              headers: { 
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(webhookPayload)
            });

            if (webhookResponse.ok) {
              console.log(`✅ ${disposition} lead sent to Planet ALTIG via Zapier successfully`);
            } else {
              console.error(`❌ Planet ALTIG webhook failed: ${webhookResponse.status}`);
            }
          }
        } catch (webhookError) {
          console.error('❌ Error sending to Planet ALTIG:', webhookError);
        }
      }

      console.log(`✅ Call disposition saved and tracked for intelligent callback routing`);
      
      res.json({
        success: true,
        leadId,
        disposition,
        notes,
        actions: `Disposition saved and call tracked for ${lead.firstName} ${lead.lastName}`,
        callbackRoutingEnabled: ['call_back', 'booked', 'instant_presentation'].includes(disposition),
        timestamp: new Date().toISOString()
      });

    } catch (error) {
      console.error('❌ Save disposition error:', error);
      res.status(500).json({ 
        success: false,
        error: 'Failed to save call disposition',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

