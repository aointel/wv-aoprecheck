  // Call status callback endpoint
  app.post("/api/twilio/call-status", (req, res) => {
    console.log('Twilio call status update:', req.body);

    const { CallSid, CallStatus } = req.body;

    if (CallStatus === 'in-progress') {
      activeCallState.isActive = true;
      activeCallState.startTime = Date.now();
      activeCallState.callSid = CallSid;
    } else if (CallStatus === 'completed' || CallStatus === 'failed' || CallStatus === 'no-answer') {
      activeCallState.isActive = false;
      activeCallState.startTime = null;
      activeCallState.callSid = null;
    }

    res.sendStatus(200);
  });

