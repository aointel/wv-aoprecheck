  // Check if VDP call requires disposition (check for appointment or video meeting)
  app.get('/api/appointments/check-vdp-disposition/:leadName/:callId', async (req, res) => {
    try {
      const { leadName, callId } = req.params;
      
      console.log(`🔍 Checking VDP disposition requirements for ${leadName} (call ${callId})`);
      
      // Check for appointments in the last hour for this lead
      const appointmentCheck = await db
        .select()
        .from(appointments)
        .where(
          and(
            sql`LOWER(${appointments.clientName}) = LOWER(${leadName})`,
            gte(appointments.createdAt, new Date(Date.now() - 60 * 60 * 1000)) // Last hour
          )
        )
        .limit(1);
      
      // Check for video meeting starts (could be tracked in call records)
      const { outboundCalls } = await import('@shared/schema');
      const videoCheck = await db
        .select()
        .from(outboundCalls)
        .where(
          and(
            eq(outboundCalls.id, parseInt(callId)),
            sql`${outboundCalls.notes} LIKE '%video%meeting%started%'`
          )
        )
        .limit(1);
      
      const hasAppointment = appointmentCheck.length > 0;
      const hasVideoMeeting = videoCheck.length > 0;
      
      console.log(`✅ VDP disposition check: appointment=${hasAppointment}, video=${hasVideoMeeting}`);
      
      res.json({
        success: true,
        hasAppointment,
        hasVideoMeeting,
        requiresDisposition: !hasAppointment && !hasVideoMeeting
      });
      
    } catch (error) {
      console.error('❌ Error checking VDP disposition:', error);
      res.status(500).json({
        error: 'Failed to check disposition requirements',
        details: error instanceof Error ? error.message : 'Unknown error'
      });
    }
  });

  // Save VDP call disposition - Two-step approach: VDP calls first, then masterlead fallback
  app.post('/api/vdp-calls/disposition', async (req, res) => {
    try {
      const { callId, leadName, disposition, userEmail, timestamp, notes } = req.body;
      
      console.log('🔍 VDP Disposition Request:', { callId, leadName, disposition, userEmail, body: req.body });
      
      if (!disposition || !userEmail) {
        return res.status(400).json({
          error: 'Missing required fields: disposition, userEmail'
        });
      }
      
      console.log(`📝 STEP 1: Trying to resolve VDP disposition in vdp_calls table: ${disposition} for call ${callId} by ${userEmail}`);
      
      let vdpResolutionSuccess = false;
      let vdpUpdateResult = null;
      
      // STEP 1: Try to resolve to VDP_CALLS table first
      if (callId) {
        try {
          const { incomingCalls } = await import('@shared/schema');
          
          // First, get the current record to check if it exists
          const currentRecord = await db
            .select()
            .from(incomingCalls)
            .where(eq(incomingCalls.id, parseInt(callId)))
            .limit(1);
          
          if (currentRecord.length > 0) {
            const existingNotes = currentRecord[0].notes || '';
            
            // Check if a disposition already exists in the notes
            let updatedNotes = '';
            if (existingNotes.includes('| Disposition:')) {
              // Replace existing disposition with new one
              updatedNotes = existingNotes.replace(/\s*\|\s*Disposition:\s*[^|]*/, ` | Disposition: ${disposition}`);
            } else {
              // Append new disposition
              updatedNotes = existingNotes + ` | Disposition: ${disposition}`;
            }
            
            const updatedCall = await db
              .update(incomingCalls)
              .set({
                notes: updatedNotes + ' | Call ended automatically after disposition',
                status: 'ended', // Automatically end the call when dispositioned
                endedAt: new Date(),
                timestamp: new Date(timestamp || Date.now())
              })
              .where(eq(incomingCalls.id, parseInt(callId)))
              .returning();
            
            if (updatedCall.length > 0) {
              vdpResolutionSuccess = true;
              vdpUpdateResult = updatedCall[0];
              console.log(`✅ STEP 1 SUCCESS: VDP call ${callId} disposition updated in vdp_calls table`);
            }
          } else {
            console.warn(`⚠️ STEP 1 FAILED: No VDP call record found for ID ${callId}`);
          }
        } catch (vdpError) {
          console.error('❌ STEP 1 ERROR:', vdpError);
        }
      } else {
        console.log('⚠️ STEP 1 SKIPPED: No callId provided');
      }
      
      // STEP 2: If VDP resolution failed, create/update lead in masterlead as fallback
      let masterleadSuccess = false;
      if (!vdpResolutionSuccess && leadName) {
        try {
          console.log(`📝 STEP 2: VDP resolution failed, creating/updating lead in masterlead for ${leadName}`);
          
          // Extract lead info from VDP call
          const leadFirstName = leadName.split(' ')[0] || leadName;
          const leadLastName = leadName.split(' ').slice(1).join(' ') || '';
          
          // Get lead ID from callId if available (format: VDP_LEADID_TIMESTAMP)
          let leadId = null;
          if (callId && typeof callId === 'string' && callId.includes('VDP_')) {
            const parts = callId.split('_');
            if (parts.length >= 2) {
              leadId = parts[1]; // Extract lead ID from VDP_18137331_1755718983305
            }
          }
          
          // Create lead in Supabase masterlead table
          const { data: newLead, error } = await supabaseClient
            .from('masterlead')
            .upsert({
              taalk_lead_id: leadId,
              name: leadName,
              firstname: leadFirstName,
              lastname: leadLastName,
              market: 'Globe Market', // Default from VDP
              taalk_market: 'Globe Market',
              ishotlead: false,
              status: 'pending',
              cnresolution: disposition, // Save disposition here
              agent_email: userEmail,
              cn_email: userEmail,
              updated_at: new Date().toISOString(),
              created_at: new Date().toISOString()
            }, { 
              onConflict: 'taalk_lead_id',
              ignoreDuplicates: false 
            })
            .select()
            .single();
          
          if (!error && newLead) {
            masterleadSuccess = true;
            console.log(`✅ STEP 2 SUCCESS: Lead created/updated in masterlead: ${leadName} with disposition ${disposition}`);
          } else {
            console.error('❌ STEP 2 ERROR:', error);
          }
        } catch (masterleadError) {
          console.error('❌ STEP 2 ERROR:', masterleadError);
        }
      }
      
      // Always log to outbound calls for tracking (regardless of which step succeeded)
      try {
        const { outboundCalls } = await import('@shared/schema');
        await db.insert(outboundCalls).values({
          leadId: leadName,
          phoneNumber: 'VDP-CALL',
          agentEmail: userEmail,
          callStartedAt: new Date(timestamp || Date.now()),
          endTime: new Date(),
          callDisposition: disposition,
          notes: notes || `VDP Call Disposition: ${disposition}`,
          callType: 'VDP',
          leadFirstName: leadName?.split(' ')[0] || leadName || 'VDP',
          leadLastName: leadName?.split(' ').slice(1).join(' ') || '',
          twilioCallSid: `VDP_${callId}_${Date.now()}`,
          requiresDisposition: false // Already dispositioned
        });
        console.log('✅ VDP disposition logged to outbound_calls for tracking');
      } catch (trackingError) {
        console.warn('⚠️ Failed to log to outbound_calls:', trackingError);
      }
      
      // Determine response based on success
      if (vdpResolutionSuccess) {
        console.log(`✅ FINAL SUCCESS: VDP disposition resolved via STEP 1 (vdp_calls table)`);
        res.json({
          success: true,
          method: 'vdp_calls',
          disposition,
          callId,
          leadName,
          message: 'VDP call disposition saved successfully in vdp_calls table'
        });
      } else if (masterleadSuccess) {
        console.log(`✅ FINAL SUCCESS: VDP disposition resolved via STEP 2 (masterlead fallback)`);
        res.json({
          success: true,
          method: 'masterlead_fallback',
          disposition,
          leadName,
          message: 'VDP call disposition saved as fallback in masterlead table'
        });
      } else {
        console.error('❌ FINAL FAILURE: Both VDP resolution steps failed');
        res.status(500).json({
          error: 'Failed to save VDP disposition in both vdp_calls and masterlead tables',
          details: 'Both resolution methods failed'
        });
      }
      
    } catch (error) {
      console.error('❌ Critical error in VDP disposition:', error);
      res.status(500).json({
        error: 'Failed to save VDP disposition',
        details: error instanceof Error ? error.message : 'Unknown error'
      });
    }
  });

