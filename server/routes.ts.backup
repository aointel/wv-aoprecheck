  // Generate AI summary for a completed presentation
  app.post("/api/presentations/:sessionId/generate-summary", async (req, res) => {
    try {
      const { sessionId } = req.params;
      
      // Get all screenshots for this session
      const { data: screenshots, error: screenshotsError } = await supabaseAdmin
        .from('presentation_screenshots')
        .select('screenshot_data')
        .eq('session_id', sessionId)
        .order('sequence_number', { ascending: true });

      if (screenshotsError) throw screenshotsError;

      if (!screenshots || screenshots.length === 0) {
        return res.status(400).json({ error: 'No screenshots found for this session' });
      }

      // Use OpenAI to generate summary from screenshots
      const { hpproAnalyzer } = await import('./hppro-analyzer');
      
      // Analyze all screenshots and compile a comprehensive summary
      const analyses = [];
      for (const screenshot of screenshots.slice(0, 10)) { // Limit to first 10 for cost
        const analysis = await hpproAnalyzer.analyzeScreenshot(screenshot.screenshot_data);
        analyses.push(analysis);
      }

      // Generate final summary
      const summary = `Presentation Summary:
- Total Screenshots Analyzed: ${analyses.length}
- Phases Detected: ${analyses.map(a => a.milestoneName).filter((v, i, a) => a.indexOf(v) === i).join(', ')}
- Client Data: ${analyses.find(a => a.leadData)?.leadData ? 
  `${analyses.find(a => a.leadData)?.leadData?.firstName || ''} ${analyses.find(a => a.leadData)?.leadData?.lastName || ''} - ${analyses.find(a => a.leadData)?.leadData?.phone || ''}`.trim() : 'Not captured'}
- Products Discussed: ${analyses.flatMap(a => a.productData || []).map(p => p.productName).filter(Boolean).join(', ') || 'None'}
- Quotes Generated: ${analyses.flatMap(a => a.quoteData || []).length}
- Enrollment Status: ${analyses.find(a => a.enrollmentData)?.enrollmentData?.esignatureComplete ? 'Complete' : 'Incomplete'}`;

      // Update the session with the summary
      const { error: updateError } = await supabaseAdmin
        .from('presentation_sessions')
        .update({ ai_summary: summary })
        .eq('id', sessionId);

      if (updateError) throw updateError;

      res.json({ success: true, summary });
    } catch (error: any) {
      console.error('❌ Error generating summary:', error);
      res.status(500).json({ error: error.message });
    }
  });

  // Get agent presentation history (split into active and recent)
  app.get("/api/presentations/agent/:agentEmail", async (req, res) => {
    try {
      const { agentEmail } = req.params;
      const limit = parseInt(req.query.limit as string) || 50;
      
      // Get all presentations from Supabase
      const { data: sessions, error: sessionsError } = await supabaseAdmin
        .from('presentation_sessions')
        .select('*')
        .eq('agent_email', agentEmail)
        .order('started_at', { ascending: false })
        .limit(limit);

      if (sessionsError) throw sessionsError;

      // Get scraped data and screenshots using electron_session_id
      const electronSessionIds = sessions?.map(s => s.electron_session_id).filter(Boolean) || [];
      const sessionUUIDs = sessions?.map(s => s.id) || [];
      
      const { data: scrapedData } = await supabaseAdmin
        .from('scraped_presentation_data')
        .select('*')
        .or(`session_id.in.(${electronSessionIds.map(id => `"${id}"`).join(',')}),session_id.in.(${sessionUUIDs.map(id => `"${id}"`).join(',')})`);
      
      const { data: screenshots } = await supabaseAdmin
        .from('presentation_screenshots')
        .select('*')
        .in('session_id', sessionUUIDs);

      // Attach scraped data and screenshots to each session
      const allPresentations = sessions?.map(session => ({
        ...session,
        scraped_data: scrapedData?.filter(d => 
          d.session_id === session.electron_session_id || d.session_id === session.id
        ) || [],
        screenshots: screenshots?.filter(s => s.session_id === session.id) || []
      }));

      if (!allPresentations) throw new Error('No data returned');

      // Helper function to check if presentation is valid (exclude only completely empty sessions)
      const isValidPresentation = (p: any) => {
        // Parse client_data to check if form was filled (state, market type, etc.)
        let clientData = p.client_data || {};
        if (typeof clientData === 'string') {
          try {
            clientData = JSON.parse(clientData);
          } catch (e) {
            clientData = {};
          }
        }
        
        // Check if they filled in any setup data (state, market type, etc.)
        const hasSetupData = !!(
          clientData.state ||          // State selected
          clientData.leadType ||       // Market type selected
          clientData.firstName ||      // Client name entered
          clientData.lastName ||
          clientData.phone ||
          clientData.city
        );
        
        // Check if they have any screenshots (captured any screens)
        const hasScreenshots = (p.screenshots?.length || p.screenshot_count || 0) > 0;
        
        // Check if they have scraped data (the real tracking data we care about)
        const hasScrapedData = (p.scraped_data?.length || 0) > 0;
        
        // Parse current_phase to see if tracking happened
        let currentPhase = p.current_phase || {};
        if (typeof currentPhase === 'string') {
          try {
            currentPhase = JSON.parse(currentPhase);
          } catch (e) {
            currentPhase = {};
          }
        }
        const hasPhaseTracking = !!(currentPhase.phase);
        
        // Only exclude sessions with NO data at all (truly empty)
        // If they have ANY of: setup data, screenshots, scraped data, or phase tracking = valid presentation
        return hasSetupData || hasScreenshots || hasScrapedData || hasPhaseTracking;
      };

      // Helper function to parse JSON fields and ensure correct data structure
      const parsePresentation = (p: any) => {
        // Parse client_data if it's a string
        let clientData = p.client_data || {};
        if (typeof clientData === 'string') {
          try {
            clientData = JSON.parse(clientData);
          } catch (e) {
            console.warn('Failed to parse client_data:', e);
            clientData = {};
          }
        }

        // Parse current_phase if it's a string
        let currentPhase = p.current_phase || { phase: 'unknown', timestamp: p.started_at };
        if (typeof currentPhase === 'string') {
          try {
            currentPhase = JSON.parse(currentPhase);
          } catch (e) {
            console.warn('Failed to parse current_phase:', e);
            currentPhase = { phase: 'unknown', timestamp: p.started_at };
          }
        }

        return {
          ...p,
          client_data: clientData,
          current_phase: currentPhase,
          screenshot_count: p.screenshot_count || 0
        };
      };

      // Filter out invalid presentations (never actually started)
      const validPresentations = (allPresentations || []).filter(isValidPresentation);
      
      console.log(`📊 Filtered presentations: ${allPresentations?.length || 0} total → ${validPresentations.length} valid (removed ${(allPresentations?.length || 0) - validPresentations.length} empty sessions)`);

      // Split into active (no ended_at) and recent (has ended_at)
      const active = validPresentations.filter(p => !p.ended_at);
      const recent = validPresentations.filter(p => p.ended_at).slice(0, 20);

      // Calculate duration for active presentations
      const enrichedActive = active.map(p => ({
        ...parsePresentation(p),
        duration_seconds: Math.floor((Date.now() - new Date(p.started_at).getTime()) / 1000),
        status: 'active' as const
      }));

      // Calculate duration for recent presentations
      const enrichedRecent = recent.map(p => ({
        ...parsePresentation(p),
        duration_seconds: p.ended_at 
          ? Math.floor((new Date(p.ended_at).getTime() - new Date(p.started_at).getTime()) / 1000)
          : 0,
        status: p.ended_at ? 'completed' as const : 'abandoned' as const
      }));
      
      res.json({ 
        success: true, 
        active: enrichedActive,
        recent: enrichedRecent,
        presentations: [...enrichedActive, ...enrichedRecent] // Add combined list for PresentationReview
      });
    } catch (error: any) {
      console.error('❌ Error getting agent presentations:', error);
      res.status(500).json({ error: error.message });
    }
  });

  // DEBUG: Get presentation phase/milestone details
  app.get("/api/presentations/debug/:agentEmail", async (req, res) => {
    try {
      const { agentEmail } = req.params;
      
      // Get all presentations with phase data
      const { data: presentations, error } = await supabaseAdmin
        .from('presentation_sessions')
        .select('session_id, started_at, ended_at, current_phase, phase_updated_at, client_data, screenshot_count')
        .eq('agent_email', agentEmail)
        .order('started_at', { ascending: false })
        .limit(20);

      if (error) throw error;

      // Parse and analyze each presentation
      const analysis = (presentations || []).map(p => {
        let clientData = p.client_data || {};
        if (typeof clientData === 'string') {
          try { clientData = JSON.parse(clientData); } catch (e) { clientData = {}; }
        }
        
        const hasSetupData = !!(clientData.state || clientData.leadType || clientData.firstName || clientData.lastName || clientData.phone || clientData.city);
        const hasScreenshots = (p.screenshot_count || 0) > 0;
        const hasPhase = !!(p.current_phase);
        
        const wouldBeFiltered = !(hasSetupData || hasScreenshots || hasPhase);
        
        return {
          session_id: p.session_id,
          started_at: p.started_at,
          ended_at: p.ended_at,
          current_phase: p.current_phase || 'NONE',
          phase_updated_at: p.phase_updated_at,
          screenshot_count: p.screenshot_count || 0,
          has_setup_data: hasSetupData,
          has_screenshots: hasScreenshots,
          has_phase_tracking: hasPhase,
          WOULD_BE_FILTERED: wouldBeFiltered,
          client_data_summary: {
            firstName: clientData.firstName,
            lastName: clientData.lastName,
            state: clientData.state,
            leadType: clientData.leadType,
            phone: clientData.phone
          }
        };
      });

      const totalCount = analysis.length;
      const filteredCount = analysis.filter(a => a.WOULD_BE_FILTERED).length;
      const validCount = totalCount - filteredCount;

      res.json({
        success: true,
        agent_email: agentEmail,
        summary: {
          total_presentations: totalCount,
          valid_presentations: validCount,
          filtered_out: filteredCount,
          with_phase_tracking: analysis.filter(a => a.has_phase_tracking).length,
          with_screenshots: analysis.filter(a => a.has_screenshots).length,
          with_setup_data: analysis.filter(a => a.has_setup_data).length
        },
        presentations: analysis
      });
    } catch (error: any) {
      console.error('❌ Error getting debug data:', error);
      res.status(500).json({ error: error.message });
    }
  });

  // ==================== CALL COACHING (LISTEN & WHISPER) ====================
  
  // Join a live call as a coach
  app.post('/api/call-coaching/join', async (req, res) => {
    try {
      const { callSid, managerEmail, managerPhone, mode } = req.body;
      
      if (!callSid || !managerEmail || !managerPhone) {
        return res.status(400).json({ error: 'callSid, managerEmail, and managerPhone required' });
      }
      
      const { callCoachingService } = await import('./call-coaching.js');
      const result = await callCoachingService.joinCall({
        callSid,
        managerEmail,
        managerPhone,
        mode: mode || 'listen'
      });
      
      res.json(result);
    } catch (error: any) {
      console.error('❌ Error joining call as coach:', error);
      res.status(500).json({ error: error.message });
    }
  });

  // Switch coaching mode (listen → whisper → barge)
  app.post('/api/call-coaching/switch-mode', async (req, res) => {
    try {
      const { managerEmail, mode } = req.body;
      
      if (!managerEmail || !mode) {
        return res.status(400).json({ error: 'managerEmail and mode required' });
      }
      
      const { callCoachingService } = await import('./call-coaching.js');
      const success = await callCoachingService.switchMode(managerEmail, mode);
      
      res.json({ success });
    } catch (error: any) {
      console.error('❌ Error switching coaching mode:', error);
      res.status(500).json({ error: error.message });
    }
  });

  // Leave coaching session
  app.post('/api/call-coaching/leave', async (req, res) => {
    try {
      const { managerEmail } = req.body;
      
      if (!managerEmail) {
        return res.status(400).json({ error: 'managerEmail required' });
      }
      
      const { callCoachingService } = await import('./call-coaching.js');
      const success = await callCoachingService.leaveCall(managerEmail);
      
      res.json({ success });
    } catch (error: any) {
      console.error('❌ Error leaving coaching session:', error);
      res.status(500).json({ error: error.message });
    }
  });

  // Get active coaching sessions
  app.get('/api/call-coaching/active', async (req, res) => {
    try {
      const { callCoachingService } = await import('./call-coaching.js');
      const sessions = callCoachingService.getAllActiveSessions();
      
      res.json({ success: true, sessions });
    } catch (error: any) {
      console.error('❌ Error getting coaching sessions:', error);
      res.status(500).json({ error: error.message });
    }
  });

  // ==================== CALL RECORDINGS & AI SUMMARIES ====================
  
  // Get recordings for an agent
  app.get('/api/call-recordings/agent/:email', async (req, res) => {
    try {
      const { email } = req.params;
      const limit = parseInt(req.query.limit as string) || 10;
      
      const { callRecordingProcessor } = await import('./call-recording-processor.js');
      const recordings = await callRecordingProcessor.getRecordingsForAgent(email, limit);
      
      res.json({ success: true, recordings });
    } catch (error: any) {
      console.error('❌ Error fetching recordings:', error);
      res.status(500).json({ error: error.message });
    }
  });

  // Get recording for a specific call
  app.get('/api/call-recordings/call/:callSid', async (req, res) => {
    try {
      const { callSid } = req.params;
      
      const { callRecordingProcessor } = await import('./call-recording-processor.js');
      const recording = await callRecordingProcessor.getRecordingByCallSid(callSid);
      
      if (!recording) {
        return res.status(404).json({ error: 'Recording not found' });
      }
      
      res.json({ success: true, recording });
    } catch (error: any) {
      console.error('❌ Error fetching recording:', error);
      res.status(500).json({ error: error.message });
    }
  });

  // Manually trigger recording processing for a specific call
  app.post('/api/call-recordings/process/:callSid', async (req, res) => {
    try {
      const { callSid } = req.params;
      
      console.log(`🎙️ Manually triggering recording processing for call ${callSid}`);
      
      // This will be handled by the poller automatically, but we can also trigger it manually
      res.json({ 
        success: true, 
        message: 'Recording will be processed automatically by the poller' 
      });
      
    } catch (error: any) {
      console.error('❌ Error processing recording:', error);
      res.status(500).json({ error: error.message });
    }
  });

  // Video upload endpoint for presentation recordings
  const upload = multer({
    storage: multer.memoryStorage(),
    limits: {
      fileSize: 500 * 1024 * 1024 // 500MB max file size
    }
  });

  app.post("/api/presentations/upload-video", upload.single('video'), async (req, res) => {
    try {
      if (!req.file) {
        return res.status(400).json({ error: 'No video file uploaded' });
      }

      const { sessionId } = req.body;
      if (!sessionId) {
        return res.status(400).json({ error: 'Session ID required' });
      }

      console.log('📹 Uploading video for session:', sessionId, '- Size:', (req.file.size / 1024 / 1024).toFixed(2), 'MB');

      // Upload to Supabase Storage
      const filename = `${sessionId}-${Date.now()}.webm`;
      const { supabaseAdmin } = await import('./supabase');
      
      const { data: uploadData, error: uploadError } = await supabaseAdmin
        .storage
        .from('presentation-recordings')
        .upload(filename, req.file.buffer, {
          contentType: 'video/webm',
          cacheControl: '3600'
        });

      if (uploadError) {
        console.error('❌ Supabase upload error:', uploadError);
        throw uploadError;
      }

      // Get public URL
      const { data: urlData } = supabaseAdmin
        .storage
        .from('presentation-recordings')
        .getPublicUrl(filename);

      const videoUrl = urlData.publicUrl;
      console.log('✅ Video uploaded to Supabase Storage:', videoUrl);

      // Update session with video URL
      const { presentationTracker } = await import('./presentation-tracker');
      await presentationTracker.updateVideoUrl(sessionId, videoUrl);

      res.json({
        success: true,
        videoUrl,
        fileSize: req.file.size
      });
    } catch (error: any) {
      console.error('❌ Error uploading video:', error);
      res.status(500).json({ error: error.message });
    }
  });

// ============================================
// PAGE SCRAPING ROUTES (Frontend Injection)
// ============================================
app.use('/api/presentations', scrapeRoutes);
app.use('/api/presentations', scrapeAnalysisRoutes);
app.use('/api/presentations', screenshotAnalysisRoutes);

// ============================================
// AO MEET ROUTES (Appointments/Scheduled Presentations)
// ============================================
app.use('/api/meets', meetsRoutes);

// ============================================
// WAR STATS ROUTES (Daily Activity Tracking)
// ============================================
app.use('/api/war', warStatsRoutes);

  // Start server and return 
  const httpServer = createServer(app);
  
  return httpServer;
}
