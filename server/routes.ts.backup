  app.post("/api/twilio/call-status", async (req, res) => {
    const { CallSid, CallStatus, CallDuration, From, To, Direction } = req.body;
    
    console.log('📞 Twilio call status update:', {
      callSid: CallSid,
      status: CallStatus,
      duration: CallDuration,
      from: From,
      to: To,
      direction: Direction
    });
    
    // Trigger hotlead assignment webhook when outbound call is completed
    if (CallStatus === 'completed' && Direction === 'outbound-api' && From) {
      console.log(`🔥 OUTBOUND CALL COMPLETED: Checking agent for hotlead assignment`);
      
      try {
        // Find agent email from phone number via customers table
        const { data: customer } = await supabase
          .from('customers')
          .select('company_email, first_name, last_name')
          .eq('phone', From.replace(/[^\d]/g, ''))
          .single();
        
        if (customer?.company_email) {
          console.log(`👤 Found agent: ${customer.company_email} for phone ${From}`);
          
          // Get agent's total completed calls from today
          const { data: todaysCalls } = await supabase
            .from('twilio_call_logs')
            .select('*', { count: 'exact' })
            .eq('from_number', From)
            .eq('call_status', 'completed')
            .eq('direction', 'outbound-api')
            .gte('date_created', new Date().toISOString().split('T')[0]); // Today's calls
          
          const todaysCallCount = todaysCalls?.length || 0;
          console.log(`📊 Agent ${customer.company_email} has ${todaysCallCount} completed calls today`);
          
          // Check for hotlead eligibility (trigger webhook if needed)
          await checkAgentForHotleadAssignment(customer.company_email, todaysCallCount);
          
        } else {
          console.log(`❓ No agent found for phone number: ${From}`);
        }
        
      } catch (webhookError) {
        console.error('❌ Hotlead webhook trigger error:', webhookError);
      }
    }
    
    res.sendStatus(200);
  });

  // Conference connect endpoint for WebRTC calling
  app.post("/api/twilio/conference-connect", (req, res) => {
    console.log('📞 Conference connect endpoint called:', req.body);
    const { CallSid, From, To } = req.body;
    
    const VoiceResponse = twilio.twiml.VoiceResponse;
    const twiml = new VoiceResponse();
    
    // Connect the incoming call (lead) to the conference
    const dial = twiml.dial();
    // This endpoint needs dynamic conference name - should not be used for outbound dialer
    const conference = dial.conference('LEGACY-ENDPOINT-DO-NOT-USE', {
      startConferenceOnEnter: false, // Don't start until agent joins
      endConferenceOnExit: true,     // End when lead leaves
      beep: false,
      waitUrl: 'http://twimlets.com/holdmusic?Bucket=com.twilio.music.soft-rock',
      maxParticipants: 20
    });
    
    console.log('📞 Connecting lead to conference:', To);
    res.type('text/xml');
    res.send(twiml.toString());
  });

