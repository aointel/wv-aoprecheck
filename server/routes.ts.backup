  // Get team billing data for MGAs/RGAs
  app.get('/api/billing/team-charges/:dateRange?', async (req, res) => {
    try {
      const userEmail = req.query.userEmail as string;
      console.log(`👥 TEAM BILLING API HIT - user: ${userEmail}`);
      
      if (!userEmail) {
        return res.status(400).json({ error: 'User email is required' });
      }
      
      // Check user's role and get their team
      const { data: userRole } = await supabaseAdmin
        ?.from('mga_rga_directory')
        .select('associate_id, role')
        .eq('email', userEmail.toLowerCase())
        .maybeSingle();
      
      if (!userRole) {
        return res.status(403).json({ error: 'User is not an MGA/RGA' });
      }
      
      // Get team agent emails
      let teamEmails: string[] = [];
      
      if (userRole.role === 'MGA' || userRole.role === 'BOTH') {
        // Get all agents under this MGA
        const { data: mgaAgents } = await supabaseAdmin
          ?.from('agent_hierarchy')
          .select('agent_email')
          .eq('mga_associate_id', userRole.associate_id);
        
        if (mgaAgents) {
          teamEmails = mgaAgents.map(a => a.agent_email?.toLowerCase()).filter(Boolean);
        }
      } else if (userRole.role === 'RGA') {
        // Get all agents under this RGA's managed MGAs
        const { data: rgaAgents } = await supabaseAdmin
          ?.from('agent_hierarchy')
          .select('agent_email')
          .eq('rga_associate_id', userRole.associate_id);
        
        if (rgaAgents) {
          teamEmails = rgaAgents.map(a => a.agent_email?.toLowerCase()).filter(Boolean);
        }
      }
      
      // Add the MGA/RGA themselves
      teamEmails.push(userEmail.toLowerCase());
      teamEmails = [...new Set(teamEmails)];
      
      console.log(`👥 Team billing for ${userEmail} (${userRole.role}): ${teamEmails.length} agents`);
      
      // Calculate date range (same as individual billing)
      const dateRange = req.params.dateRange || 'last7days';
      const now = new Date();
      let startDate: Date;
      
      switch (dateRange) {
        case 'last7days': startDate = subDays(now, 7); break;
        case 'last30days': startDate = subDays(now, 30); break;
        case 'thisweek': startDate = startOfWeek(now); break;
        case 'thismonth': startDate = startOfMonth(now); break;
        case 'lastmonth': startDate = startOfMonth(subDays(now, 30)); break;
        default: startDate = subDays(now, 7);
      }
      
      const startDateStr = startDate.toISOString();
      
      // Query billing_transactions for all team members
      const { data: teamTransactions, error: teamTxnError } = await supabaseAdmin
        ?.from('billing_transactions')
        .select('*')
        .in('agent_email', teamEmails)
        .gte('transaction_date', startDateStr)
        .order('transaction_date', { ascending: false }) || { data: [], error: null };
      
      if (teamTxnError) {
        console.error('❌ Error fetching team billing transactions:', teamTxnError);
        return res.status(500).json({ error: 'Failed to fetch team billing transactions' });
      }
      
      console.log(`✅ Found ${teamTransactions?.length || 0} team billing transactions`);
      
      // Transform to billing call format
      const typeMap = {
        'precheck': { type: 'AOI_PRECHECK', icon: '🛡️', color: 'purple' },
        'recruit': { type: 'AOI_RECRUIT', icon: '👥', color: 'green' },
        'connect': { type: 'AOI_CONNECT', icon: '📱', color: 'blue' },
        'purchase': { type: 'PURCHASE', icon: '💳', color: 'green' }
      };
      
      const allTeamCalls = (teamTransactions || []).map(txn => {
        const config = typeMap[txn.transaction_type] || { type: 'UNKNOWN', icon: '❓', color: 'gray' };
        
        return {
          id: txn.transaction_id,
          type: config.type,
          phone: txn.lead_phone || 'N/A',
          leadName: txn.lead_name || 'Unknown',
          agentId: txn.agent_associate_id || txn.agent_email?.split('@')[0] || 'N/A',
          agentName: txn.agent_name || txn.agent_email?.split('@')[0] || 'N/A',
          billingAmount: txn.amount_usd,
          creditsDeducted: txn.credits_charged,
          callAttempts: [],
          finalStatus: 'COMPLETED',
          chargedAt: new Date(txn.transaction_date).toLocaleDateString(),
          transactionDate: txn.transaction_date,
          icon: config.icon,
          color: config.color
        };
      });
      
      // Get total remaining credits for all team members
      for (const teamEmail of teamEmails) {
        const { data: agentCredits } = await supabaseAdmin
          ?.from('user_credit')
          .select('credits_remaining')
          .eq('email', teamEmail)
          .maybeSingle() || { data: null };
        
        if (agentCredits) {
          totalRemainingCredits += agentCredits.credits_remaining || 0;
        }
      }
      
      const totalCalls = allTeamCalls.filter(c => c.creditsDeducted > 0).length; // Only deductions
      const totalCharges = allTeamCalls.reduce((sum, call) => sum + (call.billingAmount || 0), 0);
      const totalCreditsUsed = allTeamCalls.filter(c => c.creditsDeducted > 0).reduce((sum, call) => sum + call.creditsDeducted, 0);
      
      console.log(`✅ Team billing: ${totalCalls} total calls, $${totalCharges}, ${totalCreditsUsed} credits used, ${totalRemainingCredits} remaining`);
      
      res.json({
        success: true,
        calls: allTeamCalls,
        totalCalls,
        totalCharges,
        totalCreditsUsed,
        totalCreditsEarned: 0,
        remainingCredits: totalRemainingCredits,
        teamSize: teamEmails.length,
        dateRange: req.params.dateRange || 'last7days'
      });
    } catch (error) {
      console.error('❌ Error fetching team billing:', error);
      res.status(500).json({ error: 'Failed to fetch team billing' });
    }
  });

  // Get aggregate outbound stats
  app.get("/api/live-call-board/outbound-stats", async (req, res) => {
    try {
      const { mgaFilter, rgaFilter } = req.query;
      const userEmail = (req.query.userEmail as string) || (req.headers['x-user-email'] as string);
      
      // Get team emails if filtering is needed
      let teamEmails: string[] | null = null;
      let enforcedMgaFilter = mgaFilter;
      let userRoleData: { associate_id: number; role: string; email: string } | null = null;
      
      // Apply same role-based filtering as agents endpoint
      if (userEmail && !userEmail.includes('cnsysop') && !userEmail.includes('richiealtig')) {
        const { data: userRole } = await supabaseAdmin
          ?.from('mga_rga_directory')
          .select('associate_id, role, email')
          .eq('email', userEmail.toLowerCase())
          .maybeSingle();
        
        userRoleData = userRole || null;
        
        if (userRole?.role === 'MGA') {
          enforcedMgaFilter = userRole.associate_id.toString();
        }
      }
      
      // Build team email list based on filters
      if (userRoleData && (userRoleData.role === 'RGA' || userRoleData.role === 'BOTH') && !enforcedMgaFilter && !rgaFilter) {
        // RGA with no filter - get all their managed MGAs' agents
        const { data: rgaAgents } = await supabaseAdmin
          ?.from('agent_hierarchy')
          .select('agent_email')
          .eq('rga_associate_id', userRoleData.associate_id);
        
        if (rgaAgents) {
          teamEmails = rgaAgents.map(a => a.agent_email?.toLowerCase()).filter(Boolean);
          if (userEmail) teamEmails.push(userEmail.toLowerCase());
        }
      } else if (enforcedMgaFilter || rgaFilter) {
        // Specific filter applied
        teamEmails = [];
        
        if (enforcedMgaFilter) {
          const { data } = await supabaseAdmin
            ?.from('agent_hierarchy')
            .select('agent_email')
            .eq('mga_associate_id', parseInt(enforcedMgaFilter as string));
          
          if (data) {
            const emails = data.map(a => a.agent_email?.toLowerCase()).filter(Boolean);
            teamEmails = [...teamEmails, ...emails];
          }
        }
        
        if (rgaFilter) {
          const { data } = await supabaseAdmin
            ?.from('agent_hierarchy')
            .select('agent_email')
            .eq('rga_associate_id', parseInt(rgaFilter as string));
          
          if (data) {
            const emails = data.map(a => a.agent_email?.toLowerCase()).filter(Boolean);
            teamEmails = [...teamEmails, ...emails];
          }
        }
        
        // Add user's own email
        if (userRoleData && userEmail) {
          teamEmails.push(userEmail.toLowerCase());
        }
        
        teamEmails = [...new Set(teamEmails)];
      }
      
      // Get stats from masterlead - TODAY ONLY
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      
      console.log(`📊 Outbound stats - filtering by ${teamEmails ? teamEmails.length + ' team emails' : 'all agents'}`);
      
      // Build queries with optional email filter
      let dialedQuery = supabaseAdmin
        ?.from('masterlead')
        .select('*', { count: 'exact', head: true })
        .gte('last_contacted', today.toISOString());
      
      let bookedQuery = supabaseAdmin
        ?.from('masterlead')
        .select('*', { count: 'exact', head: true })
        .eq('cnresolution', 'booked')
        .gte('last_contacted', today.toISOString());
      
      let reachedQuery = supabaseAdmin
        ?.from('masterlead')
        .select('*', { count: 'exact', head: true })
        .not('cnresolution', 'in', '(pending,called,wrong number)')
        .not('cnresolution', 'is', null)
        .gte('last_contacted', today.toISOString());
      
      // Apply team filter if present
      if (teamEmails && teamEmails.length > 0) {
        dialedQuery = dialedQuery?.in('cn_email', teamEmails);
        bookedQuery = bookedQuery?.in('cn_email', teamEmails);
        reachedQuery = reachedQuery?.in('cn_email', teamEmails);
      }
      
      const { count: totalDialed, error: dialedError } = await dialedQuery || { count: 0, error: null };
      const { count: totalBooked, error: bookedError } = await bookedQuery || { count: 0, error: null };
      const { count: totalReached, error: reachedError } = await reachedQuery || { count: 0, error: null };

      if (dialedError || bookedError || reachedError) {
        console.error('❌ Error fetching masterlead stats:', dialedError || bookedError || reachedError);
        return res.json({ totalDialed: 0, totalReached: 0, totalBooked: 0 });
      }

      const stats = { totalDialed, totalReached, totalBooked };
      
      console.log(`📊 Live Board: Outbound stats (TODAY):`, stats);
      
      res.json(stats);
    } catch (error) {
      console.error('❌ Error fetching outbound stats:', error);
      res.status(500).json({ error: 'Failed to fetch outbound stats' });
    }
  });

  // Get outbound stats for specific agent
  app.get("/api/live-call-board/agent-outbound-stats/:email", async (req, res) => {
    try {
      const { email } = req.params;
      const { callConnectorTracker } = await import('./call-connector-tracker');
