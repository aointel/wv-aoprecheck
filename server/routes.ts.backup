  // Get call statistics for current user or all users (admin)
  app.get("/api/twilio-call-stats", async (req, res) => {
    if (!req.isAuthenticated()) {
      return res.status(401).json({ error: "Authentication required" });
    }

    try {
      const { startDate, endDate, allUsers } = req.query;
      
      // Only allow allUsers for admin
      const ownerEmail = (allUsers === 'true' && req.user.role === 'super_admin') 
        ? undefined 
        : req.user.email;
      
      const stats = await TwilioCallLogger.getCallStats(
        ownerEmail,
        startDate as string,
        endDate as string
      );
      
      res.json({ 
        success: true, 
        stats,
        scope: ownerEmail || 'all_users'
      });
      
    } catch (error) {
      console.error('❌ Error fetching call stats:', error);
      res.status(500).json({ error: "Failed to fetch call statistics" });
    }
  });
  
