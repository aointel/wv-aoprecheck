  // Start video (mark as started)
  app.post("/api/walkthrough/start", async (req, res) => {
    try {
      const { userEmail, videoId } = req.body;
      
      if (!userEmail || !videoId) {
        return res.status(400).json({ error: "Missing userEmail or videoId" });
      }

      // Check if progress record exists
      const existing = await db.select().from(schema.walkthroughProgress)
        .where(and(
          schema.walkthroughProgress.userEmail.eq(userEmail),
          schema.walkthroughProgress.videoId.eq(videoId)
        ))
        .limit(1);

      if (existing.length === 0) {
        // Create new progress record
        await db.insert(schema.walkthroughProgress).values({
          userEmail,
          videoId,
          hasStarted: true,
          lastWatchedAt: new Date(),
        });
      } else {
        // Update existing record
        await db.update(schema.walkthroughProgress)
          .set({
            hasStarted: true,
            lastWatchedAt: new Date(),
            updatedAt: new Date(),
          })
          .where(and(
            schema.walkthroughProgress.userEmail.eq(userEmail),
            schema.walkthroughProgress.videoId.eq(videoId)
          ));
      }

      res.json({ success: true });
    } catch (error) {
      console.error("❌ Error starting video:", error);
      res.status(500).json({ error: "Failed to start video" });
    }
  });

  // Update video progress
  app.post("/api/walkthrough/progress", async (req, res) => {
    try {
      const { userEmail, videoId, watchTimeSeconds } = req.body;
      
      if (!userEmail || !videoId || watchTimeSeconds === undefined) {
        return res.status(400).json({ error: "Missing required fields" });
      }

      // Update or insert progress
      const existing = await db.select().from(schema.walkthroughProgress)
        .where(and(
          schema.walkthroughProgress.userEmail.eq(userEmail),
          schema.walkthroughProgress.videoId.eq(videoId)
        ))
        .limit(1);

      if (existing.length === 0) {
        await db.insert(schema.walkthroughProgress).values({
          userEmail,
          videoId,
          hasStarted: true,
          watchTimeSeconds,
          lastWatchedAt: new Date(),
        });
      } else {
        // Only update if new watch time is greater
        if (watchTimeSeconds > existing[0].watchTimeSeconds) {
          await db.update(schema.walkthroughProgress)
            .set({
              watchTimeSeconds,
              lastWatchedAt: new Date(),
              updatedAt: new Date(),
            })
            .where(and(
              schema.walkthroughProgress.userEmail.eq(userEmail),
              schema.walkthroughProgress.videoId.eq(videoId)
            ));
        }
      }

      res.json({ success: true });
    } catch (error) {
      console.error("❌ Error updating video progress:", error);
      res.status(500).json({ error: "Failed to update video progress" });
    }
  });

  // Complete video
  app.post("/api/walkthrough/complete", async (req, res) => {
    try {
      const { userEmail, videoId } = req.body;
      
      if (!userEmail || !videoId) {
        return res.status(400).json({ error: "Missing userEmail or videoId" });
      }

      // Mark video as completed
      await db.update(schema.walkthroughProgress)
        .set({
          hasCompleted: true,
          completedAt: new Date(),
          updatedAt: new Date(),
        })
        .where(and(
          schema.walkthroughProgress.userEmail.eq(userEmail),
          schema.walkthroughProgress.videoId.eq(videoId)
        ));

      // Check if category is now complete and update completion status
      const video = await db.select().from(schema.walkthroughVideos)
        .where(schema.walkthroughVideos.id.eq(videoId))
        .limit(1);

      if (video.length > 0) {
        const category = video[0].category;
        
        // Get all required videos in this category
        const categoryVideos = await db.select().from(schema.walkthroughVideos)
          .where(and(
            schema.walkthroughVideos.category.eq(category),
            schema.walkthroughVideos.isRequired.eq(true),
            schema.walkthroughVideos.isActive.eq(true)
          ));

        // Get completed videos in this category
        const completedVideos = await db.select().from(schema.walkthroughProgress)
          .innerJoin(schema.walkthroughVideos, schema.walkthroughProgress.videoId.eq(schema.walkthroughVideos.id))
          .where(and(
            schema.walkthroughProgress.userEmail.eq(userEmail),
            schema.walkthroughProgress.hasCompleted.eq(true),
            schema.walkthroughVideos.category.eq(category),
            schema.walkthroughVideos.isRequired.eq(true),
            schema.walkthroughVideos.isActive.eq(true)
          ));

        const categoryComplete = completedVideos.length === categoryVideos.length;

        // Update completion status
        const updateData: any = {};
        if (category === "general") updateData.generalWalkthroughCompleted = categoryComplete;
        if (category === "call_connector_pro") updateData.callConnectorProCompleted = categoryComplete;
        if (category === "ao_precheck") updateData.aoPreCheckCompleted = categoryComplete;

        // Check if all categories are complete
        const currentCompletion = await db.select().from(schema.walkthroughCompletion)
          .where(schema.walkthroughCompletion.userEmail.eq(userEmail))
          .limit(1);

        if (currentCompletion.length > 0) {
          const comp = currentCompletion[0];
          const allComplete = 
            (category === "general" ? categoryComplete : comp.generalWalkthroughCompleted) &&
            (category === "call_connector_pro" ? categoryComplete : comp.callConnectorProCompleted) &&
            (category === "ao_precheck" ? categoryComplete : comp.aoPreCheckCompleted);

          updateData.isFullyCompleted = allComplete;
          updateData.updatedAt = new Date();
          
          if (allComplete && !comp.completedAt) {
            updateData.completedAt = new Date();
          }

          await db.update(schema.walkthroughCompletion)
            .set(updateData)
            .where(schema.walkthroughCompletion.userEmail.eq(userEmail));
        }
      }

      res.json({ success: true });
    } catch (error) {
      console.error("❌ Error completing video:", error);
      res.status(500).json({ error: "Failed to complete video" });
    }
  });

  // Grant system access
  app.post("/api/walkthrough/grant-access", async (req, res) => {
    try {
      const { userEmail } = req.body;
      
      if (!userEmail) {
        return res.status(400).json({ error: "Missing userEmail" });
      }

      // Check if user has completed all required training
      const completion = await db.select().from(schema.walkthroughCompletion)
        .where(schema.walkthroughCompletion.userEmail.eq(userEmail))
        .limit(1);

      if (completion.length === 0 || !completion[0].isFullyCompleted) {
        return res.status(400).json({ error: "User has not completed all required training" });
      }

      // Grant system access
      await db.update(schema.walkthroughCompletion)
        .set({
          systemAccessGranted: true,
          firstAccessAt: new Date(),
          updatedAt: new Date(),
        })
        .where(schema.walkthroughCompletion.userEmail.eq(userEmail));

      res.json({ success: true });
    } catch (error) {
      console.error("❌ Error granting system access:", error);
      res.status(500).json({ error: "Failed to grant system access" });
    }
  });

