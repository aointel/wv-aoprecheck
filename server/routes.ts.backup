  // Complete live call (mark as finished)
  app.post("/api/live-call/complete", async (req, res) => {
    try {
      const { agentEmail, disposition, notes } = req.body;
      
      if (!agentEmail || !disposition) {
        return res.status(400).json({ 
          error: 'Required fields: agentEmail, disposition' 
        });
      }

      // Step 1: Mark live call as completed
      await db.execute(sql`
        UPDATE agent_live_call_status 
        SET is_active = false, completed_at = CURRENT_TIMESTAMP, 
            disposition = ${disposition}, notes = ${notes || ''}
        WHERE agent_email = ${agentEmail} AND is_active = true
      `);

      // Step 2: Update the masterlead with disposition
      await db.execute(sql`
        UPDATE masterlead 
        SET status = ${disposition}, updated_at = CURRENT_TIMESTAMP,
            disposition_notes = ${notes || ''}
        WHERE assigned_agent_email = ${agentEmail} 
        AND is_live_call = true 
        AND status = 'NEW'
      `);

      // Step 3: Notify frontend to reconnect Taalk VDP after live call
      console.log(`📞 TAALK VDP CONTROL: Agent ${agentEmail} should reconnect to VDP after live call`);
      // The frontend will handle: TaalkVDP.connect() when call ends

      console.log(`✅ Live call completed for ${agentEmail} with disposition: ${disposition}`);
      
      res.json({
        success: true,
        message: `Live call completed for ${agentEmail}`,
        disposition,
        agentStatus: 'available'
      });

    } catch (error) {
      console.error('❌ Live call completion error:', error);
      res.status(500).json({ error: 'Failed to complete live call' });
    }
  });


