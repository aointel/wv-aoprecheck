  // TWO-WAY OUTBOUND CALLING - Connect Agent Phone + Lead Phone in same conference
  app.post("/api/simple-outbound/call", async (req, res) => {
    try {
      const { leadPhone, leadName, leadState, agentEmail, conferenceName: providedConferenceName, connectAgent } = req.body;
      
      if (!leadPhone) {
        return res.status(400).json({ success: false, error: 'Lead phone number required' });
      }
      
      // Use provided conference name or create unique one
      const conferenceName = providedConferenceName || `ConnectNow-${Date.now()}`;
      
      console.log(`📞 TWO-WAY CALL: Setting up conference ${conferenceName}`);
      
      // Get local presence number for the lead's state
      let fromNumber = TWILIO_PHONE_NUMBER; // Default fallback
      if (leadState && (global as any).localPresenceService) {
        try {
          fromNumber = (global as any).localPresenceService.getLocalNumber(leadState);
          console.log(`🎯 Using local presence number ${fromNumber} for ${leadState} lead`);
        } catch (error) {
          console.warn(`⚠️ Failed to get local number for ${leadState}, using default:`, error);
        }
      } else {
        console.log(`📞 No lead state provided or local presence not available, using default number: ${fromNumber}`);
      }
      
      // Just call the lead - agent connects via WebRTC
      {
        // Original behavior - just call the lead
        console.log(`📞 Calling lead ${leadName} at ${leadPhone} to join conference using ${fromNumber}`);
        
        const call = await twilioClient.calls.create({
          to: leadPhone,
          from: fromNumber,
          url: `https://aoirail-production.up.railway.app/api/simple-outbound/twiml?conference=${encodeURIComponent(conferenceName)}&leadName=${encodeURIComponent(leadName)}`,
          statusCallback: `https://aoirail-production.up.railway.app/api/twilio/call-status`,
          statusCallbackEvent: ['initiated', 'ringing', 'answered', 'completed'],
          statusCallbackMethod: 'POST',
          metadata: {
            agent_email: agentEmail || 'unknown@aoglobelife.com',
            agent_name: agentEmail?.split('@')[0] || 'Unknown Agent',
            call_source: 'simple_outbound',
            lead_phone: leadPhone,
            lead_name: leadName || 'Unknown Lead',
            lead_state: leadState || 'Unknown',
            conference_name: conferenceName,
            timestamp: new Date().toISOString()
          }
        });
        
        console.log(`✅ Lead call initiated - CallSID: ${call.sid}`);
        
        // Store the lead's CallSid for this conference
        if (!global.activeCalls) global.activeCalls = {};
        global.activeCalls[conferenceName] = {
          ...global.activeCalls[conferenceName],
          leadCallSid: call.sid,
          conferenceName: conferenceName,
          leadPhone: leadPhone
        };
        
        console.log(`💾 Stored lead CallSid: ${call.sid} for conference: ${conferenceName}`);
        
        res.json({
          success: true,
          callSid: call.sid,
          conferenceName: conferenceName,
          leadName,
          leadPhone,
          message: `Call initiated to ${leadName}`
        });
      }
      
    } catch (error) {
      console.error('❌ Two-way call failed:', error);
      res.status(500).json({ 
        success: false,
        error: 'Two-way call failed',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });
  
  // TwiML that puts the lead into a conference room
  app.post("/api/simple-outbound/twiml", (req, res) => {
    const conferenceName = req.query.conference || 'ConnectNow-Default';
    const leadName = req.query.leadName || 'Lead';
    
    const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Dial answerOnBridge="true">
    <Conference 
      startConferenceOnEnter="true" 
      endConferenceOnExit="false"
      beep="false"
      maxParticipants="2"
      waitUrl="http://twimlets.com/holdmusic?Bucket=com.twilio.music.soft-rock"
              statusCallback="https://aoirail-production.up.railway.app/api/simple-outbound/conference-status"
      statusCallbackEvent="start join leave end">${conferenceName}</Conference>
  </Dial>
</Response>`;
    
    res.type('text/xml');
    res.send(twiml);
  });
  
  // Status callback for simple calls
  app.post("/api/simple-outbound/status", (req, res) => {
    const { CallStatus, CallSid, To, From } = req.body;
    console.log(`📞 Simple call status: ${CallStatus} - CallSID: ${CallSid} - To: ${To}`);
    
    // Notify frontend when lead hangs up (but don't auto-complete)
    if (CallStatus === 'completed' && To && To.includes('+1')) {
      console.log(`🎯 LEAD HUNG UP: Notifying frontend for ${To}`);
      
      // Find the conference this call belongs to
      const findConferenceForCall = async () => {
        try {
          // Look through global.activeCalls to find which conference this CallSid belongs to
          if (global.activeCalls) {
            for (const [conferenceName, callData] of Object.entries(global.activeCalls)) {
              if (callData.leadCallSid === CallSid) {
                console.log(`🎯 Found conference ${conferenceName} for completed call ${CallSid}`);
                
                // Send WebSocket message to frontend to update UI
                try {
                  if (global.io) {
                    global.io.emit('lead-hung-up', {
                      type: 'lead-hung-up',
                      conferenceName,
                      callSid: CallSid,
                      leadPhone: To
                    });
                    console.log(`📡 Sent 'lead-hung-up' event to frontend for conference: ${conferenceName}`);
                  }
                  
                  // Clean up the stored call data
                  delete global.activeCalls[conferenceName];
                  console.log(`🧹 Cleaned up call data for conference: ${conferenceName}`);
                  
                } catch (error) {
                  console.error(`❌ Error handling lead hangup for ${conferenceName}:`, error);
                }
                break;
              }
            }
          }
        } catch (error) {
          console.error(`❌ Error finding conference for completed call ${CallSid}:`, error);
        }
      };
      
      // Run async function without blocking response
      findConferenceForCall();
    }
    
    res.json({ success: true });
  });
  
