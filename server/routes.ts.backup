  // Call Center Reporting API endpoints
  app.get("/api/reporting/call-center-stats", async (req, res) => {
    try {
      const { timeframe = 'today', agentEmail, teamFilter } = req.query;
      
      console.log(`📊 Getting call center stats - Timeframe: ${timeframe}, Agent: ${agentEmail || 'all'}, Team: ${teamFilter || 'all'}`);
      
      // Get date range based on timeframe
      const now = new Date();
      let startDate: Date;
      
      switch (timeframe) {
        case 'today':
          startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
          break;
        case 'yesterday':
          startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
          break;
        case 'week':
          startDate = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
          break;
        case 'month':
          startDate = new Date(now.getFullYear(), now.getMonth(), 1);
          break;
        default:
          startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      }

      // Query outbound calls for the timeframe
      let query = db.select().from(outboundCallHistory)
        .where(gte(outboundCallHistory.startTime, startDate));
      
      // Add agent filter if specified
      if (agentEmail) {
        query = query.where(and(
          gte(outboundCallHistory.startTime, startDate),
          eq(outboundCallHistory.agentEmail, agentEmail as string)
        ));
      }
      
      const calls = await query;
      
      // Calculate dial/reached/book stats
      const totalDials = calls.length;
      const totalReached = calls.filter(call => 
        call.callStatus === 'completed' && 
        call.callDisposition && 
        !['no-answer', 'voicemail', 'busy'].includes(call.callDisposition)
      ).length;
      const totalBooked = calls.filter(call => 
        call.callDisposition === 'booked'
      ).length;
      
      // Calculate rates
      const reachRate = totalDials > 0 ? ((totalReached / totalDials) * 100).toFixed(2) : '0.00';
      const bookRate = totalReached > 0 ? ((totalBooked / totalReached) * 100).toFixed(2) : '0.00';
      
      // Get agent breakdown
      const agentStats = calls.reduce((acc: any, call) => {
        const agent = call.agentEmail;
        if (!acc[agent]) {
          acc[agent] = {
            agentEmail: agent,
            agentName: call.agentName || agent.split('@')[0],
            totalDials: 0,
            totalReached: 0,
            totalBooked: 0,
            reachRate: '0.00',
            bookRate: '0.00'
          };
        }
        
        acc[agent].totalDials++;
        
        if (call.callStatus === 'completed' && 
            call.callDisposition && 
            !['no-answer', 'voicemail', 'busy'].includes(call.callDisposition)) {
          acc[agent].totalReached++;
        }
        
        if (call.callDisposition === 'booked') {
          acc[agent].totalBooked++;
        }
        
        // Calculate rates
        acc[agent].reachRate = acc[agent].totalDials > 0 ? 
          ((acc[agent].totalReached / acc[agent].totalDials) * 100).toFixed(2) : '0.00';
        acc[agent].bookRate = acc[agent].totalReached > 0 ? 
          ((acc[agent].totalBooked / acc[agent].totalReached) * 100).toFixed(2) : '0.00';
        
        return acc;
      }, {});
      
      res.json({
        success: true,
        timeframe,
        summary: {
          totalDials,
          totalReached,
          totalBooked,
          reachRate: parseFloat(reachRate),
          bookRate: parseFloat(bookRate),
          averageCallDuration: calls.length > 0 ? 
            Math.round(calls.reduce((sum, call) => sum + (call.duration || 0), 0) / calls.length) : 0
        },
        agentStats: Object.values(agentStats),
        timestamp: new Date().toISOString()
      });
      
    } catch (error) {
      console.error('❌ Call center stats error:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to fetch call center statistics',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

  // Normalize phone number to plain 10-digit format (remove +1, dashes, spaces, parentheses)
  const normalizePhone = (phone: string): string => {
    // Remove all non-digit characters
    const digitsOnly = phone.replace(/\D/g, '');
    
    // If it starts with 1 and is 11 digits, remove the 1 (US country code)
    if (digitsOnly.length === 11 && digitsOnly.startsWith('1')) {
      return digitsOnly.substring(1);
    }
    
    // Return as-is if already 10 digits, or return original if unexpected length
    return digitsOnly.length === 10 ? digitsOnly : digitsOnly;
  };

  // Update masterlead cnresolution when disposition is selected
  app.post("/api/masterlead/update-resolution", async (req, res) => {
    try {
      const { leadId, leadPhone, cnresolution, agentEmail } = req.body;
      
      console.log(`📋 Updating masterlead cnresolution - LeadId: ${leadId}, Phone: ${leadPhone}, Resolution: ${cnresolution}`);
      
      if (!cnresolution) {
        return res.status(400).json({
          success: false,
          error: 'cnresolution is required'
        });
      }

      // Prefer leadId over phone for precise updates
      let query;
      if (leadId) {
        console.log(`✅ Using lead ID for precise update: ${leadId}`);
        query = supabaseAdmin
          .from('masterlead')
          .update({ 
            cnresolution: cnresolution,
            updated_at: new Date().toISOString()
          })
          .eq('id', leadId)
          .select();
      } else if (leadPhone) {
        const normalizedPhone = normalizePhone(leadPhone);
        console.log(`📞 Using phone normalization: ${leadPhone} → ${normalizedPhone}`);
        query = supabaseAdmin
          .from('masterlead')
          .update({ 
            cnresolution: cnresolution,
            updated_at: new Date().toISOString()
          })
          .eq('phone', normalizedPhone)
          .select();
      } else {
        return res.status(400).json({
          success: false,
          error: 'Either leadId or leadPhone is required'
        });
      }

      // Update the cnresolution column in Supabase masterlead table
      const { data, error } = await query;

      if (error) {
        console.error('❌ Supabase error updating cnresolution:', error);
        return res.status(500).json({
          success: false,
          error: 'Failed to update masterlead resolution',
          details: error.message
        });
      }

      console.log(`✅ Updated cnresolution for ${leadPhone}: ${cnresolution}`, data);
      
      res.json({
        success: true,
        message: `Lead resolution updated to: ${cnresolution}`,
        updatedRecords: data?.length || 0
      });
      
    } catch (error) {
      console.error('❌ Error updating masterlead cnresolution:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to update masterlead resolution',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

  app.get("/api/reporting/team-performance", async (req, res) => {
    try {
      const { timeframe = 'week' } = req.query;
      
      console.log(`👥 Getting team performance data - Timeframe: ${timeframe}`);
      
      // Get date range
      const now = new Date();
      const daysBack = timeframe === 'month' ? 30 : 7;
      const startDate = new Date(now.getTime() - daysBack * 24 * 60 * 60 * 1000);
      
      // Query calls for the timeframe
      const calls = await db.select().from(outboundCallHistory)
        .where(gte(outboundCallHistory.startTime, startDate));
      
      // Group by day for trend analysis
      const dailyStats = calls.reduce((acc: any, call) => {
        const day = call.startTime?.toISOString().split('T')[0] || 'unknown';
        if (!acc[day]) {
          acc[day] = { date: day, dials: 0, reached: 0, booked: 0 };
        }
        
        acc[day].dials++;
        
        if (call.callStatus === 'completed' && 
            call.callDisposition && 
            !['no-answer', 'voicemail', 'busy'].includes(call.callDisposition)) {
          acc[day].reached++;
        }
        
        if (call.callDisposition === 'booked') {
          acc[day].booked++;
        }
        
        return acc;
      }, {});
      
      res.json({
        success: true,
        timeframe,
        dailyTrends: Object.values(dailyStats).sort((a: any, b: any) => a.date.localeCompare(b.date)),
        timestamp: new Date().toISOString()
      });
      
    } catch (error) {
      console.error('❌ Team performance error:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to fetch team performance data',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

