      return res.status(403).json({ error: "Admin access required" });
    }

    try {
      console.log(`🔄 Admin ${req.user.email} initiated Twilio call sync`);
      const syncCount = await TwilioCallLogger.syncExistingTwilioCalls();
      
      res.json({ 
        success: true, 
        message: `Successfully synced ${syncCount} Twilio calls to database`,
        syncedCalls: syncCount,
        initiatedBy: req.user.email
      });
      
    } catch (error) {
      console.error('❌ Error syncing Twilio calls:', error);
      res.status(500).json({ error: "Failed to sync Twilio calls" });
    }
  });

  // Auto sync control endpoints (admin only)
  app.post("/api/twilio-auto-sync/start", async (req, res) => {
    if (!req.isAuthenticated() || req.user.role !== 'super_admin') {
      return res.status(403).json({ error: "Admin access required" });
    }

    try {
      twilioAutoSync.startAutoSync();
      res.json({ 
        success: true, 
        message: "Automated Twilio sync started - downloading call data every minute",
        status: twilioAutoSync.getStatus(),
        initiatedBy: req.user.email
      });
    } catch (error) {
      console.error('❌ Error starting auto sync:', error);
      res.status(500).json({ error: "Failed to start auto sync" });
