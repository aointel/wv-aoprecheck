      const analysis = await verificationAudioAnalyzer.analyzeAudioFromUrl(
        recordingUrl,
        session.verificationMethod || 'phone'
      );
      
      // Update session with analysis results
      await storage.updateVerificationSession(sessionId, {
        audio_analysis: analysis
      });
      
      console.log(`✅ Audio analysis complete for session ${sessionId}`);
      
      res.json({
        success: true,
        message: "Audio analyzed successfully",
        analysis
      });
      
    } catch (error: any) {
