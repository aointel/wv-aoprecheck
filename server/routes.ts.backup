  // Update team assignments for a Quality Manager
  app.put('/api/admin/quality-managers/:email/teams', async (req, res) => {
    try {
      const userContext = await loadUserContext(req);
      
      if (!userContext.isAdmin) {
        return res.status(403).json({ error: 'Admin access required' });
      }

      const { email } = req.params;
      const { teamIds } = req.body;

      if (!Array.isArray(teamIds)) {
        return res.status(400).json({ error: 'teamIds must be an array' });
      }

      // Clear existing assignments
      const clearQuery = `DELETE FROM quality_manager_assignments WHERE qm_email = '${email}'`;
      await db.execute(sql.raw(clearQuery));

      // Add new assignments
      if (teamIds.length > 0) {
        const values = teamIds.map((teamId: number) => `('${email}', ${teamId})`).join(',');
        const insertQuery = `
          INSERT INTO quality_manager_assignments (qm_email, mga_team_id)
          VALUES ${values}
        `;
        await db.execute(sql.raw(insertQuery));
      }

      res.json({ success: true, message: 'Team assignments updated successfully' });
      
    } catch (error) {
      console.error('Error updating team assignments:', error);
      res.status(500).json({ error: 'Failed to update team assignments' });
    }
  });

