  // Update agent team assignment (supports both MGA and RGA)
  app.put('/api/teams/assign', async (req, res) => {
    try {
      const { agentEmail, mgaTeam, rgaTeam } = req.body;
      
      console.log(`👥 Assigning ${agentEmail} to MGA: ${mgaTeam || 'None'}, RGA: ${rgaTeam || 'None'} in PostgreSQL agentProfiles table`);
      
      // Check if agent profile exists
      const existingProfile = await storage.getAgentProfileByEmail(agentEmail);
      
      const updates: any = {};
      if (mgaTeam !== undefined) updates.mgaTeam = mgaTeam;
      if (rgaTeam !== undefined) updates.rgaTeam = rgaTeam;
      
      if (!existingProfile) {
        console.log(`🆕 Creating new agent profile for ${agentEmail}`);
        // Create new agent profile with team assignment
        await storage.createAgentProfileWithSupabaseId({
          email: agentEmail,
          mgaTeam: mgaTeam || null,
          rgaTeam: rgaTeam || null,
          teamRole: 'Agent',
          supabaseUserId: `temp-${Date.now()}`
        });
      } else {
        console.log(`🔄 Updating existing agent profile for ${agentEmail}`);
        // Update existing profile
        await storage.updateAgentProfileBySupabaseId(existingProfile.supabaseUserId!, updates);
      }

      console.log(`✅ Successfully assigned ${agentEmail} - MGA: ${mgaTeam || 'None'}, RGA: ${rgaTeam || 'None'}`);
      
      res.json({
        success: true,
        message: `Agent assigned - MGA: ${mgaTeam || 'None'}, RGA: ${rgaTeam || 'None'}`
      });
      
    } catch (error) {
      console.error('❌ Error in team assignment endpoint:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });

