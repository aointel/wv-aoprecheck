  // User permissions endpoint for frontend RBAC
  app.get("/api/user-permissions", async (req, res) => {
    try {
      // Get user email from headers or session
      const headerEmail = req.headers['user-email'] as string;
      const sessionEmail = (req.session as any)?.user?.email;
      const userEmail = headerEmail || sessionEmail;
      
      if (!userEmail) {
        console.log('🚫 No user email found in headers or session');
        return res.status(401).json({ error: 'User authentication required' });
      }
      
      console.log(`🔐 Fetching permissions for user: ${userEmail}`);
      
      const { getUserPermissions } = await import('./rbac-helper');
      const permissions = await getUserPermissions(userEmail);
      
      console.log(`✅ Permissions for ${userEmail}:`, permissions);
      res.json(permissions);
      
    } catch (error) {
      console.error('❌ User permissions API error:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });

  // AO Precheck Admin API routes
  app.get("/api/aoi-precheck/sessions", async (req, res) => {
    try {
      console.log('📊 Fetching AO Precheck sessions for admin');
      
      // Get user permissions for RBAC - prioritize header over session
      const headerEmail = req.headers['x-user-email'] as string || req.headers['user-email'] as string || req.headers['User-Email'] as string;
      const sessionEmail = (req.session as any)?.user?.email;
      const userEmail = headerEmail || sessionEmail;
      
      if (!userEmail) {
        console.error('❌ NO USER EMAIL FOUND - header:', headerEmail, 'session:', sessionEmail);
        return res.status(401).json({ error: 'User email required', debug: { headerEmail, sessionEmail } });
      }
      
      console.log(`🔍 EMAIL DEBUG: header='${headerEmail}', session='${sessionEmail}', final='${userEmail}'`);
      console.log('🔍 ALL HEADERS:', Object.keys(req.headers).filter(h => h.toLowerCase().includes('email')));
      
      const { getUserPermissions } = await import('./rbac-helper');
      const permissions = await getUserPermissions(userEmail);
      
      console.log(`🔐 User ${userEmail} permissions:`, {
        role: permissions.role,
        canViewAll: permissions.canViewAll,
        allowedMgaTeams: permissions.allowedMgaTeams,
        allowedRgaTeams: permissions.allowedRgaTeams
      });
      
      const { search, status, method, agent, rga, mga, dateRange, page, limit } = req.query;
      console.log(`🔍 QUERY PARAMS DEBUG:`, { search, status, method, agent, rga, mga, dateRange, page, limit });
      
      let queryText = `
        SELECT s.*, 
               s.agent_mga_team,
               s.agent_rga_team,
               s.agent_first_name,
               s.agent_last_name
        FROM verification_sessions s
        WHERE 1=1
      `;
      const queryParams: any[] = [];
      let paramCount = 0;

      // Apply filters
      if (search) {
        paramCount++;
        queryText += ` AND first_name ILIKE $${paramCount}`;
        queryParams.push(`%${search}%`);
      }
      if (status && status !== 'all') {
        paramCount++;
        queryText += ` AND status = $${paramCount}`;
        queryParams.push(status);
      }
      if (method && method !== 'all') {
        paramCount++;
        queryText += ` AND verification_method = $${paramCount}`;
        queryParams.push(method);
      }
      if (agent && agent !== 'all') {
        paramCount++;
        queryText += ` AND agent_email = $${paramCount}`;
        queryParams.push(agent);
      }
      
      // Apply user-selected RGA/MGA team filters (within RBAC constraints)
      if (rga && rga !== 'all') {
        paramCount++;
        queryText += ` AND ap.rga_team = $${paramCount}`;
        queryParams.push(rga);
      }
      if (mga && mga !== 'all') {
        paramCount++;
        queryText += ` AND ap.mga_team = $${paramCount}`;
        queryParams.push(mga);
      }
      
      // Apply RBAC filtering based on user permissions
      if (permissions.precheck.readScope === 'assigned_mga') {
        // Quality Manager and similar roles - filter by assigned teams
        if (permissions.allowedMgaTeams && permissions.allowedMgaTeams.length > 0) {
          const mgaTeamsPlaceholder = permissions.allowedMgaTeams.map(() => {
            paramCount++;
            return `$${paramCount}`;
          }).join(',');
          queryText += ` AND ap.mga_team IN (${mgaTeamsPlaceholder})`;
          queryParams.push(...permissions.allowedMgaTeams);
          console.log(`🔐 RBAC filtering applied for user: ${userEmail} with ${permissions.allowedMgaTeams.length} teams`);
        } else {
          console.log(`⚠️ Quality Manager has no assigned teams - showing no sessions`);
          queryText += ` AND ap.mga_team = 'NO_TEAMS_ASSIGNED'`; // This will return no results
        }
      } else if (permissions.precheck.readScope === 'all') {
        // AO Quality Manager - see all sessions (no filtering)
        console.log(`🌍 AO Quality Manager - showing all sessions`);
      }
      
      // Apply date range filter
      if (dateRange && dateRange !== 'all') {
        const now = new Date();
        let startDate: Date;
        
        switch (dateRange) {
          case 'today':
            startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            break;
          case 'yesterday':
            startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
            paramCount++;
            queryText += ` AND created_at < $${paramCount}`;
            queryParams.push(new Date(now.getFullYear(), now.getMonth(), now.getDate()).toISOString());
            break;
          case 'week':
            startDate = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
            break;
          case 'month':
            startDate = new Date(now.getFullYear(), now.getMonth(), 1);
            break;
          default:
            startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        }
        
        if (dateRange !== 'yesterday') {
          paramCount++;
          queryText += ` AND created_at >= $${paramCount}`;
          queryParams.push(startDate.toISOString());
        }
      }

      // Use Supabase instead of pool query
      console.log('🔄 Using Supabase to fetch verification sessions...');
      
      // Pagination parameters
      const pageNum = parseInt(page as string) || 1;
      const pageSize = parseInt(limit as string) || 100;
      const offset = (pageNum - 1) * pageSize;

      // First, get total count for pagination
      let countQuery = supabaseAdmin
        .from('verification_sessions')
        .select('*', { count: 'exact', head: true });

      let query = supabaseAdmin
        .from('verification_sessions')
        .select('*')
        .order('created_at', { ascending: false });
        // NOTE: .range() is applied AFTER all filters to search entire database

      // Filter out demo sessions - show live sessions and sessions with NULL session_type
      query = query.or('session_type.is.null,session_type.neq.demo');
      countQuery = countQuery.or('session_type.is.null,session_type.neq.demo');
      console.log('🚫 DEMO FILTER: Including NULL and non-demo sessions, excluding only demo sessions');

      // Apply date range filter to Supabase query
      console.log(`📅 Date range parameter received: '${dateRange}' (type: ${typeof dateRange})`);
      if (dateRange && dateRange !== 'all') {
        const now = new Date();
        let startDate: Date;
        let endDate: Date | null = null;
        
        switch (dateRange) {
          case 'today':
            startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            endDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
            break;
          case 'yesterday':
            startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
            endDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            break;
          case 'week':
            startDate = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
            break;
          case 'month':
            startDate = new Date(now.getFullYear(), now.getMonth(), 1);
            break;
          default:
            startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        }
        
        query = query.gte('created_at', startDate.toISOString());
        countQuery = countQuery.gte('created_at', startDate.toISOString());
        if (endDate) {
          query = query.lt('created_at', endDate.toISOString());
          countQuery = countQuery.lt('created_at', endDate.toISOString());
        }
        
        console.log(`📅 Date filtering: ${dateRange} - Start: ${startDate.toISOString()}${endDate ? `, End: ${endDate.toISOString()}` : ''}`);
      }

      // Apply RBAC filtering based on new capability system
      if (permissions.precheck.readScope === 'assigned_mga') {
        // Quality Manager and similar roles - filter by assigned teams
        if (permissions.allowedMgaTeams && permissions.allowedMgaTeams.length > 0) {
          // Filter by assigned MGA teams AND exclude null values
          query = query
            .in('agent_mga_team', permissions.allowedMgaTeams)
            .not('agent_mga_team', 'is', null);
          countQuery = countQuery
            .in('agent_mga_team', permissions.allowedMgaTeams)
            .not('agent_mga_team', 'is', null);
          console.log(`🔐 RBAC ENABLED - Filtering by assigned MGA teams:`, permissions.allowedMgaTeams.slice(0, 5), `... (${permissions.allowedMgaTeams.length} total teams)`);
        } else {
          console.log(`⚠️ Quality Manager has no assigned teams - showing no sessions`);
          query = query.eq('agent_mga_team', 'NO_TEAMS_ASSIGNED'); // This will return no results
          countQuery = countQuery.eq('agent_mga_team', 'NO_TEAMS_ASSIGNED');
        }
      } else if (permissions.precheck.readScope === 'all') {
        // AO Quality Manager - see all sessions (no filtering)
        console.log(`🌍 AO Quality Manager - showing all sessions`);
      }

      // Apply other filters (apply to both query and countQuery)
      if (search) {
        // Build OR conditions for search across all relevant fields
        let searchConditions = `first_name.ilike.%${search}%,last_name.ilike.%${search}%,agent_first_name.ilike.%${search}%,agent_last_name.ilike.%${search}%,company_email.ilike.%${search}%,phone.ilike.%${search}%`;
        
        // Add associate_id search if search is numeric
        if (!isNaN(Number(search))) {
          searchConditions += `,associate_id.eq.${Number(search)}`;
        }
        
        query = query.or(searchConditions);
        countQuery = countQuery.or(searchConditions);
      }
      if (status && status !== 'all') {
        query = query.eq('status', status);
        countQuery = countQuery.eq('status', status);
      }
      if (method && method !== 'all') {
        query = query.eq('verification_method', method);
        countQuery = countQuery.eq('verification_method', method);
      }
      
      // Apply user-selected RGA/MGA team filters (within RBAC constraints)
      if (rga && rga !== 'all') {
        query = query.eq('agent_rga_team', rga);
        countQuery = countQuery.eq('agent_rga_team', rga);
        console.log(`🎯 USER FILTER: RGA team = ${rga}`);
      }
      if (mga && mga !== 'all') {
        query = query.eq('agent_mga_team', mga);
        countQuery = countQuery.eq('agent_mga_team', mga);
        console.log(`🎯 USER FILTER: MGA team = ${mga}`);
      }

      // Apply pagination (range is applied AFTER all filters)
      query = query.range(offset, offset + pageSize - 1);

      // Execute both queries in parallel
      const [{ data: result, error }, { count: totalCount, error: countError }] = await Promise.all([
        query,
        countQuery
      ]);

      if (error) {
        console.error('❌ Supabase query error:', error);
        return res.status(500).json({ error: 'Database query failed' });
      }

      // Map verification_sessions fields to frontend expected field names
      const mappedSessions = (result || []).map((session: any) => {
        return {
          ...session,
          // Map client and agent names
          client_name: `${session.first_name || ''} ${session.last_name || ''}`.trim(),
          client_email: '', // Not available in verification_sessions
          client_phone: session.phone,
          agent_name: `${session.agent_first_name || ''} ${session.agent_last_name || ''}`.trim(),
          agent_email: session.agent_email || '',
          
          // JUST USE THE FUCKING URLs FROM THE DATABASE - THEY'RE ALREADY CORRECT!
          recording_url: session.recording_url, // Use whatever is in the DB
          screenshot_url: session.screenshot_path,
          certificate_url: session.status === 'completed' ? `/api/aoi-precheck/download/certificate/${session.session_id}` : null,
          transcript_url: null,
          
          // AI Validation Results
          screenshot_validation: session.screenshot_validation || null,
          audio_analysis: session.audio_analysis || null,
        
          // Additional frontend fields
          verification_notes: session.verification_result || null,
          policy_number: null,
          beneficiary_info: session.spouse_name || null,
          premium_amount: (() => {
            const numericPremium = String(session.premium || '0').replace(/[^0-9.]/g, '');
            const parsed = parseFloat(numericPremium);
            return isNaN(parsed) ? null : parsed;
          })(),
          verification_score: null,
          screenshots_count: session.screenshot_path ? 1 : 0,
          call_duration: session.taalk_call_duration || null,
          cancellation_reason: ''
        };
      });

      // Sessions are already filtered by RBAC at the database level
      console.log(`✅ Found ${mappedSessions.length} verification sessions from Supabase (total: ${totalCount || 0})`);
      
      // Return data with pagination metadata
      res.json({
        sessions: mappedSessions,
        pagination: {
          page: pageNum,
          limit: pageSize,
          total: totalCount || 0,
          totalPages: Math.ceil((totalCount || 0) / pageSize)
        }
      });

    } catch (error) {
      console.error('❌ Precheck sessions API error:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });

  app.get("/api/aoi-precheck/stats", async (req, res) => {
    try {
      // Get user permissions for RBAC - prioritize header over session
      const headerEmail = req.headers['x-user-email'] as string || req.headers['user-email'] as string || req.headers['User-Email'] as string;
      const sessionEmail = (req.session as any)?.user?.email;
      const userEmail = headerEmail || sessionEmail;
      
      if (!userEmail) {
        console.error('❌ NO USER EMAIL FOUND - header:', headerEmail, 'session:', sessionEmail);
        return res.status(401).json({ error: 'User email required', debug: { headerEmail, sessionEmail } });
      }
      
      console.log(`🔍 STATS EMAIL DEBUG: header='${headerEmail}', session='${sessionEmail}', final='${userEmail}'`);
      
      const { getUserPermissions } = await import('./rbac-helper');
      const permissions = await getUserPermissions(userEmail);
      
      const today = new Date();
      const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());

      // Use Supabase with same RBAC filtering as sessions endpoint
      let query = supabaseAdmin
        .from('verification_sessions')
        .select('status, created_at, agent_mga_team, agent_rga_team')
        .neq('session_type', 'demo'); // Filter out demo sessions

      // Apply RBAC filtering based on user permissions
      if (permissions.precheck.readScope === 'assigned_mga') {
        // Quality Manager and similar roles - filter by assigned teams
        if (permissions.allowedMgaTeams && permissions.allowedMgaTeams.length > 0) {
          // Filter by assigned MGA teams AND exclude null values
          query = query
            .in('agent_mga_team', permissions.allowedMgaTeams)
            .not('agent_mga_team', 'is', null);
          console.log(`🔐 STATS RBAC ENABLED - Filtering by assigned MGA teams:`, permissions.allowedMgaTeams.slice(0, 5), `... (${permissions.allowedMgaTeams.length} total teams)`);
        } else {
          console.log(`⚠️ Quality Manager has no assigned teams - showing no stats`);
          query = query.eq('agent_mga_team', 'NO_TEAMS_ASSIGNED'); // This will return no results
        }
      } else if (permissions.precheck.readScope === 'all') {
        // AO Quality Manager - see all sessions (no filtering)
        console.log(`🌍 AO Quality Manager - showing all stats`);
      } else {
        // Other roles - no access
        console.log(`🚫 No access to precheck stats for role: ${permissions.role}`);
        query = query.eq('agent_mga_team', 'NO_ACCESS'); // This will return no results
      }

      const { data, error } = await query;

      if (error) {
        console.error('❌ Supabase stats query error:', error);
        return res.json({ total: 0, completed: 0, in_progress: 0, failed: 0, today: 0 });
      }
      
      const stats = {
        total: data?.length || 0,
        completed: data?.filter(s => s.status === 'completed').length || 0,
        in_progress: data?.filter(s => s.status === 'in_progress').length || 0,
        failed: data?.filter(s => s.status === 'failed').length || 0,
        today: data?.filter(s => new Date(s.created_at) >= todayStart).length || 0
      };

      console.log(`📊 RBAC Stats for ${userEmail} (${permissions.role}):`, stats);
      res.json(stats);
    } catch (error) {
      console.error('❌ Precheck stats API error:', error);
      res.json({ total: 0, completed: 0, in_progress: 0, failed: 0, today: 0 });
    }
  });

  app.get("/api/aoi-precheck/agents", async (req, res) => {
    try {
      const { data: result, error } = await supabaseAdmin
        .from('verification_sessions')
        .select('agent_first_name, agent_last_name')
        .neq('session_type', 'demo') // Filter out demo sessions
        .not('agent_first_name', 'is', null);

      if (error) {
        console.error('❌ Supabase agents query error:', error);
        return res.json([]);
      }

      const uniqueAgents = result?.map(row => `${row.agent_first_name} ${row.agent_last_name}`).filter(Boolean) || [];
      res.json(uniqueAgents);

    } catch (error) {
      console.error('❌ Precheck agents API error:', error);
      res.json([]);
    }
  });

  // Agent Usage Stats API - Shows VDP online time and connects per agent
  app.get("/api/admin/usage-stats", async (req, res) => {
    try {
      const { dateRange = 'week' } = req.query;
      
      // Calculate date range
      const now = new Date();
      let startDate: Date;
      
      if (dateRange === 'today') {
        startDate = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      } else if (dateRange === 'week') {
        startDate = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
      } else if (dateRange === 'month') {
        startDate = new Date(now.getFullYear(), now.getMonth(), 1);
      } else {
        startDate = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000); // Default to week
      }
      
      const startDateStr = startDate.toISOString();
      
      // Get VDP connects (picked calls)
      const { data: vdpCalls } = await supabaseAdmin
        ?.from('vdp_calls')
        .select('agent_email, created_at, duration, outcome, call_status')
        .gte('created_at', startDateStr) || { data: [] };
      
      // Get agent profiles with last_heartbeat to calculate online time
      const { data: agentProfiles } = await supabaseAdmin
        ?.from('agent_profiles')
        .select('email, last_heartbeat, status, VDPACTIVE, first_name, last_name') || { data: [] };
      
      // Aggregate by agent
      const agentStats = new Map<string, any>();
      
      // Process VDP calls to count connects
      (vdpCalls || []).forEach((call: any) => {
        if (!call.agent_email) return;
        
        if (!agentStats.has(call.agent_email)) {
          agentStats.set(call.agent_email, {
            email: call.agent_email,
            name: call.agent_email.split('@')[0],
            connects: 0,
            total_call_minutes: 0,
            vdp_active: false,
            last_activity: call.created_at
          });
        }
        
        const stats = agentStats.get(call.agent_email);
        
        // Count as connect if call was picked up (outcome = 'picked', 'connected', or duration > 30s)
        if (call.outcome === 'picked' || call.outcome === 'connected' || call.call_status === 'completed' || (call.duration && call.duration > 30)) {
          stats.connects++;
        }
        
        if (call.duration) stats.total_call_minutes += Math.round(call.duration / 60);
        
        if (new Date(call.created_at) > new Date(stats.last_activity)) {
          stats.last_activity = call.created_at;
        }
      });
      
      // Add agent profile info
      (agentProfiles || []).forEach((profile: any) => {
        if (!profile.email) return;
        
        if (agentStats.has(profile.email)) {
          const stats = agentStats.get(profile.email);
          stats.name = `${profile.first_name || ''} ${profile.last_name || ''}`.trim() || profile.email.split('@')[0];
          stats.vdp_active = profile.VDPACTIVE === 'ACTIVE';
        } else if (profile.VDPACTIVE === 'ACTIVE') {
          // Agent has VDP active but no calls yet
          agentStats.set(profile.email, {
            email: profile.email,
            name: `${profile.first_name || ''} ${profile.last_name || ''}`.trim() || profile.email.split('@')[0],
            connects: 0,
            total_call_minutes: 0,
            vdp_active: true,
            last_activity: profile.last_heartbeat
          });
        }
      });
      
      // Convert to array and sort by connects (most active first)
      const usageStats = Array.from(agentStats.values())
        .filter(s => s.vdp_active) // Only show VDP active agents
        .sort((a, b) => b.connects - a.connects);
      
      res.json({
        success: true,
        dateRange,
        startDate: startDateStr,
        totalAgents: usageStats.length,
        stats: usageStats
      });
      
    } catch (error: any) {
      console.error('❌ Usage stats API error:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });

  app.put("/api/aoi-precheck/sessions/:sessionId", async (req, res) => {
    try {
      const { sessionId } = req.params;
      const updates = req.body;
      
      if (!supabaseAdmin) {
        return res.status(500).json({ error: 'Database not available' });
      }

      const { data, error } = await supabaseAdmin
        .from('verification_sessions')
        .update({
          ...updates,
          updated_at: new Date().toISOString()
        })
        .eq('id', sessionId)
        .select()
        .single();

      if (error) {
        console.error('❌ Error updating precheck session:', error);
        return res.status(500).json({ error: 'Failed to update session' });
      }

      res.json(data);
    } catch (error) {
      console.error('❌ Update precheck session error:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });

  app.delete("/api/aoi-precheck/sessions/:sessionId", async (req, res) => {
    try {
      const { sessionId } = req.params;
      
      if (!supabaseAdmin) {
        return res.status(500).json({ error: 'Database not available' });
      }

      const { error } = await supabaseAdmin
        .from('aoi_precheck_sessions')
        .delete()
        .eq('id', sessionId);

      if (error) {
        console.error('❌ Error deleting precheck session:', error);
        return res.status(500).json({ error: 'Failed to delete session' });
      }

      res.json({ success: true });
    } catch (error) {
      console.error('❌ Delete precheck session error:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });

  // OPTIONS handler for recording endpoint (CORS preflight)
  app.options("/api/aoi-precheck/recording/:sessionId", (req, res) => {
    res.setHeader('Access-Control-Allow-Origin', '*');
    res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
    res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization, Range');
    res.setHeader('Access-Control-Max-Age', '86400');
    res.status(200).end();
  });

  // Proxy endpoint for Taalk recordings (bypasses CORS)
  app.get("/api/aoi-precheck/recording/:sessionId", async (req, res) => {
    try {
      const { sessionId } = req.params;
      
      if (!sessionId) {
        return res.status(400).json({ error: 'Session ID is required' });
      }

      // Get the actual session to find the proper Taalk session ID
      let taalkSessionId = sessionId;
      
      // If sessionId is a number, it's our database ID - look up the actual session_id
      if (/^\d+$/.test(sessionId)) {
        try {
          const sessionQuery = await supabaseAdmin
            .from('verification_sessions')
            .select('session_id, taalk_call_id, taalk_call_url, status')
            .eq('id', parseInt(sessionId))
            .single();
            
            if (sessionQuery.data) {
            console.log(`🔍 Session data:`, {
              id: sessionId,
              session_id: sessionQuery.data.session_id,
              taalk_call_id: sessionQuery.data.taalk_call_id,
              taalk_call_url: sessionQuery.data.taalk_call_url,
              status: sessionQuery.data.status
            });
            
            // Try Supabase storage FIRST (check multiple possible paths)
            if (sessionQuery.data.taalk_call_url) {
              const storedUrl = sessionQuery.data.taalk_call_url;
              
              // If it's already an HTTP URL, redirect directly
              if (storedUrl.startsWith('http')) {
                console.log(`🔑 Redirecting to stored URL: ${storedUrl}`);
                return res.redirect(storedUrl);
              }
              
              // Try as Supabase storage path with multiple possible formats
              const pathsToTry = [
                storedUrl, // Exact stored path
                `recordings/${storedUrl}`, // With recordings prefix
                `recordings/${taalkSessionId}.mp3`, // Using call ID
                `${taalkSessionId}.mp3`, // Direct filename
                storedUrl.endsWith('.mp3') ? storedUrl : `${storedUrl}.mp3` // Ensure .mp3 extension
              ];
              
              for (const path of pathsToTry) {
                try {
                  const { data: urlData, error: urlError } = await supabaseAdmin.storage
                    .from('verify_agent_screenshot')
                    .createSignedUrl(path, 63072000); // 2 years in seconds
                  
                  if (!urlError && urlData?.signedUrl) {
                    console.log(`✅ Found recording in Supabase at: ${path} - generating 2-year signed URL`);
                    return res.redirect(urlData.signedUrl);
                  }
                } catch (e) {
                  // Try next path
                }
              }
              
              console.log(`⚠️ Recording not found in Supabase storage, falling back to Taalk API`);
            }
            
            // Use taalk_call_id if available, otherwise session_id
            taalkSessionId = sessionQuery.data.taalk_call_id || sessionQuery.data.session_id;
            console.log(`🎵 Mapped database ID ${sessionId} to Taalk session ${taalkSessionId}`);
          } else {
            console.log(`⚠️ No session found for database ID ${sessionId}`);
          }
        } catch (error) {
          console.error(`❌ Error looking up session: ${error}`);
        }
      }

      // Construct Taalk API URL with authentication
      const taalkUrl = `https://api.taalk.ai/api/calls/${taalkSessionId}/recording?db=michaelmandella`;
      
      console.log(`🎵 Proxying recording request for session ${sessionId}`);
      console.log(`🎵 Fetching from Taalk API: ${taalkUrl}`);

      // Use the Taalk service's authentication token
      const taalkApiKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJrZXkiOiJ0YWFsay4zN2RhMGU2NS1kMGVjLTQxYWYtOGQzYi03MWRjNTJiNGNiMmYiLCJuYW1lIjoidGFhbGsiLCJleHAiOjIwNTUwMzU2OTJ9.Ywh89Z0PvELHylJReZo8KPOiL7xX21BoBYe16OZfJw4";
      
      // Check if this is a range request for audio scrubbing/seeking
      const range = req.headers.range;
      const fetchHeaders: any = {
        'Authorization': `Bearer ${taalkApiKey}`,
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36',
        'Accept': 'audio/mpeg, audio/mp3, audio/*, */*',
        'Origin': 'https://lets.taalk.ai',
        'Referer': 'https://lets.taalk.ai/'
      };

      // Forward range header if present for seeking/scrubbing support
      if (range) {
        fetchHeaders['Range'] = range;
        console.log(`🎵 Range request for audio seeking: ${range}`);
      }
      
      // Fetch the audio file from Taalk API with authentication
      const response = await fetch(taalkUrl, {
        method: 'GET',
        headers: fetchHeaders
      });
      
      if (!response.ok) {
        console.error(`❌ Taalk API error: ${response.status} ${response.statusText}`);
        console.error(`❌ Failed URL: ${taalkUrl}`);
        
        // Check if it's a 404 (recording not found) vs other errors
        if (response.status === 404) {
          console.log(`📭 Recording not found for session ${sessionId} - may not be processed yet`);
          return res.status(404).json({ 
            error: 'Recording not found', 
            message: 'This session may not have a recording yet, or it may still be processing.' 
          });
        }
        
        // Try basic auth as fallback
        console.log(`🔄 Trying basic auth fallback for session ${sessionId}`);
        const basicAuth = Buffer.from('michaelmandella@aoglobelife.com:Aoletsgrow24!').toString('base64');
        const fallbackHeaders: any = {
          'Authorization': `Basic ${basicAuth}`,
          'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36',
          'Accept': 'audio/mpeg, audio/mp3, audio/*, */*'
        };

        // Forward range header for fallback too
        if (range) {
          fallbackHeaders['Range'] = range;
        }

        const fallbackResponse = await fetch(taalkUrl, {
          method: 'GET',
          headers: fallbackHeaders
        });
        
        if (!fallbackResponse.ok) {
          console.error(`❌ Basic auth also failed: ${fallbackResponse.status} ${fallbackResponse.statusText}`);
          return res.status(response.status).json({ 
            error: `Failed to fetch recording: ${response.statusText}`,
            details: 'Both Bearer token and basic auth failed',
            sessionId: sessionId
          });
        }
        
        // Use fallback response with proper range support
        const contentType = fallbackResponse.headers.get('content-type') || 'audio/mpeg';
        const contentLength = fallbackResponse.headers.get('content-length');
        const acceptRanges = fallbackResponse.headers.get('accept-ranges');
        const contentRange = fallbackResponse.headers.get('content-range');
        
        // Set status code for range requests
        if (range && fallbackResponse.status === 206) {
          res.status(206);
        }

        res.setHeader('Content-Type', 'audio/mpeg');
        res.setHeader('Accept-Ranges', 'bytes');
        res.setHeader('Cache-Control', 'public, max-age=31536000');
        res.setHeader('Access-Control-Allow-Origin', '*');
        res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
        res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization, Range');
        res.setHeader('Content-Disposition', `inline; filename="recording-${taalkSessionId}.mp3"`);
        
        if (contentLength) {
          res.setHeader('Content-Length', contentLength);
        }
        
        if (contentRange) {
          res.setHeader('Content-Range', contentRange);
        }

        if (fallbackResponse.body) {
          fallbackResponse.body.pipe(res);
        } else {
          const buffer = await fallbackResponse.arrayBuffer();
          res.send(Buffer.from(buffer));
        }
        return;
      }

      // Get the content type from Taalk API response
      const contentType = response.headers.get('content-type') || 'audio/mpeg';
      const contentLength = response.headers.get('content-length');
      const acceptRanges = response.headers.get('accept-ranges');
      const contentRange = response.headers.get('content-range');
      
      console.log(`🎵 Recording found - Content-Type: ${contentType}, Size: ${contentLength || 'unknown'}, Range: ${range || 'none'}`);

      // Set status code for range requests
      if (range && response.status === 206) {
        res.status(206);
      }

      // Set appropriate headers for audio streaming with CORS and range support
      res.setHeader('Content-Type', 'audio/mpeg');
      res.setHeader('Accept-Ranges', 'bytes');
      res.setHeader('Cache-Control', 'public, max-age=31536000');
      res.setHeader('Access-Control-Allow-Origin', '*');
      res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
      res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization, Range');
      res.setHeader('Content-Disposition', `inline; filename="recording-${taalkSessionId}.mp3"`);
      
      if (contentLength) {
        res.setHeader('Content-Length', contentLength);
      }
      
      if (contentRange) {
        res.setHeader('Content-Range', contentRange);
      }

      // Stream the audio data back to client
      if (response.body) {
        response.body.pipe(res);
      } else {
        // Fallback for environments without streams
        const buffer = await response.arrayBuffer();
        res.send(Buffer.from(buffer));
      }

    } catch (error) {
      console.error('❌ Recording proxy error:', error);
      res.status(500).json({ error: 'Failed to fetch recording' });
    }
  });

  // Serve recordings from object storage
  app.get("/api/objstore/recordings/:filename", async (req, res) => {
    try {
      const { filename } = req.params;
      const bucketId = process.env.PRIVATE_OBJECT_DIR?.split('/')[1] || 'replit-objstore-6b6b5e82-17a0-48c7-ace1-b8adfc5db10f';
      const fullPath = `${bucketId}/.private/recordings/${filename}`;
      
      console.log(`🎵 Serving recording from object storage: ${fullPath}`);
      
      const { ObjectStorageService } = await import('./objectStorage');
      const objStorage = new ObjectStorageService();
      const file = await objStorage.getFile(fullPath);
      
      await objStorage.downloadObject(file, res);
      console.log(`✅ Successfully served recording: ${fullPath}`);
    } catch (error) {
      console.error('❌ Error serving recording from object storage:', error);
      if (error instanceof (await import('./objectStorage')).ObjectNotFoundError) {
        return res.status(404).json({ error: 'Recording not found' });
      }
      res.status(500).json({ error: 'Failed to serve recording' });
    }
  });

  // Download and store a specific recording from Taalk
  app.post("/api/aoi-precheck/recording/:sessionId/download", async (req, res) => {
    try {
      const { sessionId } = req.params;
      
      if (!sessionId || !supabaseAdmin) {
        return res.status(400).json({ error: 'Session ID required' });
      }
      
      // Get session details
      const { data: session } = await supabaseAdmin
        .from('verification_sessions')
        .select('id, session_id, taalk_call_id, taalk_call_url')
        .eq('session_id', sessionId)
        .single();
      
      if (!session) {
        return res.status(404).json({ error: 'Session not found' });
      }
      
      // If already stored, return the URL
      if (session.taalk_call_url && session.taalk_call_url.includes('/api/objstore/')) {
        return res.json({ 
          success: true, 
          url: session.taalk_call_url,
          message: 'Recording already stored' 
        });
      }
      
      const callId = session.taalk_call_id || session.session_id;
      const taalkUrl = `https://api.taalk.ai/api/calls/${callId}/recording?db=michaelmandella`;
      const taalkApiKey = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJrZXkiOiJ0YWFsay4zN2RhMGU2NS1kMGVjLTQxYWYtOGQzYi03MWRjNTJiNGNiMmYiLCJuYW1lIjoidGFhbGsiLCJleHAiOjIwNTUwMzU2OTJ9.Ywh89Z0PvELHylJReZo8KPOiL7xX21BoBYe16OZfJw4";
      
      console.log(`🎵 Downloading recording for ${sessionId} from Taalk...`);
      
      // Try to download from Taalk
