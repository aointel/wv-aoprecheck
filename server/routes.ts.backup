  // Check call status for real-time updates (Enhanced with Taalk tracking)
  app.get('/api/verification/session/:sessionId/call-status', async (req, res) => {
    try {
      // Disable caching to ensure fresh data
      res.set('Cache-Control', 'no-cache, no-store, must-revalidate');
      res.set('Pragma', 'no-cache');
      res.set('Expires', '0');

      const { sessionId } = req.params;
      
      // Get session with Taalk call data
      const session = await storage.getVerificationSession(sessionId);
      if (!session) {
        console.error(`❌ Session not found in database: ${sessionId}`);
        return res.status(404).json({ error: 'Session not found' });
      }

      console.log(`📊 Real-time call status for session ${sessionId}:`, {
        sessionId: session.sessionId,
        taalkCallId: session.taalkCallId,
        taalkCallStatus: session.taalkCallStatus,
        taalkCallInitiatedAt: session.taalkCallInitiatedAt,
        taalkCallCompletedAt: session.taalkCallCompletedAt,
        callCompleted: session.callCompleted
      });

      const currentTime = Date.now();

      // Calculate duration if call is completed
      let duration = session.taalkCallDuration || 0;
      if (!duration && session.taalkCallCompletedAt && session.taalkCallInitiatedAt) {
        const startTime = new Date(session.taalkCallInitiatedAt).getTime();
        const endTime = new Date(session.taalkCallCompletedAt).getTime();
        duration = Math.floor((endTime - startTime) / 1000); // Duration in seconds
      }

      // Determine call status based on both Twilio and Taalk data
      let callStatus = 'not_initiated';
      let isCallCompleted = false;
      let isCallActive = false;
      let answered = false;
      let progress = 'Initializing...';

      if (session.taalkCallId) {
        callStatus = session.taalkCallStatus || 'initiated';
        isCallCompleted = session.callCompleted || (session.taalkCallStatus === 'completed' && duration > 0);
        isCallActive = session.taalkCallStatus === 'answered' || session.taalkCallStatus === 'active';
        answered = session.taalkCallStatus === 'answered' || session.taalkCallStatus === 'completed';
        
        // Set progress based on call status
        if (session.taalkCallStatus === 'completed') {
          progress = 'Call completed';
        } else if (session.taalkCallStatus === 'answered' || session.taalkCallStatus === 'active') {
          progress = 'Call in progress...';
        } else if (session.taalkCallStatus === 'ringing') {
          progress = 'Ringing...';
        } else if (session.taalkCallStatus === 'initiated') {
          progress = 'Call initiated...';
        } else {
          progress = 'Processing...';
        }
      }

      // Override with Twilio data if active
      if (activeCallState.isActive) {
        isCallActive = true;
        callStatus = 'active';
      }

      const response = {
        sessionId,
        taalkCallId: session.taalkCallId || null,
        status: callStatus,
        initiatedAt: session.taalkCallInitiatedAt || null,
        completedAt: session.taalkCallCompletedAt || null,
        duration,
        answered,
        isCallCompleted,
        isCallActive,
        progress,
        twilioCallActive: activeCallState.isActive,
        twilioCallSid: activeCallState.callSid
      };

      console.log(`📊 Real-time call status for session ${sessionId}:`, response);
      res.json(response);
    } catch (error) {
      console.error('Error checking enhanced call status:', error);
      res.status(500).json({ error: 'Failed to check call status' });
    }
  });

  // Simple call status endpoint without session validation
  app.get('/api/call-status', (req, res) => {
    res.set('Cache-Control', 'no-cache, no-store, must-revalidate');
    res.set('Pragma', 'no-cache');
    res.set('Expires', '0');

    console.log(`Global call status: isActive=${activeCallState.isActive}, startTime=${activeCallState.startTime}, callSid=${activeCallState.callSid}`);

    res.json({ 
      callActive: activeCallState.isActive, 
      status: activeCallState.isActive ? 'connected' : 'waiting',
      callSid: activeCallState.callSid,
      startTime: activeCallState.startTime,
      currentTime: Date.now(),
      message: activeCallState.isActive 
        ? 'Call active - conference connected' 
        : 'Auto-answer system ready on +16052500834'
    });
  });

  // Profile picture upload endpoint
  app.post("/api/agent/upload-profile-picture", upload.single('profilePicture'), async (req, res) => {
    try {
      if (!req.file) {
        return res.status(400).json({ error: 'No file uploaded' });
      }

      // Validate file type
      if (!req.file.mimetype.startsWith('image/')) {
        return res.status(400).json({ error: 'Invalid file type. Please upload an image.' });
      }

      // Generate unique filename
      const timestamp = Date.now();
      const originalName = req.file.originalname;
      const extension = originalName.substring(originalName.lastIndexOf('.'));
      const filename = `profile-${timestamp}${extension}`;
      
      // For now, store locally (in production, you'd use cloud storage)
      const profilePictureUrl = `/uploads/${filename}`;
      
      res.json({ 
        success: true, 
        profilePictureUrl,
        message: 'Profile picture uploaded successfully' 
      });
    } catch (error) {
      console.error('Profile picture upload error:', error);
      res.status(500).json({ error: 'Failed to upload profile picture' });
    }
  });

