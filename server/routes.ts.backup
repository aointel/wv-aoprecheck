            success: true,
            profile: profile,
            message: `Found complete profile for ${email}`
          });
        } else {
          return res.json({
            success: false,
            profile: null,
            message: `No LinkedIn profile found for ${email}`
          });
        }
      } 
      
      if (emails && Array.isArray(emails)) {
        // Batch email enrichment
        
        // Save all profiles to database
        for (const profile of profiles) {
          try {
            await db
              .insert(schema.recruitCandidates)
              .values({
                email: profile.email,
                linkedinUrl: profile.linkedin_url,
                fullName: profile.full_name,
                firstName: profile.first_name,
