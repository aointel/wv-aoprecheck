        return res.status(400).json({
          error: 'Either email (string) or emails (array) is required'
        });
      }

      console.log(`📧 LinkedIn enrichment request:`, { email, emails: emails?.length });

      if (email) {
        // Single email enrichment
        
        if (profile) {
          // Save to database
          try {
            const insertResult = await db
              .insert(schema.recruitCandidates)
              .values({
                email: profile.email,
                linkedinUrl: profile.linkedin_url,
                fullName: profile.full_name,
                firstName: profile.first_name,
                lastName: profile.last_name,
                jobTitle: profile.job_title,
                companyName: profile.company_name,
                companyWebsite: profile.company_website,
                companyIndustry: profile.company_industry,
                companySize: profile.company_size,
                location: profile.location,
                city: profile.city,
                state: profile.state,
                country: profile.country,
                phoneNumbers: profile.phone_numbers,
                workEmail: profile.work_email,
                education: profile.education,
                experience: profile.experience,
                skills: profile.skills,
                summary: profile.summary,
                headline: profile.headline,
                industry: profile.industry,
                socialProfiles: profile.social_profiles,
                enrichedAt: new Date(profile.enriched_at)
              })
              .onConflictDoUpdate({
                target: schema.recruitCandidates.email,
                set: {
                  linkedinUrl: profile.linkedin_url,
                  fullName: profile.full_name,
                  firstName: profile.first_name,
                  lastName: profile.last_name,
                  jobTitle: profile.job_title,
                  companyName: profile.company_name,
                  companyWebsite: profile.company_website,
                  companyIndustry: profile.company_industry,
                  companySize: profile.company_size,
                  location: profile.location,
                  city: profile.city,
                  state: profile.state,
                  country: profile.country,
                  phoneNumbers: profile.phone_numbers,
                  workEmail: profile.work_email,
                  education: profile.education,
                  experience: profile.experience,
                  skills: profile.skills,
                  summary: profile.summary,
                  headline: profile.headline,
                  industry: profile.industry,
                  socialProfiles: profile.social_profiles,
                  enrichedAt: new Date(profile.enriched_at),
                  updatedAt: new Date()
                }
              });

            console.log(`✅ Saved recruit profile for ${email} to database`);
          } catch (dbError) {
            console.error(`❌ Failed to save recruit profile to database:`, dbError);
          }

