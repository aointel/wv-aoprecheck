// Configure multer for file uploads
const upload = multer({
  dest: 'uploads/',
  limits: {
    fileSize: 10 * 1024 * 1024, // 10MB limit
  },
  fileFilter: (req, file, cb) => {
    if (file.mimetype.startsWith('image/')) {
      cb(null, true);
    } else {
      cb(new Error('Only image files are allowed'));
    }
  },
});

// Initialize permanent call monitoring service
const callMonitoring = new CallMonitoringService(pool);

// Configure AWS S3 for Supabase
const s3 = new AWS.S3({
  accessKeyId: S3_ACCESS_KEY_ID,
  secretAccessKey: S3_SECRET_ACCESS_KEY,
  endpoint: S3_ENDPOINT,
  region: S3_REGION,
  s3ForcePathStyle: true,
  signatureVersion: 'v4'
});

export async function registerRoutes(app: Express): Promise<Server> {
  console.log('🚀 Starting server initialization...');
  console.log('💎 LOADING FIXED AOI REPORTS ROUTES v2.0 - BUG FIXES APPLIED');
  
  // Remove CSP headers - let default browser security handle it
  app.use((req, res, next) => {
    next();
  });
  
  // VERSION ENFORCEMENT - DISABLED (no longer needed)
  // app.use('/api', (req, res, next) => {
  //   const appVersion = req.headers['x-app-version'] as string;
  //   
  //   // If NO version header = web browser, ALLOW IT (don't block web access)
  //   if (!appVersion) {
  //     return next();
  //   }
  //   
  //   // If Electron app, check if version is 1.0.3+
  //   const parseVersion = (v: string) => {
  //     const parts = v.split('.').map(Number);
  //     return parts[0] * 10000 + parts[1] * 100 + parts[2];
  //   };
  //   
  //   const clientVersion = parseVersion(appVersion);
  //   const minimumVersion = parseVersion('1.0.3');
  //   
  //   if (clientVersion >= minimumVersion) {
  //     console.log(`✅ Electron v${appVersion} is OK - ALLOWING`);
  //     return next();
  //   } else {
  //     console.log(`❌ Electron v${appVersion} is TOO OLD - BLOCKING`);
  //     return res.status(426).json({
  //       error: 'Update Required',
  //       message: `Your Electron app version (${appVersion}) is outdated. Please download v1.0.3 installer.`,
  //       downloadUrl: 'https://aoirail-production.up.railway.app/downloads'
  //     });
  //   }
  // });
  
  // CRITICAL: WebRTC routes MUST be registered FIRST 
  console.log('🔧 Registering EMERGENCY WebRTC webhook at startup...');
  
  // ✅ 2. WebRTC endpoint - SUPPORT BOTH DIRECT CALLS AND CONFERENCES
  app.all("/voice", (req, res) => {
    console.log('🔥 VOICE ENDPOINT HIT FOR WEBRTC');
    console.log('Request method:', req.method);
    console.log('Request body:', req.body);
    console.log('Request query:', req.query);
    console.log('ALL REQUEST PARAMS:', JSON.stringify({ body: req.body, query: req.query }, null, 2));
    
    // Check if this is a direct call (has 'To' parameter) or conference call
    // Twilio sends custom params in the request body
    const toNumber = req.body.To || req.query.To;
    const conferenceName = req.body.conference || req.body.conferenceName || req.query.conference || req.query.conferenceName;
    
    console.log('🎧 /voice - To:', toNumber, 'Conference:', conferenceName);
    
    let twiml;
    
    if (toNumber) {
      // DIRECT CALL - Agent calling lead directly (NO CONFERENCE)
      console.log('📞 DIRECT CALL - Agent calling lead:', toNumber);
      
      // Get local presence number based on lead state (if provided)
      const leadState = req.body.leadState || req.query.leadState;
      let callerIdNumber = TWILIO_PHONE_NUMBER;
      
      if (leadState) {
        try {
          const localNumber = localPresenceService.getLocalNumber(leadState);
          if (localNumber && localNumber !== TWILIO_PHONE_NUMBER) {
            callerIdNumber = localNumber;
            console.log(`📞 LOCAL PRESENCE: Using ${localNumber} for ${leadState} lead`);
          } else {
            console.log(`📞 No local presence number available for ${leadState}, using default: ${TWILIO_PHONE_NUMBER}`);
          }
        } catch (error) {
          console.error('❌ Local presence lookup failed, using default:', error);
        }
      } else {
        console.log(`⚠️ No leadState provided, using default number: ${TWILIO_PHONE_NUMBER}`);
      }
      
      // Ensure phone number has +1 country code for US numbers
      const formattedToNumber = toNumber.startsWith('+') ? toNumber : `+1${toNumber.replace(/\D/g, '')}`;
      console.log(`📞 Formatted phone: ${toNumber} → ${formattedToNumber}`);
      
      twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Dial callerId="${callerIdNumber}">${formattedToNumber}</Dial>
</Response>`;
    } else if (conferenceName) {
      // CONFERENCE CALL - For verification calls only
      console.log('🎧 CONFERENCE CALL - Conference:', conferenceName);
      twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Dial>
    <Conference 
      beep="false" 
      maxParticipants="2" 
      endConferenceOnExit="true" 
      startConferenceOnEnter="true" 
      waitUrl="http://twimlets.com/holdmusic?Bucket=com.twilio.music.soft-rock">${conferenceName}</Conference>
  </Dial>
</Response>`;
    } else {
      // ERROR - No call destination specified
      console.log('❌ ERROR - No call destination specified');
      twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say>Error: No call destination specified</Say>
</Response>`;
    }

    console.log('🎯 Sending WebRTC TwiML:', twiml);
    res.type('text/xml');
    res.send(twiml);
  });
  
  // ADD SIMPLE GET TEST TO VERIFY ROUTE REGISTRATION
  app.get("/api/webrtc-test", (req, res) => {
    console.log('🔥 GET TEST ENDPOINT HIT - ROUTES ARE WORKING');
    res.json({ message: "WebRTC routes are working", timestamp: Date.now() });
  });
  
  console.log('✅ Emergency WebRTC endpoint registered: /api/webrtc-connect');
  console.log('✅ Test endpoint registered: /api/webrtc-test');
  console.log('🔧 Now proceeding with normal server initialization...');
  
  // Test database connection first
  try {
    console.log('🔍 Testing database connection...');
    const testQuery = await db.execute('SELECT 1 as test');
    console.log('✅ Database connection successful');
  } catch (dbError) {
    console.error('❌ Database connection failed:', dbError);
    console.log('⚠️ Server will continue starting with limited functionality');
  }
  
  // Initialize HTTP server and phone bridge
  const httpServer = createServer(app);
  
  // Initialize WebSocket server for credit notifications and video
  const wss = new WebSocketServer({ 
    server: httpServer,
    path: '/ws',
    perMessageDeflate: false,
    maxPayload: 64 * 1024 // 64KB max
  });
  
  // Store WebSocket server reference for API endpoint access
  videoWebSocketServer = wss;
  
  // Store room connections for video conferencing (using module-scope videoRooms)
  
  // WebSocket connection handler for credit notifications and video conferencing
  wss.on('connection', (ws, request) => {
    console.log('🔌 WebSocket client connected from:', request.socket.remoteAddress);
    
    // Parse URL to get user info if needed
    const parsedUrl = url.parse(request.url || '', true);
    const userEmail = parsedUrl.query.user as string;
    
    if (userEmail) {
      console.log(`📡 WebSocket connected for user: ${userEmail}`);
    }
    
    // Video conferencing variables
    let currentRoom: string | null = null;
    let participantInfo: any = null;
    
    // Register client for credit notifications
    creditService.addWebSocketClient(ws);
    
    // Send welcome message
    ws.send(JSON.stringify({
      type: 'connection',
      message: 'Connected to credit notifications and video services'
    }));
    
    // Handle incoming messages
    ws.on('message', (data) => {
      try {
        const message = JSON.parse(data.toString());
        console.log('📡 WebSocket received message:', message.type, message);
        
        switch (message.type) {
          case 'subscribe':
            // Handle credit notification subscriptions
            if (message.channel === 'credit_notifications') {
              console.log('🔔 Client subscribed to credit notifications');
              ws.send(JSON.stringify({
                type: 'subscription_confirmed',
                channel: 'credit_notifications'
              }));
            }
            break;
            
          case 'join-room':
            currentRoom = message.roomId;
            participantInfo = {
              name: message.participantName || 'Unknown',
              type: message.participantType || 'unknown'
            };
            
            if (!currentRoom) {
              console.error('❌ No room ID provided');
              return;
            }
            
            // Add client to room
            if (!videoRooms.has(currentRoom)) {
              videoRooms.set(currentRoom, new Set<WebSocket>());
            }
            const roomSet = videoRooms.get(currentRoom);
            if (roomSet) {
              roomSet.add(ws);
            }
            
            // Notify client they joined
            ws.send(JSON.stringify({
              type: 'room-joined',
              roomId: currentRoom,
              participantCount: roomSet?.size || 0
            }));
            
            // Notify other clients in room
            const roomClients = videoRooms.get(currentRoom);
            if (roomClients) {
              roomClients.forEach((client: WebSocket) => {
                if (client !== ws && client.readyState === WebSocket.OPEN) {
                  client.send(JSON.stringify({
                    type: 'user-joined',
                    roomId: currentRoom,
                    participantName: participantInfo.name,
                    participantType: participantInfo.type
                  }));
                }
              });
            }
            
            console.log(`👥 ${participantInfo.name} (${participantInfo.type}) joined video room: ${currentRoom} (${roomClients?.size || 0} total)`);
            break;
            
          case 'agent_message':
            // Handle agent sending message to waiting room
            if (message.roomId && message.message) {
              const targetRoom = videoRooms.get(message.roomId);
              if (targetRoom) {
                targetRoom.forEach((client: WebSocket) => {
                  if (client.readyState === WebSocket.OPEN) {
                    client.send(JSON.stringify({
                      type: 'agent_message',
                      roomId: message.roomId,
                      message: message.message,
                      agentName: message.agentName || 'Agent',
                      timestamp: new Date().toISOString()
                    }));
                  }
                });
                console.log(`📢 Agent message sent to room ${message.roomId}: ${message.message}`);
              }
            }
            break;
            
          case 'offer':
          case 'answer':
          case 'ice-candidate':
          case 'leave-room':
            // Forward WebRTC signaling messages to other clients in room
            if (currentRoom && videoRooms.has(currentRoom)) {
              const roomClients = videoRooms.get(currentRoom)!;
              roomClients.forEach((client: WebSocket) => {
                if (client !== ws && client.readyState === WebSocket.OPEN) {
                  client.send(JSON.stringify(message));
                }
              });
              console.log(`🔄 Relayed ${message.type} to ${roomClients.size - 1} clients in room ${currentRoom}`);
            }
            break;
            
          default:
            // Echo back for testing (legacy behavior)
            ws.send(JSON.stringify({
              type: 'echo',
              data: message
            }));
        }
      } catch (error) {
        console.error('❌ WebSocket message error:', error);
      }
    });
    
    // Handle connection close
    ws.on('close', () => {
      console.log('🔌 WebSocket client disconnected');
      
      // Remove client from room
      if (currentRoom && videoRooms.has(currentRoom)) {
        const roomClients = videoRooms.get(currentRoom)!;
        roomClients.delete(ws);
        
        if (roomClients.size === 0) {
          videoRooms.delete(currentRoom);
          console.log(`🚪 Video room ${currentRoom} deleted (empty)`);
        } else {
          console.log(`👋 Client left video room: ${currentRoom} (${roomClients.size} remaining)`);
        }
      }
    });
    
    // Handle errors
    ws.on('error', (error) => {
      console.error('❌ WebSocket error:', error);
    });
  });
  
  console.log('✅ WebSocket server initialized at /ws');
  
  // Initialize phone bridge only if Twilio is available
  let phoneBridge: WebRTCPhoneBridge | null = null;
  try {
    if (TWILIO_ACCOUNT_SID && TWILIO_AUTH_TOKEN) {
      phoneBridge = new WebRTCPhoneBridge(httpServer);
      console.log('✅ WebRTC phone bridge initialized with hard-coded credentials');
    } else {
      console.warn('⚠️ Skipping WebRTC phone bridge - Twilio credentials missing');
    }
  } catch (error) {
    console.error('❌ Failed to initialize WebRTC phone bridge:', error);
  }

  // Automatically configure Twilio webhook for first available phone number
  if (TWILIO_ACCOUNT_SID && TWILIO_AUTH_TOKEN) {
    setTimeout(async () => {
      try {
        const webhookConfig = await twilioWebhookSetup.setupWebhook();
        console.log('✅ Twilio webhook configured automatically:', webhookConfig);
      } catch (error) {
        console.error('❌ Failed to configure Twilio webhook:', error);
        console.log('Manual configuration required in Twilio Console');
      }
    }, 2000);
  }

  // Initialize admin system with retry logic
  setTimeout(async () => {
    try {
      await AdminService.initializeRoles();
      console.log('✅ Admin system initialized');
    } catch (error) {
      console.error('❌ Failed to initialize admin system:', error);
      // Retry once after 5 seconds
      setTimeout(async () => {
        try {
          await AdminService.initializeRoles();
          console.log('✅ Admin system initialized (retry)');
        } catch (retryError) {
          console.error('❌ Failed to initialize admin system (retry):', retryError);
        }
      }, 5000);
    }
  }, 1000);

  // Initialize local presence service to load all state numbers
  setTimeout(async () => {
    try {
      console.log('🔍 Initializing local presence service to load all state numbers...');
      await localPresenceService.initialize();
      console.log('✅ Local presence service initialized - state-specific numbers loaded');
    } catch (error) {
      console.error('❌ Failed to initialize local presence service:', error);
    }
  }, 1000);

  // Initialize Taalk hotlead scheduler to run every 15 minutes
  setTimeout(async () => {
    try {
      console.log('🔍 Initializing Taalk hotlead scheduler for automated call-to-hotlead conversion...');
      // DISABLED: const { taalkHotleadScheduler } = await import('./taalk-hotlead-scheduler');
      console.log('🚫 Taalk hotlead scheduler DISABLED to prevent webhook noise');
    } catch (error) {
      console.error('❌ Failed to initialize Taalk hotlead scheduler:', error);
    }
  }, 2000);

  // DISABLED: Conference keeper was causing "call already active" detection issues
  // The persistent calls show up in Twilio logs as active calls
  // setTimeout(async () => {
  //   try {
  //     await conferenceKeeper.startConferenceKeeper();
  //     await conferenceAnchor.createAnchorCall();
  //     console.log('🎯 Conference keeper started with persistent anchor - calls to +16052500834 will join persistent conference');
  //   } catch (error) {
  //     console.error('❌ Failed to start conference keeper:', error);
  //   }
  // }, 3000); // Wait 3 seconds for server to fully initialize

  // Zapier webhook to upload Taalk hotleads
  app.post("/api/webhooks/upload-taalkleads", async (req, res) => {
    try {
      console.log('📥 Zapier Taalk Hotlead Webhook received');
      console.log('Payload:', JSON.stringify(req.body, null, 2));
      
      const {
        firstName,
        lastName,
        clientphone,
        phone,
        Email,
        Taalk_secretkey,
        Taalk_LeadId,
        Taalk_GroupCode,
        Taalk_State,
        Taalk_Zip,
        Taalk_Email,
        Taalk_Market,
        Taalk_Reffered,
        Taalk_SponsorOrg,
        Taalk_Address,
        Taalk_Relationship,
        Taalk_Lead_Source
      } = req.body;
      
      // Determine which phone to use (prioritize clientphone, fallback to phone)
      const leadPhone = clientphone || phone;
      const leadEmail = Taalk_Email || Email;
      
      if (!leadPhone || !Taalk_LeadId) {
        console.error('❌ Missing required fields: phone or Taalk_LeadId');
        return res.status(400).json({ error: 'Missing required fields: phone and Taalk_LeadId are required' });
      }
      
      // Check if lead already exists
      const { data: existingLead } = await supabaseAdmin
        .from('masterlead')
        .select('id, taalk_lead_id, first_name, last_name')
        .eq('taalk_lead_id', Taalk_LeadId)
        .single();
      
      let insertedLead;
      let insertError;
      
      if (existingLead) {
        // Update existing lead - DO NOT overwrite cnresolution or cn_email
        const { data, error } = await supabaseAdmin
          .from('masterlead')
          .update({
            first_name: firstName,
            last_name: lastName,
            phone: leadPhone,
            email: leadEmail,
            taalk_state: Taalk_State,
            state: Taalk_State,
            taalk_zip: Taalk_Zip,
            zip: Taalk_Zip,
            taalk_market: Taalk_Market || 'Hot Lead',
            taalk_group_code: Taalk_GroupCode,
            taalk_sponsor_org: Taalk_SponsorOrg,
            taalk_address: Taalk_Address,
            address: Taalk_Address,
            taalk_relationship: Taalk_Relationship,
            taalk_lead_source: Taalk_Lead_Source,
            taalk_reffered: Taalk_Reffered,
            taalk_email: Taalk_Email,
            taalk_city: req.body.Taalk_City,
            is_hot_lead: true,
            updated_at: new Date().toISOString()
          })
          .eq('taalk_lead_id', Taalk_LeadId)
          .select('id, taalk_lead_id, first_name, last_name')
          .single();
        
        insertedLead = data;
        insertError = error;
        console.log('✅ Updated existing lead:', Taalk_LeadId);
      } else {
        // Insert new lead
        const { data, error } = await supabaseAdmin
          .from('masterlead')
          .insert({
            taalk_lead_id: Taalk_LeadId,
            first_name: firstName,
            last_name: lastName,
            phone: leadPhone,
            email: leadEmail,
            taalk_state: Taalk_State,
            state: Taalk_State,
            taalk_zip: Taalk_Zip,
            zip: Taalk_Zip,
            taalk_market: Taalk_Market || 'Hot Lead',
            taalk_group_code: Taalk_GroupCode,
            taalk_sponsor_org: Taalk_SponsorOrg,
            taalk_address: Taalk_Address,
            address: Taalk_Address,
            taalk_relationship: Taalk_Relationship,
            taalk_lead_source: Taalk_Lead_Source,
            taalk_reffered: Taalk_Reffered,
            taalk_email: Taalk_Email,
            taalk_city: req.body.Taalk_City,
            cnresolution: 'pending',
            is_hot_lead: true,
            status: 'new',
            created_at: new Date().toISOString(),
            updated_at: new Date().toISOString()
          })
          .select('id, taalk_lead_id, first_name, last_name')
          .single();
        
        insertedLead = data;
        insertError = error;
        console.log('✅ Inserted new lead:', Taalk_LeadId);
