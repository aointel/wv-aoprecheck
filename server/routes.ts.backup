      console.log('🔧 Fixing Twilio phone number webhooks...');
      
      const baseUrl = `https://${req.get('host')}`;
      const phoneNumbers = await twilioClient.incomingPhoneNumbers.list();
      
      const updates = [];
      for (const number of phoneNumbers) {
        // Update each phone number to use our webhook
        const updated = await twilioClient.incomingPhoneNumbers(number.sid).update({
          voiceUrl: `${baseUrl}/api/taalk/incoming-call`,
          statusCallback: `${baseUrl}/api/twilio/call-status`
        });
        
        updates.push({
          phoneNumber: number.phoneNumber,
          sid: number.sid,
          oldVoiceUrl: number.voiceUrl,
          newVoiceUrl: updated.voiceUrl,
          newStatusCallback: updated.statusCallback
        });
        
        console.log(`✅ Updated ${number.phoneNumber} webhook to ${updated.voiceUrl}`);
      }
      
      res.json({ 
        success: true, 
        message: `Updated ${updates.length} phone number webhooks`,
        updates: updates
      });
      
    } catch (error) {
      console.error('❌ Failed to fix Twilio webhooks:', error);
      res.status(500).json({ success: false, error: error.message });
    }
  });

  // Manual hotlead entitlement check endpoint  
  app.post("/api/hotlead-entitlement-check", async (req, res) => {
    try {
      const { agentEmail, callCount } = req.body;
      
      if (!agentEmail || callCount === undefined) {
        return res.status(400).json({ success: false, error: 'agentEmail and callCount required' });
      }
      
      console.log(`🔍 MANUAL CHECK: Checking hotlead entitlements for ${agentEmail} with ${callCount} calls`);
      
      await checkAgentForHotleadAssignment(agentEmail, callCount);
      
      const currentEntitlements = hotleadEntitlements.get(agentEmail) || 0;
      
      res.json({
        success: true,
        agentEmail,
        callCount,
        hotleadsEarned: Math.floor(callCount / 5),
        currentEntitlements,
        message: `Checked entitlements for ${agentEmail}`
      });
      
    } catch (error) {
      console.error('❌ Manual hotlead check error:', error);
      res.status(500).json({ success: false, error: error.message });
    }
  });

  return httpServer;
}

// VDP Monitoring Service
function startVDPAgentMonitoring() {
  setInterval(async () => {
    try {
      // Get all active agents from recent calls or active sessions
      const activeAgents = await getActiveAgents();
      
      for (const agentEmail of activeAgents) {
        await checkAgentVDPStatus(agentEmail);
      }
    } catch (error) {
      console.error('❌ VDP monitoring service error:', error);
    }
  }, 30000); // Check every 30 seconds
}

