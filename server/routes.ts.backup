  // Desktop Application Download Endpoints
  app.get("/api/desktop/download/:filename", (req, res) => {
    try {
      const { filename } = req.params;
      const allowedFiles = [
        'ConnectNow.exe',
        'ConnectNow-Setup.exe', 
        'ConnectNow-Desktop-1.0.1.exe',
        'ConnectNow-Setup-1.0.1.exe',
        'ConnectNow-1.0.2-Mac.tar.gz',
        'AOIntelligence-Setup-1.0.3.exe',
        'AOIntelligence-Setup-1.0.4.exe'
      ];

      if (!allowedFiles.includes(filename)) {
        return res.status(404).json({ error: 'File not found' });
      }

      // Check in public/installers first, then electron-dist
      let filePath = path.join(process.cwd(), 'public', 'installers', filename);
      if (!fs.existsSync(filePath)) {
        filePath = path.join(process.cwd(), 'electron-dist', filename);
      }
      if (!fs.existsSync(filePath)) {
        filePath = path.join(process.cwd(), 'uploads', 'installers', filename);
      }
      
      // Set appropriate headers for download
      res.setHeader('Content-Disposition', `attachment; filename="${filename}"`);
      res.setHeader('Content-Type', 'application/octet-stream');
      
      // Send file
      res.sendFile(filePath, (err) => {
        if (err) {
          console.error(`Download error for ${filename}:`, err);
          res.status(404).json({ error: 'File not found' });
        }
      });
    } catch (error) {
      console.error('Desktop download error:', error);
      res.status(500).json({ error: 'Download failed' });
    }
  });

  // Verification Session File Download Endpoints
  app.get("/api/aoi-precheck/download/screenshot/:sessionId", async (req, res) => {
    try {
      const { sessionId } = req.params;
      console.log(`📸 Screenshot download requested for session: ${sessionId}`);
      
      // Get session data to find screenshot path
      const { data: session, error } = await supabaseAdmin
        .from('verification_sessions')
        .select('screenshot_path, first_name, last_name')
        .eq('id', sessionId)
        .single();

      console.log(`📸 Screenshot query result:`, { session, error });

      if (error || !session || !session.screenshot_path) {
        console.error(`❌ Screenshot not found: ${error?.message || 'No screenshot_path'}`);
        return res.status(404).json({ error: 'Screenshot not found', details: error?.message });
      }
      
      console.log(`📸 Screenshot path found: ${session.screenshot_path}`);

      // Handle different screenshot path formats
      let downloadUrl;
      if (session.screenshot_path.startsWith('http')) {
        // External URL - redirect to it
        return res.redirect(session.screenshot_path);
      } else {
        // Local file path - serve from uploads or Supabase storage
        const fileName = session.screenshot_path.includes('/') 
          ? session.screenshot_path.split('/').pop() 
          : session.screenshot_path;
        
        // Try to get from Supabase storage first - try multiple extensions
        const extensions = ['', '.jpg', '.jpeg', '.png'];
        let data = null;
        let downloadError = null;
        let successPath = null;
        
        for (const ext of extensions) {
          const testPath = session.screenshot_path + ext;
          console.log(`📸 Trying Supabase storage path: ${testPath}`);
          const result = await supabaseAdmin.storage
            .from('verify_agent_screenshot')
            .download(testPath);
          
          if (!result.error && result.data) {
            data = result.data;
            downloadError = null;
            successPath = testPath;
            console.log(`✅ Found screenshot at: ${testPath}`);
            break;
          } else {
            console.log(`❌ Not found at ${testPath}:`, result.error?.message);
          }
        }

        if (!downloadError && data) {
          // Set download headers
          const clientName = `${session.first_name || ''} ${session.last_name || ''}`.trim();
          const filename = `screenshot-${clientName || sessionId}-${fileName}.jpg`;
          
          res.setHeader('Content-Disposition', `inline; filename="${filename}"`);
          res.setHeader('Content-Type', 'image/jpeg');
          
          // Convert blob to buffer and send
          const arrayBuffer = await data.arrayBuffer();
          const buffer = Buffer.from(arrayBuffer);
          res.send(buffer);
        } else {
          // Fallback to local file - try multiple extensions
          let fileFound = false;
          for (const ext of extensions) {
            const filePath = path.join(process.cwd(), 'uploads', session.screenshot_path + ext);
            console.log(`📸 Trying local file: ${filePath}`);
            if (fs.existsSync(filePath)) {
              console.log(`✅ Found local file: ${filePath}`);
              const clientName = `${session.first_name || ''} ${session.last_name || ''}`.trim();
              const filename = `screenshot-${clientName || sessionId}-${path.basename(filePath)}`;
              res.setHeader('Content-Disposition', `inline; filename="${filename}"`);
              res.sendFile(filePath);
              fileFound = true;
              break;
            }
          }
          
          if (!fileFound) {
            console.error(`❌ Screenshot not found in storage or local files for path: ${session.screenshot_path}`);
            return res.status(404).json({ 
              error: 'Screenshot file not found',
              path: session.screenshot_path,
              triedExtensions: extensions
            });
          }
        }
      }
    } catch (error) {
      console.error('Screenshot download error:', error);
      res.status(500).json({ error: 'Download failed' });
    }
  });

  app.get("/api/aoi-precheck/download/recording/:sessionId", async (req, res) => {
    try {
      const { sessionId } = req.params;
      
