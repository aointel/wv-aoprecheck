  app.post("/api/twilio/webrtc-connect", async (req, res) => {
    try {
      const { sessionId, conference } = req.body;
      console.log('🔗 WebRTC connection request:', { sessionId, conference });

      // Create an actual Twilio call that connects to the WebRTC client and joins conference
      const call = await twilioClient.calls.create({
        twiml: `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say voice="alice">Connecting WebRTC to AO Verification Live conference.</Say>
  <Dial>
    <Conference 
      statusCallback="https://${req.get('host')}/api/twilio/conference-status"
      statusCallbackEvent="start end join leave"
      startConferenceOnEnter="false"
      endConferenceOnExit="false">AO-Verification-Live</Conference>
  </Dial>
</Response>`,
        to: `client:WebRTC-Agent-${Date.now()}`,
        from: TWILIO_PHONE_NUMBER!,
        statusCallback: `https://${req.get('host')}/api/twilio/call-status`,
        statusCallbackEvent: ['initiated', 'ringing', 'answered', 'completed'],
        statusCallbackMethod: 'POST',
        metadata: {
          agent_email: 'webrtc@aoglobelife.com',
          agent_name: 'WebRTC Agent',
          call_source: 'webrtc_connection',
          session_id: sessionId,
          conference_name: conference || 'AO-Verification-Live',
          timestamp: new Date().toISOString()
