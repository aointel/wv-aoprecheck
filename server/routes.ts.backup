  // Start a presentation session
  app.post("/api/presentations/start", async (req, res) => {
    const requestId = Math.random().toString(36).substr(2, 9);
    try {
      const { agent_email, agent_name, presentation_url, presentation_type, window_title, app_version, platform, os_version } = req.body;
      console.log(`\n🎬 [${requestId}] ===== PRESENTATION START REQUEST =====`);
      console.log(`   Agent: ${agent_email}`);
      console.log(`   Type: ${presentation_type}`);
      console.log(`   URL: ${presentation_url}`);
      console.log(`   App Version: ${app_version || 'NOT PROVIDED'} (${platform})`);
      
      console.log(`📂 [${requestId}] STEP 1: Creating session in database...`);
      const { presentationTracker } = await import('./presentation-tracker');
      const sessionId = await presentationTracker.startSession({
        agent_email,
        agent_name,
        presentation_url,
        presentation_type,
        window_title
      });
      console.log(`✅ [${requestId}] STEP 1 COMPLETE: Session created: ${sessionId}`);
      
      // STEP 1.5: Record app version if provided
      if (app_version && agent_email) {
        console.log(`📱 [${requestId}] Recording app version: ${app_version}`);
        try {
          await supabaseAdmin
            .from('app_versions')
            .upsert({
              agent_email,
              agent_name,
              app_version,
              platform: platform || 'unknown',
              os_version: os_version || 'unknown',
              last_seen: new Date().toISOString(),
              updated_at: new Date().toISOString()
            }, {
              onConflict: 'agent_email'
            });
          console.log(`✅ [${requestId}] App version recorded`);
        } catch (versionError) {
          console.error(`⚠️ [${requestId}] Failed to record app version:`, versionError);
          // Don't fail the request
        }
      }
      
      // CRITICAL: Register with live tracker so screenshots can be received
      console.log(`📂 [${requestId}] STEP 2: Registering with live tracker...`);
      try {
        const { presentationLiveTracker } = await import('./presentation-live-tracker');
        console.log(`   [${requestId}] Live tracker imported, calling startPresentation()...`);
        
        const registrationData = {
          sessionId,
          agentEmail: agent_email,
          agentName: agent_name,
          clientName: 'Unknown',
          clientPhone: 'Unknown',
          presentationType: presentation_type,
          presentationUrl: presentation_url
        };
        console.log(`   [${requestId}] Registration data:`, JSON.stringify(registrationData, null, 2));
        
        presentationLiveTracker.startPresentation(registrationData);
        console.log(`✅ [${requestId}] STEP 2 COMPLETE: Live tracker registered`);
      } catch (trackerError: any) {
        console.error(`❌❌❌ [${requestId}] STEP 2 FAILED: Live tracker registration error:`);
        console.error(`   Error name: ${trackerError?.name}`);
        console.error(`   Error message: ${trackerError?.message}`);
        console.error(`   Error stack: ${trackerError?.stack}`);
        // Don't fail the whole request, but this is critical
      }
      
      console.log(`📤 [${requestId}] STEP 3: Sending response to Electron...`);
      const response = { 
        success: true, 
        sessionId,
        startScreenshotCapture: true,
        captureInterval: 30000 // 30 seconds
      };
      console.log(`✅ [${requestId}] ===== PRESENTATION START COMPLETE =====\n`);
      
      // Tell Electron to NOT start screenshot capture automatically
      response.startScreenshotCapture = false; // Disable auto-capture
      response.captureInterval = 0; // No screenshots
      
      res.json(response);
    } catch (error: any) {
      console.error(`❌❌❌ [${requestId}] FATAL ERROR in presentation start:`, error?.message);
      console.error(`   Error stack:`, error?.stack);
      res.status(500).json({ error: error.message });
    }
  });
  
