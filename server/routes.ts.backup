      const voiceGrant = new VoiceGrant({
        outgoingApplicationSid: TWILIO_TWIML_APP_SID,
        incomingAllow: true,
      });

      token.addGrant(voiceGrant);

      const jwt = token.toJwt(); // ✅ This must be a base64 JWT string
      console.log(`✅ Issued token for identity: ${identity}`);
      res.json({ token: jwt, identity: identity });
    } catch (err: any) {
      console.error("❌ Failed to generate token:", err.message);
      res.status(500).json({ message: "Internal server error" });
    }
  });

  // Test endpoint to reconfigure Twilio webhook
  app.post("/api/test-webhook-config", async (req, res) => {
    const { phoneNumber } = req.body;
    
    try {
      // Find the phone number SID and update its webhook
      const phoneNumbers = await twilioClient.incomingPhoneNumbers.list();
      const targetNumber = phoneNumbers.find(num => num.phoneNumber === phoneNumber);
      
      if (!targetNumber) {
        return res.json({ success: false, error: "Phone number not found" });
      }
      
      // Update to point to our server instead of Taalk
      const updated = await twilioClient.incomingPhoneNumbers(targetNumber.sid).update({
        voiceUrl: 'https://aoirail-production.up.railway.app/webhook/webrtc',
        statusCallback: 'https://aoirail-production.up.railway.app/api/twilio/call-status'
      });
      
      console.log(`🔄 Reconfigured ${phoneNumber} to use our server (with lofi music)`);
      
      res.json({
        success: true,
        phoneNumber: phoneNumber,
        oldUrl: targetNumber.voiceUrl,
        newUrl: updated.voiceUrl,
        message: "Number now routes to server with lofi music"
      });
      
    } catch (error: any) {
      console.error('❌ Failed to reconfigure webhook:', error.message);
      res.json({ success: false, error: error.message });
    }
  });

  // Legacy token endpoint to return proper JWT for WebRTC (returns JSON format)
  app.get("/api/twilio/token", async (req, res) => {
    try {
      // Use the actual agent's email as identity
      const userEmail = (req.session as any)?.user?.email || req.query.userEmail || req.query.identity;
      const identity = userEmail || 'cnsysop@aoglobelife.com';
      
      const accountSid = TWILIO_ACCOUNT_SID;
      const apiKey = TWILIO_API_KEY;
      const apiSecret = TWILIO_API_SECRET;
      const twimlAppSid = TWILIO_TWIML_APP_SID;
      
      if (!accountSid || !apiKey || !apiSecret || !twimlAppSid) {
        return res.status(500).json({ error: 'Missing Twilio credentials' });
      }

      // Use your new working TwiML App SID
      const newTwimlAppSid = 'AP958ebb1810e2315e9ff008cc06e91c1d'; // Your new TwiML App
      
      const AccessToken = twilio.jwt.AccessToken;
      const VoiceGrant = AccessToken.VoiceGrant;

      const voiceGrant = new VoiceGrant({
        outgoingApplicationSid: newTwimlAppSid,
        incomingAllow: true,
      });

      const token = new AccessToken(accountSid, apiKey, apiSecret, {
        identity: identity,
        ttl: 3600
      });

      token.addGrant(voiceGrant);

      const jwt = token.toJwt();
      console.log(`🔥 Using NEW TwiML App: ${newTwimlAppSid} (points to /voice endpoint)`);
      console.log(`Generated token for identity: ${identity}`);
      console.log(`Token length: ${jwt.length} characters`);
      console.log(`OLD TWILIO_TWIML_APP_SID: ${twimlAppSid}`);
      console.log(`NEW TWILIO_TWIML_APP_SID: ${newTwimlAppSid}`);
      console.log(`AccountSid: ${accountSid?.substring(0, 10)}...`);
      console.log(`ApiKey: ${apiKey?.substring(0, 10)}...`);

      res.json({
        token: jwt,
        identity: identity
      });

    } catch (error) {
      console.error('Token generation failed:', error);
      res.status(500).json({ error: 'Failed to generate token' });
    }
  });

  // SINGLE WebRTC endpoint - handles ALL agent WebRTC connections AND INBOUND CALLS
  const handleWebRTC = async (req, res) => {
    try {
      console.log('🔥🔥🔥 WEBRTC ENDPOINT HIT 🔥🔥🔥');
      console.log('Request method:', req.method);
      console.log('Request path:', req.path);
      console.log('Request URL:', req.url);
      console.log('Body params:', req.body);
      console.log('Query params:', req.query);
      
      // Check if this is an INBOUND CALL (lead calling back)
      const callerNumber = req.body.From || req.query.From; // Lead's phone number
      const calledNumber = req.body.To || req.query.To; // Your Twilio number they called
      const callSid = req.body.CallSid || req.query.CallSid;
      
      // If From exists but no conference/agentEmail params, it's an INBOUND call
      if (callerNumber && !req.body.conference && !req.query.conference && !req.body.agentEmail) {
        console.log(`📞 INBOUND CALL DETECTED from ${callerNumber} to ${calledNumber}`);
        
        // Lookup which agent called this lead last
        try {
          const { data: leads, error } = await supabaseAdmin
            .from('masterlead')
            .select('cn_email, first_name, last_name, taalk_market')
            .or(`phone.eq.${callerNumber},phone.ilike.%${callerNumber.slice(-10)}%`)
            .not('cn_email', 'is', null)
            .order('updated_at', { ascending: false })
            .limit(1);
          
          if (error || !leads || leads.length === 0) {
            console.log(`❌ No agent found for inbound call from ${callerNumber}`);
            // Route to Veterans fallback by default
            const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say voice="alice">Thank you for calling. Please hold while we connect you.</Say>
  <Dial timeout="10" action="/api/twilio/inbound-fallback">
    <Number>+17046868739</Number>
  </Dial>
  <Say voice="alice">Sorry, all agents are currently unavailable. Please call back later.</Say>
</Response>`;
            res.type('text/xml').send(twiml);
            return;
          }
          
          const assignedAgent = leads[0];
          const agentEmail = assignedAgent.cn_email;
          
          console.log(`✅ INBOUND ROUTING: ${callerNumber} (${assignedAgent.first_name} ${assignedAgent.last_name}) → Agent: ${agentEmail}`);
          
          // Get agent's phone number from agent_profiles
          const { data: agentProfile } = await supabaseAdmin
            .from('agent_profiles')
            .select('phone, first_name, last_name')
            .eq('email', agentEmail)
            .single();
          
          const agentPhone = agentProfile?.phone;
          
          if (!agentPhone) {
            console.log(`❌ No phone found for agent ${agentEmail}, routing to fallback`);
            const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say voice="alice">Thank you for calling. Please hold while we connect you.</Say>
  <Dial timeout="10">
    <Number>+17046868739</Number>
  </Dial>
  <Say voice="alice">Sorry, the agent is currently unavailable.</Say>
</Response>`;
            res.type('text/xml').send(twiml);
            return;
          }
          
          // Create TwiML to ring agent for 10 seconds, then fallback
          const market = assignedAgent.taalk_market || 'Unknown';
          const fallbackNumber = market.toLowerCase().includes('veteran') ? '+18005551234' : '+18005556789';
          
          const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say voice="alice">Thank you for calling back. Connecting you to your agent.</Say>
  <Dial timeout="10" action="/api/twilio/inbound-fallback?market=${encodeURIComponent(market)}&caller=${encodeURIComponent(callerNumber)}">
    <Number>${agentPhone}</Number>
  </Dial>
</Response>`;
          
          console.log(`📞 Ringing agent ${agentEmail} at ${agentPhone} for 10 seconds...`);
          res.type('text/xml').send(twiml);
          
          // Log inbound call
          try {
            await supabaseAdmin.from('call_logs').insert({
              call_sid: callSid,
              agent_email: agentEmail,
              lead_phone: callerNumber,
              call_type: 'inbound',
              call_direction: 'inbound',
              status: 'ringing',
              created_at: new Date().toISOString()
            });
          } catch (logError) {
            console.warn('⚠️ Failed to log inbound call:', logError);
          }
          
          return;
          
        } catch (lookupError) {
          console.error('❌ Error looking up agent for inbound call:', lookupError);
          const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say voice="alice">Thank you for calling. Please hold.</Say>
  <Dial timeout="10">
    <Number>+17046868739</Number>
  </Dial>
</Response>`;
          res.type('text/xml').send(twiml);
          return;
        }
      }
      
      // Get conference name from WebRTC device params (supports both 'conference' and 'conferenceName')
      const conferenceName = req.body.conference || req.body.conferenceName || req.query.conference || req.query.conferenceName;
      
      // CRITICAL: Get agent email from WebRTC device params
      const agentEmail = req.body.agentEmail || req.query.agentEmail || 'unknown@aoglobelife.com';
      const agentName = req.body.agentName || req.query.agentName || 'Unknown Agent';
      
      // Check for DIRECT CALL mode (Call Connector Pro direct dial)
      const directCallNumber = req.body.To || req.query.To;
      
      if (directCallNumber) {
        // DIRECT CALL MODE: Agent dials lead directly (NO CONFERENCE)
        console.log(`📞 DIRECT CALL: Agent ${agentEmail} calling ${directCallNumber}`);
        
        const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Dial callerId="${TWILIO_PHONE_NUMBER || '+19142289324'}">${directCallNumber}</Dial>
</Response>`;
        
        console.log(`✅ DIRECT CALL TwiML sent for ${directCallNumber}`);
        res.type('text/xml');
        res.send(twiml);
        return;
      }
      
      console.log(`🔥 AGENT ATTRIBUTION: ${agentEmail} (${agentName}) joining conference: ${conferenceName}`);
      
      if (!conferenceName) {
        console.log('❌ No conference name provided - using fallback');
        res.status(400).type('text/xml').send(`<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say>No conference specified</Say>
</Response>`);
        return;
      }
      
      console.log(`🎯 Agent ${agentEmail} joining conference: ${conferenceName}`);
      
      // CRITICAL: Add StatusCallback with metadata for proper call attribution
      const statusCallback = `https://aoirail-production.up.railway.app/api/twilio/status`;
      
      // FORCE ALL WEBRTC CONFERENCES TO USE SOFT-ROCK (override agent preferences)
      const waitMusicUrl = "http://twimlets.com/holdmusic?Bucket=com.twilio.music.soft-rock";
      console.log(`🎵 FORCED: All WebRTC conferences using soft-rock hold music for ${agentEmail}`);
      
      const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Dial>
    <Conference 
      beep="false"
      startConferenceOnEnter="true"
      endConferenceOnExit="false"
      maxParticipants="2"
      waitUrl="${waitMusicUrl}"
      statusCallback="${statusCallback}"
      statusCallbackEvent="start,end,join,leave"
      statusCallbackMethod="POST">${conferenceName}</Conference>
  </Dial>
</Response>`;

      console.log(`✅ TwiML sent - Agent ${agentEmail} going to: ${conferenceName}`);
      res.type('text/xml');
      res.send(twiml);
      
      // CRITICAL: Store this WebRTC connection in the live tracking
      try {
        // Log this agent connection for call attribution
        storage.trackAgentWebRTCConnection({
          agentEmail,
          agentName,
          conferenceName,
          timestamp: new Date().toISOString(),
          connectionType: 'webrtc_agent'
        });
        console.log(`✅ Agent WebRTC connection tracked for ${agentEmail}`);
      } catch (trackingError) {
        console.warn('⚠️ Failed to track agent WebRTC connection:', trackingError);
      }
      
    } catch (error) {
      console.error('❌ WebRTC error:', error);
      res.status(500).type('text/xml').send(`<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say>Connection error</Say>
</Response>`);
    }
  };

  // TwiML App webhook endpoint (what the TwiML App actually calls)
  app.post("/webhook/webrtc", (req, res) => {
    console.log('🎯 TWIML APP WEBHOOK HIT: /webhook/webrtc');
    console.log('Request method:', req.method);
    console.log('Request path:', req.path);
    console.log('Request body:', req.body);
    handleWebRTC(req, res);
  });

  // UNIQUE WebRTC endpoint to avoid ALL conflicts - must be FIRST
  app.post("/webrtc-agent-connect", (req, res) => {
    console.log('🔥🔥🔥 UNIQUE WEBRTC ENDPOINT HIT 🔥🔥🔥');
    console.log('Request method:', req.method);
    console.log('Request path:', req.path);
    console.log('Request body:', req.body);
    handleWebRTC(req, res);
  });
  
  // Keep original endpoints for backup
  app.post("/api/twilio/webrtc", handleWebRTC);
  app.post("/api/twilio/voice", handleWebRTC);  
  app.post("/voice", handleWebRTC);  
  app.post("/incoming", handleWebRTC);  
  app.post("/api/voice", handleWebRTC); 
  app.post("/twiml", handleWebRTC);
  
  // Debug: Log that WebRTC endpoints are registered
  console.log('✅ WebRTC endpoints registered: /webhook/webrtc, /webrtc-agent-connect, /api/twilio/webrtc, /api/twilio/voice, /voice, /incoming, /api/voice, /twiml');
  console.log('🔧 TwiML App configured to call: https://aoirail-production.up.railway.app/webhook/webrtc');
  
  // Test the unique endpoint immediately  
  console.log('🧪 Testing unique WebRTC endpoint...');
  setTimeout(() => {
    console.log('handleWebRTC function defined:', typeof handleWebRTC === 'function');
  }, 1000);
  
  // Inbound call fallback endpoint - when agent doesn't answer in 10 seconds
  app.post("/api/twilio/inbound-fallback", async (req, res) => {
    try {
      const market = req.query.market as string || '';
      const caller = req.query.caller as string || '';
      const dialCallStatus = req.body.DialCallStatus; // 'no-answer', 'busy', 'failed', 'completed'
      
      console.log(`📞 INBOUND FALLBACK triggered: market=${market}, caller=${caller}, status=${dialCallStatus}`);
      
      // Determine fallback number based on market
      const VETERANS_FALLBACK = '+17046868739'; // Veterans support line
      const GLOBE_FALLBACK = '+14583132402';    // Globe Life support line
      
      const fallbackNumber = market.toLowerCase().includes('veteran') 
        ? VETERANS_FALLBACK 
        : GLOBE_FALLBACK;
      
      const fallbackName = market.toLowerCase().includes('veteran') 
        ? 'Veterans support team' 
        : 'Globe Life support team';
      
      // If agent answered, just end
      if (dialCallStatus === 'completed') {
        res.type('text/xml').send(`<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Hangup/>
</Response>`);
        return;
      }
      
      // Agent didn't answer, route to fallback
      console.log(`📞 Agent unavailable, routing to ${fallbackName} at ${fallbackNumber}`);
      
      const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say voice="alice">Your agent is currently unavailable. Connecting you to our ${fallbackName}.</Say>
  <Dial timeout="30">
    <Number>${fallbackNumber}</Number>
  </Dial>
  <Say voice="alice">We're sorry, all representatives are busy. Please call back later or leave a message after the tone.</Say>
  <Record maxLength="120" transcribe="true" transcribeCallback="/api/twilio/voicemail"/>
</Response>`;
      
      res.type('text/xml').send(twiml);
      
    } catch (error) {
      console.error('❌ Fallback error:', error);
      res.type('text/xml').send(`<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say voice="alice">We're experiencing technical difficulties. Please call back later.</Say>
  <Hangup/>
</Response>`);
    }
  });
  

  // ✅ 3. API endpoint for dialing leads with shared conference + HOTLEAD EARNED DEDUCTION
  app.post("/api/dial-lead", async (req, res) => {
    try {
      const { leadPhone, conference, leadId, isHotLead } = req.body;
      console.log('📞 /api/dial-lead - dialing to conf:', conference);
      
      if (!leadPhone || !conference) {
        return res.status(400).json({ error: 'leadPhone and conference are required' });
      }

      // ✅ Create call that joins lead to SAME conference with agent attribution  
      const agentEmail = req.user?.email || 'unknown@aoglobelife.com';
      const agentName = req.user?.name || 'Unknown Agent';
      
      // 🔥 HOTLEAD EARNED DEDUCTION: Check if this is a hotlead call
      if (isHotLead && leadId) {
        console.log('🔥 HOTLEAD CALL DETECTED! Triggering earned deduction for:', agentEmail);
        
        // Get agent's associate_id for webhook
        const associateId = null; // DO NOT USE 999 - must get from logged in user
        
        // Trigger immediate earned deduction webhook
        const WEBHOOK_URL = 'https://hooks.zapier.com/hooks/catch/2467580/u6o3xar/';
        const deductionPayload = {
          leadId: leadId,
          associate_id: associateId,
          agentEmail: agentEmail,
          duration: 0, // Call just started
          autoAssigned: false, // This is agent-initiated call
          reason: "Hotlead dialed - earned deduction triggered",
          assignedAt: new Date().toISOString(),
          callType: 'hotlead_dial',
          phone: leadPhone
        };

        try {
          const webhookResponse = await fetch(WEBHOOK_URL, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(deductionPayload)
          });
          
          console.log(`🎯 Hotlead earned deduction webhook sent! Status: ${webhookResponse.status}`);
          
          // Track this hotlead call in database for accountability
          try {
            const { error: supabaseError } = await supabaseAdmin
              .from('masterlead')
              .update({ 
                last_contacted: new Date().toISOString(),
                status: 'called',
                cnresolution: 'called'
              })
              .eq('taalk_lead_id', leadId)
              .eq('cn_email', agentEmail);
              
            if (supabaseError) {
              console.error('❌ Failed to update hotlead status:', supabaseError);
            } else {
              console.log('✅ Hotlead status updated in Supabase');
            }
          } catch (updateError) {
            console.error('❌ Error updating hotlead status:', updateError);
          }
          
        } catch (webhookError) {
          console.error('❌ Failed to send hotlead deduction webhook:', webhookError);
        }
      }
      
      const call = await twilioClient.calls.create({
        url: `https://${req.hostname}/lead-join?conf=${encodeURIComponent(conference)}`,
        to: leadPhone,
        from: process.env.TWILIO_CALLER_ID || '+12035896464',
        method: 'GET',
        statusCallback: `https://${req.get('host')}/api/twilio/call-status`,
        statusCallbackEvent: ['initiated', 'ringing', 'answered', 'completed'],
        statusCallbackMethod: 'POST',
        metadata: {
          agent_email: agentEmail,
          agent_name: agentName,
          call_source: 'agent_initiated',
          conference_name: conference,
          lead_phone: leadPhone,
          lead_id: leadId,
          is_hotlead: isHotLead ? 'true' : 'false',
          timestamp: new Date().toISOString()
        }
      });

      console.log('📞 Lead call initiated:', call.sid);
      res.json({ 
        success: true, 
        callSid: call.sid,
        hotleadDeductionTriggered: isHotLead || false
      });
      
    } catch (error) {
      console.error('❌ Dial lead error:', error);
      res.status(500).json({ error: 'Failed to dial lead' });
    }
  });

