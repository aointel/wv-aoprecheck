  // Stripe payment endpoints for credit purchasing
  app.post("/api/payments/create-payment-intent", async (req, res) => {
    try {
      const { amount, creditPackage, userEmail, userName } = req.body;
      
      if (!amount || !creditPackage || !userEmail) {
        return res.status(400).json({ error: 'Amount, credit package, and user email are required' });
      }

      // Create Stripe customer if needed and get customer ID
      let stripeCustomerId;
      try {
        const existingCustomers = await stripe.customers.list({
          email: userEmail,
          limit: 1
        });

        if (existingCustomers.data.length > 0) {
          stripeCustomerId = existingCustomers.data[0].id;
        } else {
          // Create new customer with billing details
          const customer = await stripe.customers.create({
            email: userEmail,
            name: userName || userEmail.split('@')[0], // Use email prefix as name if no name provided
            metadata: {
              source: 'ConnectNow CRM'
            }
          });
          stripeCustomerId = customer.id;
        }
      } catch (customerError) {
        console.warn('Could not create/find Stripe customer:', customerError);
        // Continue without customer for now
      }

      // Create payment intent with Stripe
      const paymentIntent = await stripe.paymentIntents.create({
        amount: Math.round(amount * 100), // Convert to cents
        currency: "usd",
        customer: stripeCustomerId,
        metadata: {
          creditPackage: creditPackage.toString(),
          credits: creditPackage.toString(),
          userEmail: userEmail,
          userName: userName || userEmail.split('@')[0]
        },
        automatic_payment_methods: {
          enabled: true,
        },
        // Pre-fill billing details from user info
        shipping: stripeCustomerId ? {
          name: userName || userEmail.split('@')[0],
          address: {
            line1: '',
            city: '',
            state: '',
            postal_code: '',
            country: 'US'
          }
        } : undefined,
      });

      res.json({ 
        clientSecret: paymentIntent.client_secret,
        paymentIntentId: paymentIntent.id
      });
      
    } catch (error: any) {
      console.error('Payment intent creation error:', error);
      res.status(500).json({ 
        error: "Error creating payment intent: " + error.message 
      });
    }
  });

  // Handle successful payment and add credits
  app.post("/api/payments/confirm-payment", async (req, res) => {
    try {
      const { paymentIntentId, userEmail } = req.body;
      
      if (!paymentIntentId || !userEmail) {
        return res.status(400).json({ error: 'Payment intent ID and user email are required' });
      }

      // Retrieve payment intent from Stripe to verify payment
      const paymentIntent = await stripe.paymentIntents.retrieve(paymentIntentId);
      
      if (paymentIntent.status !== 'succeeded') {
        return res.status(400).json({ error: 'Payment not completed' });
      }

      const creditPackage = parseInt(paymentIntent.metadata.creditPackage || '0');
      if (!creditPackage) {
        return res.status(400).json({ error: 'Invalid credit package' });
      }

      // Add credits to user account via storage service (handles both Supabase and local DB)
      try {
        // Use the existing connectnow service to add credits
        const updatedCredits = await connectnowService.addUserCredits(userEmail, creditPackage);
        
        console.log(`✅ Credits added successfully: ${creditPackage} credits for ${userEmail}`);
        console.log('Updated credits:', updatedCredits);
        
        res.json({
          success: true,
          message: `${creditPackage} credits added successfully`,
          creditsAdded: creditPackage,
          paymentAmount: paymentIntent.amount / 100,
          totalCredits: updatedCredits.credits_remaining || updatedCredits.creditsRemaining
        });

      } catch (creditError) {
        console.error('Credit update error:', creditError);
        res.status(500).json({ 
          error: 'Payment processed but there was an issue adding credits. Please contact support.' 
        });
      }

    } catch (error: any) {
      console.error('Payment confirmation error:', error);
      res.status(500).json({ 
        error: "Error confirming payment: " + error.message 
      });
    }
  });

  // Stripe webhook handler for checkout.session.completed
  app.post("/api/webhooks/stripe", express.raw({type: 'application/json'}), async (req, res) => {
    const sig = req.headers['stripe-signature'] as string;
    
    let event;
    
    try {
      // Verify webhook signature (in production, set your webhook secret)
      event = stripe.webhooks.constructEvent(req.body, sig, process.env.STRIPE_WEBHOOK_SECRET || 'whsec_test_secret');
    } catch (err: any) {
      console.log('❌ Webhook signature verification failed:', err.message);
      return res.status(400).send(`Webhook Error: ${err.message}`);
    }

    // Handle the checkout.session.completed event
    if (event.type === 'checkout.session.completed') {
      const session = event.data.object as Stripe.Checkout.Session;
      const email = session.customer_details?.email;
      const credits = (session.amount_total ?? 0) / 100; // Convert from cents to credits
      
      console.log(`🎯 Processing Stripe purchase: ${credits} credits for ${email}`);
      
      if (email && credits > 0) {
        try {
          // Add credits using Supabase RPC function
          const { data, error } = await supabase.rpc('increment_credits_purchased', {
            p_email: email,
            p_credits_amount: credits
          });
          
          if (error) {
            console.error('❌ Supabase credit increment failed:', error);
            // Fallback to local service
            await connectnowService.addUserCredits(email, credits);
          } else {
            console.log(`✅ Credits added via Supabase: ${credits} credits for ${email}`);
          }
          
        } catch (error: any) {
          console.error('❌ Credit addition failed:', error);
          // Still send 200 to acknowledge receipt to Stripe
        }
      }
    }

    // Return a 200 response to acknowledge receipt of the event
    res.json({received: true});
  });

  // Credit purchase API endpoint - Create Stripe checkout session
  app.post("/api/stripe/purchase-credits", async (req, res) => {
    try {
      const { credits, email, successUrl, cancelUrl } = req.body;
      
      if (!credits || !email) {
        return res.status(400).json({ error: 'Credits amount and email are required' });
      }

      // Create Stripe checkout session
      const session = await stripe.checkout.sessions.create({
        payment_method_types: ['card'],
        line_items: [
          {
            price_data: {
              currency: 'usd',
              product_data: {
                name: `${credits} Credits`,
                description: `Purchase ${credits} credits for AO Intelligence`,
              },
              unit_amount: credits * 100, // $1 per credit, convert to cents
            },
            quantity: 1,
          },
        ],
        mode: 'payment',
        customer_email: email,
        success_url: successUrl || `${req.protocol}://${req.get('host')}/dashboard/aoi?purchase=success`,
        cancel_url: cancelUrl || `${req.protocol}://${req.get('host')}/dashboard/aoi?purchase=cancelled`,
        metadata: {
          email: email,
          credits: credits.toString(),
        },
      });

      res.json({ sessionId: session.id, url: session.url });
    } catch (error: any) {
      console.error('Stripe checkout session creation error:', error);
      res.status(500).json({ 
        error: "Error creating checkout session: " + error.message 
      });
    }
  });

