      res.status(500).json({ error: 'Failed to fetch agent performance data' });
    }
  });

  // VDP Agent Tracking - Heartbeat endpoint
  app.post("/api/vdp/heartbeat", async (req, res) => {
    try {
      const { email, timestamp } = req.body;
      
      if (!email) {
        return res.status(400).json({ error: 'Email required' });
      }

      // CHECK CREDITS - Enforce -10 credit limit
      const { data: creditsData } = await supabaseAdmin
        .from('user_credits')
        .select('credits_remaining')
        .eq('email', email)
        .maybeSingle();
      
      const creditsRemaining = creditsData?.credits_remaining || 0;
      
      if (creditsRemaining <= -8) {
        console.log(`🚫 VDP HEARTBEAT REJECTED: ${email} has ${creditsRemaining} credits (limit: -8)`);
        
        // Auto-disable VDP in customers table
        await supabaseAdmin
          .from('customers')
          .update({ VDPACTIVE: 'INACTIVE' })
          .ilike('company_email', email);
        
        return res.status(403).json({ 
          error: 'Account suspended - insufficient credits',
          creditsRemaining,
          message: 'Your VDP account has been automatically disabled due to insufficient credits. Please contact support.'
        });
      }

      // Get agent name from database
      let agentName = email.split('@')[0];
      try {
        const { data: profile } = await supabaseAdmin
          .from('agent_profiles')
          .select('first_name, last_name')
          .eq('email', email)
          .single();
        
        if (profile) {
          agentName = `${profile.first_name} ${profile.last_name}`;
        }
      } catch (error) {
        // Use email if profile not found
      }

      // Update tracker
      const { vdpAgentTracker } = await import('./vdp-agent-tracker');
      vdpAgentTracker.updateHeartbeat(email, agentName);

      res.json({ success: true, timestamp: new Date().toISOString() });
    } catch (error) {
      console.error('❌ VDP heartbeat error:', error);
      res.status(500).json({ error: 'Failed to process heartbeat' });
    }
  });

  // VDP Call Start - Track when agent starts a call
  app.post("/api/vdp/call-start", async (req, res) => {
    try {
      const { email, callId, direction, phoneNumber } = req.body;
      
      if (!email || !callId) {
        return res.status(400).json({ error: 'Email and callId required' });
      }

      const { vdpAgentTracker } = await import('./vdp-agent-tracker');
      vdpAgentTracker.startCall(email, callId, direction || 'outbound', phoneNumber || 'Unknown');

      res.json({ success: true });
    } catch (error) {
      console.error('❌ VDP call-start error:', error);
      res.status(500).json({ error: 'Failed to track call start' });
    }
  });

  // VDP Call End - Track when agent ends a call
  app.post("/api/vdp/call-end", async (req, res) => {
    try {
      const { email } = req.body;
      
      if (!email) {
        return res.status(400).json({ error: 'Email required' });
      }

      const { vdpAgentTracker } = await import('./vdp-agent-tracker');
      vdpAgentTracker.endCall(email);

      res.json({ success: true });
    } catch (error) {
      console.error('❌ VDP call-end error:', error);
      res.status(500).json({ error: 'Failed to track call end' });
    }
  });

  // VDP Debug - Get current VDP tracker status
  app.get("/api/vdp/debug", async (req, res) => {
    try {
      const { vdpAgentTracker } = await import('./vdp-agent-tracker');
      const allAgents = vdpAgentTracker.getAgents();
      const onlineAgents = allAgents.filter(a => a.status !== 'offline');
      
      res.json({
        totalAgents: allAgents.length,
        onlineAgents: onlineAgents.length,
        offlineAgents: allAgents.length - onlineAgents.length,
        agents: allAgents.map(a => ({
          email: a.email,
          name: a.name,
          status: a.status,
          lastHeartbeat: a.lastHeartbeat,
          timeSinceHeartbeat: Math.floor((Date.now() - new Date(a.lastHeartbeat).getTime()) / 1000),
          currentCall: a.currentCall ? {
            callId: a.currentCall.callId,
            phoneNumber: a.currentCall.phoneNumber,
            direction: a.currentCall.direction,
            duration: Math.floor((Date.now() - a.currentCall.startTime.getTime()) / 1000)
          } : null
        }))
      });
    } catch (error) {
      console.error('❌ VDP debug error:', error);
      res.status(500).json({ error: 'Failed to get VDP status' });
    }
  });

  // Live Call Board API routes - Real-time agent monitoring from Taalk API
  app.get("/api/live-call-board/stats", async (req, res) => {
    try {
      console.log('📊 Live Call Board: Calculating real-time statistics...');
      
      // Get agents who have touched leads in the last 8 hours
      const eightHoursAgo = new Date(Date.now() - 8 * 60 * 60 * 1000);
      const { data: recentLeads, error: leadsError } = await supabaseAdmin
        .from('masterlead')
        .select('cn_email, last_contacted')
        .not('cn_email', 'is', null)
        .not('last_contacted', 'is', null)
        .gte('last_contacted', eightHoursAgo.toISOString())
        .limit(100000);

      const agentEmails = new Set<string>();
      (recentLeads || []).forEach(lead => agentEmails.add(lead.cn_email));
      
      // Add Call Connector Pro agents with recent heartbeats
      try {
        const { callConnectorTracker } = await import('./call-connector-tracker');
        const callConnectorAgents = callConnectorTracker.getActiveAgents();
        callConnectorAgents.forEach(agent => agentEmails.add(agent.agentEmail));
        console.log(`💓 Call Connector active agents: ${callConnectorAgents.length}`);
      } catch (e) {
        console.log('⚠️ Call Connector tracker not available:', e);
      }
      
      // Add agents currently on calls from Twilio (they're definitely online)
      try {
        const { twilioCallsPoller } = await import('./twilio-calls-poller.js');
        const activeCalls = twilioCallsPoller.getAllActiveCalls();
        activeCalls.forEach(call => agentEmails.add(call.agentEmail));
        console.log(`📞 Twilio active calls contributing to online: ${activeCalls.length}`);
      } catch (e) {
        console.log('⚠️ Twilio poller not available for online count:', e);
      }
      
      // Add agents currently presenting (they're definitely online)
      try {
        const { presentationLiveTracker } = await import('./presentation-live-tracker');
        const activePresentations = presentationLiveTracker.getActivePresentations();
        activePresentations.forEach(p => agentEmails.add(p.agentEmail));
        console.log(`🎬 Active presentations contributing to online: ${activePresentations.length}`);
      } catch (e) {
        console.log('⚠️ Presentation tracker not available for online count:', e);
      }
      
      const totalOnlineAgents = agentEmails.size;
      console.log(`👥 Total online agents: ${totalOnlineAgents}`);
      
      // Count agents currently on calls
      let agentsOnCalls = 0;
      try {
        const { twilioCallsPoller } = await import('./twilio-calls-poller.js');
        const activeCalls = twilioCallsPoller.getAllActiveCalls();
        // Get unique agent emails from active calls
        const agentsOnCallsSet = new Set(activeCalls.map(call => call.agentEmail));
        agentsOnCalls = agentsOnCallsSet.size;
        console.log(`📞 Agents on calls (Twilio): ${agentsOnCalls} (${activeCalls.length} total calls)`);
      } catch (e) {
        console.log('⚠️ Twilio poller not available:', e);
      }
      
      // Count agents currently presenting
      let agentsPresenting = 0;
      try {
        const { presentationLiveTracker } = await import('./presentation-live-tracker');
        const activePresentations = presentationLiveTracker.getActivePresentations();
        // Get unique agent emails from presentations
        const agentsPresentingSet = new Set(activePresentations.map(p => p.agentEmail));
        agentsPresenting = agentsPresentingSet.size;
        console.log(`🎬 Agents presenting: ${agentsPresenting} (${activePresentations.length} total presentations)`);
      } catch (e) {
        console.log('⚠️ Presentation tracker not available:', e);
      }
      
      // Get today's totals for presentations, sales, and ALP
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      
      // Get real presentations (20+ minutes only) from presentation_sessions
      const { data: presentationData } = supabaseAdmin ? await supabaseAdmin
        .from('presentation_sessions')
        .select('id, started_at, ended_at, duration_seconds')
        .gte('started_at', today.toISOString()) : { data: null };
      
      // Filter to only presentations 20+ minutes (1200 seconds)
      const realPresentations = presentationData?.filter(p => {
        if (p.duration_seconds && p.duration_seconds >= 1200) return true;
        if (p.started_at && p.ended_at) {
          const duration = (new Date(p.ended_at).getTime() - new Date(p.started_at).getTime()) / 1000;
          return duration >= 1200;
        }
        return false;
      }) || [];
      
      const { data: salesData } = supabaseAdmin ? await supabaseAdmin
        .from('call_logs')
        .select('id')
        .eq('disposition', 'sale')
        .gte('created_at', today.toISOString()) : { data: null };
      
      const { data: alpData } = supabaseAdmin ? await supabaseAdmin
        .from('call_logs')
        .select('id')
        .not('alp', 'is', null)
        .gte('created_at', today.toISOString()) : { data: null };

      // Calculate estimated wait time
      let estimatedWaitTime = '0:00';
      if (totalOnlineAgents > 0 && agentsOnCalls > 0) {
        const busyRatio = agentsOnCalls / totalOnlineAgents;
        if (busyRatio >= 1) {
          estimatedWaitTime = '2:00';
        } else if (busyRatio >= 0.8) {
          estimatedWaitTime = '1:30';
        } else if (busyRatio >= 0.5) {
          estimatedWaitTime = '0:45';
        } else {
          estimatedWaitTime = '0:10';
        }
      } else if (totalOnlineAgents > 0 && agentsOnCalls === 0) {
        estimatedWaitTime = '0:05';
      } else {
        estimatedWaitTime = '2:00';
      }

      const stats = {
        totalAgents: totalOnlineAgents,
        onlineAgents: totalOnlineAgents,
        callingAgents: agentsOnCalls,
        presentingAgents: agentsPresenting,
        totalPresentations: realPresentations.length,
        totalSales: salesData?.length || 0,
        totalALP: alpData?.length || 0,
        avgCallTime: '1:30',
        estimatedWaitTime
      };
      
      console.log('📊 Stats:', stats);
      res.json(stats);
    } catch (error) {
      console.error('❌ Live Call Board stats error:', error);
      res.status(500).json({ error: 'Failed to fetch live call board stats' });
    }
  });
  app.get("/api/live-call-board/stats-legacy", async (req, res) => {
    try {
      console.log('📊 Live Call Board: Getting database statistics (legacy)...');
      
      // Get total agents count from war_connects table
      const agentCountQuery = `
        SELECT COUNT(DISTINCT agent_email) as total_agents
        FROM war_connects 
        WHERE connect_date >= CURRENT_DATE - INTERVAL '7 days'
      `;
      
      // Get today's contact stats from masterlead table (real lead contact activity)
      console.log('📊 Live Call Board: Using masterlead contact data for accurate stats...');
      
      const today = new Date();
      const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());
      const todayEnd = new Date(todayStart.getTime() + 24 * 60 * 60 * 1000);

      // Use count-based queries to avoid pagination issues with masterlead table
      console.log('📞 Live Call Board: Using count-based masterlead queries to avoid pagination limits...');
      console.log(`🗓️ Date range: ${todayStart.toISOString()} to ${todayEnd.toISOString()}`);

      try {
        // First check total masterlead records to see if table has data
        const { count: totalRecords, error: totalError } = await supabase
          .from('masterlead')
          .select('*', { count: 'exact', head: true });

        console.log(`📊 Total masterlead records in database: ${totalRecords || 0}`);

        // Check how many have last_contacted field populated  
        const { count: withLastContacted, error: contactedError } = await supabase
          .from('masterlead')
          .select('*', { count: 'exact', head: true })
          .not('last_contacted', 'is', null);

        console.log(`📞 Records with last_contacted field: ${withLastContacted || 0}`);

        // Total dialed = any contact attempt today (based on last_contacted)
        const { count: totalDials, error: dialsError } = await supabase
          .from('masterlead')
          .select('*', { count: 'exact', head: true })
          .not('last_contacted', 'is', null)
          .gte('last_contacted', todayStart.toISOString())
          .lt('last_contacted', todayEnd.toISOString());

        if (dialsError) throw dialsError;

        // Count reached contacts (human contact - good dispositions or minimum talk time)
        const { count: totalReached, error: reachedError } = await supabase
          .from('masterlead')
          .select('*', { count: 'exact', head: true })
          .not('last_contacted', 'is', null)
          .gte('last_contacted', todayStart.toISOString())
          .lt('last_contacted', todayEnd.toISOString())
          .or('status.in.(contacted,connected,talked,qualified,interested,not_interested,transfer,appointment,booked,callback_scheduled),and(duration.gte.15,status.not.in.(no_answer,busy,failed,voicemail,bad_number))');

        if (reachedError) throw reachedError;

        // Count bookings (appointment statuses or very interested contacts)
        const { count: totalBooked, error: bookedError } = await supabase
          .from('masterlead')
          .select('*', { count: 'exact', head: true })
          .not('last_contacted', 'is', null)
          .gte('last_contacted', todayStart.toISOString())
          .lt('last_contacted', todayEnd.toISOString())
          .or('status.in.(appointment,booked,qualified,callback_scheduled),and(status.eq.interested,duration.gte.60)');

        if (bookedError) throw bookedError;

        // Get sample of durations for average calculation (limited to 100 to avoid pagination)
        const { data: sampleDurations, error: durError } = await supabase
          .from('masterlead')
          .select('duration, duration_after_transfer')
          .not('last_contacted', 'is', null)
          .gte('last_contacted', todayStart.toISOString())
          .lt('last_contacted', todayEnd.toISOString())
          .or('duration.gt.0,duration_after_transfer.gt.0')
          .limit(100);

        let avgDuration = 0;
        if (!durError && sampleDurations && sampleDurations.length > 0) {
          const validDurations = sampleDurations.map(d => (d.duration || 0) + (d.duration_after_transfer || 0)).filter(d => d > 0);
          avgDuration = validDurations.length > 0 ? validDurations.reduce((sum, dur) => sum + dur, 0) / validDurations.length : 0;
        }

        console.log(`📞 Live Call Board MASTERLEAD Counts: Contacts: ${totalDials || 0}, Reached: ${totalReached || 0}, Booked: ${totalBooked || 0}`);

        // Create result structure to match war_connects query format
        var todayStatsResult = {
          rows: [{
            total_dials: totalDials || 0,
            total_reached: totalReached || 0,
            total_booked: totalBooked || 0,
            avg_call_duration: avgDuration
          }]
        };

      } catch (contactError) {
        console.error('❌ Masterlead count queries error:', contactError);
        // Fallback to war_connects if masterlead fails
        const todayStatsQuery = `
          SELECT 
            COUNT(*) as total_dials,
            COUNT(CASE WHEN duration > 30 THEN 1 END) as total_reached,
            COUNT(CASE WHEN immediate_outcome = 'appointment' OR connect_type = 'appointment' OR immediate_outcome = 'booked' THEN 1 END) as total_booked,
            AVG(CASE WHEN duration > 0 THEN duration END) as avg_call_duration
          FROM war_connects 
          WHERE DATE(connect_date) = CURRENT_DATE
        `;
        var todayStatsResult = await db.execute(sql.raw(todayStatsQuery));
      }
      
      // Get active appointments today
      const appointmentsQuery = `
        SELECT COUNT(*) as appointments_today
        FROM appointments 
        WHERE DATE(created_at) = CURRENT_DATE
      `;

      // Run the agent count and appointments queries independently  
      const [agentCountResult, appointmentsResult] = await Promise.all([
        db.execute(sql.raw(agentCountQuery)),
        db.execute(sql.raw(appointmentsQuery))
      ]);
      
      // todayStatsResult is already set above from either Supabase or fallback query

      const agentData = agentCountResult.rows[0] || {};
      const todayData = todayStatsResult.rows[0] || {};
      const appointmentData = appointmentsResult.rows[0] || {};
      
      // Calculate averages and format
      const avgDuration = Number(todayData.avg_call_duration || 0);
      const avgMinutes = Math.floor(avgDuration / 60);
      const avgSeconds = Math.round(avgDuration % 60);
      const avgCallTime = `${avgMinutes}:${String(avgSeconds).padStart(2, '0')}`;
      
      // Get real active calls count
      const activeCallsCountQuery = `
        SELECT COUNT(*) as active_calls
        FROM call_logs 
        WHERE call_status IN ('in-progress', 'ringing') 
        AND call_started_at > NOW() - INTERVAL '2 hours'
      `;
      
      const activeCallsCountResult = await db.execute(sql.raw(activeCallsCountQuery));
      const activeCallsCount = Number(activeCallsCountResult.rows[0]?.active_calls || 0);
      
      // Get agents active today (made calls in last 8 hours)
      const activeAgentsQuery = `
        SELECT COUNT(DISTINCT agent_email) as active_agents
        FROM war_connects 
        WHERE connect_date > NOW() - INTERVAL '8 hours'
      `;
      
      const activeAgentsResult = await db.execute(sql.raw(activeAgentsQuery));
      const activeAgents = Number(activeAgentsResult.rows[0]?.active_agents || 0);

      // Always use real data - no demo fallback
      const finalStats = {
        totalAgents: Number(agentData.total_agents || 0),
        activeAgents: activeAgents,
        totalCalls: Number(todayData.total_dials || 0),
        activeCalls: activeCallsCount,
        totalDials: Number(todayData.total_dials || 0),
        totalReached: Number(todayData.total_reached || 0),
        totalBooked: Number(todayData.total_booked || 0) + Number(appointmentData.appointments_today || 0),
        avgCallTime: avgCallTime
      };

      console.log('📊 Live Call Board Stats:', finalStats);
      res.json(finalStats);
      
    } catch (error) {
      console.error('❌ Live call board stats error:', error);
      res.status(500).json({ error: 'Failed to fetch live call board statistics' });
    }
  });

  app.get("/api/live-call-board/agents", async (req, res) => {
    try {
      const { mgaFilter, rgaFilter } = req.query;
      console.log('👥 Live Call Board: Getting agents active in last 8 hours...');
      console.log(`🔍 Filters - MGA: ${mgaFilter || 'none'}, RGA: ${rgaFilter || 'none'}`);
      
      // Get agents who have touched leads in the last 8 hours from masterlead (increased for stability)
      const threeHoursAgo = new Date(Date.now() - 8 * 60 * 60 * 1000);
      const { data: recentLeads, error: leadsError } = await supabaseAdmin
        .from('masterlead')
        .select('cn_email, last_contacted')
        .not('cn_email', 'is', null)
        .not('last_contacted', 'is', null)
        .gte('last_contacted', threeHoursAgo.toISOString())
        .limit(100000); // Remove 1000 row limit

      if (leadsError) {
        console.error('❌ Error fetching recent leads:', leadsError);
        return res.status(500).json({ error: 'Failed to fetch agents' });
      }

      // Get unique agent emails and their last activity
      const agentActivity = new Map();
      (recentLeads || []).forEach(lead => {
        const email = lead.cn_email;
        // Database stores UTC time, JavaScript Date handles conversion automatically
        const lastActivity = new Date(lead.last_contacted);
        
        if (!agentActivity.has(email) || lastActivity > agentActivity.get(email)) {
          agentActivity.set(email, lastActivity);
        }
      });

      console.log(`👥 Found ${agentActivity.size} agents active in last 3 hours`);

      // Also get VDP agents currently online from Taalk API
      try {
        const { taalkVDPPoller } = await import('./taalk-vdp-poller');
        const allVdpAgents = taalkVDPPoller.getAgents();
        console.log(`👥 Taalk VDP has ${allVdpAgents.length} total agents`);
        
        const vdpAgents = allVdpAgents.filter(a => a.status !== 'offline');
        console.log(`👥 Found ${vdpAgents.length} VDP agents currently online (not offline)`);
        
        vdpAgents.forEach(agent => {
          const vdpActivity = new Date(agent.lastActivity);
          const existingActivity = agentActivity.get(agent.email);
          
          console.log(`  - VDP Agent: ${agent.email}, status: ${agent.status}, activity: ${vdpActivity.toISOString()}`);
          
          // Use VDP activity if no existing activity OR if VDP activity is more recent
          if (!existingActivity || vdpActivity > existingActivity) {
            agentActivity.set(agent.email, vdpActivity);
            console.log(`    ✅ Added/updated ${agent.email} with VDP activity`);
          } else {
            console.log(`    ⏭️ Skipped ${agent.email} - existing activity is more recent`);
          }
        });
        console.log(`👥 Final agent count after VDP: ${agentActivity.size}`);
      } catch (e: any) {
        console.log('⚠️ Taalk VDP poller not available:', e?.message);
      }

      // Get Call Connector stats for each agent
      const { callConnectorTracker } = await import('./call-connector-tracker');
      
      // Also add Call Connector Pro agents with recent heartbeats
      const callConnectorAgents = callConnectorTracker.getActiveAgents();
      callConnectorAgents.forEach(agent => {
        const ccHeartbeat = new Date(agent.lastHeartbeat);
        const existingActivity = agentActivity.get(agent.agentEmail);
        
        // Use Call Connector heartbeat if no existing activity OR if CC heartbeat is more recent
        if (!existingActivity || ccHeartbeat > existingActivity) {
          agentActivity.set(agent.agentEmail, ccHeartbeat);
        }
      });
      console.log(`📞 Added/updated ${callConnectorAgents.length} Call Connector Pro agents with recent activity`);
      
      // Get active presentations
      const { presentationLiveTracker } = await import('./presentation-live-tracker');
      const activePresentations = presentationLiveTracker.getActivePresentations();
      console.log(`🎬 Found ${activePresentations.length} active presentations`);
      
      // Build agent list
      const enrichedAgents = await Promise.all(
        Array.from(agentActivity.entries()).map(async ([email, lastActivity]) => {
          // Get profile from user_profiles first
          const { data: profile } = await supabaseAdmin
            .from('user_profiles')
            .select('first_name, last_name')
            .eq('email', email)
            .maybeSingle();

          // Get associate ID from customers table
          const { data: customerData } = await supabaseAdmin
            .from('customers')
            .select('associate_id')
            .or(`company_email.eq.${email},personal_email.eq.${email}`)
            .maybeSingle();
          
          // Get credits from user_credit table
          const { data: creditsData } = await supabaseAdmin
            .from('user_credit')
            .select('credits_remaining')
            .eq('email', email)
            .maybeSingle();
          
          // If no profile, try to get name from producerlist using associate_id or email
          let name = profile 
            ? `${profile.first_name} ${profile.last_name}`
            : null;
          
          if (!name && customerData?.associate_id) {
            const { data: producer } = await supabaseAdmin
              .from('producerlist')
              .select('first_name, last_name')
              .eq('associate_id', customerData.associate_id)
              .maybeSingle();
            
            if (producer) {
              name = `${producer.first_name} ${producer.last_name}`;
            }
          }
          
          // Fallback to email username
          if (!name) {
            name = email.split('@')[0];
          }

          // Get Call Connector stats for today
          const ccStats = callConnectorTracker.getAgentStats(email);
          const activeCalls = callConnectorTracker.getAgentCalls(email);
          
      // Get today's stats
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      
      // Get masterlead stats for today using COUNT (no row limit!)
      const { count: dialedCount } = supabaseAdmin ? await supabaseAdmin
        .from('masterlead')
        .select('*', { count: 'exact', head: true })
        .eq('cn_email', email)
        .gte('last_contacted', today.toISOString()) : { count: 0 };
      
      const { count: bookedCount } = supabaseAdmin ? await supabaseAdmin
        .from('masterlead')
        .select('*', { count: 'exact', head: true })
        .eq('cn_email', email)
        .eq('cnresolution', 'booked')
        .gte('last_contacted', today.toISOString()) : { count: 0 };
      
      const { count: reachedCount } = supabaseAdmin ? await supabaseAdmin
        .from('masterlead')
        .select('*', { count: 'exact', head: true })
        .eq('cn_email', email)
        .not('cnresolution', 'in', '(pending,called,wrong number)')
        .not('cnresolution', 'is', null)
        .gte('last_contacted', today.toISOString()) : { count: 0 };
      
      // Calculate stats from masterlead
      const masterleadStats = {
        dialed: dialedCount || 0,
        booked: bookedCount || 0,
        reached: reachedCount || 0
      };
      
      // Get today's presentation count - ONLY presentations 20+ minutes (real presentations)
      const { data: presentationData } = supabaseAdmin ? await supabaseAdmin
        .from('presentation_sessions')
        .select('id, started_at, ended_at, duration_seconds')
        .eq('agent_email', email)
        .gte('started_at', today.toISOString()) : { data: null };
      
      // Filter to only presentations 20+ minutes (1200 seconds)
      const realPresentations = presentationData?.filter(p => {
        // If we have duration_seconds, use it
        if (p.duration_seconds && p.duration_seconds >= 1200) return true;
        
        // Otherwise calculate from timestamps
        if (p.started_at && p.ended_at) {
          const duration = (new Date(p.ended_at).getTime() - new Date(p.started_at).getTime()) / 1000;
          return duration >= 1200; // 20 minutes
        }
        
        // If no end time, it's still running - don't count it
        return false;
      }) || [];
      
      console.log(`   📊 Presentations: ${presentationData?.length || 0} total → ${realPresentations.length} real (20+ min)`);
      
      // Get today's sales count (from call logs with sale disposition)
      const { data: salesData } = supabaseAdmin ? await supabaseAdmin
        .from('call_logs')
        .select('id')
        .eq('agent_email', email)
        .eq('disposition', 'sale')
        .gte('created_at', today.toISOString()) : { data: null };
      
      // Get today's ALP count (from call logs with ALP field)
      const { data: alpData } = supabaseAdmin ? await supabaseAdmin
        .from('call_logs')
        .select('id')
        .eq('agent_email', email)
        .not('alp', 'is', null)
        .gte('created_at', today.toISOString()) : { data: null };
      
      // Get today's VDP calls count (ConnectNow inbound calls) - Use created_at, not updated_at
      const { count: vdpCallsCount } = supabaseAdmin ? await supabaseAdmin
        .from('vdp_calls')
        .select('*', { count: 'exact', head: true })
        .eq('company_email', email)
        .gte('created_at', today.toISOString()) : { count: 0 };
      
      // Get pending leads count (callable leads)
      const { count: pendingLeadsCount } = supabaseAdmin ? await supabaseAdmin
        .from('masterlead')
        .select('*', { count: 'exact', head: true })
        .eq('cn_email', email)
        .in('cnresolution', ['pending', null])
        .eq('dnc', false) : { count: 0 };
          
          // Check if agent is in presentation
          const activePresentation = activePresentations.find(p => p.agentEmail === email);
          
          // Check if agent is in an active Whereby meeting (status = 'in_progress')
          const { data: activeMeets } = await supabaseAdmin
            .from('meets')
            .select('*')
            .eq('agent_email', email)
            .eq('status', 'in_progress')
            .not('whereby_room_url', 'is', null);
          
          const activeMeet = activeMeets && activeMeets.length > 0 ? activeMeets[0] : null;
          
          // Check if agent has recent masterlead activity (last 2 minutes), active Call Connector calls, OR heartbeat - "Live" status
          const twoMinutesAgo = new Date(Date.now() - 2 * 60 * 1000);
          const hasRecentActivity = lastActivity > twoMinutesAgo;
          const hasActiveCall = activeCalls.length > 0;
          const hasHeartbeat = callConnectorTracker.isAgentActive(email);
          const isLive = hasRecentActivity || hasActiveCall || hasHeartbeat;
          
          // Determine agent status:
          // - Presenting: Only if in HPPro presentation
          // - Live: Only if on an ANSWERED/IN-PROGRESS call (actively talking)
          // - Dialing: Only if call is RINGING/DIALING (not yet answered)
          // - Active: All other online agents (show call status inline, don't separate into sections)
          
          let status = 'active';
          let currentActivity = undefined;
          let currentCall = undefined;
          let availableForInbound = false;
          let vdpAgent = null;
          
          // Check if agent is available for inbound (VDP online agents) and get their VDP call status
          try {
            const { taalkVDPPoller } = await import('./taalk-vdp-poller');
            const allAgents = taalkVDPPoller.getAgents();
            vdpAgent = allAgents.find(a => a.email === email);
            availableForInbound = vdpAgent && vdpAgent.status !== 'offline';
            
            // Debug logging
            if (email.includes('cnsysop') || email.includes('chrislafond')) {
              console.log(`🔍 ${email} VDP Status:`, {
                found: !!vdpAgent,
                status: vdpAgent?.status,
                hasCurrentCall: !!vdpAgent?.currentCall,
                currentCall: vdpAgent?.currentCall,
                availableForInbound
              });
            }
          } catch (e) {
            // Taalk VDP poller not available
            console.log('⚠️ VDP tracker not available:', e);
          }
          
          // Debug logging - Call Connector
          if (email.includes('cnsysop') || email.includes('chrislafond')) {
            console.log(`🔍 ${email} Call Connector:`, {
              hasActiveCalls: activeCalls.length > 0,
              activeCalls: activeCalls,
              hasHeartbeat: hasHeartbeat
            });
          }
          
          // All agents stay in "Active" status - presentation shown inline
          status = 'active';
          
          let currentMeeting = undefined;
          
          if (activeMeet) {
            // Agent is in a Whereby meeting - get current stage from linked presentation analysis
            let currentStage = 'Introduction';
            let meetingDuration = 0;
            
            // Calculate duration if meeting started
            if (activeMeet.created_at) {
              const meetStartTime = new Date(activeMeet.created_at);
              meetingDuration = Math.floor((Date.now() - meetStartTime.getTime()) / 1000);
            }
            
            // If this meet is linked to a presentation session, get the AI analysis stage
            if (activeMeet.presentation_session_id) {
              const { data: presentationSession } = await supabaseAdmin
                .from('presentation_sessions')
                .select('ai_summary, current_phase')
                .eq('id', activeMeet.presentation_session_id)
                .maybeSingle();
              
              if (presentationSession?.current_phase?.phase) {
                currentStage = presentationSession.current_phase.phase;
              } else if (presentationSession?.ai_summary) {
                // Extract stage from AI summary if available
                currentStage = presentationSession.ai_summary.split(' - ')[0] || 'In Progress';
              }
            }
            
            currentMeeting = {
              type: 'aoi-meet',
              isActive: true,
              title: `${activeMeet.client_first_name || ''} ${activeMeet.client_last_name || ''}`.trim() || 'Client Meeting',
              leadName: `${activeMeet.client_first_name || ''} ${activeMeet.client_last_name || ''}`.trim() || 'Client',
              joinUrl: activeMeet.whereby_room_url,
              meetingId: activeMeet.id,
              startTime: new Date(activeMeet.created_at),
              endTime: new Date(new Date(activeMeet.created_at).getTime() + (activeMeet.duration_minutes || 60) * 60 * 1000),
              duration: meetingDuration,
              currentStage: currentStage,
              clientPhone: activeMeet.client_phone,
              clientEmail: activeMeet.client_email
            };
          }
          
          if (activePresentation) {
            // Agent is in a presentation - store data for inline display
            currentActivity = {
              type: 'presentation',
              presentationType: activePresentation.presentationType,
              duration: activePresentation.durationSeconds || 0,
              clientName: activePresentation.clientName,
              clientPhone: activePresentation.clientPhone,
              presentationUrl: activePresentation.presentationUrl
            };
          } else {
            // Agent is NOT presenting - track call status for inline display
            
            // Priority 1: Check Twilio API directly for active calls (MOST ACCURATE!)
            try {
              const { twilioCallsPoller } = await import('./twilio-calls-poller.js');
              const twilioActiveCall = twilioCallsPoller.getActiveCallForAgent(email);
              
              if (email.includes('cnsysop') || email.includes('chrislafond')) {
                console.log(`🔍 ${email} Twilio Poller Active Call:`, twilioActiveCall ? 'FOUND' : 'NONE');
                if (twilioActiveCall) {
                  console.log(`  Call:`, {
                    status: twilioActiveCall.status,
                    phoneNumber: twilioActiveCall.phoneNumber,
                    duration: twilioActiveCall.duration,
                    startedAt: twilioActiveCall.startedAt
                  });
                }
              }
              
              if (twilioActiveCall) {
                const callDuration = Math.floor((Date.now() - twilioActiveCall.startedAt.getTime()) / 1000);
                
                currentCall = {
                  type: 'call',
                  phoneNumber: twilioActiveCall.phoneNumber,
                  duration: callDuration,
                  clientName: twilioActiveCall.phoneNumber,
                  direction: twilioActiveCall.direction,
                  callStatus: twilioActiveCall.status === 'in-progress' ? 'answered' : 'ringing'
                };
                
                if (email.includes('cnsysop') || email.includes('chrislafond')) {
                  console.log(`✅ ${email} has Twilio LIVE call from poller:`, currentCall);
                }
              }
            } catch (e) {
              console.log('⚠️ Twilio poller not available:', e);
            }
            
            // Priority 2: Check if they have a VDP call (if no Twilio call found)
            if (!currentCall && vdpAgent?.currentCall) {
              const vdpCallStatus = vdpAgent.status === 'calling' ? 'answered' : 'dialing';
              currentCall = {
                type: 'call',
                phoneNumber: vdpAgent.currentCall.phoneNumber,
                duration: Math.floor((Date.now() - vdpAgent.currentCall.startTime.getTime()) / 1000),
                clientName: vdpAgent.currentCall.phoneNumber,
                direction: vdpAgent.currentCall.direction,
                callStatus: vdpCallStatus
              };
              
              if (email.includes('cnsysop') || email.includes('chrislafond')) {
                console.log(`✅ ${email} has VDP call:`, currentCall);
              }
            } 
            
            // Priority 3: Check if they have a tracked Call Connector call (if no other call found)
            if (!currentCall && activeCalls.length > 0) {
              currentCall = {
                type: 'call',
                phoneNumber: activeCalls[0].leadPhone,
                duration: Math.floor((Date.now() - activeCalls[0].startedAt.getTime()) / 1000),
                clientName: activeCalls[0].leadName,
                direction: 'outbound',
                callStatus: activeCalls[0].status
              };
              
              if (email.includes('cnsysop') || email.includes('chrislafond')) {
                console.log(`✅ ${email} has Call Connector tracked call:`, currentCall);
              }
            } else if (email.includes('cnsysop') || email.includes('chrislafond')) {
              console.log(`❌ ${email} has NO calls detected`);
            }
          }

          // Check for AO Recruit heartbeat - agent must be on AO Recruit page
          let hasRecruitHeartbeat = false;
          try {
            const { recruitTracker } = await import('./recruit-tracker');
            hasRecruitHeartbeat = recruitTracker.isAgentActive(email);
            
            if (email.includes('cnsysop') || email.includes('chrislafond')) {
              console.log(`🔍 ${email} AO Recruit:`, {
                hasRecruitHeartbeat,
                availableForInbound
              });
            }
          } catch (e) {
            console.log('⚠️ Recruit tracker not available:', e);
          }
          
          return {
            id: email,
            name,
            email,
            associateId: customerData?.associate_id?.toString() || email.split('@')[0],
            status,
            availableForInbound, // VDP online status
            hasCallConnectorHeartbeat: hasHeartbeat, // Call Connector Pro active
            hasRecruitHeartbeat: hasRecruitHeartbeat, // AO Recruit active
            currentCall: currentCall,
            currentMeeting: currentMeeting, // Whereby meeting with JOIN button
            currentPresentation: currentActivity?.type === 'presentation' ? currentActivity : undefined, // Show inline
            currentLive: status === 'live' ? currentActivity : undefined,
            todayStats: {
              // Combine masterlead stats with Call Connector stats (use whichever is higher)
              dialed: Math.max(ccStats.dialed, masterleadStats.dialed),
              reached: Math.max(ccStats.reached, masterleadStats.reached),
              booked: Math.max(ccStats.booked, masterleadStats.booked),
              presentations: realPresentations.length, // Only count 20+ minute presentations
              sales: salesData?.length || 0,
              alp: alpData?.length || 0
            },
            vdpCalls: vdpCallsCount || 0,
            credits: creditsData?.credits_remaining || 0, // Credits from user_credit table
            creditsRemaining: creditsData?.credits_remaining || 0, // Keep backward compatibility
            pendingLeads: pendingLeadsCount || 0, // Number of callable pending leads
            connects: vdpCallsCount || 0, // Connects = VDP calls
            lastActivity: lastActivity.toISOString()
          };
        })
      );

      // Sort by last activity (most recent first)
      enrichedAgents.sort((a, b) => 
        new Date(b.lastActivity).getTime() - new Date(a.lastActivity).getTime()
      );

      // Get user email from request (check headers or query)
      const userEmail = (req.query.userEmail as string) || (req.headers['x-user-email'] as string);
      let enforcedMgaFilter = mgaFilter;
      let userRoleData: { associate_id: number; role: string; email: string } | null = null;
      
      // Security: Check if user is an MGA/RGA and enforce their team filter
      if (userEmail && !userEmail.includes('cnsysop') && !userEmail.includes('richiealtig')) {
        const { data: userRole } = await supabaseAdmin
          ?.from('mga_rga_directory')
          .select('associate_id, role, email')
          .eq('email', userEmail.toLowerCase())
          .maybeSingle();
        
        userRoleData = userRole || null;
        
        if (userRole?.role === 'MGA') {
          // MGA can ONLY see their own team - enforce filter
          enforcedMgaFilter = userRole.associate_id.toString();
          console.log(`🔒 MGA ${userEmail} - enforcing team filter: ${enforcedMgaFilter}`);
        } else if (userRole?.role === 'RGA' || userRole?.role === 'BOTH') {
          // RGA can only see their managed MGAs - validate the filter if provided
          if (mgaFilter) {
            // Check if this MGA is managed by this RGA
            const { data: managedAgents } = await supabaseAdmin
              ?.from('agent_hierarchy')
              .select('mga_associate_id')
              .eq('rga_associate_id', userRole.associate_id)
              .eq('mga_associate_id', parseInt(mgaFilter))
              .limit(1);
            
            if (!managedAgents || managedAgents.length === 0) {
              // Invalid filter - clear it (RGA sees all their MGAs)
              enforcedMgaFilter = '';
              console.log(`🔒 RGA ${userEmail} - invalid MGA filter, clearing`);
            }
          }
          // If no MGA filter, RGA will see all agents under their managed MGAs (handled below)
        }
      }

      // Apply team filtering if requested
      let filteredAgents = enrichedAgents;
      
      // Special case: RGA with no MGA filter should see all their managed MGAs' agents
      if (userRoleData && (userRoleData.role === 'RGA' || userRoleData.role === 'BOTH') && !enforcedMgaFilter && !rgaFilter) {
        // Get all agents under this RGA's managed MGAs
        const { data: rgaAgents, error: rgaError } = await supabaseAdmin
          ?.from('agent_hierarchy')
          .select('agent_email')
          .eq('rga_associate_id', userRoleData.associate_id);
        
        if (!rgaError && rgaAgents && rgaAgents.length > 0) {
          let teamEmails = rgaAgents.map(a => a.agent_email?.toLowerCase()).filter(Boolean);
          
          // Add RGA's own email
          if (userEmail) {
            const lowerUserEmail = userEmail.toLowerCase();
            if (!teamEmails.includes(lowerUserEmail)) {
              teamEmails.push(lowerUserEmail);
            }
          }
          
          teamEmails = [...new Set(teamEmails)];
          console.log(`🔍 RGA ${userEmail} - showing all ${teamEmails.length} agents under managed MGAs (including themselves)`);
          
          filteredAgents = enrichedAgents.filter(agent => 
            teamEmails.includes(agent.email.toLowerCase())
          );
        }
      } else if (enforcedMgaFilter || rgaFilter) {
        console.log(`🔍 Applying team filter - MGA: ${enforcedMgaFilter}, RGA: ${rgaFilter}`);
        
        let teamEmails: string[] = [];
        
        // Build filter conditions
        if (enforcedMgaFilter) {
          const { data, error } = await supabaseAdmin
            ?.from('agent_hierarchy')
            .select('agent_email')
            .eq('mga_associate_id', parseInt(enforcedMgaFilter));
          
          if (!error && data) {
            const emails = data.map(a => a.agent_email?.toLowerCase()).filter(Boolean);
            teamEmails = [...teamEmails, ...emails];
          }
        }
        
        if (rgaFilter) {
          const { data, error } = await supabaseAdmin
            ?.from('agent_hierarchy')
            .select('agent_email')
            .eq('rga_associate_id', parseInt(rgaFilter));
          
          if (!error && data) {
            const emails = data.map(a => a.agent_email?.toLowerCase()).filter(Boolean);
            teamEmails = [...teamEmails, ...emails];
          }
        }
        
        // Remove duplicates
        teamEmails = [...new Set(teamEmails)];
        
        // IMPORTANT: Add the MGA/RGA's own email so they can see themselves
        if (userRoleData && userEmail) {
          const lowerUserEmail = userEmail.toLowerCase();
          if (!teamEmails.includes(lowerUserEmail)) {
            teamEmails.push(lowerUserEmail);
            console.log(`👤 Added ${userEmail} to team list (MGA/RGA can see themselves)`);
          }
        }
        
        console.log(`🔍 Found ${teamEmails.length} agents matching team filter (including MGA/RGA)`);
        
        // Filter enriched agents to only those in the team
        filteredAgents = enrichedAgents.filter(agent => 
          teamEmails.includes(agent.email.toLowerCase())
        );
        
        console.log(`🔍 After filtering: ${filteredAgents.length} agents`);
      } else if (userRoleData && userEmail) {
        // No filter applied, but user is MGA/RGA - they should still see themselves if they're active
        // (This handles the case where they haven't selected a filter yet)
        // We don't restrict here - let them see all until they filter
        console.log(`👤 User ${userEmail} is ${userRoleData.role} but no filter applied - showing all agents`);
      }

      console.log(`👥 Returning ${filteredAgents.length} agents`);
      res.json(filteredAgents);
    } catch (error) {
      console.error('❌ Live Call Board agents error:', error);
      res.status(500).json({ error: 'Failed to fetch agents' });
    }
  });


  // Check Twilio usage for yesterday
  app.get("/api/admin/twilio-usage-yesterday", async (req, res) => {
    try {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      
      const yesterday = new Date(today);
      yesterday.setDate(yesterday.getDate() - 1);
      
      const { data: calls, error } = await supabaseAdmin
        .from('twilio_call_logs')
        .select('owner_email, call_duration, call_status, created_at')
        .gte('created_at', yesterday.toISOString())
        .lt('created_at', today.toISOString());
      
      if (error) throw error;
      
      const uniqueAgents = new Set(calls?.map(c => c.owner_email).filter(e => e) || []);
      const totalCalls = calls?.length || 0;
      const callsWithDuration = calls?.filter(c => c.call_duration && c.call_duration > 0) || [];
      const totalMinutes = calls?.reduce((sum, call) => sum + ((call.call_duration || 0) / 60), 0) || 0;
      const answeredCalls = calls?.filter(c => c.call_status === 'completed' || c.call_status === 'answered').length || 0;
      const estimatedCost = totalMinutes * 0.013;
      
      // Sample data for debugging
      const sampleCalls = calls?.slice(0, 5).map(c => ({
        email: c.owner_email,
        duration: c.call_duration,
        status: c.call_status
      }));
      
      res.json({
        totalCalls,
        answeredCalls,
        unanswered: totalCalls - answeredCalls,
        callsWithDuration: callsWithDuration.length,
        callsWithoutDuration: totalCalls - callsWithDuration.length,
        totalMinutes: totalMinutes.toFixed(2),
        uniqueAgents: uniqueAgents.size,
        avgCallsPerAgent: uniqueAgents.size > 0 ? (totalCalls / uniqueAgents.size).toFixed(1) : '0',
        avgMinutesPerAgent: uniqueAgents.size > 0 ? (totalMinutes / uniqueAgents.size).toFixed(2) : '0',
        estimatedCost: estimatedCost.toFixed(2),
        costPerAgent: uniqueAgents.size > 0 ? (estimatedCost / uniqueAgents.size).toFixed(2) : '0',
        sampleCalls
      });
    } catch (error) {
      console.error('❌ Error checking Twilio usage:', error);
      res.status(500).json({ error: 'Failed to check Twilio usage' });
    }
  });

  // Request leads for current agent (called from "Get Started" button or when queue is empty)
  app.post("/api/leads/request-leads", async (req, res) => {
    try {
      const { agentEmail } = req.body;
      
      if (!agentEmail) {
        return res.status(400).json({ error: 'Agent email required' });
      }
      
      console.log(`📋 LEAD REQUEST: ${agentEmail} requesting leads...`);
      
      // Count their current pending/called/null leads
      const { count: currentCount } = await supabaseAdmin
        .from('masterlead')
        .select('*', { count: 'exact', head: true })
        .eq('cn_email', agentEmail)
        .or('cnresolution.is.null,cnresolution.eq.pending,cnresolution.eq.called,cnresolution.eq.')
        .eq('dnc', false);
      
      const current = currentCount || 0;
      const needed = 50 - current;
      
      console.log(`   Current: ${current} leads, Need: ${needed}`);
      
      if (needed <= 0) {
        return res.json({
          success: true,
          message: 'Agent already has 50 leads',
          currentLeads: current,
          assigned: 0
        });
      }
      
      // Get agent's states and market from customers table (VDP data)
      const { data: agentData } = await supabaseAdmin
        .from('customers')
        .select('states, market')
        .or(`company_email.eq.${agentEmail},personal_email.eq.${agentEmail}`)
        .maybeSingle();
      
      const agentStates = agentData?.states || [];
      const agentMarket = agentData?.market || 'Veteran';
      
      console.log(`   Agent states: ${agentStates.join(', ')}, Market: ${agentMarket}`);
      
      // Get unassigned pending/null/called leads matching agent's states and market
      // ORDER BY STATE RARITY (states with fewest licensed agents first)
      
      // Count how many agents are licensed in each state
      const { data: allAgents } = await supabaseAdmin
        .from('customers')
        .select('states')
        .not('states', 'is', null);
      
      const agentsPerState: Record<string, number> = {};
      allAgents?.forEach(agent => {
        const states = agent.states || [];
        states.forEach((state: string) => {
          agentsPerState[state] = (agentsPerState[state] || 0) + 1;
        });
      });
      
      console.log(`   State rarity (agents licensed): ${JSON.stringify(agentsPerState)}`);
      
      // Get all matching leads (unordered)
      let leadQuery = supabaseAdmin
        .from('masterlead')
        .select('id, state, taalk_state')
        .is('cn_email', null)
        .eq('dnc', false)
        .not('state', 'eq', 'DC')
        .or('cnresolution.is.null,cnresolution.eq.pending,cnresolution.eq.called,cnresolution.eq.');
      
      // Match by market
      if (agentMarket) {
        leadQuery = leadQuery.eq('taalk_market', agentMarket);
      }
      
      // Match by states
      if (agentStates.length > 0) {
        const stateConditions = agentStates.map(state => `state.eq.${state},taalk_state.eq.${state}`).join(',');
        leadQuery = leadQuery.or(stateConditions);
      }
      
      const { data: matchingLeads } = await leadQuery.limit(needed * 3); // Get more than needed for sorting
      
      // Sort by state rarity (states with FEWEST agents first)
      const sortedLeads = matchingLeads?.sort((a, b) => {
        const stateA = a.state || a.taalk_state;
        const stateB = b.state || b.taalk_state;
        const agentCountA = agentsPerState[stateA] || 999; // States with 0 agents = highest priority
        const agentCountB = agentsPerState[stateB] || 999;
        return agentCountA - agentCountB; // Ascending: fewest agents first
      }).slice(0, needed) || [];
      
      const availableLeads = sortedLeads;
      
      if (!availableLeads || availableLeads.length === 0) {
        console.log(`   ❌ No unassigned leads available`);
        return res.json({
          success: false,
          message: 'No unassigned leads available',
          currentLeads: current,
          assigned: 0
        });
      }
      
      // Assign them
      const { error: assignError } = await supabaseAdmin
        .from('masterlead')
        .update({
          cn_email: agentEmail,
          assigned_date: new Date().toISOString(),
          cnresolution: 'pending'
        })
        .in('id', availableLeads.map(l => l.id));
      
      if (assignError) {
        console.error(`   ❌ Error assigning leads:`, assignError);
        return res.status(500).json({ error: 'Failed to assign leads' });
      }
      
      console.log(`   ✅ Assigned ${availableLeads.length} leads to ${agentEmail}`);
      
      res.json({
        success: true,
        message: `Assigned ${availableLeads.length} leads`,
        currentLeads: current + availableLeads.length,
        assigned: availableLeads.length
      });
      
    } catch (error: any) {
      console.error('❌ Error requesting leads:', error);
      res.status(500).json({ error: 'Failed to request leads' });
    }
  });

  // ADMIN: Force assign all agents to 50 pending leads NOW
  app.post("/api/admin/force-assign-leads", async (req, res) => {
    try {
      console.log('🔄 ADMIN: Force assigning all agents to 50 pending leads...');
      
      // Get all unique agents who have ANY assigned leads
      const { data: assignedLeads, error: agentsError } = await supabaseAdmin
        .from('masterlead')
        .select('cn_email')
        .not('cn_email', 'is', null)
        .limit(100000);

      if (agentsError) throw agentsError;

      // Get unique agent emails
      const uniqueEmails = [...new Set(assignedLeads?.map(l => l.cn_email) || [])];
      const agents = uniqueEmails.map(email => ({ company_email: email }));

      console.log(`👥 Found ${agents.length} unique agents with assigned leads`);

      let totalAssigned = 0;
      let agentsProcessed = 0;

      for (const agent of agents) {
        const agentEmail = agent.company_email || agent.personal_email;
        if (!agentEmail) continue;

        // Count current pending leads - ONLY pending, called, null
        const { count: currentCount } = await supabaseAdmin
          .from('masterlead')
          .select('*', { count: 'exact', head: true })
          .eq('cn_email', agentEmail)
          .or('cnresolution.is.null,cnresolution.eq.pending,cnresolution.eq.called,cnresolution.eq.')
          .eq('dnc', false);

        const current = currentCount || 0;
        const needed = 50 - current;

        console.log(`   ${agentEmail}: ${current} callable leads (need ${needed})`);

        if (needed <= 0) continue;

        console.log(`📤 ${agentEmail}: Has ${current}, need ${needed} more...`);

        // Get unassigned leads - pending, null, called, blank - NOT booked, closed, sale
        const { data: availableLeads } = await supabaseAdmin
          .from('masterlead')
          .select('id')
          .is('cn_email', null)
          .eq('dnc', false)
          .not('state', 'eq', 'DC')
          .not('cnresolution', 'in', '(booked,closed,sale)')
          .limit(needed);

        if (!availableLeads || availableLeads.length === 0) {
          console.log(`   ⚠️ No unassigned leads available for ${agentEmail}`);
          continue;
        }

        // Assign them
        const { error: assignError } = await supabaseAdmin
          .from('masterlead')
          .update({
            cn_email: agentEmail,
            assigned_date: new Date().toISOString(),
            cnresolution: 'pending'
          })
          .in('id', availableLeads.map(l => l.id));

        if (assignError) {
          console.error(`   ❌ Error assigning to ${agentEmail}:`, assignError);
          continue;
        }

        totalAssigned += availableLeads.length;
        agentsProcessed++;
        console.log(`   ✅ Assigned ${availableLeads.length} leads to ${agentEmail}`);
      }

      console.log(`✅ Force assignment complete: ${totalAssigned} leads assigned to ${agentsProcessed} agents`);
      res.json({
        success: true,
        agentsProcessed,
        totalAssigned
      });
    } catch (error: any) {
      console.error('❌ Error force assigning leads:', error);
      res.status(500).json({ 
        error: 'Failed to force assign leads',
        details: error?.message || String(error)
      });
    }
  });

  // ADMIN: Reset all agents to max 50 pending leads
  app.post("/api/admin/reset-pending-leads", async (req, res) => {
    try {
      console.log('🔄 ADMIN: Resetting all agents to max 50 pending leads...');
      
      // Get all agents with assigned leads
      const { data: agents, error: agentsError } = await supabaseAdmin
        .from('masterlead')
        .select('cn_email')
        .not('cn_email', 'is', null)
        .in('cnresolution', ['pending', null]);

      if (agentsError) throw agentsError;

      // Get unique agent emails
      const uniqueAgents = [...new Set(agents.map(a => a.cn_email))];
      console.log(`👥 Found ${uniqueAgents.length} agents with pending leads`);

      let totalUnassigned = 0;
      let agentsProcessed = 0;

      for (const agentEmail of uniqueAgents) {
        // Count their current pending leads - ONLY pending, called, null, blank
        const { count: pendingCount } = await supabaseAdmin
          .from('masterlead')
          .select('*', { count: 'exact', head: true })
          .eq('cn_email', agentEmail)
          .or('cnresolution.is.null,cnresolution.eq.pending,cnresolution.eq.called,cnresolution.eq.')
          .eq('dnc', false);

        const currentPending = pendingCount || 0;

        if (currentPending > 50) {
          const toUnassign = currentPending - 50;
          console.log(`📋 ${agentEmail}: ${currentPending} pending → Unassigning ${toUnassign} leads`);

          // Get the excess leads (oldest first) - ONLY pending, called, null, blank
          const { data: excessLeads } = await supabaseAdmin
            .from('masterlead')
            .select('id, currently_calling')
            .eq('cn_email', agentEmail)
            .or('cnresolution.is.null,cnresolution.eq.pending,cnresolution.eq.called,cnresolution.eq.')
            .eq('dnc', false)
            .or('currently_calling.is.null,currently_calling.eq.false') // NEVER touch leads being called
            .order('assigned_date', { ascending: true, nullsFirst: true })
            .limit(toUnassign);

          if (excessLeads && excessLeads.length > 0) {
            // Unassign them - Reset cnresolution back to pending
            const { error: unassignError } = await supabaseAdmin
              .from('masterlead')
              .update({
                previous_cn_email: agentEmail,
                last_assigned_date: new Date().toISOString(),
                cn_email: null,
                assigned_date: null,
                cnresolution: 'pending' // Reset back to pending when unassigning
              })
              .in('id', excessLeads.map(l => l.id));

            if (unassignError) throw unassignError;

            totalUnassigned += excessLeads.length;
            agentsProcessed++;
          }
        }
      }

      console.log(`✅ Reset complete: ${totalUnassigned} leads unassigned from ${agentsProcessed} agents`);
      res.json({
        success: true,
        agentsProcessed,
        totalUnassigned
      });
    } catch (error) {
      console.error('❌ Error resetting pending leads:', error);
      res.status(500).json({ error: 'Failed to reset pending leads' });
    }
  });

  // Get user's team role and MGAs they manage (for RGA)
  app.get("/api/live-call-board/user-team-info", async (req, res) => {
    try {
      const userEmail = req.query.email as string;
      if (!userEmail) {
        return res.status(400).json({ error: 'Email required' });
      }

      // Check if user is in mga_rga_directory
      const { data: userRole } = await supabaseAdmin
        ?.from('mga_rga_directory')
        .select('associate_id, name, role, email')
        .eq('email', userEmail.toLowerCase())
        .maybeSingle();

      if (!userRole) {
        // Not an MGA/RGA - return null (will show all for sysops/admins)
        return res.json({ role: null, mgaAssociateId: null, managedMGAs: [] });
      }

      let managedMGAs: any[] = [];

      // If user is an RGA, get all MGAs they manage
      if (userRole.role === 'RGA' || userRole.role === 'BOTH') {
        // Get all agents under this RGA, then find their unique MGAs
        const { data: agents } = await supabaseAdmin
          ?.from('agent_hierarchy')
          .select('mga_associate_id, mga_name')
          .eq('rga_associate_id', userRole.associate_id)
          .not('mga_associate_id', 'is', null);

        if (agents && agents.length > 0) {
          // Get unique MGAs
          const uniqueMGAs = new Map();
          agents.forEach(agent => {
            if (agent.mga_associate_id && agent.mga_name) {
              uniqueMGAs.set(agent.mga_associate_id, {
                associate_id: agent.mga_associate_id,
                name: agent.mga_name
              });
            }
          });
          managedMGAs = Array.from(uniqueMGAs.values());
        }
      }

      res.json({
        role: userRole.role,
        mgaAssociateId: userRole.role === 'MGA' || userRole.role === 'BOTH' ? userRole.associate_id : null,
        managedMGAs: managedMGAs
      });
    } catch (error) {
      console.error('❌ Error fetching user team info:', error);
      res.status(500).json({ error: 'Failed to fetch user team info' });
    }
  });

  // Get agent's licensed states
  app.get("/api/agent/licensed-states", async (req, res) => {
    try {
      const userEmail = req.query.email as string;
      
      if (!userEmail) {
        return res.status(400).json({ error: 'Email required' });
      }
      
      // Get states from agent_profiles or customers table
      const { data: agentData } = await supabaseAdmin
        ?.from('agent_profiles')
        .select('states')
        .eq('email', userEmail.toLowerCase())
        .maybeSingle();
      
      let states: string[] = [];
      
      if (agentData && agentData.states) {
        // States might be stored as JSON array or string
        if (typeof agentData.states === 'string') {
          try {
            states = JSON.parse(agentData.states);
          } catch {
            // If not JSON, might be comma-separated
            states = agentData.states.split(',').map(s => s.trim()).filter(Boolean);
          }
        } else if (Array.isArray(agentData.states)) {
          states = agentData.states;
        }
      }
      
      res.json({ states });
    } catch (error) {
      console.error('❌ Error fetching licensed states:', error);
      res.status(500).json({ error: 'Failed to fetch licensed states', states: [] });
    }
  });

  // Check user's credit status and VDP status
  app.get("/api/user/credit-status", async (req, res) => {
    try {
      const userEmail = req.query.email as string;
      
      if (!userEmail) {
        return res.status(400).json({ error: 'Email required' });
      }
      
      // Get credits
      const { data: creditData } = await supabaseAdmin
        ?.from('user_credit')
        .select('credits_remaining')
        .eq('email', userEmail.toLowerCase())
        .maybeSingle();
      
      // Get VDP status
      const { data: customerData } = await supabaseAdmin
        ?.from('customers')
        .select('VDPACTIVE')
        .eq('company_email', userEmail.toLowerCase())
        .maybeSingle();
      
      const creditsRemaining = creditData?.credits_remaining || 0;
      const vdpActive = customerData?.VDPACTIVE === 'ACTIVE';
      const vdpDisabledDueToCredits = !vdpActive && creditsRemaining < 0;
      
      res.json({
        credits_remaining: creditsRemaining,
        vdpActive,
        vdpDisabledDueToCredits
      });
    } catch (error) {
