  // Reassign hotleads from one email to another
  app.post("/api/admin/reassign-hotleads", async (req, res) => {
    try {
      const { from, to } = req.body;
      console.log(`🔄 Reassigning hotleads from ${from} to ${to}...`);
      
      // Try reassigning with clean email first
      let { data: updated, error } = await supabaseAdmin
        .from('masterlead')
        .update({ cn_email: to })
        .eq('cn_email', from)
        .eq('is_hot_lead', true)
        .select();

      let totalUpdated = updated?.length || 0;

      // Also try with newline character if no results
      if (totalUpdated === 0) {
        console.log(`🔄 No leads found with clean email, trying with newline: "${from}\\n"`);
        const fromWithNewline = from + '\n';
        const result = await supabaseAdmin
          .from('masterlead')
          .update({ cn_email: to })
          .eq('cn_email', fromWithNewline)
          .eq('is_hot_lead', true)
          .select();
        
        if (!result.error && result.data) {
          updated = [...(updated || []), ...result.data];
          totalUpdated += result.data.length;
        }
      }

      if (error && totalUpdated === 0) {
        console.error('❌ Error reassigning hotleads:', error);
        return res.status(500).json({ error: 'Failed to reassign hotleads' });
      }

      console.log(`✅ Successfully reassigned ${totalUpdated} hotleads from ${from} to ${to}`);
      
      res.json({
        success: true,
        message: `Reassigned ${totalUpdated} hotleads from ${from} to ${to}`,
        hotleads: updated
      });
      
    } catch (error) {
      console.error('❌ Script error:', error);
      res.status(500).json({ error: 'Reassignment failed' });
    }
  });

  // Migrate veteran leads to Supabase
  app.post("/api/admin/migrate-leads-to-supabase", async (req, res) => {
    try {
      console.log('🚀 Starting migration of veteran leads to Supabase...');
      
      // DISABLED: Only use masterlead table from Supabase
      const leads = [];
      console.log('⚠️ Veteran leads migration disabled - use masterlead table only');
      
      console.log(`📊 Found ${leads.length} leads to migrate`);
      
      // Prepare leads for Supabase (remove auto-generated fields)
      const leadsForSupabase = leads.map(lead => {
        const { id, created_at, updated_at, ...leadData } = lead;
        return {
          ...leadData,
          created_at: lead.created_at || new Date().toISOString(),
          updated_at: lead.updated_at || new Date().toISOString()
        };
      });
      
      // Insert all leads in batches using the admin client
      const batchSize = 100;
      let totalMigrated = 0;
      
      for (let i = 0; i < leadsForSupabase.length; i += batchSize) {
        const batch = leadsForSupabase.slice(i, i + batchSize);
        
        console.log(`🚀 Inserting batch ${Math.floor(i/batchSize) + 1}/${Math.ceil(leadsForSupabase.length/batchSize)} (${batch.length} leads)...`);
        
        const { data: insertData, error: insertError } = await supabase
          .from('Taalk2CN')
          .insert(batch);
        
        if (insertError) {
          console.error(`❌ Error inserting batch:`, insertError);
          return res.status(500).json({
            success: false,
            error: 'Failed to insert batch',
            details: insertError.message
          });
        }
        
        totalMigrated += batch.length;
        console.log(`✅ Migrated ${totalMigrated}/${leadsForSupabase.length} leads`);
      }
      
      // Verify migration
      const { count, error: countError } = await supabase
        .from('Taalk2CN')
        .select('*', { count: 'exact', head: true });
        
      if (countError) {
        console.error('❌ Error verifying migration:', countError);
        return res.status(500).json({
          success: false,
          error: 'Failed to verify migration',
          details: countError.message
        });
      }
      
      console.log(`🎉 Successfully migrated all ${totalMigrated} veteran leads to Supabase!`);
      console.log(`✅ Verification: Supabase now contains ${count} veteran leads`);
      
      res.json({
        success: true,
        migrated: totalMigrated,
        totalInSupabase: count,
        message: `Successfully migrated ${totalMigrated} veteran leads to Supabase`
      });
      
    } catch (error) {
      console.error('❌ Migration failed:', error);
      res.status(500).json({
        success: false,
        error: 'Migration failed',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

  // Verification Results API - Admin only access (cnsysop@aoglobelife.com)
  app.get("/api/admin/verification-results", async (req, res) => {
    try {
      // Check admin access - only cnsysop@aoglobelife.com can access
      const userEmail = (req.session as any)?.user?.email;
      if (userEmail !== 'cnsysop@aoglobelife.com') {
        return res.status(403).json({
          success: false,
          error: 'Access denied. Admin privileges required.',
          message: 'Only cnsysop@aoglobelife.com can access verification results'
        });
      }

      console.log('📊 Fetching verification results for admin dashboard...');

      // Get all verification sessions from database
      const sessions = await db
        .select()
        .from(schema.verificationSessions)
        .orderBy(desc(schema.verificationSessions.createdAt));

      // Calculate overview metrics
      const totalSessions = sessions.length;
      const completedSessions = sessions.filter(s => s.status === 'completed').length;
      const pendingSessions = sessions.filter(s => s.status === 'pending').length;
      const failedSessions = sessions.filter(s => s.status === 'failed').length;
      const completionRate = totalSessions > 0 ? Math.round((completedSessions / totalSessions) * 100) : 0;

      // Language breakdown
      const englishSessions = sessions.filter(s => s.language === 'en' || !s.language).length;
      const spanishSessions = sessions.filter(s => s.language === 'es').length;

      // Verification method breakdown
      const methodBreakdown = sessions.reduce((acc, session) => {
        const method = session.verificationMethod || 'unknown';
        acc[method] = (acc[method] || 0) + 1;
        return acc;
      }, {} as Record<string, number>);

      // SMS verification stats
      const smsStats = {
        sent: sessions.filter(s => s.smsVerificationSent).length,
        approved: sessions.filter(s => s.clientApprovalStatus === 'approved').length,
        denied: sessions.filter(s => s.clientApprovalStatus === 'denied').length,
        pending: sessions.filter(s => s.clientApprovalStatus === 'pending').length
      };

      // Taalk call integration stats
      const taalkStats = {
        callsInitiated: sessions.filter(s => s.taalkCallId).length,
        callsCompleted: sessions.filter(s => s.taalkCallStatus === 'completed').length,
        callsFailed: sessions.filter(s => s.taalkCallStatus === 'failed').length,
        totalDuration: sessions.reduce((sum, s) => sum + (s.taalkCallDuration || 0), 0)
      };

      // Recent sessions (last 30 days) for trends
      const thirtyDaysAgo = new Date();
      thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
      
      const trends = [];
      for (let i = 29; i >= 0; i--) {
        const date = new Date();
        date.setDate(date.getDate() - i);
        const dateStr = date.toISOString().split('T')[0];
        
        const daySessions = sessions.filter(session => {
          const sessionDate = session.createdAt ? new Date(session.createdAt) : null;
          return sessionDate && sessionDate.toISOString().split('T')[0] === dateStr;
        });
        
        const dayCompleted = daySessions.filter(s => s.status === 'completed').length;
        const dayCompletionRate = daySessions.length > 0 ? Math.round((dayCompleted / daySessions.length) * 100) : 0;
        
        trends.push({
          date: dateStr,
          total: daySessions.length,
          completed: dayCompleted,
          completionRate: dayCompletionRate
        });
      }

      // Agent performance (by agent name from sessions)
      const agentPerformance = sessions.reduce((acc, session) => {
        const agentName = `${session.agentFirstName || 'Unknown'} ${session.agentLastName || 'Agent'}`;
        if (!acc[agentName]) {
          acc[agentName] = { 
            agentName, 
            totalSessions: 0, 
            completedSessions: 0, 
            completionRate: 0 
          };
        }
        acc[agentName].totalSessions++;
        if (session.status === 'completed') {
          acc[agentName].completedSessions++;
        }
        acc[agentName].completionRate = Math.round((acc[agentName].completedSessions / acc[agentName].totalSessions) * 100);
        return acc;
      }, {} as Record<string, any>);

      console.log(`✅ Retrieved ${totalSessions} verification sessions for dashboard`);

      res.json({
        success: true,
        overview: {
          totalSessions,
          completedSessions,
          pendingSessions,
          failedSessions,
          completionRate,
          englishSessions,
          spanishSessions
        },
        trends,
        agentPerformance: Object.values(agentPerformance),
        methodBreakdown: Object.entries(methodBreakdown).map(([method, count]) => ({
          method,
          count,
          percentage: Math.round((count / totalSessions) * 100)
        })),
        smsStats,
        taalkStats,
        recentSessions: sessions.slice(0, 50), // Last 50 sessions for detail view
        timestamp: new Date().toISOString()
      });

    } catch (error) {
      console.error('❌ Error fetching verification results:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to fetch verification results',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

