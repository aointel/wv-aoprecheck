  // ===== CURRENT LEAD MANAGEMENT API =====
  
  // Set current lead (supports both masterlead and vdp sources)
  app.post("/api/current-lead", async (req, res) => {
    try {
      const { source, id } = req.body;
      const userEmail = req.query.userEmail as string;
      
      if (!userEmail) {
        return res.status(400).json({ success: false, error: 'User email is required' });
      }
      
      if (!source || !id) {
        return res.status(400).json({ success: false, error: 'Source and ID are required' });
      }
      
      console.log(`📋 Setting current lead for ${userEmail}: ${source} - ${id}`);
      
      if (source === 'vdp') {
        // Get associate_id for the user email
        const { data: userProfile, error: profileError } = await supabase
          .from('aoimanualcalls')
          .select('associate_id')
          .eq('email', userEmail)
          .single();
          
        if (profileError || !userProfile?.associate_id) {
          console.error('❌ Could not get associate_id for user:', userEmail);
          return res.status(400).json({ success: false, error: 'User not found or no associate_id' });
        }
        
        // Fetch VDP call from vdp_calls table with ownership check
        const { data: vdpCall, error: vdpError } = await supabase
          .from('vdp_calls')
          .select('*')
          .eq('id', id)
          .eq('Agent', userProfile.associate_id.toString())
          .single();
          
        if (vdpError || !vdpCall) {
          console.error('❌ VDP call not found or unauthorized:', vdpError);
          return res.status(404).json({ success: false, error: 'VDP call not found or unauthorized' });
        }
        
        // Map VDP call to CurrentLead format
        const currentLead = {
          source: 'vdp' as const,
          id: vdpCall.id,
          name: `${vdpCall.firstname || ''} ${vdpCall.lastname || ''}`.trim() || 'Unknown',
          phone: vdpCall.Phone || '',
          market: vdpCall.market || 'Unknown Market',
          state: vdpCall.state || '',
          city: vdpCall.city || '',
          address: vdpCall.address || '',
          notes: vdpCall.resolutionNotes || '',
          cnresolution: vdpCall.resolutionStatus || 'pending',
          metadata: vdpCall
        };
        
        // Store in memory via storage
        await storage.setCurrentLead(userEmail, currentLead);
        
        console.log(`✅ Set VDP current lead: ${currentLead.name} (${currentLead.phone})`);
        return res.json({ success: true, currentLead });
        
      } else if (source === 'masterlead') {
        // Handle masterlead source (existing logic can be adapted here)
        return res.status(400).json({ success: false, error: 'Masterlead source not yet implemented' });
      } else {
        return res.status(400).json({ success: false, error: 'Invalid source. Must be "vdp" or "masterlead"' });
      }
      
    } catch (error) {
      console.error('❌ Set current lead error:', error);
      res.status(500).json({ success: false, error: 'Internal server error' });
    }
  });
  
