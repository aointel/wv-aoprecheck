  // End only outbound PSTN call while keeping agent WebRTC persistent - CRITICAL ARCHITECTURE FIX
  app.post("/api/outbound-dialer/end-outbound-call", async (req, res) => {
    try {
      const { leadPhone, conferenceName = 'Call-Connector-Pro-Conference' } = req.body;
      
      console.log(`📞 ENDING OUTBOUND CALL: Terminating only PSTN call to ${leadPhone}, keeping agent WebRTC active`);
      
      // Find active conference
      const conferences = await twilioClient.conferences.list({
        friendlyName: conferenceName,
        status: 'in-progress'
      });
      
      if (conferences.length === 0) {
        console.log('⚠️ No active conference found to end outbound call');
        return res.json({
          success: false,
          message: 'No active conference found'
        });
      }
      
      const conference = conferences[0];
      console.log(`🎯 Found conference: ${conference.sid}`);
      
      // Get all participants in the conference
      const participants = await twilioClient.conferences(conference.sid).participants.list();
      console.log(`👥 Conference has ${participants.length} participants`);
      
      // Also get the lead's call directly by CallSid if we have it
      console.log(`🔍 Looking for lead's call in conference participants...`);
      
      // Find and end only the outbound call to the lead (keep agent WebRTC connection)
      let outboundCallEnded = false;
      for (const participant of participants) {
        try {
          // Get call details to identify the outbound call
          const call = await twilioClient.calls(participant.callSid).fetch();
          
          // Identify outbound call by phone number (to lead) vs WebRTC (agent)
          const cleanLeadPhone = leadPhone.replace(/\D/g, '');
          const callToClean = call.to.replace(/\D/g, '');
          const callFromClean = call.from.replace(/\D/g, '');
          
          console.log(`🔍 Checking call ${participant.callSid}: to=${call.to}, from=${call.from}`);
          console.log(`🔍 Clean numbers: lead=${cleanLeadPhone}, callTo=${callToClean}, callFrom=${callFromClean}`);
          
          // Check if this is the outbound call to the lead (not the agent's WebRTC)
          if (callToClean.includes(cleanLeadPhone) || callFromClean.includes(cleanLeadPhone)) {
            console.log(`📞 Ending outbound PSTN call to lead: ${participant.callSid}`);
            await twilioClient.calls(participant.callSid).update({ status: 'completed' });
            outboundCallEnded = true;
          } else {
            console.log(`🔌 Keeping agent WebRTC connection active: ${participant.callSid}`);
          }
        } catch (error) {
          console.error(`⚠️ Error checking participant ${participant.callSid}:`, error);
        }
      }
      
      // If we didn't find the call in participants, try to end it directly by looking up recent calls
      if (!outboundCallEnded) {
        console.log(`🔍 Lead's call not found in conference, trying direct call lookup...`);
        try {
          // Look for recent calls to this phone number
          const calls = await twilioClient.calls.list({
            to: `+1${leadPhone}`,
            status: 'in-progress'
          });
          
          if (calls.length > 0) {
            console.log(`📞 Found ${calls.length} active calls to ${leadPhone}, ending them...`);
            for (const call of calls) {
              console.log(`📞 Ending call ${call.sid} to ${call.to}`);
              await twilioClient.calls(call.sid).update({ status: 'completed' });
              outboundCallEnded = true;
            }
          } else {
            console.log(`⚠️ No active calls found to ${leadPhone}`);
          }
        } catch (error) {
          console.error(`❌ Error looking up calls to ${leadPhone}:`, error);
        }
      }
      
      res.json({
        success: true,
        message: outboundCallEnded ? 'Outbound call ended, agent WebRTC remains active' : 'No matching outbound call found',
        conferenceSid: conference.sid,
        outboundCallEnded
      });
      
    } catch (error) {
      console.error('❌ Error ending outbound call:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to end outbound call',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

