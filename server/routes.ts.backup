  // Analyze lead database and recommend which phone numbers to purchase
  app.get("/api/twilio/analyze-leads", async (req, res) => {
    try {
      console.log('📊 Analyzing lead database for phone number recommendations...');
      
      // Get ALL leads with proper pagination - use smaller batches
      let allLeads: any[] = [];
      let page = 0;
      const pageSize = 500; // Smaller batch size
      let hasMore = true;
      
      console.log('📊 Starting to fetch ALL leads from masterlead table...');
      
      while (hasMore) {
        console.log(`📊 Fetching page ${page + 1} (range: ${page * pageSize} to ${(page + 1) * pageSize - 1})`);
        
        const { data: leads, error: leadsError } = await supabaseAdmin
          .from('masterlead')
          .select('phone, taalk_state, taalk_city, cn_email')
          .not('phone', 'is', null)
          .range(page * pageSize, (page + 1) * pageSize - 1);
        
        if (leadsError) {
          console.error('❌ Error fetching leads:', leadsError);
          return res.status(500).json({ error: 'Failed to fetch leads from database' });
        }
        
        if (leads && leads.length > 0) {
          allLeads = allLeads.concat(leads);
          page++;
          console.log(`📊 Fetched page ${page}: ${leads.length} leads (Total: ${allLeads.length})`);
          
          // If we got less than pageSize, we're done
          if (leads.length < pageSize) {
            hasMore = false;
            console.log(`📊 Reached end - got ${leads.length} leads in last page`);
          }
        } else {
          hasMore = false;
          console.log(`📊 No more leads found at page ${page}`);
        }
        
        // Add a small delay to prevent overwhelming the database
        await new Promise(resolve => setTimeout(resolve, 100));
      }
      
      console.log(`📊 Found ${allLeads.length} total leads with phone numbers`);
      
      // Extract area codes and count leads per area code
      const areaCodeCounts = new Map<string, { count: number; states: Set<string>; cities: Set<string> }>();
      
      allLeads.forEach(lead => {
        if (!lead.phone) return;
        
        // Extract area code (first 3 digits after country code)
        const cleaned = lead.phone.replace(/\D/g, '');
        let areaCode = '';
        
        if (cleaned.length === 11 && cleaned.startsWith('1')) {
          areaCode = cleaned.substring(1, 4);
        } else if (cleaned.length === 10) {
          areaCode = cleaned.substring(0, 3);
        }
        
        if (areaCode && areaCode.length === 3) {
          if (!areaCodeCounts.has(areaCode)) {
            areaCodeCounts.set(areaCode, { 
              count: 0, 
              states: new Set<string>(), 
              cities: new Set<string>() 
            });
          }
          
          const data = areaCodeCounts.get(areaCode)!;
          data.count++;
          
          if (lead.taalk_state) data.states.add(lead.taalk_state);
          if (lead.taalk_city) data.cities.add(lead.taalk_city);
        }
      });
      
      // Sort by lead count (highest first)
      const sortedAreaCodes = Array.from(areaCodeCounts.entries())
        .map(([areaCode, data]) => ({
          areaCode,
          leadCount: data.count,
          states: Array.from(data.states),
          cities: Array.from(data.cities).slice(0, 3), // Top 3 cities
          percentage: ((data.count / (allLeads?.length || 1)) * 100).toFixed(2)
        }))
        .sort((a, b) => b.leadCount - a.leadCount);
      
      // Get existing Twilio numbers to avoid duplicates
      const client = twilio(TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN);
      const existingNumbers = await client.incomingPhoneNumbers.list({ limit: 100 });
      const existingAreaCodes = new Set(
        existingNumbers
          .map(num => {
            const cleaned = num.phoneNumber.replace(/\D/g, '');
            if (cleaned.length === 11 && cleaned.startsWith('1')) {
              return cleaned.substring(1, 4);
            } else if (cleaned.length === 10) {
              return cleaned.substring(0, 3);
            }
            return null;
          })
          .filter(Boolean)
      );
      
      console.log(`📊 Existing area codes: ${Array.from(existingAreaCodes).join(', ')}`);
      
      // Recommend numbers to purchase (top area codes not already owned)
      const recommendations = sortedAreaCodes
        .filter(item => !existingAreaCodes.has(item.areaCode))
        .slice(0, 20) // Top 20 recommendations
        .map(item => ({
          ...item,
          priority: item.leadCount > 100 ? 'high' : item.leadCount > 50 ? 'medium' : 'low',
          estimatedCost: 1.00 // $1/month per number
        }));
      
      // Calculate coverage statistics
      const totalLeads = allLeads?.length || 0;
      const coveredLeads = sortedAreaCodes
        .filter(item => existingAreaCodes.has(item.areaCode))
        .reduce((sum, item) => sum + item.leadCount, 0);
      const coveragePercentage = ((coveredLeads / totalLeads) * 100).toFixed(2);
      
      res.json({
        success: true,
        summary: {
          totalLeads,
          uniqueAreaCodes: sortedAreaCodes.length,
          existingNumbers: existingNumbers.length,
          existingAreaCodes: Array.from(existingAreaCodes),
          coveredLeads,
          coveragePercentage: `${coveragePercentage}%`,
          recommendedPurchases: recommendations.length,
          estimatedMonthlyCost: `$${recommendations.length.toFixed(2)}`
        },
        areaCodeDistribution: sortedAreaCodes.slice(0, 50), // Top 50 area codes
        recommendations: recommendations,
        existingNumbers: existingNumbers.map(num => ({
          phoneNumber: num.phoneNumber,
          friendlyName: num.friendlyName
        }))
      });
      
    } catch (error) {
      console.error('❌ Error analyzing leads:', error);
      res.status(500).json({ 
        error: 'Failed to analyze lead database',
        details: error.message
      });
    }
  });

  // Generate and send VDP calls weekly reports to all agents
  app.post("/api/reports/send-weekly-vdp", async (req, res) => {
    try {
