  // Send webhook specifically for Chris LaFond's qualifying hotleads
  app.post("/api/hotleads/send-chris-webhooks", async (req, res) => {
    try {
      const { data, error } = await supabase
        .from('masterlead')
        .select('*');
      
      if (error) {
        return res.status(500).json({ error: error.message });
      }

      // Filter for Chris's hotleads with 90+ second duration
      const chrisQualifyingLeads = data.filter((lead: any) => {
        const email = lead.cn_email?.toLowerCase() || '';
        const isChris = false; // Remove hardcoded agent logic
        
        if (!isChris || !lead.notes) return false;
        
        const durationMatch = lead.notes.match(/Duration:\s*(\d+)s/);
        if (!durationMatch) return false;
        
        const duration = parseInt(durationMatch[1]);
        return duration >= 90;
      });

      console.log(`🔥 Found ${chrisQualifyingLeads.length} qualifying hotleads for Chris LaFond (90+ seconds)`);

      const webhookResults = [];
      const WEBHOOK_URL = 'https://hooks.zapier.com/hooks/catch/2467580/u6o3xar/';

      for (const lead of chrisQualifyingLeads) {
        const durationMatch = lead.notes.match(/Duration:\s*(\d+)s/);
        const duration = durationMatch ? parseInt(durationMatch[1]) : 0;
        
        const payload = {
          leadId: lead.id, // Use database primary key
          associate_id: 409, // Chris LaFond's associate ID
          agentEmail: 'unknown@aoglobelife.com',
          duration: duration,
          autoAssigned: true,
          reason: "1.5-minute rule triggered",
          assignedAt: new Date().toISOString(),
          firstName: lead.first_name,
          lastName: lead.last_name,
          phone: lead.phone,
          email: lead.email
        };

        try {
          const webhookResponse = await fetch(WEBHOOK_URL, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
          });

          const result = await webhookResponse.text();
          webhookResults.push({
            leadId: lead.id, // Use database primary key
            name: `${lead.first_name} ${lead.last_name}`,
            duration: duration,
            cn_email: lead.cn_email,
            status: webhookResponse.status,
            response: result
          });

          console.log(`✅ CHRIS WEBHOOK: ${lead.first_name} ${lead.last_name} (${lead.taalk_lead_id}): ${duration}s - ${lead.cn_email}`);
        } catch (webhookError: any) {
          console.error(`❌ Webhook failed for ${lead.first_name}:`, webhookError.message);
          webhookResults.push({
            leadId: lead.id, // Use database primary key
            name: `${lead.first_name} ${lead.last_name}`,
            duration: duration,
            status: 'error',
            response: webhookError.message
          });
        }
      }

      res.json({
        totalFound: chrisQualifyingLeads.length,
        webhooksSent: webhookResults.length,
        results: webhookResults,
        allEmails: [...new Set(data.map(lead => lead.cn_email))]
      });

    } catch (err: any) {
      res.status(500).json({ error: err.message });
    }
  });

  // Search for Chris's hotleads in all possible email variations  
  app.get("/api/hotleads/find-chris", async (req, res) => {
    try {
      const { data, error } = await supabase
        .from('masterlead')
        .select('*');
      
      if (error) {
        return res.status(500).json({ error: error.message });
      }

      // Find all records that might belong to Chris
      const chrisRecords = data.filter((lead: any) => {
        const email = lead.cn_email?.toLowerCase() || '';
        const firstName = lead.first_name?.toLowerCase() || '';
        const lastName = lead.last_name?.toLowerCase() || '';
        
        return email.includes('chris') || 
               email.includes('lafond') ||
               firstName.includes('chris') ||
               lastName.includes('lafond') ||
               (firstName.includes('christopher') && lastName.includes('lafond'));
      });

      // Also get all unique cn_email values for debugging
      const allEmails = [...new Set(data.map((lead: any) => lead.cn_email))];

      res.json({
        totalHotleads: data.length,
        chrisRecords: chrisRecords,
        chrisCount: chrisRecords.length,
        allUniqueEmails: allEmails
      });
    } catch (err: any) {
      res.status(500).json({ error: err.message });
    }
  });

