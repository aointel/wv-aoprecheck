  // Simple Hotlead Entitlement System
  console.log('🔥 Starting simple hotlead entitlement system...');
  
  // Track hotlead entitlements per agent
  let hotleadEntitlements = new Map(); // agentEmail -> count
  
  // Simple direct hotlead assignment - no webhook needed
  const assignHotleadToAgent = async (agentEmail: string) => {
    try {
      if (!supabase) {
        console.log('⚠️ Supabase not available - cannot assign hotlead');
        return;
      }

      console.log(`🔥 DIRECT ASSIGNMENT: Finding unassigned hotlead for ${agentEmail}`);
      
      // Find an unassigned hotlead from masterlead table
      const { data: unassignedHotleads, error: fetchError } = await supabase
        .from('masterlead')
        .select('*')
        .eq('is_hot_lead', true)
        .or('cn_email.is.null,cn_email.eq.""')
        .order('priority_score', { ascending: false })
        .limit(1);
      
      if (fetchError) {
        console.error('❌ Error fetching unassigned hotleads:', fetchError);
        return;
      }

      if (!unassignedHotleads || unassignedHotleads.length === 0) {
        console.log(`❌ No unassigned hotleads available for ${agentEmail}`);
        return;
      }

      const hotlead = unassignedHotleads[0];
      console.log(`🎯 Assigning hotlead ${hotlead.first_name} ${hotlead.last_name} to ${agentEmail}`);

      // Assign the hotlead to the agent
      const { error: updateError } = await supabase
        .from('masterlead')
        .update({
          cn_email: agentEmail,
          updated_at: new Date().toISOString()
        })
        .eq('id', hotlead.id);

      if (updateError) {
        console.error('❌ Error assigning hotlead:', updateError);
        return;
      }

      console.log(`✅ SUCCESS: Hotlead ${hotlead.first_name} ${hotlead.last_name} assigned to ${agentEmail}`);
      
    } catch (error) {
      console.error('❌ Error in direct hotlead assignment:', error);
    }
  };
  
