  // SIMPLE CALL ANALYTICS - ONE SOURCE OF TRUTH (PostgreSQL only)
  app.get('/api/analytics/live-stats', async (req, res) => {
    const { timeRange = 'today' } = req.query;
    console.log(`🎯 SIMPLE ANALYTICS: PostgreSQL call_logs table ONLY - timeRange: "${timeRange}" (type: ${typeof timeRange})`);
    
    try {
      let calls;
      
      // Build date filter based on timeRange
      switch (timeRange) {
        case 'week':
          calls = await db
            .select()
            .from(callLogs)
            .where(sql`call_started_at >= CURRENT_DATE - INTERVAL '7 days'`);
          break;
        case 'month':
          calls = await db
            .select()
            .from(callLogs)
            .where(sql`call_started_at >= CURRENT_DATE - INTERVAL '30 days'`);
          break;
        case 'today':
        default:
          calls = await db
            .select()
            .from(callLogs)
            .where(sql`DATE(call_started_at AT TIME ZONE 'UTC' AT TIME ZONE 'America/Los_Angeles') = '2025-08-27'`);
          break;
      }

      console.log(`📊 FOUND ${calls.length} calls for ${timeRange.toUpperCase()} in PostgreSQL`);

      // Calculate simple stats
      const totalDials = calls.length;
      const totalReached = calls.filter(c => c.isReached).length;
      const totalBooked = calls.filter(c => c.isBooked).length;

      // Group by agent
      const agentStats = {};
      const agentNames = {
        'chrislafond@aoglobelife.com': 'Chris LaFond',
        'martintoma@aoglobelife.com': 'Martin Toma', 
        'cnsysop@aoglobelife.com': 'Michael Mandella',
        'davidfulfer@aoglobelife.com': 'David Fulfer',
        'fayesaad@aoglobelife.com': 'Faye Saad',
        'tabithamcdermid@aoglobelife.com': 'Tabitha McDermid',
        'kingsleyibeh@aoglobelife.com': 'Kingsley Ibeh'
      };

      // Initialize all agents with 0
      Object.keys(agentNames).forEach(email => {
        agentStats[email] = {
          email,
          name: agentNames[email],
          dials: 0,
          reached: 0,
          booked: 0,
          reachRate: 0,
          bookRate: 0
        };
      });

      // Count actual calls
      calls.forEach(call => {
        const agent = agentStats[call.agentEmail];
        if (agent) {
          agent.dials++;
          if (call.isReached) agent.reached++;
          if (call.isBooked) agent.booked++;
          agent.reachRate = agent.dials > 0 ? Math.round((agent.reached / agent.dials) * 100) : 0;
          agent.bookRate = agent.dials > 0 ? Math.round((agent.booked / agent.dials) * 100) : 0;
        }
      });

      res.json({
        timeRange: timeRange,
        lastUpdated: new Date().toISOString(),
        totals: {
          total_dials: totalDials,
          total_reached: totalReached,
          total_booked: totalBooked
        },
        agents: Object.values(agentStats),
        dataSource: 'postgresql_call_logs'
      });
      
      console.log(`✅ SIMPLE: ${totalDials} dials, ${totalReached} reached, ${totalBooked} booked`);
    } catch (error) {
      console.error('❌ ANALYTICS ERROR:', error);
      res.status(500).json({ error: 'Failed to fetch analytics' });
    }
  });

  // COMPREHENSIVE OUTBOUND ANALYTICS - Track ALL outbound calls from ALL sources
  app.post('/api/analytics/unified-stats', async (req, res) => {
    try {
      const { timeRange = 'today' } = req.body;
      console.log(`📊 Fetching COMPREHENSIVE outbound analytics for ${timeRange}`);

      // Focus on database tracking for reliability
      let startDate = new Date();
      startDate.setHours(0, 0, 0, 0);
      
      if (timeRange === 'yesterday') {
        startDate.setDate(startDate.getDate() - 1);
      } else if (timeRange === 'week') {
        startDate.setDate(startDate.getDate() - 7);
      }

      console.log(`📞 Analyzing outbound calls from database sources`);

      // Agent mapping
      const agentMap = {
        'davidfulfer@aoglobelife.com': 'David Fulfer',
        'fayesaad@aoglobelife.com': 'Faye Saad', 
        'chrislafond@aoglobelife.com': 'Chris LaFond',
        'martintoma@aoglobelife.com': 'Martin Toma',
        'tabithamcdermid@aoglobelife.com': 'Tabitha McDermid',
        'kingsleyibeh@aoglobelife.com': 'Kingsley Ibeh',
        'cnsysop@aoglobelife.com': 'System Admin'
      };

      const client = await pool.connect();
      try {
        const agentStats = {};
        
        // Initialize agent stats
        Object.keys(agentMap).forEach(email => {
          agentStats[email] = {
            email,
            name: agentMap[email],
            dials: 0,
            reached: 0,
            booked: 0,
            sales: 0,
            reachRate: 0,
            bookRate: 0
          };
        });

        // Skip Twilio API calls for now - focus on database tracking

        // Also get data from war_connects, call_logs, and outbound_call_history
        for (const email of Object.keys(agentMap)) {
          // War connects data
          const warQuery = `
            SELECT 
              COUNT(*) as war_dials,
              COUNT(CASE WHEN immediate_outcome IN ('reached', 'contacted') OR connect_type = 'connected' THEN 1 END) as war_reached,
              COUNT(CASE WHEN appointment_set = true OR immediate_outcome = 'booked' THEN 1 END) as war_booked,
              COUNT(CASE WHEN immediate_outcome = 'sale' OR production_status = 'completed' THEN 1 END) as war_sales
            FROM war_connects 
            WHERE agent_email = $1 AND DATE(connect_date) = CURRENT_DATE
          `;
          
          // Call logs data
          const callLogsQuery = `
            SELECT 
              COUNT(*) as log_dials,
              COUNT(CASE WHEN status = 'completed' OR disposition = 'reached' THEN 1 END) as log_reached,
              COUNT(CASE WHEN disposition = 'appointment' THEN 1 END) as log_booked
            FROM call_logs 
            WHERE (agent_email = $1 OR user_id = $1) 
              AND call_type != 'inbound' 
              AND DATE(created_at) = CURRENT_DATE
          `;
          
          // Outbound call history
          const outboundQuery = `
            SELECT 
              COUNT(*) as out_dials,
              COUNT(CASE WHEN call_disposition IN ('reached', 'contacted', 'answered') THEN 1 END) as out_reached,
              COUNT(CASE WHEN call_disposition = 'appointment' OR appointment_scheduled = true THEN 1 END) as out_booked
            FROM outbound_call_history 
            WHERE agent_email = $1 AND DATE(created_at) = CURRENT_DATE
          `;

          const [warResult, logResult, outResult] = await Promise.all([
            client.query(warQuery, [email]),
            client.query(callLogsQuery, [email]),
            client.query(outboundQuery, [email])
          ]);

          const warStats = warResult.rows[0] || { war_dials: 0, war_reached: 0, war_booked: 0, war_sales: 0 };
          const logStats = logResult.rows[0] || { log_dials: 0, log_reached: 0, log_booked: 0 };
          const outStats = outResult.rows[0] || { out_dials: 0, out_reached: 0, out_booked: 0 };

          // Combine all sources
          agentStats[email].dials += parseInt(warStats.war_dials) + parseInt(logStats.log_dials) + parseInt(outStats.out_dials);
          agentStats[email].reached += parseInt(warStats.war_reached) + parseInt(logStats.log_reached) + parseInt(outStats.out_reached);
          agentStats[email].booked += parseInt(warStats.war_booked) + parseInt(logStats.log_booked) + parseInt(outStats.out_booked);
          agentStats[email].sales += parseInt(warStats.war_sales);
          
          // Calculate rates
          if (agentStats[email].dials > 0) {
            agentStats[email].reachRate = Math.round((agentStats[email].reached / agentStats[email].dials) * 100);
          }
          if (agentStats[email].reached > 0) {
            agentStats[email].bookRate = Math.round((agentStats[email].booked / agentStats[email].reached) * 100);
          }
        }

        const results = Object.values(agentStats).sort((a, b) => b.dials - a.dials);
        
        const totals = results.reduce((acc, agent) => ({
          total_dials: acc.total_dials + agent.dials,
          total_reached: acc.total_reached + agent.reached,
          total_booked: acc.total_booked + agent.booked,
          total_sales: acc.total_sales + agent.sales
        }), { total_dials: 0, total_reached: 0, total_booked: 0, total_sales: 0 });

        const response = {
          timeRange,
          lastUpdated: new Date().toISOString(),
          totals,
          agents: results
        };

        console.log(`📊 COMPREHENSIVE analytics: ${totals.total_dials} total dials from all sources`);
        res.json(response);

      } finally {
        client.release();
      }
    } catch (error) {
      console.error('❌ Comprehensive analytics error:', error);
      res.status(500).json({ error: 'Failed to fetch comprehensive analytics' });
    }
  });

  // CALL HISTORY ENDPOINT - Get call history from vdp_calls ONLY
  app.get('/api/call-history', async (req, res) => {
    try {
      const userEmail = req.query.userEmail as string;
      
      // Get associate_id from user profile - we need this to filter vdp_calls by agent field
      let associateId = null;
      try {
        const profileResult = await supabase
          .from('user_credits')
          .select('associate_id')
          .eq('email', userEmail)
          .maybeSingle();
        
        associateId = profileResult.data?.associate_id;
        console.log(`📞 CALL HISTORY: User ${userEmail} has associate_id: ${associateId}`);
      } catch (error) {
        console.error('❌ Failed to get associate_id for user:', error);
      }

      if (!associateId) {
        console.error(`❌ No associate_id found for user: ${userEmail}`);
        return res.json({
          success: true,
          calls: [],
          total: 0,
          userEmail,
          message: 'No associate ID found for this user'
        });
      }

      console.log(`📞 CALL HISTORY: Fetching vdp_calls for agent: ${associateId}`);

      // Get ALL calls from vdp_calls table filtered by agent field and END events only
      const { data: vdpCalls, error: vdpError } = await supabase
        .from('vdp_calls')
        .select('id, time, event, phone, firstName, lastName, market, agent, leadid, mga, rga, duration, cnresolution, ALP')
        .eq('agent', associateId)
        .eq('event', 'END')
        .order('time', { ascending: false })
        .limit(50);

      if (vdpError) {
        console.error('❌ VDP calls query error:', vdpError);
        return res.status(500).json({
          error: 'Failed to fetch VDP calls',
          details: vdpError.message
        });
      }

      console.log(`📞 CALL HISTORY: Found ${vdpCalls?.length || 0} completed calls from vdp_calls`);

      // Map vdp_calls to lead queue format
      const formattedCalls = (vdpCalls || []).map(call => {
        // Parse timestamp from vdp_calls time field
        let timestamp = null;
        try {
          if (call.time) {
            timestamp = new Date(call.time).toISOString();
          } else {
            timestamp = new Date().toISOString();
          }
        } catch (error) {
          console.error('❌ Date parsing error for VDP call:', call.id, error);
          timestamp = new Date().toISOString();
        }

        const fullName = [call.firstName, call.lastName].filter(Boolean).join(' ');

        return {
          // Standard call data
          id: `vdp_${call.id}`,
          phone: call.phone,
          call_status: call.cnresolution || 'completed', // Use cnresolution as the call status
          duration_seconds: Math.round(parseFloat(call.duration) || 0),
          started_at: timestamp,
          source: 'vdp_calls',
          
          // Lead data in same format as lead queue  
          name: fullName || 'Unknown Lead',
          leadId: call.leadid,
          market: call.market || 'Unknown Market',
          
          // Agent data
          agent: call.agent,
          mga: call.mga,
          rga: call.rga,
          
          // Premium/financial data
          premium_amount: call.ALP,
          
          // Call resolution status 
          resolution: call.cnresolution
        };
      });

      // Return formatted call data
      res.json({
        success: true,
        calls: formattedCalls,
        total: formattedCalls.length,
        userEmail,
        associateId,
        source: 'vdp_calls_only'
      });

    } catch (error) {
      console.error('❌ Call history error:', error);
      res.status(500).json({ 
        error: 'Failed to fetch call history',
        details: error instanceof Error ? error.message : 'Unknown error'
      });
    }
  });


  app.get('/api/analytics/dashboard', async (req, res) => {
    try {
      const userEmail = req.query.userEmail as string;
      const timeRange = req.query.timeRange || '30d';
      
      if (!userEmail) {
        return res.status(400).json({ error: 'User email is required' });
      }

      console.log(`📊 Fetching analytics dashboard for: ${userEmail} (${timeRange})`);

      // Calculate date range
      const endDate = new Date();
      let startDate = new Date();
      
      switch(timeRange) {
        case '7d':
          startDate.setDate(endDate.getDate() - 7);
          break;
        case '30d':
          startDate.setDate(endDate.getDate() - 30);
          break;
        case '90d':
          startDate.setDate(endDate.getDate() - 90);
          break;
        case '1y':
          startDate.setFullYear(endDate.getFullYear() - 1);
          break;
        default:
          startDate.setDate(endDate.getDate() - 30);
      }

      // Get customer data using the same successful method as connectnowService
      let userCreditsData;
      try {
        console.log(`📊 Analytics: Attempting to get user credits for ${userEmail}...`);
        userCreditsData = await connectnowService.getUserCredits(userEmail);
        console.log(`📊 Analytics: getUserCredits result:`, userCreditsData);
      } catch (error) {
        console.error(`❌ Analytics: Error calling getUserCredits for ${userEmail}:`, error);
        return res.status(500).json({ error: 'Failed to fetch user data' });
      }
      
      if (!userCreditsData || !userCreditsData.associate_id) {
        console.log(`❌ Analytics: Customer/associate_id not found for: ${userEmail}. Data:`, userCreditsData);
        return res.status(404).json({ error: 'Customer not found' });
      }

      const associateId = userCreditsData.associate_id.toString();
      const customerData = {
        associate_id: userCreditsData.associate_id,
        first_name: userCreditsData.name ? userCreditsData.name.split(' ')[0] : userEmail.split('@')[0],
        last_name: userCreditsData.name ? userCreditsData.name.split(' ').slice(1).join(' ') : 'User'
      };

      console.log(`✅ Analytics: Found customer data for ${userEmail}:`, { associateId, customerData });

      // Get appointments data
      const { data: appointments } = await supabase
        .from('appointments')
        .select('*')
        .eq('user_email', userEmail)
        .gte('start_time', startDate.toISOString());

      // Get lead data from masterlead table
      const { data: leads } = await supabase
        .from('masterlead')
        .select('*')
        .eq('agent_email', userEmail);

      // Calculate metrics
      const totalLeads = leads?.length || 0;
      const qualifiedLeads = leads?.filter(lead => 
        lead.status === 'contacted' || lead.status === 'qualified'
      ).length || 0;
      
      const convertedLeads = appointments?.filter(apt => 
        apt.status === 'completed' || apt.status === 'sale'
      ).length || 0;

      const scheduledAppointments = appointments?.length || 0;
      const completedAppointments = appointments?.filter(apt => 
        apt.status === 'completed' || apt.status === 'sale'
      ).length || 0;
      const noShowAppointments = appointments?.filter(apt => 
        apt.status === 'no_show'
      ).length || 0;

      // Calculate revenue from appointments (assuming average sale value)
      const avgSaleValue = 2500; // Average insurance sale value
      const totalRevenue = completedAppointments * avgSaleValue;
      
      // Today's metrics
      const today = new Date().toISOString().split('T')[0];
      const todayAppointments = appointments?.filter(apt => 
        apt.start_time.startsWith(today)
      ).length || 0;

      // Performance scores (based on industry benchmarks)
      const connectionRate = totalLeads > 0 ? (qualifiedLeads / totalLeads) * 100 : 0;
      const conversionRate = qualifiedLeads > 0 ? (convertedLeads / qualifiedLeads) * 100 : 0;
      const completionRate = scheduledAppointments > 0 ? (completedAppointments / scheduledAppointments) * 100 : 0;

      const dialingScore = Math.min(100, (totalLeads / 100) * 100); // 100 leads = 100% score
      const salesScore = Math.min(100, conversionRate * 2); // 50% conversion = 100% score
      const appointmentScore = Math.min(100, completionRate);
      const overallScore = (dialingScore + salesScore + appointmentScore) / 3;

      // Recent activity from appointments
      const recentActivity = appointments?.slice(-10).map(apt => ({
        date: new Date(apt.start_time).toLocaleDateString(),
        type: apt.status === 'completed' || apt.status === 'sale' ? 'sale' : 'appointment',
        lead: apt.lead_name || 'Unknown Lead',
        amount: apt.status === 'completed' || apt.status === 'sale' ? avgSaleValue : undefined,
        status: apt.status
      })) || [];

      const analyticsData = {
        revenue: {
          total: totalRevenue,
          thisMonth: totalRevenue, // Simplified - could be refined with date filtering
          lastMonth: totalRevenue * 0.8, // Mock last month data
          change: 20 // Mock percentage change
        },
        calls: {
          total: totalLeads,
          thisMonth: totalLeads,
          connected: qualifiedLeads,
          connectionRate: connectionRate
        },
        leads: {
          total: totalLeads,
          qualified: qualifiedLeads,
          converted: convertedLeads,
          conversionRate: conversionRate
        },
        appointments: {
          scheduled: scheduledAppointments,
          completed: completedAppointments,
          noShows: noShowAppointments,
          completionRate: completionRate
        },
        performance: {
          dialingScore: dialingScore,
          salesScore: salesScore,
          appointmentScore: appointmentScore,
          overallScore: overallScore
        },
        daily: {
          callsToday: 0, // Could be enhanced with call tracking
          appointmentsToday: todayAppointments,
          salesToday: appointments?.filter(apt => 
            apt.start_time.startsWith(today) && (apt.status === 'completed' || apt.status === 'sale')
          ).length || 0,
          revenueToday: (appointments?.filter(apt => 
            apt.start_time.startsWith(today) && (apt.status === 'completed' || apt.status === 'sale')
          ).length || 0) * avgSaleValue
        },
        trends: {
          labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
          calls: [totalLeads * 0.2, totalLeads * 0.3, totalLeads * 0.25, totalLeads * 0.25],
          revenue: [totalRevenue * 0.2, totalRevenue * 0.3, totalRevenue * 0.25, totalRevenue * 0.25],
          appointments: [scheduledAppointments * 0.2, scheduledAppointments * 0.3, scheduledAppointments * 0.25, scheduledAppointments * 0.25]
        },
        recentActivity: recentActivity
      };

      console.log(`✅ Analytics data compiled for ${userEmail}:`, {
        totalLeads,
        scheduledAppointments,
        completedAppointments,
        totalRevenue,
        overallScore: overallScore.toFixed(1)
      });

      res.json(analyticsData);

    } catch (error) {
      console.error('❌ Analytics dashboard error:', error);
      res.status(500).json({ error: 'Failed to fetch analytics data' });
    }
  });

