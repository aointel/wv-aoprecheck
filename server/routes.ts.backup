  app.post("/api/hotleads/sync", async (req, res) => {
    try {
      console.log('🔥 Manual hotlead sync initiated via API');
      const { hotleadSyncService } = await import('./hotlead-sync-service');
      
      const result = await hotleadSyncService.syncHotleads();
      
      if (result.success) {
        // Also run assignment after successful sync
        await hotleadSyncService.assignHotleads();
        
        res.json({
          success: true,
          message: `Sync completed: ${result.newCount} new hotleads, ${result.updateCount} updated`,
          newCount: result.newCount,
          updateCount: result.updateCount
        });
      } else {
        res.status(500).json({
          success: false,
          error: result.error || 'Sync failed'
        });
      }
    } catch (error) {
      console.error('❌ Error in manual hotlead sync:', error);
      res.status(500).json({
        success: false,
        error: error instanceof Error ? error.message : 'Unknown error'
      });
    }
  });

  app.post("/api/hotleads/force-sync", async (req, res) => {
