  // User Credits API
  app.get("/api/user/credits", async (req, res) => {
    try {
      // Get authenticated user from Supabase session
      let userEmail = null;
      
      // Try Supabase auth first
      try {
        const { createClient } = await import('@supabase/supabase-js');
        const supabaseUrl = HARDCODED_CONFIG.SUPABASE_URL;
        const supabaseKey = HARDCODED_CONFIG.SUPABASE_ANON_KEY;
        
        if (supabaseUrl && supabaseKey) {
          const supabase = createClient(supabaseUrl, supabaseKey);
          const authHeader = req.headers.authorization;
          
          if (authHeader && authHeader.startsWith('Bearer ')) {
            const token = authHeader.substring(7);
            const { data: { user }, error } = await supabase.auth.getUser(token);
            if (user && !error && user.email) {
              userEmail = user.email;
            }
          }
        }
      } catch (supabaseError) {
        console.log('Supabase auth failed, trying session fallback');
      }
      
      // Fallback to session
      if (!userEmail) {
        const session = req.session as any;
        if (session?.user?.claims?.email) {
          userEmail = session.user.claims.email;
        } else if (session?.user?.email) {
          userEmail = session.user.email;
        }
      }
      
      // Fallback to x-user-email header (used by frontend)
      if (!userEmail) {
        userEmail = req.headers['x-user-email'] as string;
      }
      
      // Check if user is authenticated
      if (!userEmail) {
        console.error('❌ NO USER EMAIL FOR CREDITS ENDPOINT');
        return res.status(401).json({ error: 'User email required for credits' });
      }
      
      console.log(`🔍 Getting credits for authenticated user: ${userEmail}`);
      
      // Use the same getUserCredits method that works correctly
      const credits = await connectnowService.getUserCredits(userEmail);
      
      // Ensure we return the correct format that the counter expects
      // Handle both camelCase (local DB) and snake_case (Supabase) property formats
      const response = {
        credits_remaining: (credits as any)?.credits_remaining || (credits as any)?.creditsRemaining || 0,
        credits_used: (credits as any)?.credits_used || (credits as any)?.creditsUsed || 0,
        credits_purchased: (credits as any)?.credits_purchased || (credits as any)?.creditsPurchased || 0
      };
      
      res.json(response);
    } catch (error) {
      console.error('User credits error:', error);
      res.status(500).json({ error: 'Failed to get user credits' });
    }
  });

