  // Update verification method
  app.patch("/api/verification/session/:sessionId/method", async (req, res) => {
    try {
      const { sessionId } = req.params;
      const { verificationMethod } = methodSelectionSchema.parse({
        sessionId,
        verificationMethod: req.body.verificationMethod,
      });

      const updatedSession = await storage.updateVerificationSession(sessionId, {
        verificationMethod,
      });

      if (!updatedSession) {
        return res.status(404).json({ message: "Verification session not found" });
      }

      res.json(updatedSession);
    } catch (error) {
      if (error instanceof z.ZodError) {
        return res.status(400).json({ message: "Invalid verification method", errors: error.errors });
      }
      res.status(500).json({ message: "Failed to update verification method" });
    }
  });

  // Capture client IP during verification call setup (agent calls this)
  app.post("/api/verification/session/:sessionId/capture-ip", async (req, res) => {
    try {
      const { sessionId } = req.params;
      
      // Get client IP address and user agent
      const clientIp = req.ip || req.connection.remoteAddress || req.headers['x-forwarded-for']?.toString().split(',')[0] || 'unknown';
      const userAgent = req.headers['user-agent'] || 'unknown';
      
      console.log(`Capturing IP for session ${sessionId}: ${clientIp} (Note: This is likely the agent's IP since called from Step 3)`);

      // Get location data from IP address using IP-API.com (free, no key required)
      let locationData = null;
      try {
        if (clientIp && clientIp !== 'unknown' && clientIp !== '::1' && clientIp !== '127.0.0.1') {
          const geoResponse = await fetch(`http://ip-api.com/json/${clientIp}?fields=status,country,regionName,city,lat,lon,timezone,isp`);
          if (geoResponse.ok) {
            const geoData = await geoResponse.json();
            if (geoData.status === 'success') {
              locationData = geoData;
              console.log(`IP Geolocation for ${clientIp}:`, locationData);
            }
          }
        }
      } catch (geoError) {
        console.warn('IP geolocation failed:', geoError);
      }

      // Update session with agent IP and location data (Note: This captures the agent's IP, not client)
      const updatedSession = await storage.updateVerificationSession(sessionId, {
        agentIpAddress: clientIp,
        agentUserAgent: userAgent,
        agentCountry: locationData?.country || null,
        agentRegion: locationData?.regionName || null,
        agentCity: locationData?.city || null,
        agentLatitude: locationData?.lat?.toString() || null,
        agentLongitude: locationData?.lon?.toString() || null,
        agentTimezone: locationData?.timezone || null,
        agentIsp: locationData?.isp || null,
      });

      if (!updatedSession) {
        return res.status(404).json({ message: "Verification session not found" });
      }

      console.log('Agent IP and location data captured successfully');
      res.json({ success: true, clientIp, locationData });
    } catch (error: any) {
      console.error('Failed to capture agent IP:', error);
      res.status(500).json({ message: "Failed to capture agent IP address" });
    }
  });

  // Capture actual client IP when client visits their verification page
  app.post("/api/verification/session/:sessionId/capture-client-ip", async (req, res) => {
    try {
      const { sessionId } = req.params;
      
      // Get REAL client IP address and user agent
      const clientIp = req.ip || req.connection.remoteAddress || req.headers['x-forwarded-for']?.toString().split(',')[0] || 'unknown';
      const userAgent = req.headers['user-agent'] || 'unknown';
      
      console.log(`🎯 Capturing REAL CLIENT IP for session ${sessionId}: ${clientIp}`);

      // Get location data from IP address using IP-API.com (free, no key required)
      let locationData = null;
      try {
        if (clientIp && clientIp !== 'unknown' && clientIp !== '::1' && clientIp !== '127.0.0.1') {
          const geoResponse = await fetch(`http://ip-api.com/json/${clientIp}?fields=status,country,regionName,city,lat,lon,timezone,isp`);
          if (geoResponse.ok) {
            const geoData = await geoResponse.json();
            if (geoData.status === 'success') {
              locationData = geoData;
              console.log(`🌍 Client IP Geolocation for ${clientIp}:`, locationData);
            }
          }
        }
      } catch (geoError) {
        console.warn('Client IP geolocation failed:', geoError);
      }

      // Update session with REAL client IP and location data
      const updatedSession = await storage.updateVerificationSession(sessionId, {
        clientIpAddress: clientIp,
        clientUserAgent: userAgent,
        clientCountry: locationData?.country || null,
        clientRegion: locationData?.regionName || null,
        clientCity: locationData?.city || null,
        clientLatitude: locationData?.lat?.toString() || null,
        clientLongitude: locationData?.lon?.toString() || null,
        clientTimezone: locationData?.timezone || null,
        clientIsp: locationData?.isp || null,
        clientApprovalTime: new Date(), // Track when client visited
      });

      if (!updatedSession) {
        return res.status(404).json({ message: "Verification session not found" });
      }

      console.log('✅ REAL CLIENT IP and location data captured successfully');
      res.json({ success: true, clientIp, locationData });
    } catch (error: any) {
