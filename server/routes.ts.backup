  // Twilio conference status updates
  app.post("/api/twilio/conference-status", (req, res) => {
    console.log('Twilio conference status:', req.body);
    const { ConferenceName, StatusCallbackEvent, CallSid, ConferenceSid } = req.body;

    // Update active call state based on conference activity
    if (StatusCallbackEvent === 'participant-join') {
      console.log(`Participant joined conference: ${ConferenceName}`);
      activeCallState.isActive = true;
      activeCallState.startTime = Date.now();
      activeCallState.callSid = ConferenceSid || CallSid;
    } else if (StatusCallbackEvent === 'participant-leave') {
      console.log(`Participant left conference: ${ConferenceName}`);
      activeCallState.isActive = false;
      activeCallState.startTime = null;
      activeCallState.callSid = null;
    }

    res.sendStatus(200);
  });

  // Call Connector Pro - TwiML Application Handler (completely separate from verification)
  app.post("/api/twilio/call-connector-pro", (req, res) => {
    try {
      console.log('🎯 Call Connector Pro TwiML Application Handler');
      console.log('Request body:', req.body);
      console.log('Request headers:', req.headers);
      
      const { CallSid, From, To, Direction } = req.body;
      
      // Handle outgoing calls from Call Connector Pro WebRTC
      if (Direction === 'outbound-api') {
        console.log('📞 Outbound call from Call Connector Pro WebRTC device');
        
        // For outbound calls, connect agent to Call Connector Pro conference with hold music
        const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say voice="alice">Call Connector Pro active. Connecting to conference.</Say>
  <Dial>
    <Conference 
      startConferenceOnEnter="true" 
      endConferenceOnExit="false"
      beep="false"
      waitUrl="http://twimlets.com/holdmusic?Bucket=com.twilio.music.soft-rock"
      maxParticipants="2">Call-Connector-Pro-Conference</Conference>
  </Dial>
</Response>`;
        
        console.log('✅ Generated outbound TwiML for Call Connector Pro with hold music');
        res.type('text/xml');
        res.send(twiml);
        return;
      }
      
      // Handle incoming calls to Call Connector Pro system  
      if (Direction === 'inbound') {
        console.log('📞 Incoming call to Call Connector Pro system');
        
        const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Dial>
    <Conference 
      startConferenceOnEnter="false" 
      endConferenceOnExit="true"
      beep="false"
      waitUrl="http://twimlets.com/holdmusic?Bucket=com.twilio.music.soft-rock"
      maxParticipants="2">Call-Connector-Pro-Conference</Conference>
  </Dial>
</Response>`;
        
        console.log('✅ Generated inbound TwiML for Call Connector Pro');
        res.type('text/xml');
        res.send(twiml);
        return;
      }
      
      // Default response for any other scenario (silent)
      const defaultTwiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Dial>
    <Conference 
      startConferenceOnEnter="true" 
      endConferenceOnExit="false"
      beep="false"
      waitUrl="http://twimlets.com/holdmusic?Bucket=com.twilio.music.soft-rock"
      maxParticipants="2">Call-Connector-Pro-Conference</Conference>
  </Dial>
</Response>`;
      
      console.log('✅ Generated default TwiML for Call Connector Pro');
      res.type('text/xml');
      res.send(defaultTwiml);
      
    } catch (error) {
      console.error('Call Connector Pro TwiML error:', error);
      const errorTwiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Hangup/>
</Response>`;
      res.type('text/xml');
      res.send(errorTwiml);
    }
  });

  // Call Connector Pro - Make outbound call with local presence to lead
  app.post("/api/twilio/call-connector-outbound", async (req, res) => {
    try {
      const { leadPhone, leadName, leadState, localNumber } = req.body;
      
      console.log(`🎯 Call Connector Pro making outbound call to ${leadPhone} (${leadName}) using local number ${localNumber}`);
      
      // Create TwiML that connects the lead to Call Connector Pro conference
      const twiml = `<?xml version="1.0" encoding="UTF-8"?>
<Response>
  <Say voice="alice">Hello ${leadName}. You have been connected to our Call Connector Pro system.</Say>
  <Pause length="1"/>
  <Dial>
    <Conference 
      startConferenceOnEnter="false" 
      endConferenceOnExit="true"
      beep="true"
      waitUrl="http://twimlets.com/holdmusic?Bucket=com.twilio.music.soft-rock"
      maxParticipants="20">Call-Connector-Pro-Conference</Conference>
  </Dial>
  <Say voice="alice">Thank you for calling. Have a great day.</Say>
</Response>`;

      // Make actual Twilio call using local presence number with agent attribution
      const call = await twilioClient.calls.create({
        twiml: twiml,
        to: leadPhone,
        from: localNumber,
        statusCallback: `https://${req.get('host')}/api/twilio/call-status`,
        statusCallbackEvent: ['initiated', 'ringing', 'answered', 'completed'],
        timeout: 30,
        metadata: {
          agent_email: 'unknown@aoglobelife.com', // Default agent for Call Connector Pro
          agent_name: leadName || 'Unknown Lead',
          call_source: 'call_connector_pro_outbound',
          lead_phone: leadPhone,
          lead_name: leadName || 'Unknown Lead',
          lead_state: leadState || 'Unknown',
          local_number: localNumber,
          timestamp: new Date().toISOString()
        }
      });

      console.log(`✅ Call Connector Pro call created: ${call.sid}`);
      
      res.json({
        success: true,
        callSid: call.sid,
        leadPhone,
        leadName,
        localNumber,
        conferenceName: 'Call-Connector-Pro-Conference',
        message: 'Outbound call initiated with local presence'
      });
      
    } catch (error) {
      console.error('Call Connector Pro outbound call error:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to create outbound call',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

  // Connect agent to Twilio conference
  app.post("/api/twilio/connect-agent", async (req, res) => {
    try {
      const { conferenceName, agentPhone } = req.body;
      console.log(`Connecting agent ${agentPhone} to conference ${conferenceName}`);

      // Conference room is created automatically when first participant joins
      // No need to manually create it
      const result = { success: true, conferenceName, status: 'ready' };

      res.json({
        success: true,
        conferenceName,
        message: 'Conference room ready for incoming calls'
      });

    } catch (error) {
      console.error('Failed to connect agent to conference:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to connect agent to conference'
      });
    }
  });

  // Get conference participants
  app.get("/api/twilio/conference-participants/:conferenceName", async (req, res) => {
    try {
      const { conferenceName } = req.params;
      // Return basic status for now - participants are tracked via conference callbacks
      res.json({
        participants: [],
        status: activeCallState.isActive ? 'active' : 'waiting',
        conferenceName
      });
    } catch (error) {
      console.error('Failed to get conference participants:', error);
      res.status(500).json({
        participants: [],
        status: 'error'
      });
    }
  });

  app.get("/api/conference/join/:conferenceName", async (req, res) => {
    try {
      const { conferenceName } = req.params;
      const { identity } = req.query;

      const userAgent = req.headers['user-agent'] || '';
      const isBrowser = userAgent.includes('Mozilla') || userAgent.includes('Chrome') || userAgent.includes('Safari');

      if (isBrowser && identity === 'agent') {
        // Serve a simple WebRTC conference page for browsers
        const html = `
<!DOCTYPE html>
<html>
<head>
    <title>AO Precheck Conference - ${conferenceName}</title>
    <script src="https://sdk.twilio.com/js/client/releases/1.14.1/twilio.min.js"></script>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; text-align: center; background: #f8fafc; }
        .conference-info { background: #ffffff; padding: 30px; border-radius: 12px; margin: 20px 0; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .status { padding: 15px; margin: 15px 0; border-radius: 8px; font-weight: bold; font-size: 18px; }
        .connected { background: #dcfce7; color: #166534; border: 2px solid #22c55e; }
        .waiting { background: #fef3c7; color: #92400e; border: 2px solid #f59e0b; }
        .calling { background: #dbeafe; color: #1e40af; border: 2px solid #3b82f6; }
        button { padding: 12px 24px; margin: 10px; font-size: 16px; border-radius: 8px; border: none; cursor: pointer; font-weight: bold; }
        .primary { background: #3b82f6; color: white; }
        .primary:hover { background: #2563eb; }
        .danger { background: #ef4444; color: white; }
        .danger:hover { background: #dc2626; }
        .success { background: #22c55e; color: white; }
        .success:hover { background: #16a34a; }
        .phone-number { font-size: 24px; font-weight: bold; color: #1e40af; margin: 10px 0; }
        .instructions { background: #f1f5f9; padding: 20px; border-radius: 8px; margin-top: 20px; }
        .auto-answer { background: #fef2f2; border: 2px solid #fca5a5; padding: 15px; border-radius: 8px; margin: 20px 0; }
        .participants { margin: 20px 0; padding: 15px; background: #f0f9ff; border-radius: 8px; }
    </style>
</head>
<body>
    <h1>🎯 AO Precheck Live Conference</h1>
    <div class="conference-info">
        <h3>Conference Room: ${conferenceName}</h3>
        <div class="phone-number">📞 +16052500834</div>
        <div id="status" class="status waiting">🔄 Connecting to conference...</div>

        <div class="auto-answer">
            <h4>🤖 Auto-Answer Enabled</h4>
            <p>Conference will automatically answer when Taalk calls</p>
        </div>

        <div class="participants">
            <h4>👥 Conference Participants</h4>
            <div id="participantList">
                <div>🎧 Agent (You) - Connected</div>
                <div id="callerStatus">📞 Waiting for Taalk caller...</div>
            </div>
        </div>
    </div>

    <div id="controls">
        <button id="connectBtn" class="success" onclick="connectToConference()" style="display: none;">🔗 Connect to Conference</button>
        <button id="muteBtn" class="primary" onclick="toggleMute()">🎤 Mute</button>
        <button id="endBtn" class="danger" onclick="endCall()">📞 End Call</button>
    </div>

    <div class="instructions">
        <h4>📋 Verification Instructions:</h4>
        <p><strong>1.</strong> Click "Connect to Conference" to join the audio conference</p>
        <p><strong>2.</strong> When Taalk calls +16052500834, they'll auto-join this conference</p>
        <p><strong>3.</strong> Say <strong>"Hey Alex"</strong> to activate AI verification assistant</p>
        <p><strong>4.</strong> Keep this window open throughout the verification process</p>
        <p><strong>5.</strong> Conference will auto-answer - no manual intervention needed</p>
    </div>

    <audio id="remoteAudio" autoplay></audio>

    <script>
        let device = null;
        let connection = null;
        let muted = false;

        // Connect to Twilio conference
        async function connectToConference() {
            try {
                document.getElementById('status').textContent = '🔄 Connecting to Twilio conference...';
                document.getElementById('status').className = 'status calling';

                // Make outbound call to connect agent to conference
                const response = await fetch('/api/twilio/connect-agent', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        conferenceName: '${conferenceName}',
                        agentPhone: '+16052500834' // Use same number for testing
                    })
                });

                const result = await response.json();

                if (result.success) {
                    document.getElementById('status').textContent = '✅ Connected to Conference - Auto-Answer Active';
                    document.getElementById('status').className = 'status connected';
                    document.getElementById('connectBtn').style.display = 'none';

                    // Monitor conference participants
                    setInterval(async () => {
                        try {
                            const statusResponse = await fetch('/api/twilio/conference-participants/${conferenceName}');
                            const data = await statusResponse.json();

                            if (data.participants && data.participants.length > 1) {
                                document.getElementById('callerStatus').textContent = '📞 Taalk caller joined conference!';
                                document.getElementById('status').textContent = '🎙️ Call Active - Say "Hey Alex" to begin';
                            }
                        } catch (e) {
                            // Ignore polling errors
                        }
                    }, 5000);

                } else {
                    document.getElementById('status').textContent = '❌ Failed to connect to conference';
                }

            } catch (error) {
                console.error('Conference connection failed:', error);
                document.getElementById('status').textContent = '❌ Failed to connect';
            }
        }

        function toggleMute() {
            if (connection) {
                muted = !muted;
                connection.mute(muted);
                const btn = document.getElementById('muteBtn');
                btn.textContent = muted ? '🔇 Unmute' : '🎤 Mute';
                btn.style.background = muted ? '#ef4444' : '#3b82f6';
            }
        }

        function endCall() {
            if (connection) {
                connection.disconnect();
            }
            if (device) {
                device.destroy();
            }
            window.close();
        }

        // Auto-connect immediately on page load
        window.onload = () => {
            document.getElementById('status').textContent = '🚀 Auto-connecting to conference...';
            document.getElementById('status').className = 'status calling';
            setTimeout(connectToConference, 500);
        };

        // Keep connection alive
        window.onbeforeunload = () => {
            if (connection) {
                connection.disconnect();
            }
        };
    </script>
</body>
</html>`;

        res.type('text/html');
        res.send(html);
      } else {
        // Generate TwiML for phone calls
        let twiml;
        if (identity === 'agent') {
          twiml = await twilioConferenceService.addAgentToConference(conferenceName, 'webrtc-agent');
        } else {
          twiml = await twilioConferenceService.addCallerToConference(conferenceName, 'incoming-caller');
        }

        res.type('text/xml');
        res.send(twiml);
      }
    } catch (error) {
      console.error('Failed to join conference:', error);
      res.status(500).send('Failed to join conference');
    }
  });

  // Extract state from phone number area code
  function extractStateFromPhoneNumber(phoneNumber: string): string | null {
    // Remove all non-digits
    const cleanNumber = phoneNumber.replace(/\D/g, '');
    
    // Get area code (first 3 digits after country code if present)
    let areaCode = '';
    if (cleanNumber.length === 11 && cleanNumber.startsWith('1')) {
      areaCode = cleanNumber.substring(1, 4);
    } else if (cleanNumber.length === 10) {
      areaCode = cleanNumber.substring(0, 3);
    } else {
      return null;
    }

    // Basic area code to state mapping for common codes
    const areaCodeMap: { [key: string]: string } = {
      '503': 'OR', '971': 'OR', '541': 'OR',
      '206': 'WA', '253': 'WA', '360': 'WA', '425': 'WA', '509': 'WA', '564': 'WA',
      '415': 'CA', '510': 'CA', '650': 'CA', '408': 'CA', '831': 'CA', '925': 'CA',
      '213': 'CA', '323': 'CA', '424': 'CA', '661': 'CA', '818': 'CA', '747': 'CA',
      '832': 'TX', '713': 'TX', '281': 'TX', '409': 'TX', '979': 'TX', '346': 'TX',
      '214': 'TX', '469': 'TX', '972': 'TX', '945': 'TX', '903': 'TX', '430': 'TX',
      '212': 'NY', '347': 'NY', '646': 'NY', '718': 'NY', '917': 'NY', '929': 'NY',
      '518': 'NY', '585': 'NY', '607': 'NY', '631': 'NY', '716': 'NY', '845': 'NY',
      '305': 'FL', '786': 'FL', '954': 'FL', '754': 'FL', '561': 'FL', '728': 'FL',
      '202': 'DC', '771': 'VI', '340': 'VI',
      '803': 'SC', '843': 'SC', '854': 'SC',
      '501': 'AR', '479': 'AR', '870': 'AR',
      '785': 'KS', '316': 'KS', '620': 'KS',
      '714': 'CA', '949': 'CA', '657': 'CA',
      '772': 'FL', '865': 'TN', '217': 'IL'
    };

    return areaCodeMap[areaCode] || null;
  }

  // GET endpoint for outbound leads - SEPARATE Plus Lead queue and Hotlead queue
  app.get("/api/outbound-dialer/leads", async (req, res) => {
    console.log(`\n\n🚀🚀🚀 ===== CALL CONNECTOR PRO LEADS REQUEST ===== 🚀🚀🚀`);
    console.log(`Query:`, req.query);
    try {
      const userEmail = req.query.userEmail as string;
      console.log(`📧 Fetching leads for: ${userEmail}`);
      const market = req.query.market as string || 'Veteran';
      const queueType = req.query.queueType as string || 'plus'; // 'plus' or 'hotlead'
      const limit = parseInt(req.query.limit as string) || 50;
      console.log(`🔍 ENDPOINT START: userEmail=${userEmail}, market=${market}, queueType=${queueType}, limit=${limit}`);
      const resumePosition = req.query.resumePosition === 'true';
      
      console.log(`🔥 GET LEADS: Loading ${queueType} queue from masterlead for ${userEmail}`);
      console.log(`🔥 DEBUG QUEUE TYPE: "${queueType}" (type: ${typeof queueType})`);

      // DEBUG: Check what leads exist for this email
      const { count: totalCount, error: countError } = await supabase
        .from('masterlead')
        .select('*', { count: 'exact', head: true })
        .eq('cn_email', userEmail);
      
      console.log(`🔍 DEBUG: Total lead count for ${userEmail}: ${totalCount || 0}`);
      
      const { count: pendingCount, error: pendingError } = await supabase
        .from('masterlead')
        .select('*', { count: 'exact', head: true })
        .eq('cn_email', userEmail)
        .eq('cnresolution', 'pending');
      
      console.log(`🔍 DEBUG: Pending lead count for ${userEmail}: ${pendingCount || 0}`);

      // AUTO-REFILL: If agent has 10 OR FEWER leads, top them up to 50 total
      if (pendingCount <= 10) {
        const leadsNeeded = 50 - pendingCount;
        console.log(`📋 AUTO-REFILL: ${userEmail} has ${pendingCount} leads, topping up to 50 (adding ${leadsNeeded})...`);
        
        // Get agent's states and market from customers table (VDP data)
        const { data: agentData } = await supabaseAdmin
          .from('customers')
          .select('states, market')
          .or(`company_email.eq.${userEmail},personal_email.eq.${userEmail}`)
          .maybeSingle();
        
        const agentStates = agentData?.states || [];
        const agentMarkets = Array.isArray(agentData?.market) ? agentData.market : (agentData?.market ? [agentData.market] : ['Veteran']);
        
        console.log(`📋 AUTO-REFILL: Agent ${userEmail} licensed in states:`, agentStates);
        console.log(`📋 AUTO-REFILL: Agent ${userEmail} markets:`, agentMarkets);
        
        // Build query matching agent's territory - ORDER BY STATE RARITY
        
        // Count how many agents are licensed in each state
        const { data: allAgents } = await supabaseAdmin
          .from('customers')
          .select('states')
          .not('states', 'is', null);
        
        const agentsPerState: Record<string, number> = {};
        allAgents?.forEach(agent => {
          const states = agent.states || [];
          states.forEach((state: string) => {
            agentsPerState[state] = (agentsPerState[state] || 0) + 1;
          });
        });
        
        let refillQuery = supabaseAdmin
          .from('masterlead')
          .select('id, state, taalk_state')
          .is('cn_email', null)
          .eq('dnc', false)
          .not('state', 'eq', 'DC')
          .or('cnresolution.is.null,cnresolution.eq.pending,cnresolution.eq.called,cnresolution.eq.');
        
        // Match by market - FIXED: Handle array of markets
        if (agentMarkets.length > 0) {
          const marketConditions = agentMarkets.map(market => `taalk_market.eq.${market}`).join(',');
          refillQuery = refillQuery.or(marketConditions);
          console.log(`📋 AUTO-REFILL: Matching markets:`, agentMarkets);
        }
        
        // Match by states
        if (agentStates.length > 0) {
          const stateConditions = agentStates.map(state => `state.eq.${state},taalk_state.eq.${state}`).join(',');
          refillQuery = refillQuery.or(stateConditions);
          console.log(`📋 AUTO-REFILL: Matching states:`, agentStates);
        }
        
        const { data: matchingLeads } = await refillQuery.limit(150); // Get more for sorting
        
        // Sort by state rarity (states with FEWEST agents first)
        const sortedLeads = matchingLeads?.sort((a, b) => {
          const stateA = a.state || a.taalk_state;
          const stateB = b.state || b.taalk_state;
          const agentCountA = agentsPerState[stateA] || 999;
          const agentCountB = agentsPerState[stateB] || 999;
          return agentCountA - agentCountB; // Ascending: fewest agents first
        }).slice(0, leadsNeeded) || []; // Assign exactly what's needed to reach 50
        
        const newLeads = sortedLeads;
        
        if (newLeads && newLeads.length > 0) {
          await supabaseAdmin
            .from('masterlead')
            .update({
              cn_email: userEmail,
              assigned_date: new Date().toISOString(),
              cnresolution: 'pending'
            })
            .in('id', newLeads.map(l => l.id));
          
          console.log(`   ✅ AUTO-REFILL: Assigned ${newLeads.length} new leads to ${userEmail}`);
        } else {
          console.log(`   ⚠️ AUTO-REFILL: No unassigned leads available`);
        }
      }

      let supabaseQuery = supabase
        .from('masterlead')
        .select('*, FTCRESTRICTED')
        .eq('cnresolution', 'pending')
        .eq('cn_email', userEmail);

      // SIMPLIFIED QUEUE FILTERING - market=hotleads means "all pending leads for this agent"
      if (market === 'hotleads') {
        console.log(`🔥 HOTLEADS REQUESTED for ${userEmail}`);
        console.log(`✅ NO FILTERING: Returning all pending leads assigned to this agent`);
        // No additional filtering - just cn_email and cnresolution=pending
      } else {
        console.log(`🔥 OTHER MARKET: ${market} - applying hotlead filter`);
        supabaseQuery = supabaseQuery.eq('is_hot_lead', true);
      }

      // Try to get all leads without limit - Supabase might have default 1000 limit
      const { data: supabaseLeads, error: leadsError } = await supabaseQuery;

      if (leadsError) {
        console.error('❌ Error fetching masterlead hotleads:', leadsError);
        return res.status(500).json({ error: 'Failed to fetch hotleads from masterlead' });
      }

      console.log(`📊 Found ${supabaseLeads?.length || 0} hotleads in masterlead (cnresolution=pending AND isHotLead=true)`);
      
      let leads: any[] = [];
      let startPosition = 0;
      
      if (supabaseLeads && supabaseLeads.length > 0) {
        // Use the hotlead data directly
        let filteredLeads = supabaseLeads;
        
        // NO FTC FILTERING - Return all leads
        console.log(`🔥 NO FILTERING: Returning all ${filteredLeads.length} leads without FTC restrictions`);
        
        // Log first few leads for debugging
        if (filteredLeads.length > 0) {
          console.log(`🔍 Sample callable leads for ${userEmail}:`, filteredLeads.slice(0, 3).map(lead => `${lead.first_name} ${lead.last_name} (${lead.taalk_market}) - ${lead.state || lead.taalk_state} - ${lead.status || 'null'}`));
        }
        
        // Get agent's last position if resuming - DISABLED FOR MARKET FILTERING
        if (resumePosition && market === 'All') {
          try {
            const [agentProgress] = await db
              .select()
              .from(agentLeadProgress)
              .where(eq(agentLeadProgress.agentEmail, userEmail))
              .where(eq(agentLeadProgress.market, market))
              .where(eq(agentLeadProgress.isActive, true));
            
            if (agentProgress) {
              startPosition = agentProgress.currentPosition || 0;
              console.log(`📍 Resuming from position ${startPosition} for ${userEmail} in ${market} market`);
            }
          } catch (error) {
            console.error('❌ Error fetching agent progress:', error);
          }
        } else if (market !== 'All') {
          console.log(`🎯 MARKET FILTERING: Starting from position 0 for ${market} market (resume disabled)`);
        } else {
          console.log(`🔄 NO RESUME: Starting from position 0 for ${userEmail} in ${market} market (resumePosition=false)`);
          startPosition = 0;
        }
        
        // Apply position-based slicing (skip leads before start position)
        const positionedLeads = filteredLeads.slice(startPosition);
        
        // Debug Cornell Blanche specifically  
        const cornellBlanche = positionedLeads.find(lead => 
          lead.first_name === 'Cornell' && 
          lead.last_name === 'Blanche' && 
          lead.phone?.includes('6198202853')
        );
        
        if (cornellBlanche) {
          console.log('🔍 CORNELL BLANCHE DEBUG:');
          console.log('taalk_groupname:', JSON.stringify(cornellBlanche.taalk_groupname));
          console.log('taalk_group_code:', JSON.stringify(cornellBlanche.taalk_group_code));
          console.log('Expected Group Name: "Sponsored Veteran Referral"');
          console.log('Raw lead data:', JSON.stringify(cornellBlanche, null, 2));
        }
        
        // CALLBACK INTEGRATION: Add any callback leads for this agent (regardless of cn_email mismatches)
        let callbackLeads: any[] = [];
        try {
          console.log(`🔄 Checking for callback leads for ${userEmail}...`);
          const { data: callbacks, error: callbackError } = await supabase
            .from('masterlead')
            .select('*')
            .ilike('cnresolution', '%callback%')
            .or(`cnresolution.ilike.*call back*,cnresolution.ilike.*follow up*`)
            .limit(10);
          
          if (!callbackError && callbacks && callbacks.length > 0) {
            console.log(`🔄 Found ${callbacks.length} total callback leads in system`);
            // Filter callbacks to only those assigned to this agent in the callbacks system
            // This ensures we only show callbacks that legitimately belong to this agent
            callbackLeads = callbacks.filter(lead => {
              // Include callback leads for all users
              return true;
            });
            console.log(`🔄 Filtered to ${callbackLeads.length} callback leads for ${userEmail}`);
          }
        } catch (error) {
          console.error('❌ Error fetching callback leads:', error);
        }
        
        // Merge callback leads at the beginning (highest priority)
        const allLeads = [...callbackLeads, ...positionedLeads];
        
        // Convert to expected format - PASS ALL DATABASE FIELDS
        leads = allLeads.map((lead: any, index: number) => ({
          ...lead,  // SPREAD OPERATOR - Passes ALL database fields
          leadId: lead.taalk_lead_id || lead.lead_id || lead.id,
          name: lead.name || `${lead.first_name || ''} ${lead.last_name || ''}`.trim(),
          position: startPosition + index // Track position in queue
        }));
      }
      
      // STEP 1: Check for LIVE CALLS with MAXIMUM PRIORITY (999999)
      // DISABLED: Live call priority query - table schema mismatch
      let liveCallLeads = [];

      // DISABLED: Hotlead prioritization disabled per user request - code completely removed
      
      // FINAL STEP: Prepend LIVE CALLS with ABSOLUTE PRIORITY (always first)
      if (liveCallLeads && liveCallLeads.length > 0) {
        leads = [...liveCallLeads, ...leads];
        console.log(`🔥 LIVE CALL PRIORITY: Added ${liveCallLeads.length} live calls to the ABSOLUTE FRONT of the queue`);
      }

      console.log(`✅ Found ${leads.length} total leads from masterlead table for ${userEmail} (starting from position ${startPosition})`);
      
      // AUTO-ASSIGNMENT WEBHOOK: If agent has < 50 leads, request more from Lead Sync API
      let webhookSent = false;
      let webhookResponse = null;
      let leadsAssigned = 0;
      let webhookError = null;
      
      console.log(`🔍 WEBHOOK CHECK: Agent has ${leads.length} leads. Threshold: 50. Should trigger: ${leads.length < 50}`);
      
      if (leads.length < 50) {
        try {
          console.log(`📤 AUTO-ASSIGNMENT: Agent ${userEmail} has ${leads.length} leads (< 50), requesting more via Lead Sync API...`);
          
          // Get associate_id from customers table dynamically
          let associateId = "999"; // Default fallback
          try {
            const { data: customer } = await supabaseAdmin
              .from('customers')
              .select('associate_id')
              .or(`company_email.eq.${userEmail},personal_email.eq.${userEmail}`)
              .maybeSingle();
            
            if (customer?.associate_id) {
              associateId = customer.associate_id.toString();
              console.log(`✅ Found associate_id ${associateId} for ${userEmail}`);
            } else {
              // Fallback to hardcoded mapping for known agents
              associateId = userEmail === 'martintoma@aoglobelife.com' ? "1253" :
                           userEmail === 'cnsysop@aoglobelife.com' ? "1253" :
                           userEmail === 'davidfulfer@aoglobelife.com' ? "124235" : "999";
              console.log(`⚠️ No customer record found for ${userEmail}, using fallback associate_id: ${associateId}`);
            }
          } catch (associateError) {
            console.error(`❌ Error fetching associate_id for ${userEmail}:`, associateError);
            associateId = "999"; // Use default on error
          }
          
          const webhookPayload = {
            agentEmail: userEmail,
            associate_id: associateId,
            requestedCount: 50 - leads.length, // Request enough to reach 50
            currentCount: leads.length,
            source: 'call_connector_pro'
          };
          
          console.log(`📤 Sending bulk assignment request to Lead Sync API:`, webhookPayload);
          
          const webhookResult = await fetch('https://lead-sync-mmandella.replit.app/api/bulk-assign-leads', {
            method: 'POST',
            headers: { 
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(webhookPayload),
            signal: AbortSignal.timeout(10000) // 10 second timeout
          });
          
          if (webhookResult.ok) {
            webhookResponse = await webhookResult.json();
            webhookSent = true;
            leadsAssigned = webhookResponse.assigned || 0;
            console.log(`✅ AUTO-ASSIGNMENT: Lead Sync API assigned ${leadsAssigned} leads to ${userEmail}`);
            console.log(`📊 Assignment Details:`, {
              agentMarkets: webhookResponse.agentMarkets,
              agentStates: webhookResponse.agentStates,
              totalAvailable: webhookResponse.totalAvailable,
              afterMarketFilter: webhookResponse.afterMarketFilter
            });
          } else {
            const errorText = await webhookResult.text();
            webhookError = `HTTP ${webhookResult.status}: ${errorText}`;
            console.error(`❌ AUTO-ASSIGNMENT: Lead Sync API failed with status ${webhookResult.status}:`, errorText);
          }
        } catch (error) {
          webhookError = error instanceof Error ? error.message : String(error);
          console.error('❌ AUTO-ASSIGNMENT: Lead Sync API error:', webhookError);
        }
      }
      
      res.json({
        success: true,
        leads: leads,
        total: leads.length,
        filtered: leads.length,
        returned: leads.length,
        startPosition,
        market,
        hasLiveCall: liveCallLeads.length > 0,
        needsMoreLeads: leads.length < 50,
        webhookSent,
        webhookResponse,
        leadsAssigned,
        debug: {
          leadCount: leads.length,
          threshold: 50,
          shouldTrigger: leads.length < 50,
          webhookAttempted: leads.length < 50,
          webhookError,
          timestamp: new Date().toISOString()
        }
      });
      
    } catch (error) {
      console.error('❌ Failed to get leads:', error);
      res.status(500).json({ 
        success: false,
        error: 'Failed to get leads',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

  // Force lead assignment sync for all agents with < 50 leads
  app.post("/api/outbound-dialer/force-sync-all-agents", async (req, res) => {
    try {
      console.log('🔄 FORCE SYNC: Starting lead assignment sync for all agents...');
      
      // Get all agents from customers table
      const { data: customers, error: customersError } = await supabaseAdmin
        .from('customers')
        .select('company_email, personal_email, associate_id')
        .or('company_email.not.is.null,personal_email.not.is.null');
      
      if (customersError) {
        console.error('❌ Error fetching customers:', customersError);
        return res.status(500).json({ error: 'Failed to fetch agents' });
      }
      
      // Collect unique agent emails
      const agentEmails = new Set<string>();
      const emailToAssociateId = new Map<string, string>();
      
      (customers || []).forEach(customer => {
        if (customer.company_email) {
          agentEmails.add(customer.company_email);
          if (customer.associate_id) {
            emailToAssociateId.set(customer.company_email, customer.associate_id.toString());
          }
        }
        if (customer.personal_email) {
          agentEmails.add(customer.personal_email);
          if (customer.associate_id) {
            emailToAssociateId.set(customer.personal_email, customer.associate_id.toString());
          }
        }
      });
      
      console.log(`👥 Found ${agentEmails.size} agents to sync`);
      
      const results = [];
      const errors = [];
      
      // Check each agent's lead count and sync if needed
      for (const userEmail of agentEmails) {
        try {
          // Get current pending lead count
          const { count: leadCount } = await supabaseAdmin
            .from('masterlead')
            .select('*', { count: 'exact', head: true })
            .eq('cn_email', userEmail)
            .eq('cnresolution', 'pending');
          
          const currentCount = leadCount || 0;
          
          if (currentCount < 50) {
            const associateId = emailToAssociateId.get(userEmail) || "999";
            const requestedCount = 50 - currentCount;
            
            console.log(`📤 SYNCING: ${userEmail} has ${currentCount} leads, requesting ${requestedCount} more (associate_id: ${associateId})`);
            
            const webhookPayload = {
              agentEmail: userEmail,
              associate_id: associateId,
              requestedCount: requestedCount,
              currentCount: currentCount,
              source: 'force_sync_all'
            };
            
            try {
              const webhookResult = await fetch('https://lead-sync-mmandella.replit.app/api/bulk-assign-leads', {
                method: 'POST',
                headers: { 
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify(webhookPayload),
                signal: AbortSignal.timeout(10000) // 10 second timeout
              });
              
              if (webhookResult.ok) {
                const webhookResponse = await webhookResult.json();
                const leadsAssigned = webhookResponse.assigned || 0;
                results.push({
                  email: userEmail,
                  associate_id: associateId,
                  currentCount,
                  requestedCount,
                  leadsAssigned,
                  success: true
                });
                console.log(`✅ SYNCED: ${userEmail} - ${leadsAssigned} leads assigned`);
              } else {
                const errorText = await webhookResult.text();
                errors.push({
                  email: userEmail,
                  associate_id: associateId,
                  error: `HTTP ${webhookResult.status}: ${errorText}`
                });
                console.error(`❌ SYNC FAILED: ${userEmail} - HTTP ${webhookResult.status}`);
              }
            } catch (webhookError) {
              errors.push({
                email: userEmail,
                associate_id: associateId,
                error: webhookError instanceof Error ? webhookError.message : String(webhookError)
              });
              console.error(`❌ SYNC ERROR: ${userEmail} -`, webhookError);
            }
          } else {
            console.log(`⏭️ SKIPPED: ${userEmail} already has ${currentCount} leads (>= 50)`);
            results.push({
              email: userEmail,
              currentCount,
              skipped: true,
              reason: 'Already has 50+ leads'
            });
          }
        } catch (agentError) {
          errors.push({
            email: userEmail,
            error: agentError instanceof Error ? agentError.message : String(agentError)
          });
          console.error(`❌ ERROR checking ${userEmail}:`, agentError);
        }
      }
      
      console.log(`✅ FORCE SYNC COMPLETE: ${results.length} agents processed, ${errors.length} errors`);
      
      res.json({
        success: true,
        totalAgents: agentEmails.size,
        synced: results.filter(r => r.success).length,
        skipped: results.filter(r => r.skipped).length,
        errors: errors.length,
        results,
        errors: errors.length > 0 ? errors : undefined
      });
      
    } catch (error) {
      console.error('❌ Force sync error:', error);
      res.status(500).json({ 
        error: 'Failed to force sync all agents',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

  // Validate leads - check if cached leads are still assigned to agent
  app.post("/api/outbound-dialer/validate-leads", async (req, res) => {
    try {
      const { userEmail, leadIds } = req.body;
      
      if (!userEmail || !leadIds || !Array.isArray(leadIds)) {
        return res.status(400).json({ 
          error: 'Missing required fields: userEmail and leadIds (array)' 
        });
      }
      
      console.log(`🔍 VALIDATING: Checking ${leadIds.length} leads for ${userEmail}`);
      
      // Get current assignments from masterlead
      const { data: assignedLeads, error } = await supabaseAdmin
        .from('masterlead')
        .select('id, cn_email, cnresolution')
        .eq('cn_email', userEmail)
        .eq('cnresolution', 'pending')
        .in('id', leadIds);
      
      if (error) {
        console.error('❌ Validation error:', error);
        return res.status(500).json({ error: 'Failed to validate leads' });
      }
      
      const validLeadIds = new Set((assignedLeads || []).map(l => l.id));
      const invalidLeadIds = leadIds.filter(id => !validLeadIds.has(id));
      
      console.log(`✅ VALIDATION: ${validLeadIds.size} valid, ${invalidLeadIds.length} no longer assigned`);
      
      res.json({
        validLeadIds: Array.from(validLeadIds),
        invalidLeadIds,
        totalChecked: leadIds.length,
        validCount: validLeadIds.size,
        invalidCount: invalidLeadIds.length
      });
    } catch (error) {
      console.error('❌ Validate leads error:', error);
      res.status(500).json({ error: 'Failed to validate leads' });
    }
  });

  // Agent lead position tracking endpoints
  app.post("/api/outbound-dialer/track-position", async (req, res) => {
    try {
      const { agentEmail, market, leadId, leadPhone, position } = req.body;
      
      console.log(`📍 Tracking position ${position} for ${agentEmail} in ${market} market (lead: ${leadId})`);
      
      // Update or create agent progress record
      const progressData = {
        agentEmail,
        market,
        lastLeadId: leadId,
        lastLeadPhone: leadPhone,
        currentPosition: position,
        lastUpdated: new Date(),
        isActive: true
      };
      
      // Upsert agent progress
      await db
        .insert(agentLeadProgress)
        .values(progressData)
        .onConflictDoUpdate({
          target: [agentLeadProgress.agentEmail, agentLeadProgress.market],
          set: {
            lastLeadId: progressData.lastLeadId,
            lastLeadPhone: progressData.lastLeadPhone,
            currentPosition: progressData.currentPosition,
            lastUpdated: progressData.lastUpdated,
            isActive: progressData.isActive
          }
        });
      
      res.json({
        success: true,
        message: "Lead position tracked successfully",
        position,
        agentEmail,
        market
      });
      
    } catch (error) {
      console.error('❌ Error tracking lead position:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to track lead position',
        details: error instanceof Error ? error.message : String(error)
      });
    }
