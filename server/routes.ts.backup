  // Get callback routing statistics  
  app.get("/api/inbound-calls/callback-stats", async (req, res) => {
    try {
      // This could be enhanced with more sophisticated analytics
      const activeCalls = await storage.getActiveInboundCalls();
      
      const callbackCalls = activeCalls.filter(call => call.routingReason === 'callback');
      const newCallerCalls = activeCalls.filter(call => call.routingReason === 'new_caller');
      
      const stats = {
        totalActiveCalls: activeCalls.length,
        callbackCalls: callbackCalls.length,
        newCallerCalls: newCallerCalls.length,
        callbackPercentage: activeCalls.length > 0 ? Math.round((callbackCalls.length / activeCalls.length) * 100) : 0,
        agentSpecificCallbacks: callbackCalls.reduce((acc, call) => {
          const agent = call.routedToAgent || 'unknown';
          acc[agent] = (acc[agent] || 0) + 1;
          return acc;
        }, {} as Record<string, number>)
      };
      
      console.log(`📈 Callback routing stats: ${stats.callbackCalls} callbacks, ${stats.newCallerCalls} new callers`);
      
      res.json({
        success: true,
        stats: stats,
        timestamp: new Date().toISOString()
      });
      
