      const otherAgents = [
        { email: 'tabithamcdermid@aoglobelife.com', name: 'TABITHA MCDERMID' },
        { email: 'cnsysop@aoglobelife.com', name: 'MICHAEL MANDELLA' },
        { email: 'martintoma@aoglobelife.com', name: 'MARTIN TOMA' }
