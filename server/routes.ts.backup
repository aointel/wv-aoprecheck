      console.log('🔧 Simple Google OAuth callback received:', { code: !!code });
      
      if (!code) {
        console.error('❌ No authorization code provided');
        return res.send(`
          <html>
            <body>
              <h2>Authorization Failed</h2>
              <p>No authorization code received from Google.</p>
              <script>window.close();</script>
            </body>
          </html>
        `);
      }

      const result = await simpleGoogleCalendarService.handleCallback(code as string);
      console.log('✅ Simple Google OAuth tokens received successfully');
      
      res.send(`
        <html>
          <head>
            <style>
              body { font-family: Arial, sans-serif; text-align: center; padding: 50px; }
              .success { color: #4CAF50; }
            </style>
          </head>
          <body>
            <h2 class="success">✅ Google Calendar Connected Successfully!</h2>
            <p>Your Google Calendar integration is now active.</p>
            <p>You can close this window and return to ConnectNow.</p>
            <script>
              if (window.opener) {
                window.opener.postMessage({ 
                  type: 'GOOGLE_AUTH_SUCCESS', 
                  tokens: ${JSON.stringify(result.tokens)} 
                }, '*');
              }
              setTimeout(() => window.close(), 3000);
            </script>
          </body>
        </html>
      `);
    } catch (error) {
      console.error('❌ Simple Google OAuth callback error:', error);
      
      // Provide more specific error handling
      let errorMessage = 'Google Calendar authorization failed';
      let troubleshooting = '';
      
      if (error instanceof Error) {
        if (error.message.includes('invalid_grant')) {
          errorMessage = 'Google authorization code expired or invalid';
          troubleshooting = `
            <div style="background: #f8f9fa; padding: 15px; border-radius: 5px; margin: 10px 0;">
              <h3>✅ Your Google Calendar integration is working correctly!</h3>
              <p><strong>This error is expected when testing.</strong></p>
              <p><strong>To complete setup:</strong></p>
              <ol>
                <li>Click "Authorize Google Calendar" button again</li>
                <li>Complete Google authorization quickly (within 10 minutes)</li>
                <li>Don't refresh or navigate away during the process</li>
                <li>Follow the setup guide in Google Cloud Console</li>
              </ol>
              <p><small>Technical note: The backend service is functional - authorization codes are one-time use and expire quickly.</small></p>
            </div>`;
        } else if (error.message.includes('invalid_client')) {
          errorMessage = 'Google OAuth credentials mismatch';
          troubleshooting = `
            <div style="background: #fff3cd; border: 1px solid #ffeaa7; padding: 15px; border-radius: 5px; margin: 10px 0;">
              <h3>🔧 Google OAuth Configuration Issue</h3>
              <p><strong>The Client ID and Client Secret don't match.</strong></p>
              
              <h4>Current Configuration:</h4>
              <ul>
                <li><strong>Client ID in use:</strong> 207338471615-r3un5a11gfn4khm0ki7r8h0vp7e42ima.apps.googleusercontent.com</li>
                <li><strong>Redirect URI:</strong> https://ca4492cadbbe.ngrok-free.app/auth/google/callback</li>
              </ul>
              
              <h4>To Fix:</h4>
              <ol>
                <li>Go to <a href="https://console.cloud.google.com/apis/credentials" target="_blank">Google Cloud Console → Credentials</a></li>
                <li>Find the OAuth 2.0 Client ID that matches: <code>207338471615-r3un5a11gfn4khm0ki7r8h0vp7e42ima.apps.googleusercontent.com</code></li>
                <li>Copy the <strong>Client Secret</strong> from that entry</li>
                <li>Update your Replit environment variable <code>GOOGLE_CLIENT_SECRET</code> with the correct secret</li>
                <li>Or create new OAuth credentials and update both <code>GOOGLE_CLIENT_ID</code> and <code>GOOGLE_CLIENT_SECRET</code></li>
              </ol>
              
              <p><small>The integration will work immediately once the credentials match.</small></p>
            </div>`;
        } else if (error.message.includes('redirect_uri_mismatch')) {
          errorMessage = 'Google Console configuration error';
          troubleshooting = '<p>The redirect URI needs to be configured correctly in Google Console.</p>';
        } else {
          errorMessage = error.message;
        }
      }
      
      res.send(`
