  // Connect Review API endpoint (for card deck)
  app.post('/api/war/connect-review', async (req, res) => {
    try {
      const { connectId, result, saleAmount, nextReviewDate } = req.body;
      
      console.log('📋 Processing connect review:', { connectId, result, saleAmount });
      
      // Update the connect with review result
      const updateData: any = {
        reviewStatus: result,
        reviewedAt: new Date(),
      };
      
      if (result === 'sale' && saleAmount) {
        updateData.saleAmount = saleAmount;
        updateData.productionStatus = 'completed';
      } else if (result === 'interested' && nextReviewDate) {
        updateData.nextReviewDate = new Date(nextReviewDate);
        updateData.followUpRequired = true;
        updateData.productionStatus = 'pending';
      } else if (result === 'not_interested') {
        updateData.productionStatus = 'cancelled';
        updateData.followUpRequired = false;
      } else if (result === 'callback') {
        updateData.productionStatus = 'pending';
        updateData.followUpRequired = true;
        // Set next review date to tomorrow
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);
        updateData.nextReviewDate = tomorrow;
      }
      
      // Update in database
      await db
        .update(warConnects)
        .set(updateData)
        .where(eq(warConnects.connectId, connectId));
      
      console.log('✅ Connect review processed successfully');
      
      res.json({
        success: true,
        connectId,
        result,
        message: `Connect marked as ${result}`,
        timestamp: new Date().toISOString()
      });
      
    } catch (error) {
      console.error('❌ Connect review error:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to process connect review',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

