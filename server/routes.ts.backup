  // End inbound call
  app.post("/api/inbound-calls/end", async (req, res) => {
    try {
      const { callSid, agentEmail } = req.body;
      console.log(`📞 Agent ${agentEmail} ending call ${callSid}`);

      // Update call status to completed
      await db
        .update(schema.incomingCalls)
        .set({
          status: 'completed',
          endedAt: new Date()
        })
        .where(eq(schema.incomingCalls.twilioCallSid, callSid));

      // Use Twilio to actually end the call
      if (TWILIO_ACCOUNT_SID && TWILIO_AUTH_TOKEN) {
        try {
          await twilioClient.calls(callSid).update({ status: 'completed' });
          console.log(`📞 Twilio call ${callSid} ended successfully`);
        } catch (twilioError) {
          console.error('⚠️ Failed to end Twilio call, but database updated:', twilioError);
        }
      }
      
      res.json({ success: true, message: 'Call ended successfully' });

    } catch (error) {
      console.error('❌ Failed to end inbound call:', error);
      res.status(500).json({ error: 'Failed to end call' });
    }
  });

  // Webhook for incoming Taalk VDP calls - data capture only
  app.post("/api/taalk/incoming-call", async (req, res) => {
    try {
      console.log('🔍 RAW WEBHOOK DATA RECEIVED:');
      console.log('Headers:', JSON.stringify(req.headers, null, 2));
      console.log('Body:', JSON.stringify(req.body, null, 2));
      console.log('Query:', JSON.stringify(req.query, null, 2));
      console.log('Method:', req.method);
      console.log('URL:', req.url);
      console.log('Timestamp:', new Date().toISOString());
      console.log('User-Agent:', req.headers['user-agent']);
      console.log('Content-Type:', req.headers['content-type']);
      console.log('Raw body length:', JSON.stringify(req.body).length);
      
      // Database logging disabled - using Supabase only
      console.log('📋 Webhook received - logging to Supabase');
      
      // Parse actual VDP data format - capture ALL fields including AI summary
      const {
        associate_id,
        agent,
        event,
        duration,
        LeadId,
        company_email,
        clientmarket,
        clientaddress,
        clientcity,
        clientstate,
        clientsecretkey,
        clientemail,
        clientphone,
        clientgroupcode,
        name,
        ai_summary,
        summary,
        analysis,
        call_summary
      } = req.body;
      
      // AI summary can be in multiple fields - check all of them
      const aiSummaryData = ai_summary || summary || analysis || call_summary;
      
      // Look up agent email from associate_id if company_email is not provided
      let agentEmail = company_email;
      const agentAssociateId = agent || associate_id;
      
      if (!agentEmail && agentAssociateId) {
        console.log(`🔍 Looking up agent email for associate_id: ${agentAssociateId}`);
        
        const { data: producer } = await supabaseAdmin
          .from('producerlist')
          .select('company_email')
          .eq('associate_id', agentAssociateId)
          .single();
        
        if (producer?.company_email) {
          agentEmail = producer.company_email;
          console.log(`✅ Found agent email: ${agentEmail}`);
        } else {
          console.warn(`⚠️ No email found for associate_id: ${agentAssociateId}`);
        }
      }
      
      // Map to our expected format
      const callerNumber = clientphone;
      const callSid = `VDP_${LeadId}_${Date.now()}`;
      const CallerName = name;
      const CallerCity = clientcity;
      const CallerState = clientstate;
      const AgentEmail = agentEmail;
      const CallStatus = event;
      const dialedNumber = "VDP_SYSTEM"; // VDP calls don't have a "To" number
      
      console.log(`📋 VDP Call Data Received: ${callerNumber} -> ${dialedNumber}, CallSid: ${callSid}`);
      console.log(`👤 Caller: ${CallerName || 'Unknown'} from ${CallerCity || 'Unknown'}, ${CallerState || 'Unknown'}`);
      console.log(`🎯 Assigned Agent: ${AgentEmail || 'Not specified'} (Associate ID: ${agentAssociateId})`);

      // Store call data for Call Connector Pro display
      const leadName = CallerName || `Lead ${callerNumber}`;
      const leadCity = CallerCity || null;
      const leadState = CallerState || null;
      const assignedAgent = AgentEmail || 'system';

      // Store to Supabase instead of local DB
      let result = null;
      try {
        if (supabase) {
          await supabase.from("vdp_calls").insert({
            agent: agentAssociateId,
            event,
            leadid: LeadId,
            company_email: agentEmail,
            phone: callerNumber,
            firstName: CallerName?.split(' ')[0] || '',
            lastName: CallerName?.split(' ').slice(1).join(' ') || '',
            market: clientmarket,
            duration: duration ? parseFloat(duration) : null,
            mga: req.body.mga,
            rga: req.body.rga,
            time: new Date().toISOString()
          });
          console.log(`✅ VDP call logged to Supabase for ${agentEmail || 'unknown'}`);
        }
      } catch (err) {
        console.warn("⚠️ Supabase log failed (non-critical):", err?.message);
      }

      // Check if this is a recruit call - UPDATE CANDIDATE WITH AI SUMMARY
      const isRecruitCall = clientmarket?.toLowerCase().includes('recruit') || 
                           clientmarket?.toLowerCase().includes('hiring') ||
                           clientgroupcode?.toLowerCase().includes('recruit');
      
      if (isRecruitCall && AgentEmail && event === 'PICK_UP') {
        console.log(`🎯 Detected recruit VDP call for ${AgentEmail}: ${leadName} (${callerNumber})`);
        
        // If we have AI summary, update the candidate
        if (aiSummaryData && callerNumber) {
          console.log(`🤖 AI Summary received for ${callerNumber}`);
          console.log(`📝 Summary: ${aiSummaryData.substring(0, 200)}...`);
          
          try {
            // Find candidate by phone number
            const { data: existingCandidate, error: lookupError } = await supabaseAdmin
              .from('recruit_candidates')
              .select('id, first_name, last_name')
              .eq('phone', callerNumber)
              .maybeSingle();
            
            if (lookupError) {
              console.error('❌ Error looking up candidate:', lookupError);
            } else if (existingCandidate) {
              // Update existing candidate with AI summary
              console.log(`✅ Found candidate ${existingCandidate.id}: ${existingCandidate.first_name} ${existingCandidate.last_name}`);
              
              const { error: updateError } = await supabaseAdmin
                .from('recruit_candidates')
                .update({ 
                  ai_summary: aiSummaryData,
                  updated_at: new Date().toISOString()
                })
                .eq('id', existingCandidate.id);
              
              if (updateError) {
                console.error('❌ Failed to update candidate with AI summary:', updateError);
              } else {
                console.log(`✅ ✅ ✅ AI SUMMARY SAVED to candidate ${existingCandidate.id}!`);
              }
            } else {
              console.log(`⚠️ No candidate found for phone ${callerNumber} - will be created by poller`);
            }
          } catch (summaryError) {
            console.error('❌ Error processing AI summary:', summaryError);
          }
        } else if (!aiSummaryData) {
          console.log(`ℹ️ No AI summary in webhook data`);
        }
      }

      // Simple acknowledgment response (no call routing needed)
      res.json({ 
        success: true, 
        message: 'Call data captured for agent display',
        callId: result?.id,
        displayData: {
          callerName: leadName,
          callerNumber: callerNumber,
          location: `${leadCity || ''} ${leadState || ''}`.trim(),
          agent: AgentEmail || 'Unknown'
        }
      });

    } catch (error) {
      console.error('❌ Failed to capture VDP call data:', error);
      res.status(500).json({ 
        error: 'Failed to capture call data',
        details: error.message 
      });
    }
  });

