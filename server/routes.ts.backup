      const billingResults = await MissedCallBillingService.processMissedCallBilling(missedCalls);
      
      res.json({
        success: true,
        missedCallsFound: missedCalls.length,
        processed: billingResults.processed,
        failed: billingResults.failed,
        details: billingResults.results,
        missedCalls: missedCalls
      });
      
    } catch (error) {
      console.error('❌ Error processing missed calls:', error);
      res.status(500).json({ 
