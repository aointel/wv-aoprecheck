  // Appointments API endpoints - CREATE new appointment (using proper imported function)
  app.post("/api/appointments", createAppointment);

  // Enhanced appointment creation for Call Connector Pro booking flow
  app.post("/api/appointments/create", async (req, res) => {
    try {
      const { platform, service, date, time, leadId, leadName, agentEmail } = req.body;
      
      if (!platform || !service || !date || !time || !leadId || !agentEmail) {
        return res.status(400).json({ error: 'Missing required appointment details' });
      }

      // Combine date and time into proper datetime format
      const appointmentDateTime = new Date(`${date}T${time}`);
      const endDateTime = new Date(appointmentDateTime.getTime() + (60 * 60 * 1000)); // 1 hour duration

      // Create appointment title based on platform and service
      const platformName = platform === 'aoi' ? 'AO Intelligence' : 'Planet/Off Platform';
      const title = `${platformName} - ${service} with ${leadName}`;

      // Insert appointment into Supabase
      const { data: appointmentData, error: insertError } = await supabase
        .from('appointments')
        .insert({
          title: title,
          agent_email: agentEmail,
          lead_id: leadId?.toString(),
          lead_name: leadName,
          start_time: appointmentDateTime.toISOString(),
          end_time: endDateTime.toISOString(),
          meeting_platform: platform === 'aoi' ? 'aoi_intelligence' : service,
          service_type: service,
          platform_type: platform,
          status: 'scheduled',
          google_calendar_sync_status: 'pending',
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        })
        .select('id')
        .single();

      if (insertError) {
        console.error('❌ Failed to create appointment:', insertError);
        return res.status(500).json({ error: 'Failed to create appointment in database' });
      }

      console.log(`✅ Created appointment for ${leadName} on ${date} at ${time} (Platform: ${platformName}, Service: ${service})`);

      res.status(201).json({
        success: true,
        appointmentId: appointmentData.id,
        title: title,
        platform: platformName,
        service: service,
        dateTime: appointmentDateTime.toISOString()
      });

    } catch (error) {
      console.error('❌ Appointment creation error:', error);
      res.status(500).json({ error: 'Internal server error during appointment creation' });
    }
  });

  // GET appointments for an agent by email parameter
  app.get("/api/appointments/:agentEmail", async (req, res) => {
    try {
      const { agentEmail } = req.params;
      
      console.log(`🗓️ Fetching appointments for agent: ${agentEmail}`);

      // Query the actual appointments table in Supabase
      const { data: appointmentsData, error } = await supabase
        .from('appointments')
        .select('*')
        .eq('agent_email', agentEmail)
        .order('start_time', { ascending: true });

      if (error) {
        console.error('❌ Supabase appointments error:', error);
        return res.status(500).json({ error: 'Failed to fetch appointments from database' });
      }

      console.log(`✅ Found ${appointmentsData?.length || 0} appointments for ${agentEmail}`);
      
      res.json(appointmentsData || []);

    } catch (error: any) {
      console.error('❌ Error fetching appointments:', error);
      res.status(500).json({ 
        error: 'Failed to fetch appointments',
        details: error.message 
      });
    }
  });

