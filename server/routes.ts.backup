  // Add sample data endpoint for testing
  app.post("/api/war/sample-data", async (req, res) => {
    try {
      const agentEmail = 'davidfulfer@aoglobelife.com';
      const agentName = 'David Fulfer';
      const teamName = 'Globe Life Team';
      
      // Generate sample data for this week
      const today = new Date();
      const thisWeekStart = new Date(today);
      thisWeekStart.setDate(today.getDate() - today.getDay()); // Start of week (Sunday)
      
      const sampleData = [];
      const markets = ['plus', 'veteran', 'globe', 'willkit'];
      
      // Generate data for each day of the week and each market
      for (let day = 0; day < 7; day++) {
        const reportDate = new Date(thisWeekStart);
        reportDate.setDate(thisWeekStart.getDate() + day);
        
        for (const market of markets) {
          // Generate realistic sample metrics
          const dials = Math.floor(Math.random() * 50) + 10;
          const reached = Math.floor(dials * (0.15 + Math.random() * 0.25)); // 15-40% reach rate
          const booked = Math.floor(reached * (0.20 + Math.random() * 0.30)); // 20-50% booking rate
          const appointments = Math.floor(booked * (0.70 + Math.random() * 0.25)); // 70-95% show rate
          const presentations = Math.floor(appointments * (0.80 + Math.random() * 0.15)); // 80-95% presentation rate
          const sales = Math.floor(presentations * (0.10 + Math.random() * 0.20)); // 10-30% close rate
          const alp = sales * (Math.random() * 5000 + 2000); // $2K-$7K per sale
          
          const metrics = await warService.upsertDailyMetrics({
            agentEmail,
            agentName,
            teamName,
            reportDate,
            marketType: market as any,
            dials,
            reached,
            booked,
            appointments,
            presentations,
            sales,
            alp
          });
          
          sampleData.push(metrics);
        }
      }
      
      res.json({ 
        success: true, 
        message: `Generated ${sampleData.length} sample metric entries for ${agentName}`,
        data: sampleData
      });
    } catch (error) {
      console.error('❌ Failed to generate sample data:', error);
      res.status(500).json({ success: false, error: 'Failed to generate sample data' });
    }
  });

