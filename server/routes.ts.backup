  // Alex AI Lead Actions endpoint - performs actual lead table modifications
  app.post("/api/alex-ai/actions", async (req, res) => {
    try {
      const { userEmail, action, parameters } = req.body;
      
      if (!userEmail || !action) {
        return res.status(400).json({
          error: 'User email and action are required'
        });
      }

      console.log(`🤖 ALEX AI ACTION: ${action} for ${userEmail} with params:`, parameters);

      let result;
      
      switch (action) {
        case 'sort_leads_by_state':
          result = await performSortLeadsByState(userEmail, parameters);
          break;
          
        case 'sort_leads_by_priority':
          result = await performSortLeadsByPriority(userEmail, parameters);
          break;
          
        case 'filter_leads_by_market':
          result = await performFilterLeadsByMarket(userEmail, parameters);
          break;
          
        case 'update_lead_status':
          result = await performUpdateLeadStatus(userEmail, parameters);
          break;
          
        case 'organize_leads_custom':
          result = await performCustomLeadOrganization(userEmail, parameters);
          break;
          
        case 'sort_plus_leads_by_state':
          result = await performSortPlusLeadsByState(userEmail, parameters);
          break;
          
        case 'submit_help_request':
          result = await performSubmitHelpRequest(userEmail, parameters);
          break;
          
        default:
          return res.status(400).json({
            error: `Unknown action: ${action}`
          });
      }

      res.json({
        success: true,
        action,
        result,
        message: `Successfully executed ${action} for ${userEmail}`
      });
      
    } catch (error) {
      console.error('❌ ALEX AI ACTION ERROR:', error);
      res.status(500).json({
        error: 'Failed to execute Alex AI action',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

  // Alex AI Lead Action Functions
  async function performSortLeadsByState(userEmail: string, parameters: any) {
    if (!supabase) throw new Error('Supabase not available');
    
    console.log(`🌎 ALEX AI: Sorting leads by state for ${userEmail}`);
    
    // Get current leads from Supabase masterlead table
    const { data: leads, error } = await supabase
      .from('masterlead')
      .select('*')
      .order('created_at', { ascending: false })
      .limit(500);
      
    if (error) throw error;
    
    // Separate hotleads (keep at top) and regular leads
    const hotleads = leads.filter(lead => lead.is_hot_lead);
    const regularLeads = leads.filter(lead => !lead.is_hot_lead);
    
    // Sort regular leads by state alphabetically
    const sortedRegularLeads = regularLeads.sort((a, b) => {
      const stateA = (a.taalk_state || a.state || '').toUpperCase();
      const stateB = (b.taalk_state || b.state || '').toUpperCase();
      return stateA.localeCompare(stateB);
    });
    
    const sortedLeads = [...hotleads, ...sortedRegularLeads];
    
    console.log(`✅ ALEX AI: Sorted ${regularLeads.length} leads by state, preserved ${hotleads.length} hotleads at top`);
    
    return {
      action: 'sort_by_state',
      totalLeads: leads.length,
      hotleadsPreserved: hotleads.length,
      regularLeadsSorted: regularLeads.length,
      sortedOrder: sortedLeads.slice(0, 10).map(l => ({
        name: `${l.first_name} ${l.last_name}`,
        state: l.taalk_state || l.state,
        isHotlead: !!l.is_hot_lead
      }))
    };
  }

  async function performSortLeadsByPriority(userEmail: string, parameters: any) {
    if (!supabase) throw new Error('Supabase not available');
    
    console.log(`⭐ ALEX AI: Sorting leads by priority for ${userEmail}`);
    
    const { data: leads, error } = await supabase
      .from('masterlead')
      .select('*')
      .order('created_at', { ascending: false })
      .limit(500);
      
    if (error) throw error;
    
    // Separate hotleads and regular leads
    const hotleads = leads.filter(lead => lead.is_hot_lead);
    const regularLeads = leads.filter(lead => !lead.is_hot_lead);
    
    // Sort regular leads by priority (newer leads first, then by market)
    const sortedRegularLeads = regularLeads.sort((a, b) => {
      // Priority: Veteran > Traditional > Other markets
      const marketPriority = { 'Veteran': 3, 'Traditional': 2 };
      const aPriority = marketPriority[a.taalk_market] || 1;
      const bPriority = marketPriority[b.taalk_market] || 1;
      
      if (aPriority !== bPriority) return bPriority - aPriority;
      
      // Then by creation date (newer first)
      return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
    });
    
    const sortedLeads = [...hotleads, ...sortedRegularLeads];
    
    console.log(`✅ ALEX AI: Sorted ${regularLeads.length} leads by priority, preserved ${hotleads.length} hotleads`);
    
    return {
      action: 'sort_by_priority',
      totalLeads: leads.length,
      hotleadsPreserved: hotleads.length,
      regularLeadsSorted: regularLeads.length,
      priorityOrder: sortedLeads.slice(0, 10).map(l => ({
        name: `${l.first_name} ${l.last_name}`,
        market: l.taalk_market,
        state: l.taalk_state || l.state,
        isHotlead: !!l.is_hot_lead
      }))
    };
  }

  async function performFilterLeadsByMarket(userEmail: string, parameters: any) {
    if (!supabase) throw new Error('Supabase not available');
    
    const { market } = parameters || {};
    console.log(`🎯 ALEX AI: Filtering leads by market '${market}' for ${userEmail}`);
    
    const { data: leads, error } = await supabase
      .from('masterlead')
      .select('*')
      .eq('taalk_market', market)
      .order('created_at', { ascending: false });
      
    if (error) throw error;
    
    console.log(`✅ ALEX AI: Found ${leads.length} leads in ${market} market`);
    
    return {
      action: 'filter_by_market',
      market,
      totalLeads: leads.length,
      leads: leads.slice(0, 20).map(l => ({
        name: `${l.first_name} ${l.last_name}`,
        state: l.taalk_state || l.state,
        phone: l.phone,
        isHotlead: !!l.is_hot_lead
      }))
    };
  }

  async function performUpdateLeadStatus(userEmail: string, parameters: any) {
    if (!supabase) throw new Error('Supabase not available');
    
    const { leadId, newStatus } = parameters || {};
    console.log(`📝 ALEX AI: Updating lead ${leadId} status to '${newStatus}' for ${userEmail}`);
    
    const { data, error } = await supabase
      .from('masterlead')
      .update({ status: newStatus, updated_at: new Date().toISOString() })
      .eq('id', leadId)
      .select();
      
    if (error) throw error;
    
    console.log(`✅ ALEX AI: Updated lead ${leadId} status to ${newStatus}`);
    
    return {
      action: 'update_status',
      leadId,
      newStatus,
      updated: data?.length || 0
    };
  }

  async function performCustomLeadOrganization(userEmail: string, parameters: any) {
    if (!supabase) throw new Error('Supabase not available');
    
    const { sortCriteria, states, markets } = parameters || {};
    console.log(`🎨 ALEX AI: Custom lead organization for ${userEmail}:`, parameters);
    
    let query = supabase.from('masterlead').select('*');
    
    // Apply filters
    if (states && states.length > 0) {
      query = query.in('taalk_state', states);
    }
    
    if (markets && markets.length > 0) {
      query = query.in('taalk_market', markets);
    }
    
    // Apply sorting
    switch (sortCriteria) {
      case 'alphabetical':
        query = query.order('first_name', { ascending: true });
        break;
      case 'newest_first':
        query = query.order('created_at', { ascending: false });
        break;
      case 'oldest_first':
        query = query.order('created_at', { ascending: true });
        break;
      default:
        query = query.order('created_at', { ascending: false });
    }
    
    const { data: leads, error } = await query.limit(500);
    
    if (error) throw error;
    
    console.log(`✅ ALEX AI: Custom organization found ${leads.length} leads`);
    
    return {
      action: 'custom_organization',
      criteria: { sortCriteria, states, markets },
      totalLeads: leads.length,
      sample: leads.slice(0, 15).map(l => ({
        name: `${l.first_name} ${l.last_name}`,
        state: l.taalk_state || l.state,
        market: l.taalk_market,
        isHotlead: !!l.is_hot_lead
      }))
    };
  }

  async function performSortPlusLeadsByState(userEmail: string, parameters: any) {
    if (!supabase) throw new Error('Supabase not available');
    
    console.log(`🌟 ALEX AI: Sorting PLUS leads by state for ${userEmail}`);
    
    // Get plus leads specifically from Supabase masterlead table
    const { data: leads, error } = await supabase
      .from('masterlead')
      .select('*')
      .eq('taalk_market', 'Traditional') // Plus leads are Traditional market
      .order('created_at', { ascending: false })
      .limit(1000);
      
    if (error) throw error;
    
    // Separate hotleads (keep at top) and plus leads
    const hotleads = leads.filter(lead => lead.is_hot_lead);
    const plusLeads = leads.filter(lead => !lead.is_hot_lead);
    
    // Sort plus leads by state alphabetically A-Z
    const sortedPlusLeads = plusLeads.sort((a, b) => {
      const stateA = (a.taalk_state || a.state || '').toUpperCase();
      const stateB = (b.taalk_state || b.state || '').toUpperCase();
      return stateA.localeCompare(stateB);
    });
    
    console.log(`✅ ALEX AI: Sorted ${sortedPlusLeads.length} PLUS leads by state A-Z, preserved ${hotleads.length} hotleads`);
    
    return {
      action: 'sort_plus_leads_by_state',
      totalPlusLeads: plusLeads.length,
      hotleadsPreserved: hotleads.length,
      market: 'Traditional (Plus)',
      sortedOrder: sortedPlusLeads.slice(0, 15).map(l => ({
        name: `${l.first_name} ${l.last_name}`,
        state: l.taalk_state || l.state,
        market: l.taalk_market,
        isHotlead: !!l.is_hot_lead
      }))
    };
  }

  async function performSubmitHelpRequest(userEmail: string, parameters: any) {
    try {
      const { subject, message, name } = parameters;
      
      console.log(`🆘 ALEX AI: Submitting help request for ${userEmail}`);
      
      // Get user name if not provided
      let userName = name;
      if (!userName) {
        try {
          // Try to get user name from database
          const { data: userData } = await supabase
            .from('customers')
            .select('first_name, last_name')
            .eq('company_email', userEmail.toLowerCase().trim())
            .single();
          
          if (userData) {
            userName = `${userData.first_name} ${userData.last_name}`.trim();
          }
        } catch (error) {
          // Fallback to email if name not found
          userName = userEmail.split('@')[0];
        }
      }
      
      // Create email content
      const htmlContent = `
        <h2>AO Intelligence Support Request - Alex AI Chat</h2>
        <p><strong>From:</strong> ${userName} (${userEmail})</p>
        <p><strong>Subject:</strong> ${subject || 'Alex AI Chat Support Request'}</p>
        <p><strong>Source:</strong> Alex AI Chat Interface</p>
        <p><strong>Message:</strong></p>
        <div style="background: #f5f5f5; padding: 15px; border-radius: 5px;">
          ${message.replace(/\n/g, '<br>')}
        </div>
        <hr>
        <p><em>Submitted via Alex AI Chat on ${new Date().toLocaleString()}</em></p>
      `;

      // Send email to support using existing email service
      const emailSent = await sendEmail({
        to: 'aointel@aoglobelife.com',
        subject: `AO Intelligence - Alex AI Support: ${subject || 'Chat Help Request'}`,
        html: htmlContent,
        from: 'noreply@aoglobelife.com'
      });

      if (emailSent) {
        console.log(`✅ ALEX AI: Help request sent successfully for ${userEmail}`);
        return {
          success: true,
          message: 'Support request submitted successfully',
          ticketId: `alex-${Date.now()}`,
          sentTo: 'aointel@aoglobelife.com'
        };
      } else {
        throw new Error('Failed to send support email');
      }

    } catch (error) {
      console.error('❌ ALEX AI: Help request submission failed:', error);
      throw error;
    }
  }

  // AI-powered lead organization endpoint - "Meet Alex" chatbot
  app.post("/api/outbound-dialer/organize-leads", async (req, res) => {
    try {
      const { userEmail, organizationRequest } = req.body;
      
      if (!userEmail || !organizationRequest) {
        return res.status(400).json({
          error: 'User email and organization request are required'
        });
      }

      console.log(`🤖 AI LEAD ORGANIZATION: "${organizationRequest}" for ${userEmail}`);

      // Get agent's current leads from Supabase
      const { data: leads, error } = await supabaseAdmin
        .from('masterlead')
        .select('*')
        .eq('cn_email', userEmail)
        .range(0, 2999);

      if (error) {
        console.error('❌ Failed to fetch leads for AI organization:', error);
        return res.status(500).json({
          error: 'Failed to fetch leads for organization'
        });
      }

      // Import and use the AI organization service
      const { organizeLeadsWithAI } = await import('./openai-service');
      
      const sortResult = await organizeLeadsWithAI({
        userRequest: organizationRequest,
        leads: leads || [],
        userEmail
      });

      console.log(`✅ AI ORGANIZATION COMPLETE: ${sortResult.explanation}`);

      // Transform to frontend format
      const formattedLeads = sortResult.sortedLeads.map(lead => ({
        id: lead.id,
        name: `${lead.first_name || ''} ${lead.last_name || ''}`.trim() || 'Lead',
        firstName: lead.first_name || 'Lead',
        lastName: lead.last_name || 'Contact',
        phone: lead.phone,
        cnresolution: lead.cnresolution,
        corevt: lead.cnresolution, // Map cnresolution to corevt for frontend display
        status: lead.status || 'new',
        leadId: lead.id, // Use database primary key
        market: lead.taalk_market || 'Veteran',
        state: lead.taalk_state || lead.state || 'Unknown',
        city: lead.taalk_city || lead.city || 'Unknown',
        isHotLead: lead.is_hot_lead || false,
        priority: lead.priority_score || 0
      }));

      res.json({
        success: true,
        leads: formattedLeads,
        explanation: sortResult.explanation,
        sortingLogic: sortResult.sortingLogic,
        totalLeads: formattedLeads.length,
        hotleads: formattedLeads.filter(l => l.isHotLead).length
      });

    } catch (error: any) {
      console.error('❌ AI Lead Organization Error:', error);
      res.status(500).json({
        error: 'AI lead organization failed',
        message: error.message
      });
    }
  });

