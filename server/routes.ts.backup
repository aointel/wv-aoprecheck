  // Get call connections data for billing interface (legacy endpoint)
  app.get('/api/billing/connections', async (req, res) => {
    try {
      const userEmail = req.query.userEmail as string;
      
      if (!userEmail) {
        return res.status(400).json({ error: 'User email is required' });
      }
      
      console.log(`📞 Fetching connections data for: ${userEmail}`);
      
      // Get answered calls from Supabase call logs
      const { data: answeredCalls, error: answeredError } = await supabase
        .from('twilio_call_logs')
        .select('*')
        .eq('owner_email', userEmail)
        .in('status', ['completed', 'in-progress'])
        .order('call_started_at', { ascending: false })
        .limit(50);
      
      if (answeredError) {
        console.error('❌ Error fetching answered calls:', answeredError);
      }
      
      // Get user's missed call count
      const { data: userCredits, error: creditsError } = await supabase
        .from('user_credits')
        .select('aoi_missed_calls, associate_id')
        .eq('email', userEmail)
        .single();
      
      if (creditsError) {
        console.error('❌ Error fetching user credits:', creditsError);
      }
      
      res.json({
        success: true,
        answeredCalls: answeredCalls || [],
        missedCallCount: userCredits?.aoi_missed_calls || 0,
        agentId: userCredits?.associate_id || '',
        totalConnections: (answeredCalls?.length || 0) + (userCredits?.aoi_missed_calls || 0)
      });
      
    } catch (error) {
      console.error('❌ Error in connections endpoint:', error);
      res.status(500).json({ error: 'Internal server error' });
    }
  });

