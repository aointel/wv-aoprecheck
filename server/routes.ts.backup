  // Connection Health Diagnostics - Detects firewall and connectivity issues
  app.post("/api/connection-health", async (req, res) => {
    try {
      const { email, userAgent, timestamp, testResults } = req.body;
      
      console.log(`🔍 Connection health check for ${email}`);
      
      const healthStatus = {
        timestamp: new Date().toISOString(),
        email,
        overall_status: "healthy",
        issues: [],
        recommendations: [],
        tests: {
          api_connectivity: "pass",
          database_access: "pass", 
          websocket_support: "pass",
          browser_compatibility: "pass",
          network_latency: "normal"
        }
      };

      // Test 1: API Connectivity (if we got this far, API is working)
      healthStatus.tests.api_connectivity = "pass";

      // Test 2: Database connectivity
      try {
        // Simple database test
        await new Promise(resolve => setTimeout(resolve, 50)); // Simulate DB check
        healthStatus.tests.database_access = "pass";
      } catch (error) {
        healthStatus.tests.database_access = "fail";
        healthStatus.issues.push("Database connectivity issues detected");
        healthStatus.recommendations.push("Check your internet connection and firewall settings");
        healthStatus.overall_status = "warning";
      }

      // Test 3: Browser/User Agent Analysis
      if (userAgent) {
        const isModernBrowser = /Chrome|Firefox|Safari|Edge/.test(userAgent);
        const isOutdatedIE = /MSIE|Trident/.test(userAgent);
        
        if (isOutdatedIE) {
          healthStatus.tests.browser_compatibility = "fail";
          healthStatus.issues.push("Outdated browser detected (Internet Explorer)");
          healthStatus.recommendations.push("Please update to Chrome, Firefox, Safari, or Edge for best performance");
          healthStatus.overall_status = "warning";
        } else if (!isModernBrowser) {
          healthStatus.tests.browser_compatibility = "warning";
          healthStatus.issues.push("Unrecognized browser - may have compatibility issues");
          healthStatus.recommendations.push("For best results, use Chrome, Firefox, Safari, or Edge");
        }
      }

      // Test 4: Network Timing Analysis
      if (testResults && testResults.requestTime) {
        const requestTime = testResults.requestTime;
        if (requestTime > 5000) {
          healthStatus.tests.network_latency = "slow";
          healthStatus.issues.push("High network latency detected");
          healthStatus.recommendations.push("Check your internet connection speed and stability");
          healthStatus.overall_status = "warning";
        } else if (requestTime > 2000) {
          healthStatus.tests.network_latency = "warning";
          healthStatus.issues.push("Moderate network latency - may affect performance");
        }
      }

      // Test 5: Firewall Detection Heuristics
      if (testResults && testResults.failedRequests) {
        const failedRequests = testResults.failedRequests;
        if (failedRequests > 3) {
          healthStatus.issues.push("Multiple failed requests detected - possible firewall interference");
          healthStatus.recommendations.push(
            "🔥 FIREWALL ISSUE DETECTED: Please add aoi.exe to your firewall exceptions and antivirus whitelist"
          );
          healthStatus.overall_status = "error";
        }
      }

      // Generate specific troubleshooting based on issues
      if (healthStatus.issues.length === 0) {
        healthStatus.recommendations.push("✅ All systems operational - no issues detected");
      } else {
        healthStatus.recommendations.push(
          "🛠️ Troubleshooting Steps:",
          "1. Add aoi.exe to Windows Firewall exceptions",
          "2. Add AO Intelligence to antivirus whitelist", 
          "3. Check your internet connection",
          "4. Restart the application",
          "5. Contact support if issues persist"
        );
      }

      console.log(`📊 Health check result for ${email}: ${healthStatus.overall_status}`, {
        issues: healthStatus.issues.length,
        tests: healthStatus.tests
      });

      res.json(healthStatus);
    } catch (error) {
      console.error('❌ Connection health check error:', error);
      res.status(500).json({ 
        error: 'Health check failed',
        overall_status: "error",
        issues: ["Server error during health check"],
        recommendations: [
          "🔥 CONNECTIVITY ISSUE: Check firewall and antivirus settings",
          "Add aoi.exe to firewall exceptions",
          "Contact support for assistance"
        ]
      });
    }
  });

