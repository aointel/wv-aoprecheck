  // Get saved recruit profiles
  app.get("/api/recruit-profiles", async (req, res) => {
    try {
      const { email } = req.query;

      if (email) {
        // Get specific profile
        const profile = await db
          .select()
          .from(schema.recruitCandidates)
          .where(eq(schema.recruitCandidates.email, email as string));

        return res.json({
          success: true,
          profile: profile[0] || null,
          found: profile.length > 0
        });
      } else {
        // Get all profiles
        const profiles = await db
          .select()
          .from(schema.recruitCandidates)
          .orderBy(desc(schema.recruitCandidates.createdAt));

        return res.json({
          success: true,
          profiles: profiles,
          count: profiles.length
        });
      }
    } catch (error) {
      console.error('❌ Get recruit profiles error:', error);
      res.status(500).json({
        error: 'Failed to get recruit profiles',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

