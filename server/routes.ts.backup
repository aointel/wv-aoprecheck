  // Whereby API - Create Real Meeting Rooms
  app.post("/api/whereby/create-meeting", async (req, res) => {
    try {
      console.log('🎥 Creating Whereby meeting room...');
      
      const { endDate, fields } = req.body;
      
      // Get Whereby API key from config
      const { WHEREBY_API_KEY } = await import('./hardcoded-config');
      
      if (!WHEREBY_API_KEY) {
        console.error('❌ WHEREBY_API_KEY not configured');
        return res.status(500).json({ 
          success: false, 
          error: 'Whereby API key not configured' 
        });
      }
      
      // Create meeting via Whereby API
      const wherebyResponse = await fetch('https://api.whereby.dev/v1/meetings', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${WHEREBY_API_KEY}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          endDate: endDate || new Date(Date.now() + 2 * 60 * 60 * 1000).toISOString(), // 2 hours default
          fields: fields || ['hostRoomUrl']
        })
      });
      
      if (!wherebyResponse.ok) {
        const errorText = await wherebyResponse.text();
        console.error('❌ Whereby API error:', wherebyResponse.status, errorText);
        return res.status(500).json({ 
          success: false, 
          error: 'Failed to create Whereby meeting',
          details: errorText
        });
      }
      
      const meetingData = await wherebyResponse.json();
      console.log('✅ Whereby meeting created:', meetingData.roomUrl);
      
      res.json({
        success: true,
        roomUrl: meetingData.roomUrl,
        hostRoomUrl: meetingData.hostRoomUrl,
        meetingId: meetingData.meetingId
      });
      
    } catch (error) {
      console.error('❌ Whereby creation error:', error);
      res.status(500).json({ 
        success: false, 
        error: 'Failed to create Whereby meeting',
        details: error.message
      });
    }
  });

