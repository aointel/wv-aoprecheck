// Credit adjustment webhook endpoint
export function setupCreditAdjustmentWebhook(app: Express) {
  console.log('💳 Setting up credit adjustment webhook endpoint...');
  // Webhook to apply credits based on associate_id
  app.post('/api/webhook/credit-adjustment', express.json(), async (req, res) => {
    try {
      console.log('💳 Credit adjustment webhook received:', req.body);
      
      const { associate_id, credits_amount } = req.body;
      
      if (!associate_id || credits_amount === undefined) {
        return res.status(400).json({
          success: false,
          error: 'Missing required fields: associate_id and credits_amount'
        });
      }

      // Convert credits_amount to number to prevent string concatenation bug
      const creditsAmountNumber = Number(credits_amount);
      if (isNaN(creditsAmountNumber)) {
        return res.status(400).json({
          success: false,
          error: 'credits_amount must be a valid number'
        });
      }

      // Step 1: Look up company_email from customers table using associate_id
      const { data: customerData, error: customerError } = await supabaseAdmin
        .from('customers')
        .select('company_email')
        .eq('associate_id', associate_id)
        .single();

      if (customerError || !customerData) {
        console.error('❌ Failed to find customer with associate_id:', associate_id, customerError);
        return res.status(404).json({
          success: false,
          error: `No customer found with associate_id: ${associate_id}`
        });
      }

      const companyEmail = customerData.company_email;
      console.log(`📧 Found company email: ${companyEmail} for associate_id: ${associate_id}`);

      // Step 2: Apply credit adjustment to user_credits table
      const { data: currentCredits, error: fetchError } = await supabaseAdmin
        .from('user_credits')
        .select('aoi_connect_credits_used, credits_used')
        .eq('email', companyEmail)
        .single();

      if (fetchError || !currentCredits) {
        console.error('❌ Failed to find user_credits for email:', companyEmail, fetchError);
        return res.status(404).json({
          success: false,
          error: `No user_credits record found for email: ${companyEmail}`
        });
      }

      // Calculate new credit values (positive creditsAmountNumber INCREASES used credits)
      const newAoiConnectCreditsUsed = currentCredits.aoi_connect_credits_used + creditsAmountNumber;
      const newCreditsUsed = currentCredits.credits_used + creditsAmountNumber;

      // Step 3: Update the user_credits table
      const { data: updateData, error: updateError } = await supabaseAdmin
        .from('user_credits')
        .update({
          aoi_connect_credits_used: newAoiConnectCreditsUsed,
          credits_used: newCreditsUsed,
          updated_at: new Date().toISOString()
        })
        .eq('email', companyEmail)
        .select()
        .single();

      if (updateError) {
        console.error('❌ Failed to update user_credits:', updateError);
        return res.status(500).json({
          success: false,
          error: 'Failed to update user credits'
        });
      }

      console.log(`✅ Credit adjustment successful:
        Associate ID: ${associate_id}
        Email: ${companyEmail}
        Credits Applied: ${creditsAmountNumber}
        Previous AOI Connect Credits Used: ${currentCredits.aoi_connect_credits_used}
        New AOI Connect Credits Used: ${newAoiConnectCreditsUsed}
        Previous Total Credits Used: ${currentCredits.credits_used}
        New Total Credits Used: ${newCreditsUsed}`);

      res.json({
        success: true,
        message: 'Credit adjustment applied successfully',
        data: {
          associate_id,
          company_email: companyEmail,
          credits_applied: creditsAmountNumber,
          previous_aoi_connect_credits_used: currentCredits.aoi_connect_credits_used,
          new_aoi_connect_credits_used: newAoiConnectCreditsUsed,
          previous_credits_used: currentCredits.credits_used,
          new_credits_used: newCreditsUsed
        }
      });

    } catch (error) {
      console.error('❌ Credit adjustment webhook error:', error);
      res.status(500).json({
        success: false,
        error: 'Internal server error during credit adjustment'
      });
    }
  });
  
  // FORCE SYNC ENDPOINT - Clear all calls and reprocess everything
  app.post('/api/twilio/force-sync', async (req, res) => {
    try {
      console.log('🚀 FORCE SYNC: Starting complete call resync...');
      
      // Import the modules we need
      const { TwilioCallLogger } = await import('./twilio-call-logger.js');
      const { TwilioAutoSync } = await import('./twilio-auto-sync.js');
      
      // Step 1: Clear all existing call records
      console.log('🗑️ Step 1: Clearing all existing call records...');
      const cleared = await TwilioCallLogger.clearAllCalls();
      if (!cleared) {
        return res.status(500).json({ error: 'Failed to clear existing call records' });
      }
      
      // Step 2: Force a manual sync of all calls
      console.log('🔄 Step 2: Running complete Twilio sync...');
      const syncSuccess = await TwilioAutoSync.performSync();
      
      if (syncSuccess) {
        res.json({ 
          success: true, 
          message: 'Force sync completed successfully. All calls reprocessed with masterlead attribution.' 
        });
      } else {
        res.status(500).json({ error: 'Sync failed during processing' });
      }
      
    } catch (error) {
      console.error('❌ Force sync error:', error);
      res.status(500).json({ error: 'Failed to force sync' });
    }
  });

  // MASTERLEAD SAMPLE ENDPOINT - Check what's in the table
  app.get('/api/supabase/masterlead/sample', async (req, res) => {
    try {
      console.log('🔍 Sampling masterlead table...');
      
      const { data: leads, error } = await supabase
        .from('masterlead')
        .select('id, phone, cn_email, first_name, last_name')
        .limit(10);
      
      if (error) {
        return res.status(500).json({ error: error.message });
      }
      
      console.log('📋 Sample masterlead records:', leads);
      res.json({
        success: true,
        count: leads?.length || 0,
        sample: leads
      });
      
    } catch (error) {
      console.error('❌ Masterlead sample error:', error);
      res.status(500).json({ error: 'Failed to fetch masterlead sample' });
    }
  });

  // MIGRATE SUPABASE CALL DATA TO POSTGRESQL - Data reconciliation
  app.post('/api/migrate/supabase-to-postgresql', async (req, res) => {
    try {
      console.log('🔄 MIGRATION: Starting Supabase -> PostgreSQL data migration...');
      
      if (!supabase) {
        return res.status(500).json({ error: 'Supabase not available' });
      }

      // Get all Supabase call logs
      let allCalls = [];
      let from = 0;
      const batchSize = 1000;
      
      while (true) {
        const { data: batch, error } = await supabase
          .from('twilio_call_logs')
          .select('*')
          .range(from, from + batchSize - 1)
          .order('created_at', { ascending: true });
        
        if (error) {
          console.error('❌ Failed to fetch Supabase calls:', error);
          break;
        }
        
        if (!batch || batch.length === 0) {
          break;
        }
        
        allCalls = allCalls.concat(batch);
        from += batchSize;
        
        console.log(`📊 Fetched ${allCalls.length} calls from Supabase...`);
        
        if (batch.length < batchSize) {
          break; // No more data
        }
      }
      
      console.log(`📊 Total Supabase calls to migrate: ${allCalls.length}`);
      
      let migratedCount = 0;
      let skippedCount = 0;
      let errorCount = 0;
      
      // Process in batches
      const processedSids = new Set();
      
      for (const call of allCalls) {
        try {
          // Skip duplicates
          if (processedSids.has(call.twilio_call_sid)) {
            skippedCount++;
            continue;
          }
          processedSids.add(call.twilio_call_sid);
          
          // Check if already exists in PostgreSQL
          const existing = await db
            .select()
            .from(callLogs)
            .where(eq(callLogs.twilioCallSid, call.twilio_call_sid))
            .limit(1);
          
          if (existing.length > 0) {
            skippedCount++;
            continue;
          }
          
          // Calculate reach/book status
          const duration = call.call_duration || 0;
          const isReached = duration > 30;
          const isBooked = duration > 120;
          
          // Insert into PostgreSQL
          await db.insert(callLogs).values({
            twilioCallSid: call.twilio_call_sid,
            agentEmail: call.owner_email || 'unknown@aoglobelife.com',
            toNumber: call.to_number,
            fromNumber: call.from_number,
            callStatus: call.call_status,
            callDuration: duration,
            callStartedAt: new Date(call.call_started_at || call.created_at),
            callEndedAt: call.call_ended_at ? new Date(call.call_ended_at) : null,
            isReached,
            isBooked
          });
          
          migratedCount++;
          
          if (migratedCount % 100 === 0) {
            console.log(`📊 Migrated ${migratedCount} calls...`);
          }
          
        } catch (error) {
          console.error(`❌ Failed to migrate call ${call.twilio_call_sid}:`, error);
          errorCount++;
        }
      }
      
      console.log(`✅ MIGRATION COMPLETE: ${migratedCount} migrated, ${skippedCount} skipped, ${errorCount} errors`);
      
      res.json({
        success: true,
        totalSupabaseCalls: allCalls.length,
        migratedCount,
        skippedCount,
        errorCount,
        message: `Successfully migrated ${migratedCount} calls from Supabase to PostgreSQL`
      });
      
    } catch (error) {
      console.error('❌ Migration failed:', error);
      res.status(500).json({ 
        error: 'Migration failed', 
        details: error.message 
      });
    }
  });

  // Real-time leaderboard endpoint
  app.get('/api/leaderboard', async (req, res) => {
    try {
      console.log('📊 Fetching real-time leaderboard data from masterlead...');
      
      // Get today's date range
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      
      // Get real leaderboard data from masterlead table (same as Live Call Board)
      let leaderboardData: any[] = [];
      
      try {
        if (supabaseAdmin) {
          const { data: agents } = await supabaseAdmin
            .from('masterlead')
            .select('cn_email')
            .gte('last_contacted', today.toISOString())
            .not('cn_email', 'is', null);
          
          // Get unique agent emails
          const uniqueAgents = [...new Set(agents?.map(a => a.cn_email) || [])];
          
          // Get stats for each agent
          for (const email of uniqueAgents) {
            const { data: agentLeads } = await supabaseAdmin
              .from('masterlead')
              .select('cnresolution, last_contacted, first_name, last_name')
              .eq('cn_email', email)
              .gte('last_contacted', today.toISOString());
            
            if (agentLeads && agentLeads.length > 0) {
              const dialed = agentLeads.length;
              const reached = agentLeads.filter(l => 
                l.cnresolution && 
                l.cnresolution !== 'pending' && 
                l.cnresolution !== 'called' && 
                l.cnresolution !== 'wrong number'
              ).length;
              const booked = agentLeads.filter(l => l.cnresolution === 'booked').length;
              
              // Get presentations from presentation_sessions table
              let presentations = 0;
              try {
                const { data: presData } = await supabaseAdmin
                  .from('presentation_sessions')
                  .select('id')
                  .eq('agent_email', email)
                  .gte('start_time', today.toISOString());
                presentations = presData?.length || 0;
              } catch (presError) {
                console.log(`⚠️ Could not fetch presentations for ${email}:`, presError);
              }
              
              // Get sales from sales or production tracking table (adjust table name as needed)
              let sales = 0;
              try {
                const { data: salesData } = await supabaseAdmin
                  .from('production')
                  .select('id')
                  .eq('agent_email', email)
                  .gte('sale_date', today.toISOString());
                sales = salesData?.length || 0;
              } catch (salesError) {
                console.log(`⚠️ Could not fetch sales for ${email}:`, salesError);
              }
              
              // Get agent name from producers table
              let agentName = email.split('@')[0];
              try {
                const { data: producer } = await supabaseAdmin
                  .from('producers')
                  .select('agent_name')
                  .eq('email', email)
                  .single();
                
                if (producer?.agent_name) {
                  agentName = producer.agent_name;
                }
              } catch (producerError) {
                // Fallback to email username if producer not found
              }
              
              leaderboardData.push({
                agentName,
                email,
                dials: dialed,
                reaches: reached,
                bookings: booked,
                presentations: presentations,
                sales: sales
              });
            }
          }
        }
      } catch (dbError) {
        console.log('⚠️ Database query failed, using fallback data:', dbError);
        leaderboardData = [];
      }

      // NEW POINT SYSTEM:
      // 1 dial = 1 point
      // 1 reach = 25 points (takes 25 dials to reach someone)
      // 1 booked = 50 points (takes 2 reaches to book)
      // 1 presentation = 200 points (takes 4 booked to present)
      // 1 sale = 800 points (takes 4 presentations to sell)
      
      // Sort by total points
      leaderboardData.sort((a, b) => {
        const aPoints = (a.dials || 0) * 1 + (a.reaches || 0) * 25 + (a.bookings || 0) * 50 + (a.presentations || 0) * 200 + (a.sales || 0) * 800;
        const bPoints = (b.dials || 0) * 1 + (b.reaches || 0) * 25 + (b.bookings || 0) * 50 + (b.presentations || 0) * 200 + (b.sales || 0) * 800;
        return bPoints - aPoints;
      });

      // Calculate rates and rankings
      const leaderboard = leaderboardData.map((agent, index) => ({
        rank: index + 1,
        agentName: agent?.agentName || 'Unknown Agent',
        email: agent?.email || '',
        dials: Number(agent?.dials) || 0,
        reaches: Number(agent?.reaches) || 0,
        bookings: Number(agent?.bookings) || 0,
        presentations: Number(agent?.presentations) || 0,
        sales: Number(agent?.sales) || 0,
        points: (Number(agent?.dials || 0) * 1) + (Number(agent?.reaches || 0) * 25) + (Number(agent?.bookings || 0) * 50) + (Number(agent?.presentations || 0) * 200) + (Number(agent?.sales || 0) * 800),
        reachRate: (agent?.dials && Number(agent.dials) > 0) ? ((Number(agent.reaches || 0) / Number(agent.dials)) * 100) : 0,
        bookingRate: (agent?.reaches && Number(agent.reaches) > 0) ? ((Number(agent.bookings || 0) / Number(agent.reaches)) * 100) : 0,
        avgDuration: 0 // Would need call duration data from call logs
      }));
      
      console.log(`✅ Generated real leaderboard with ${leaderboard.length} agents from masterlead`);
      
      // Always return success with leaderboard data (even if empty)
      res.json({
        success: true,
        leaderboard: leaderboard,
        lastUpdated: new Date().toISOString()
      });
      
    } catch (error) {
      console.error('❌ Error fetching leaderboard:', error);
      
      // Return fallback data instead of 500 error to prevent UI breakage
      res.json({
        success: true,
        leaderboard: [],
        lastUpdated: new Date().toISOString(),
        error: 'Leaderboard temporarily unavailable'
      });
    }
  });

  // TEAM MANAGEMENT API ENDPOINTS

  // Get hierarchy data from Supabase customers table for team assignments
  app.get('/api/admin/hierarchy-data', async (req, res) => {
    try {
      console.log('🏢 Fetching hierarchy data from Supabase customers table...');
      
      const { data: customers, error } = await supabaseAdmin
        .from('customers')
        .select('associate_id, first_name, last_name, company_email, mga, rga, agent_name')
        .not('associate_id', 'is', null)
        .order('associate_id');

      if (error) {
        console.error('❌ Error fetching hierarchy data:', error);
        return res.status(500).json({ error: 'Failed to fetch hierarchy data' });
      }

      // Process and organize the hierarchy data
      const hierarchyData = {
        rgaTeams: [...new Set(customers.map(c => c.rga).filter(Boolean))].sort(),
        mgaTeams: [...new Set(customers.map(c => c.mga).filter(Boolean))].sort(),
        totalCustomers: customers.length,
        customersByRGA: {},
        customersByMGA: {},
        allCustomers: customers
      };

      // Group customers by RGA
      hierarchyData.rgaTeams.forEach(rga => {
        hierarchyData.customersByRGA[rga] = customers.filter(c => c.rga === rga);
      });

      // Group customers by MGA  
      hierarchyData.mgaTeams.forEach(mga => {
        hierarchyData.customersByMGA[mga] = customers.filter(c => c.mga === mga);
      });

      console.log(`✅ Hierarchy data loaded: ${hierarchyData.rgaTeams.length} RGA teams, ${hierarchyData.mgaTeams.length} MGA teams, ${customers.length} total customers`);
      
      res.json({
        success: true,
        data: hierarchyData
      });

    } catch (error) {
