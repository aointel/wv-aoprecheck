  // Connections for review endpoint - mandatory workflow blocking
  app.get("/api/war/connects-for-review", async (req, res) => {
    try {
      const { agentEmail } = req.query;
      
      if (!agentEmail) {
        return res.status(400).json({ error: 'agentEmail is required' });
      }
      
      // Query connections that need review - includes AO Intelligence calls, pending connections, and Call Connector Pro appointments
      const connects = await db
        .select()
        .from(warConnects)
        .where(
          and(
            eq(warConnects.agentEmail, agentEmail as string),
            or(
              eq(warConnects.reviewStatus, 'pending'),
              isNull(warConnects.reviewStatus)
            )
          )
        )
        .orderBy(warConnects.connectDate);
      
      res.json(connects);
    } catch (error) {
      console.error('❌ Error fetching connections for review:', error);
      res.status(500).json({ error: 'Failed to fetch connections for review' });
    }
  });

  // Check if agent has pending connections requiring review (mandatory blocking)
  app.get("/api/connections/check-blocking", async (req, res) => {
    try {
      const { agentEmail } = req.query;
      
      if (!agentEmail) {
        return res.status(400).json({ error: 'agentEmail is required' });
      }
      
      // Count pending connections that require review
      const pendingConnections = await db
        .select({ count: sql`count(*)::integer` })
        .from(warConnects)
        .where(
          and(
            eq(warConnects.agentEmail, agentEmail as string),
            or(
              eq(warConnects.reviewStatus, 'pending'),
              isNull(warConnects.reviewStatus)
            )
          )
        );
      
      const count = pendingConnections[0]?.count || 0;
      
      res.json({
        hasPendingConnections: count > 0,
        pendingCount: count,
        mustReviewConnections: count > 0
      });
    } catch (error) {
      console.error('❌ Error checking connection blocking status:', error);
      res.status(500).json({ error: 'Failed to check connection blocking status' });
    }
  });

  // Update connect review result from card deck
  app.post("/api/war/connect-review", async (req, res) => {
    try {
      const { connectId, result, saleAmount, nextReviewDate, connectType, productionStatus } = req.body;
      
      if (!connectId || !result) {
        return res.status(400).json({ error: 'connectId and result are required' });
      }
      
      const updateData: any = {
        reviewStatus: 'reviewed',
        reviewedAt: new Date(),
      };
      
      // Set lead lifecycle tracking fields from frontend
      if (connectType) {
        updateData.connectType = connectType;
      }
      if (productionStatus) {
        updateData.productionStatus = productionStatus;
      }
      if (nextReviewDate) {
        updateData.nextReviewDate = new Date(nextReviewDate);
      }
      
      // Set disposition based on result
      if (result === 'sale') {
        updateData.disposition = 'Sale';
        updateData.productionStatus = 'completed';
        if (saleAmount) {
          updateData.saleAmount = parseFloat(saleAmount);
        }
      } else if (result === 'interested') {
        updateData.disposition = 'Appointment';
        // Use frontend-provided connectType/productionStatus or defaults
        if (!connectType) updateData.connectType = 'aoi_appointment';
        if (!productionStatus) updateData.productionStatus = 'confirmed';
      } else if (result === 'not_interested') {
        updateData.disposition = 'Not interested';
        updateData.productionStatus = 'cancelled';
      } else if (result === 'no_show') {
        updateData.disposition = 'No Show';
        updateData.productionStatus = 'no_show';
      } else if (result === 'reschedule') {
        updateData.disposition = 'Rescheduled';
        updateData.connectType = 'aoi_appointment';
        updateData.productionStatus = 'confirmed';
        updateData.followUpRequired = true;
      } else if (result === 'pending') {
        updateData.disposition = 'Pending';
        updateData.reviewStatus = 'pending'; // Keep as pending for future review
        updateData.productionStatus = 'pending';
        updateData.followUpRequired = true;
        // Don't mark as reviewed since it's still pending
        delete updateData.reviewedAt;
      }
      
      // Update the connect
      const [updatedConnect] = await db
        .update(warConnects)
        .set(updateData)
        .where(eq(warConnects.connectId, connectId))
        .returning();
      
      if (!updatedConnect) {
        return res.status(404).json({ error: 'Connect not found' });
      }
      
      res.json(updatedConnect);
    } catch (error) {
      console.error('❌ Error updating connect review:', error);
      res.status(500).json({ error: 'Failed to update connect review' });
    }
  });

  // Create Chris's customer data for VDP routing
  app.post('/api/admin/create-chris-customer', async (req, res) => {
    try {
      console.log('🔧 Creating Chris Lafond customer data for VDP routing...');
      
      const { data: existingData, error: checkError } = await supabaseAdmin!
        .from('customers')
        .select('*')
