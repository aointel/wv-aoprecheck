// Initialize Twilio client using API Keys instead of Auth Token
let twilioClient: twilio.Twilio;
try {
  twilioClient = twilio(TWILIO_API_KEY, TWILIO_API_SECRET, { accountSid: TWILIO_ACCOUNT_SID });
  console.log('✅ Twilio client initialized with API Keys (no Auth Token required)');
} catch (error) {
