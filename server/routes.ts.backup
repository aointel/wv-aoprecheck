  // Twilio webhook for call status updates (Enhanced for call tracking)
  app.post('/api/twilio/call-status-tracker', async (req, res) => {
    try {
      const {
        CallSid,
        CallStatus,
        CallDuration,
        From,
        To,
        Direction,
        ParentCallSid,
        ConferenceSid
      } = req.body;

      console.log('📞 Twilio call status tracker:', { CallSid, CallStatus, From, To });

      // Update call status in database
      const updates: any = {
        callStatus: CallStatus.toLowerCase(),
      };

      if (CallStatus === 'answered') {
        updates.answerTime = new Date();
      } else if (CallStatus === 'completed') {
        updates.endTime = new Date();
        if (CallDuration) {
          updates.duration = parseInt(CallDuration);
        }
      }

      if (ConferenceSid) {
        updates.twilioConferenceSid = ConferenceSid;
      }

      await callTrackingService.updateCallStatus(CallSid, updates);

      res.status(200).send('OK');
    } catch (error) {
      console.error('❌ Call status tracker error:', error);
      res.status(500).send('Error');
    }
  });

