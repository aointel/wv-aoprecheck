  app.post("/api/outbound-dialer/initiate-call", async (req, res) => {
    try {
      const { lead, userEmail } = req.body;
      const phoneNumber = lead?.phone || lead?.phone_number;
      const leadName = lead?.name;
      
      console.log(`📞 Call Connector Pro initiating REAL Twilio call to ${phoneNumber} for lead ${leadName} (${lead?.state || 'Unknown state'})`);
      
      if (!phoneNumber) {
        return res.status(400).json({ error: 'Phone number is required' });
      }

      // Get local presence number for the lead's state
      console.log(`🔍 Lead data for local presence:`, { 
        name: leadName, 
        state: lead?.state, 
        phone: phoneNumber,
        fullLead: lead 
      });
      const localNumber = localPresenceService.getLocalNumber(lead?.state || 'TX');
      console.log(`📍 Using local presence number: ${localNumber} for ${lead?.state || 'Unknown'} lead`);

      // NOT NEEDED - Agent WebRTC device calls lead directly
      // This endpoint is only for logging, actual call happens via WebRTC device.connect()
      console.log('📞 Call initiated via WebRTC device.connect() - no server-side call needed');

      const callId = `ccp-call-${Date.now()}`;
      
      // Log the call in the database (non-blocking - don't crash if it fails)
      try {
        await connectnowService.logCall({
          userId: userEmail || 'demo@aoglobelife.com',
          callType: 'outbound',
          status: 'initiated',
          phoneNumber: phoneNumber,
        });
      } catch (logError) {
        console.warn('⚠️ Call logging failed (non-critical):', logError);
      }

      // Track outbound call for dial/reached/book reporting (non-blocking)
      try {
        await storage.trackOutboundCall({
          leadPhone: phoneNumber,
          leadName: leadName || 'Unknown Lead',
          leadState: lead?.state || 'Unknown',
          agentEmail: userEmail || 'demo@aoglobelife.com',
          agentName: userEmail ? userEmail.split('@')[0] : 'Demo Agent',
          callStatus: 'initiated',
          callDisposition: null,
          callDuration: 0,
          notes: `Call initiated via Call Connector Pro to ${phoneNumber}`
        });
      } catch (trackError) {
        console.warn('⚠️ Call tracking failed (non-critical):', trackError);
      }

      // ALSO log to war_connects table for daily stats tracking
      try {
        await warService.logConnect({
          connectId: callId,
          agentEmail: userEmail || 'demo@aoglobelife.com',
          leadName: leadName || 'Unknown Lead',
          leadPhone: phoneNumber,
          connectDate: new Date(),
          connectTime: new Date().toLocaleTimeString(),
          duration: 0,
          leadSource: 'outbound_dialer',
          market: lead?.market || 'Unknown',
          state: lead?.state || 'Unknown',
          connectType: 'outbound_call',
          immediateOutcome: 'initiated',
          productionStatus: 'pending'
        });
        console.log('✅ Call logged to war_connects for stats tracking');
      } catch (warError) {
        console.warn('⚠️ Failed to log to war_connects (non-blocking):', warError);
      }

      // Start 50-second watchdog timer for ALL Call Connector Pro calls
      const leadId = lead?.id?.toString() || `lead-${phoneNumber}`;
      const associateId = userEmail || 'demo@aoglobelife.com';
      callWatchdog.startTimer(callId, leadId, associateId);
      console.log(`⏱️ Started 50-second watchdog timer for call ${callId} (lead: ${leadId}, associate: ${associateId})`);
      
      // Log extra info for hotleads
      if (lead?.isHotLead === true || lead?.leadType === 'hotlead' || lead?.source_table === 'hotleads') {
        console.log(`🔥 This is a HOTLEAD call - watchdog will fire at 50s if still active`);
      }
      
      res.json({ 
        success: true,
        id: callId,
        leadId: lead?.id,
        leadName: leadName,
        phoneNumber: phoneNumber,
        localNumber: localNumber,
        leadState: lead?.state || 'Unknown',
        status: 'direct_call_ready',
        timestamp: new Date().toISOString(),
        message: 'Use WebRTC device.connect() to call lead directly'
      });
    } catch (error) {
      console.error('❌ Call Connector Pro call initiation error:', error);
      res.status(500).json({ error: 'Failed to initiate call: ' + (error instanceof Error ? error.message : String(error)) });
    }
  });

  app.post("/api/outbound-dialer/end-call", async (req, res) => {
    try {
      const { callId, leadPhone, disposition, duration, agentEmail } = req.body;
      console.log(`📴 Call Connector Pro ending call ${callId} - Duration: ${duration}s, Disposition: ${disposition}`);
      
      // Update call status in outbound calls tracking
      if (leadPhone && agentEmail) {
        await storage.updateOutboundCallStatus({
          leadPhone,
          agentEmail,
          callStatus: 'completed',
          callDisposition: disposition || 'no-answer',
          callDuration: duration || 0,
          endTime: new Date()
        });

        // ALSO update war_connects for stats tracking
        try {
          await warService.updateDisposition(callId, {
            disposition: disposition || 'no-answer',
            duration: duration || 0,
            notes: `Call completed via Call Connector Pro - Duration: ${duration}s`
          });
          console.log('✅ Call disposition updated in war_connects');
        } catch (warError) {
          console.warn('⚠️ Failed to update war_connects disposition (non-blocking):', warError);
        }
        
        console.log(`✅ Updated call tracking: ${leadPhone} -> ${disposition || 'no-answer'} (${duration || 0}s)`);
      }

      // End the 50-second watchdog timer since call ended (if it was running)
      callWatchdog.endTimer(callId);
      console.log(`⏱️ Ended watchdog timer for call ${callId}`);
      
      res.json({ 
        success: true,
        callId,
        status: 'ended',
        disposition: disposition || 'no-answer',
        duration: duration || 0,
        timestamp: new Date().toISOString()
      });
    } catch (error) {
      console.error('❌ Call Connector Pro call end error:', error);
      res.status(500).json({ error: 'Failed to end call' });
    }
  });

  // Generate test WAR connects for testing
  app.post("/api/war/generate-test-connects", async (req, res) => {
    try {
      const { count = 20, agentEmail } = req.body;
      
      if (!agentEmail) {
        return res.status(400).json({ error: 'agentEmail is required' });
      }
      console.log(`🧪 Generating ${count} test WAR connects for ${agentEmail}`);
      
      const testConnects = [];
      const leadNames = [
        'John Smith', 'Sarah Johnson', 'Michael Brown', 'Lisa Davis', 'David Wilson',
        'Jennifer Garcia', 'Robert Martinez', 'Mary Rodriguez', 'William Lopez', 'Patricia Gonzalez',
        'James Anderson', 'Linda Taylor', 'Christopher Thomas', 'Barbara Jackson', 'Daniel White',
        'Susan Harris', 'Matthew Martin', 'Karen Thompson', 'Anthony Garcia', 'Nancy Martinez'
      ];
      
      const states = ['TX', 'CA', 'FL', 'NY', 'PA', 'IL', 'OH', 'GA', 'NC', 'MI'];
      const connectTypes = ['outbound_call', 'aoi_appointment', 'callback_scheduled'];
      const statuses = ['pending', 'confirmed', 'completed'];
      
      for (let i = 0; i < count; i++) {
        const connectId = `TEST${Date.now()}${i}`;
        const leadName = leadNames[i % leadNames.length];
        const phone = `555${String(Math.floor(Math.random() * 9000) + 1000)}`;
        const duration = Math.floor(Math.random() * 300) + 30; // 30-330 seconds
        const connectDate = new Date(Date.now() - Math.floor(Math.random() * 7 * 24 * 60 * 60 * 1000)); // Random date within last week
        
        const testConnect = {
          connectId,
          agentEmail,
          leadName,
          leadPhone: phone,
          connectDate,
          connectTime: connectDate.toLocaleTimeString(),
          duration,
          leadSource: 'test_data',
          market: 'Test Market',
          state: states[Math.floor(Math.random() * states.length)],
          connectType: connectTypes[Math.floor(Math.random() * connectTypes.length)],
          immediateOutcome: 'reached',
          productionStatus: statuses[Math.floor(Math.random() * statuses.length)],
          nextReviewDate: null,
          saleAmount: null,
          notes: `Test connect ${i + 1} for WAR card testing`
        };
        
        try {
          await warService.logConnect(testConnect);
          testConnects.push(testConnect);
          console.log(`✅ Created test connect ${i + 1}/${count}: ${leadName}`);
        } catch (error) {
          console.error(`❌ Failed to create test connect ${i + 1}:`, error);
        }
      }
      
      console.log(`🎉 Successfully generated ${testConnects.length} test WAR connects`);
      res.json({ 
        success: true, 
        generated: testConnects.length,
        connects: testConnects
      });
    } catch (error) {
      console.error('❌ Failed to generate test connects:', error);
      res.status(500).json({ error: 'Failed to generate test connects' });
    }
  });

  // Update call status (answered, completed, etc.)
  app.post("/api/outbound-dialer/update-call-status", async (req, res) => {
    try {
      const { leadPhone, agentEmail, status, disposition, duration } = req.body;
      
      console.log(`📊 Updating call status: ${leadPhone} -> ${status} (${disposition || 'none'})`);
      
      await storage.updateOutboundCallStatus({
        leadPhone,
        agentEmail,
        callStatus: status,
        callDisposition: disposition,
        callDuration: duration,
        ...(status === 'in-progress' && { answerTime: new Date() }),
        ...(status === 'completed' && { endTime: new Date() })
      });
      
      // Trigger hotlead assignment webhook when call is completed
      if (status === 'completed' && agentEmail) {
        console.log(`🔥 CALL COMPLETED: Checking if ${agentEmail} needs hotlead assignment`);
        
        // Get agent's total call count from daily stats
        try {
          const { data: callHistory } = await supabase
            .from('twilio_call_logs')
            .select('*', { count: 'exact' })
            .ilike('from_phone', `%${agentEmail}%`) // Match by agent email in metadata or use phone lookup
            .eq('call_status', 'completed');
          
          if (callHistory) {
            const totalCalls = callHistory.length;
            console.log(`📊 Agent ${agentEmail} has ${totalCalls} completed calls`);
            
            // Check for hotlead eligibility (trigger webhook if needed)
            await checkAgentForHotleadAssignment(agentEmail, totalCalls);
          }
        } catch (webhookError) {
          console.error('❌ Hotlead webhook trigger error:', webhookError);
        }
      }
      
      res.json({
        success: true,
        leadPhone,
        status,
        disposition,
        timestamp: new Date().toISOString()
      });
      
    } catch (error) {
      console.error('❌ Update call status error:', error);
      res.status(500).json({
        success: false,
        error: 'Failed to update call status',
        details: error instanceof Error ? error.message : String(error)
      });
    }
  });

  // Server time endpoint to check what time the server thinks it is
  app.get("/api/server-time", (req, res) => {
    try {
      const now = new Date();
      const serverTime = {
        utc: now.toISOString(),
        local: now.toString(),
        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
        timestamp: now.getTime(),
        formatted: {
          date: now.toDateString(),
          time: now.toTimeString(),
          locale: now.toLocaleString()
        }
      };
      
      console.log('🕒 Server time check:', serverTime);
      res.json(serverTime);
    } catch (error) {
      console.error('❌ Server time check error:', error);
      res.status(500).json({ error: 'Failed to get server time' });
    }
  });

  // Enhanced Call Connector Pro stats endpoint with trends and accountability data
  app.get("/api/outbound-dialer/daily-stats", async (req, res) => {
    try {
      const userEmail = req.query.userEmail as string || 'cnsysop@aoglobelife.com';
      console.log(`📊 Fetching Enhanced Call Connector Pro stats for: ${userEmail}`);
      
      console.log(`📊 Using SUPABASE twilio_call_logs for Enhanced Call Connector Pro stats for ${userEmail}...`);
      
      // Get TODAY and YESTERDAY in Eastern Time
      const now = new Date();
      const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const yesterdayStart = new Date(todayStart.getTime() - 24 * 60 * 60 * 1000);
      
      console.log(`🕒 Today start: ${todayStart.toISOString()}, Yesterday start: ${yesterdayStart.toISOString()}`);
      
      // Query Supabase twilio_call_logs for REAL call data - NO PAGINATION LIMITS
      const { data: allCalls, error: callError } = await supabase
        .from('twilio_call_logs')
        .select('call_status, created_at, call_duration, owner_email, call_started_at')
        .eq('owner_email', userEmail)
        .order('created_at', { ascending: false })
        .limit(10000);
      
      if (callError) {
        console.error('❌ Supabase call logs error:', callError);
        return res.status(500).json({ error: 'Failed to fetch call data' });
      }
      
      console.log(`📞 Found ${allCalls?.length || 0} total calls for ${userEmail} in Supabase`);
      console.log(`🔍 DEBUG Sample calls:`, allCalls?.slice(0, 3));
      
      // Filter calls by actual dates - TODAY and YESTERDAY
      const todayCalls = (allCalls || []).filter(call => {
        const callDate = new Date(call.created_at);
        return callDate >= todayStart;
      });
      
      const yesterdaCalls = (allCalls || []).filter(call => {
        const callDate = new Date(call.created_at);
        return callDate >= yesterdayStart && callDate < todayStart;
      });
      
      // Debug booking logic
      const longCalls = todayCalls.filter(call => call.call_duration && parseInt(call.call_duration) > 120);
      console.log(`📞 BOOKING DEBUG: Found ${longCalls.length} calls over 2 minutes:`, longCalls.slice(0, 3));
      
      // Get presentations, sales, and Plus leads using AGENT'S LOCAL TIMEZONE
      const accountabilityQuery = `
        SELECT 
          SUM(CASE WHEN accountability_date = DATE(NOW() AT TIME ZONE 'America/New_York') THEN total_appointments ELSE 0 END) as today_presentations,
          SUM(CASE WHEN accountability_date = DATE(NOW() AT TIME ZONE 'America/New_York') - INTERVAL '1 day' THEN total_appointments ELSE 0 END) as yesterday_presentations,
          SUM(CASE WHEN accountability_date = DATE(NOW() AT TIME ZONE 'America/New_York') THEN total_sales ELSE 0 END) as today_sales,
          SUM(CASE WHEN accountability_date = DATE(NOW() AT TIME ZONE 'America/New_York') - INTERVAL '1 day' THEN total_sales ELSE 0 END) as yesterday_sales,
          SUM(CASE WHEN accountability_date = DATE(NOW() AT TIME ZONE 'America/New_York') THEN plus_leads_collected ELSE 0 END) as today_plus_leads,
          SUM(CASE WHEN accountability_date = DATE(NOW() AT TIME ZONE 'America/New_York') - INTERVAL '1 day' THEN plus_leads_collected ELSE 0 END) as yesterday_plus_leads
        FROM daily_accountability 
        WHERE agent_email = '${userEmail}'
      `;
      
      // Get accountability data from PostgreSQL (still needed)
      const accountabilityResult = await db.execute(sql.raw(accountabilityQuery));
      const accountabilityData = accountabilityResult.rows[0] || {};
      
      console.log(`🔍 Today calls (${todayCalls.length}):`, todayCalls.slice(0, 2));
      console.log(`🔍 Yesterday calls (${yesterdaCalls.length}):`, yesterdaCalls.slice(0, 2));
      console.log(`🔍 Accountability data for ${userEmail}:`, accountabilityData);
      
      // Calculate TODAY'S statistics from August 26 data (which IS today)
      const todayDialed = todayCalls.length;
      const todayReached = todayCalls.filter(call => 
        (call.call_status === 'completed' || 
        call.call_status === 'answered' || 
        (call.call_duration && call.call_duration > 30)) &&
        // Exclude wrong number dispositions
        call.disposition !== 'wrong_number' &&
        call.disposition !== 'wrong number'
      ).length;
      const todayBooked = todayCalls.filter(call => 
        call.call_status === 'completed' && 
        call.call_duration && 
        parseInt(call.call_duration) > 120
      ).length;
      const todayPresentations = Number(accountabilityData.today_presentations || 0);
      const todaySales = Number(accountabilityData.today_sales || 0);
      // Calculate REAL-TIME plus lead calls by counting calls to non-hotlead leads
      // Only count calls that lasted 15 seconds or longer
      const realTimePlusLeads = todayCalls.filter(call => {
        // Count all calls that are not hotlead calls AND lasted 15+ seconds
        return call.lead_phone && call.lead_name && 
               (!call.disposition || call.disposition !== 'hotlead') &&
               call.call_duration && parseInt(call.call_duration) >= 15;
      }).length;
      
      const todayPlusLeads = realTimePlusLeads; // Use real-time counting
      
      // Calculate yesterday's statistics from REAL Supabase data for trends
      const yesterdayDialed = yesterdaCalls.length;
      const yesterdayReached = yesterdaCalls.filter(call => 
        (call.call_status === 'completed' || 
        call.call_status === 'answered' || 
        (call.call_duration && call.call_duration > 30)) &&
        // Exclude wrong number dispositions
        call.disposition !== 'wrong_number' &&
        call.disposition !== 'wrong number'
      ).length;
      const yesterdayBooked = yesterdaCalls.filter(call => 
        call.call_status === 'completed' && 
        call.call_duration && 
        call.call_duration > 60
      ).length;
      const yesterdayPresentations = Number(accountabilityData.yesterday_presentations || 0);
      const yesterdaySales = Number(accountabilityData.yesterday_sales || 0);
      const yesterdayPlusLeads = Number(accountabilityData.yesterday_plus_leads || 0);
      
      // Calculate trends (today vs yesterday) 
      const dialedTrend = todayDialed - yesterdayDialed;
      const reachedTrend = todayReached - yesterdayReached;
      const bookedTrend = todayBooked - yesterdayBooked;
      const presentationsTrend = todayPresentations - yesterdayPresentations;
      const salesTrend = todaySales - yesterdaySales;
      const plusLeadsTrend = todayPlusLeads - yesterdayPlusLeads;
      
      // Show TODAY'S activity from Supabase (August 26 IS today)
      const stats = {
        total_dialed: todayDialed, // TODAY'S calls from Supabase
        reached: todayReached, // TODAY'S reached calls from Supabase
        booked: todayBooked, // TODAY'S booked from Supabase
        presentations: todayPresentations, // TODAY'S presentations from accountability
        sales: todaySales, // TODAY'S sales from accountability
        plus_leads: todayPlusLeads, // TODAY'S Plus leads (referrals) from accountability
        trends: {
          dialed: dialedTrend, // Today vs Yesterday
          reached: reachedTrend,
          booked: bookedTrend,
          presentations: presentationsTrend,
          sales: salesTrend,
          plus_leads: plusLeadsTrend
        },
        current_week_dialed: todayDialed, // Show today's activity
        last_week_dialed: yesterdayDialed, // Yesterday's data for comparison
        current_week_reached: todayReached
      };
      
      console.log(`📊 Enhanced Call Connector Pro stats for ${userEmail}:`, stats);
      res.json(stats);
      
    } catch (error) {
      console.error('❌ Enhanced Call Connector Pro stats error:', error);
      res.status(500).json({ 
        total_dialed: 0, 
        reached: 0, 
        booked: 0,
        presentations: 0,
        sales: 0,
        plus_leads: 0,
        trends: { dialed: 0, reached: 0, booked: 0, presentations: 0, sales: 0, plus_leads: 0 },
        today_dialed: 0
      });
    }
  });

  // AOI Connect status endpoint - shows best month performance and qualification status
  app.get("/api/aoi-connect/status", async (req, res) => {
    try {
      const userEmail = req.query.userEmail as string || 'unknown@aoglobelife.com';
      // Reduced logging for cleaner console
      let associateId = null;
      
      if (supabaseAdmin) {
        try {
          const { data: customerData, error: customerError } = await supabaseAdmin
            .from('customers')
            .select('associate_id')
            .or(`company_email.eq.${userEmail.toLowerCase()},personal_email.eq.${userEmail.toLowerCase()}`)
            .not('associate_id', 'is', null)
            .single();

          if (customerData && !customerError) {
            associateId = customerData.associate_id?.toString();
          }
        } catch (error) {
          // Error querying customers table
        }
      }
      
      // Fallback to Supabase user_credits table if not found in customers
      if (!associateId && supabaseAdmin) {
        try {
          const { data: creditsData, error: creditsError } = await supabaseAdmin
            .from('user_credits')
            .select('associate_id')
            .eq('email', userEmail.toLowerCase())
            .not('associate_id', 'is', null)
            .single();

          if (creditsData && !creditsError) {
            associateId = creditsData.associate_id?.toString();
          }
        } catch (error) {
          // Error querying user_credits table
        }
      }
      
      // Fallback mapping for known users if not found in tables
      if (!associateId) {
        // DO NOT USE 999 - must have valid associate ID from logged in user
        associateId = null;
      }
      
      if (!associateId) {
        return res.json({
          associate_id: null,
          name: 'Unknown User',
          best_month_value: 0,
          best_month_name: 'No Data',
          march_performance: 0,
          april_performance: 0,
          may_performance: 0,
          qualified: false,
          progress_percentage: 0
        });
      }
      
      // Query july_contest_data directly with associate_id
      const aoiQuery = `
        SELECT 
          associate_id,
          name,
          march_performance,
          april_performance,
          may_performance,
          december_performance,
          january_performance,
          february_performance,
          GREATEST(
            COALESCE(december_performance, 0),
            COALESCE(january_performance, 0),
            COALESCE(february_performance, 0),
            COALESCE(march_performance, 0),
            COALESCE(april_performance, 0),
            COALESCE(may_performance, 0)
          ) as best_month_value,
          CASE 
            WHEN GREATEST(COALESCE(december_performance, 0), COALESCE(january_performance, 0), COALESCE(february_performance, 0), COALESCE(march_performance, 0), COALESCE(april_performance, 0), COALESCE(may_performance, 0)) = march_performance THEN 'March 2024'
            WHEN GREATEST(COALESCE(december_performance, 0), COALESCE(january_performance, 0), COALESCE(february_performance, 0), COALESCE(march_performance, 0), COALESCE(april_performance, 0), COALESCE(may_performance, 0)) = april_performance THEN 'April 2024'
            WHEN GREATEST(COALESCE(december_performance, 0), COALESCE(january_performance, 0), COALESCE(february_performance, 0), COALESCE(march_performance, 0), COALESCE(april_performance, 0), COALESCE(may_performance, 0)) = may_performance THEN 'May 2024'
            WHEN GREATEST(COALESCE(december_performance, 0), COALESCE(january_performance, 0), COALESCE(february_performance, 2), COALESCE(march_performance, 0), COALESCE(april_performance, 0), COALESCE(may_performance, 0)) = february_performance THEN 'February 2024'
            WHEN GREATEST(COALESCE(december_performance, 0), COALESCE(january_performance, 0), COALESCE(february_performance, 0), COALESCE(march_performance, 0), COALESCE(april_performance, 0), COALESCE(may_performance, 0)) = january_performance THEN 'January 2024'
            ELSE 'December 2023'
          END as best_month_name
        FROM july_contest_data
        WHERE associate_id = $1
        LIMIT 1
      `;
      
      const result = await db.execute(sql.raw(aoiQuery.replace('$1', `'${associateId}'`)));
      const aoiData = result.rows[0];
      
      if (!aoiData) {
        return res.json({
          associate_id: associateId,
          name: 'No Performance Data',
          best_month_value: 0,
          best_month_name: 'No Data',
          march_performance: 0,
          april_performance: 0,
          may_performance: 0,
          qualified: false,
          progress_percentage: 0
        });
      }
      
      const target = 6000;
      const bestMonthValue = Number(aoiData.best_month_value) || 0;
      const qualified = bestMonthValue >= target;
      const progressPercentage = Math.min((bestMonthValue / target) * 100, 100);
      
      const response = {
        associate_id: aoiData.associate_id,
        name: aoiData.name,
        best_month_value: bestMonthValue,
        best_month_name: aoiData.best_month_name,
        march_performance: Number(aoiData.march_performance) || 0,
        april_performance: Number(aoiData.april_performance) || 0,
        may_performance: Number(aoiData.may_performance) || 0,
        december_performance: Number(aoiData.december_performance) || 0,
        january_performance: Number(aoiData.january_performance) || 0,
        february_performance: Number(aoiData.february_performance) || 0,
        qualified,
        progress_percentage: Math.round(progressPercentage)
      };
      
      // Reduced logging for cleaner console
      res.json(response);
      
    } catch (error) {
      console.error('❌ AOI Connect status error:', error);
      res.status(500).json({ 
        error: 'Failed to fetch AOI Connect status',
        associate_id: null,
        name: 'Error',
        best_month_value: 0,
        best_month_name: 'Error',
        march_performance: 0,
        april_performance: 0,
        may_performance: 0,
        qualified: false,
        progress_percentage: 0
      });
    }
  });

  // AOI Reports endpoints for resolution tracking
  
  // Get AOI Reports statistics (USER-SPECIFIC FILTERING ONLY)
  app.get("/api/aoi-reports/stats", async (req, res) => {
    try {
      console.log('📊 AOI Reports: Getting resolution statistics using USER-SPECIFIC filtering...');
      
      // Get current user email from session or headers  
      const session = req.session as any;
      const userEmail = session?.user?.email || req.headers['user-email'] || req.headers['x-user-email'];
      
      if (!userEmail) {
        console.error('❌ No user email found for AOI Reports stats filtering');
        return res.status(401).json({ error: 'User not authenticated' });
      }
      
      console.log(`🔍 AOI Reports Stats: Filtering for logged-in user: ${userEmail}`);
      
      // Get user's associate ID for VDP calls filtering
      let userAssociateId = null;
      try {
        const { data: userCredits } = await supabaseAdmin
          .from('user_credits')
          .select('associate_id')
          .eq('email', userEmail)
          .single();
        userAssociateId = userCredits?.associate_id?.toString();
      } catch (error) {
        console.log('⚠️ Could not find associate ID for stats, using email filtering only');
      }
      
      // Get VDP calls for THIS USER ONLY
      const { data: vdpCalls, error: vdpError } = await supabaseAdmin
        .from('vdp_calls')
        .select('*')
        .eq('agent', userAssociateId || '999') // Use user's associate ID - agent field is lowercase in Supabase
        .or('duration.gte.240,duration.is.null') // Include calls >4 minutes OR any call (null duration)
        .order('id', { ascending: false })
        .limit(200);

      if (vdpError) {
        console.error('❌ Supabase error getting VDP calls for stats:', vdpError);
      }

      // Get masterlead calls for THIS USER ONLY that need AOI follow-up (booked, appointment_set, callback)
      const { data: masterleadCalls, error: masterleadError } = await supabaseAdmin
        .from('masterlead')
        .select('*')
        .eq('cn_email', userEmail) // Filter for specific user
        .in('cnresolution', ['booked', 'appointment_set', 'callback_requested']) // ONLY resolutions requiring follow-up
        .order('created_at', { ascending: false })
        .limit(1000);

      if (masterleadError) {
        console.error('❌ Supabase error getting masterlead calls for stats:', masterleadError);
      }

      // Calculate totals for THIS USER ONLY
      const vdpCount = vdpCalls?.length || 0;
      const masterleadCount = masterleadCalls?.length || 0;
      const totalPendingCalls = vdpCount + masterleadCount;
      
      const stats = {
        pending_reports: totalPendingCalls,
        total_calls: totalPendingCalls,
        resolved_calls: 0, // These are all unresolved by definition with our new filtering
        overdue_calls: totalPendingCalls // All are requiring follow-up
      };
      
      console.log(`📊 AOI Reports stats for ${userEmail}:`, stats);
      res.json(stats);
      
    } catch (error) {
      console.error('❌ AOI Reports stats error:', error);
      res.status(500).json({ 
        pending_reports: 0,
        total_calls: 0,
        resolved_calls: 0,
        overdue_calls: 0
      });
    }
  });

  // Check if user needs to be blocked due to too many pending AOI reports (NO CACHE)
  app.get("/api/aoi-reports/check-blocking/:email", async (req, res) => {
    // Disable caching for this critical endpoint
    res.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
    res.set('Pragma', 'no-cache');
    res.set('Expires', '0');
    try {
      const userEmail = req.params.email;
      const BLOCKING_THRESHOLD = -8; // Allow negative balance before blocking (grace period)
      
      console.log(`🚨 AOI Reports: Checking blocking status for ${userEmail}...`);
      
      // Get user's associate ID for AOI reports filtering 
      let userAssociateId = null;
      try {
        const { data: customerData } = await supabaseAdmin
          .from('customers')
          .select('associate_id')
          .eq('company_email', userEmail)
          .single();
        userAssociateId = customerData?.associate_id?.toString();
        console.log(`🔍 Found associate ID for ${userEmail}: ${userAssociateId}`);
      } catch (error) {
        console.log('⚠️ Could not find associate ID for AOI reports blocking check');
      }
      
      // Get pending VDP calls that need AOI reports
      let totalPendingAOIReports = 0;
      
      if (userAssociateId) {
        // DISABLED: VDP calls - column 'agent' doesn't exist in twilio_call_logs
        // TODO: Fix column name or disable this feature entirely
        const vdpCalls = [];
        
        // DISABLED: masterlead_calls table doesn't exist in Supabase
        // TODO: Create this table or use different approach
        const masterleadCalls = [];
        
        const vdpCount = vdpCalls?.length || 0;
        const masterleadCount = masterleadCalls?.length || 0;
        totalPendingAOIReports = vdpCount + masterleadCount;
        
        console.log(`🔍 AOI Reports blocking check for ${userEmail}: VDP=${vdpCount}, Masterlead=${masterleadCount}, Total=${totalPendingAOIReports}`);
      }
      
      const blockingStatus = {
        hasPendingReports: totalPendingAOIReports > 0,
        pendingCount: totalPendingAOIReports,
        mustResolveReports: false, // DISABLED - AOI Reports blocking disabled
        threshold: BLOCKING_THRESHOLD
      };
      
      console.log(`🚨 AOI Reports blocking status for ${userEmail}:`, blockingStatus);
      res.json(blockingStatus);
      
    } catch (error) {
      console.error('❌ AOI Reports blocking check error:', error);
      res.status(500).json({
        hasPendingReports: false,
        pendingCount: 0,
        mustResolveReports: false,
        threshold: 0
      });
    }
  });

  // Get pending reports for authenticated user only (no email parameter)
  app.get("/api/aoi-reports/pending", async (req, res) => {
    // CRITICAL: Disable caching to ensure fresh data  
    res.set('Cache-Control', 'no-store, no-cache, must-revalidate');
    res.set('Pragma', 'no-cache');  
    res.set('Expires', '0');
    try {
      console.log('📊 AOI Reports: Getting pending reports for authenticated user...');
      
      // Get user email from request header (like other endpoints)
      const userEmail = req.headers['x-user-email'] || req.query.userEmail;
      
      if (!userEmail) {
        console.error('❌ No user email found for AOI Reports filtering');
        return res.status(401).json({ error: 'User not authenticated' });
      }
      
      console.log(`🔍 AOI Reports: Filtering for logged-in user: ${userEmail}`);
      
      // Get user's associate ID for VDP calls filtering (use customers table like VDP routing)
      let userAssociateId = null;
      try {
        const { data: customerData } = await supabaseAdmin
          .from('customers')
          .select('associate_id')
          .eq('company_email', userEmail)
          .single();
        userAssociateId = customerData?.associate_id?.toString();
        console.log(`🔍 Found associate ID in customers table for ${userEmail}: ${userAssociateId}`);
      } catch (error) {
        console.log(`⚠️ Could not find associate ID in customers table for ${userEmail}, using default 999:`, error.message);
      }
      
      // Use the same direct database calls as Master AOI Reports
      // Get VDP calls that need closure from SUPABASE
      // Include: NOT in final states (VDP calls may not have updated_at)
      const threeDaysAgo = new Date(Date.now() - 3 * 24 * 60 * 60 * 1000).toISOString();
      const finalAgentId = userAssociateId || '999';
      console.log(`🔍 VDP Query: Looking for agent="${finalAgentId}" - unresolved VDP calls need follow-up`);
      
      const { data: vdpCalls, error: vdpError } = await supabaseAdmin
        .from('vdp_calls')
        .select('*')
        .eq('agent', finalAgentId) // Use user's associate ID - agent field is lowercase in Supabase
        .is('cnresolution', null) // Only get calls that haven't been resolved yet
        .order('id', { ascending: false }); // Get unresolved VDP calls only

      if (vdpError) {
        console.error('❌ Supabase error getting VDP calls for pending:', vdpError);
      } else {
        console.log(`📞 Found ${vdpCalls?.length || 0} VDP calls needing closure for ${userEmail}`);
      }

      // Get masterlead calls for THIS USER that need AOI follow-up (booked, appointment_set, callback)
      const { data: masterleadCalls, error: masterleadError } = await supabaseAdmin
        .from('masterlead')
        .select('*')
        .eq('cn_email', userEmail) // Filter for specific user
        .in('cnresolution', ['booked', 'appointment_set', 'callback_requested']) // ONLY resolutions requiring follow-up
        .order('created_at', { ascending: false })
        .limit(1000); // Get all actionable items that need follow-up

      if (masterleadError) {
        console.error('❌ Supabase error getting masterlead calls for pending:', masterleadError);
      }

      // Agent ID to email mapping for VDP calls - could be moved to configuration or database
      const agentIdToEmail: Record<string, string> = {
        '409': process.env.AGENT_409_EMAIL || '',
        '117239': process.env.AGENT_117239_EMAIL || '',
        // Add other agent mappings as needed via environment variables
      };

      // Get due 'in_progress' follow-ups from Supabase aoi_followups table
      console.log(`📅 Checking for due 'in_progress' follow-ups for ${userEmail}...`);
      
      let dueFollowups = [];
      try {
        const now = new Date();
        const { data: dueInProgressFollowups, error: followupError } = await supabaseAdmin
          .from('aoi_followups')
          .select('*')
          .eq('agent_email', userEmail)
          .eq('followup_type', 'in_progress')
          .eq('status', 'pending')
          .lte('due_date', now.toISOString())
          .order('due_date', { ascending: true });

        if (followupError) {
          console.warn('⚠️ Error fetching due follow-ups from Supabase:', followupError);
        } else {
          console.log(`📅 Found ${dueInProgressFollowups?.length || 0} due 'in_progress' follow-ups`);
          
          // Convert follow-ups to call format by fetching the original call data
          for (const followup of dueInProgressFollowups || []) {
            let originalCall = null;
            
            // Try to get original call from VDP or masterlead
            if (followup.vdp_call_id) {
              const { data: vdpCallData } = await supabaseAdmin
                .from('vdp_calls')
                .select('*')
                .eq('id', followup.vdp_call_id)
                .single();
              originalCall = vdpCallData;
            } else {
              // Try to find masterlead call by taalk_leadid
              const { data: masterCallData } = await supabaseAdmin
                .from('masterlead')
                .select('*')
                .eq('taalk_leadid', followup.taalk_leadid)
                .single();
              originalCall = masterCallData;
            }

            if (originalCall) {
              // Mark this as a follow-up item with special metadata
              originalCall.isFollowup = true;
              originalCall.followupType = 'in_progress';
              originalCall.followupDue = followup.due_date;
              originalCall.overdueDays = Math.floor((now - new Date(followup.due_date)) / (1000 * 60 * 60 * 24));
              dueFollowups.push(originalCall);
            }
          }
        }
      } catch (error) {
        console.warn('⚠️ Error fetching due follow-ups:', error);
      }

      // Flatten all calls and normalize structure
      const allPendingCalls = [];
      
      // Add VDP calls
      if (vdpCalls) {
        vdpCalls.forEach(call => {
          let callDate = null;
          if (call.time && !isNaN(Date.parse(call.time))) {
            callDate = call.time;
          } else {
            callDate = new Date(Date.now() - Math.random() * 30 * 24 * 60 * 60 * 1000).toISOString();
          }
          
          const daysSince = Math.floor((new Date().getTime() - new Date(callDate).getTime()) / (1000 * 60 * 60 * 24));
          
          // Parse raw webhook data properly (handle JSON string or object)
          const rawWebhook = call.raw_webhook_data;
          const rawData = rawWebhook ? (typeof rawWebhook === 'string' ? JSON.parse(rawWebhook) : rawWebhook) : {};
          const callDurationSeconds = Number(call.duration) || 0;
          
          // Format duration as MM:SS
          const durationFormatted = callDurationSeconds > 0 ? `${Math.floor(callDurationSeconds/60)}m ${Math.floor(callDurationSeconds%60)}s` : 'N/A';
          
          const firstName = call.firstName && call.firstName !== ':' ? call.firstName : '';
          const lastName = call.lastName && call.lastName !== ':' ? call.lastName : '';
          const clientName = `${firstName} ${lastName}`.trim() || 'Unknown';
          console.log(`🔍 VDP Call ${call.id}: duration=${call.duration}, formatted=${durationFormatted}, firstName=${call.firstName}, lastName=${call.lastName}, cleanClientName=${clientName}`);
          
          allPendingCalls.push({
            ...call,
            source: 'vdp_calls',
            days_since_call: daysSince,
            phone_number: call.Phone || rawData.clientphone || 'Unknown',
            customer_name: (() => {
              const firstName = call.firstName && call.firstName !== ':' ? call.firstName : '';
              const lastName = call.lastName && call.lastName !== ':' ? call.lastName : '';
              return `${firstName} ${lastName}`.trim() || rawData.name || 'Unknown';
            })(),
            agent_email: agentIdToEmail[call.agent] || call.agent || 'Unknown Agent',
            created_at: callDate,
            call_duration: callDurationSeconds,
            market: call.market || rawData.clientmarket || 'Unknown Market',
            lead_id: call.leadid || rawData.LeadId || 'No Lead ID',
            duration_display: durationFormatted
          });
        });
      }
      
      // Add masterlead calls
      if (masterleadCalls) {
        masterleadCalls.forEach(call => {
          let callDate = call.called_at || call.created_at || call.updated_at || call.last_contacted;
          if (!callDate || isNaN(Date.parse(callDate))) {
            callDate = new Date(Date.now() - Math.random() * 30 * 24 * 60 * 60 * 1000).toISOString();
          }
          
          const daysSince = Math.floor((new Date().getTime() - new Date(callDate).getTime()) / (1000 * 60 * 60 * 24));
          
          allPendingCalls.push({
            ...call,
            source: 'masterlead',
            days_since_call: daysSince,
            phone_number: call.phone || 'Unknown',
            customer_name: `${call.first_name || ''} ${call.last_name || ''}`.trim() || 'Unknown',
            agent_email: call.cn_email || 'Unknown Agent',
            created_at: callDate,
            call_duration: parseInt(call.duration) || 0,
            // Add lead identification fields
            market: call.taalk_market || 'Unknown Market',
            lead_id: call.taalk_lead_id || 'No Lead ID',
            duration_display: 'N/A' // masterlead doesn't have duration
          });
        });
      }
      
      // Add due follow-ups to the pending calls list
      if (dueFollowups.length > 0) {
        console.log(`📅 Adding ${dueFollowups.length} due 'in_progress' follow-ups to pending list`);
        
        // Convert follow-ups to the same format as pending calls
        dueFollowups.forEach(followup => {
          const daysSince = Math.floor((new Date() - new Date(followup.created_at || followup.followupDue)) / (1000 * 60 * 60 * 24));
          
          allPendingCalls.push({
            ...followup,
            source: followup.vdpCallId ? 'vdp_calls' : 'masterlead',
            days_since_call: daysSince,
            phone_number: followup.Phone || followup.phone || 'Unknown',
            customer_name: `${followup.firstname || followup.first_name || ''} ${followup.lastname || followup.last_name || ''}`.trim() || 'Unknown',
            agent_email: followup.agent_email || followup.Agent || followup.cn_email || userEmail,
            call_duration: parseInt(followup.duration || followup.call_duration) || 0,
            market: followup.market || 'Unknown Market',
            lead_id: followup.leadid || followup.taalk_leadid || followup.lead_id || 'No Lead ID',
            duration_display: followup.duration || 'N/A',
            // Add follow-up specific fields
            isFollowup: true,
            followupType: 'in_progress',
            followupBadge: followup.overdueDays > 0 ? `Overdue ${followup.overdueDays}d` : 'Due Now (72h)',
            cnresolution: 'in_progress' // Override resolution status for UI
          });
        });
      }

      const totalCount = (vdpCalls?.length || 0) + (masterleadCalls?.length || 0) + dueFollowups.length;
      console.log(`📊 Found ${vdpCalls?.length || 0} VDP + ${masterleadCalls?.length || 0} masterlead + ${dueFollowups.length} follow-ups = ${totalCount} total pending reports for ${userEmail}`);
      res.json(allPendingCalls);
      
    } catch (error) {
      console.error('❌ AOI Reports pending error:', error);
      res.status(500).json([]);
    }
  });

  // Get all reports
  app.get("/api/aoi-reports/all", async (req, res) => {
    try {
      console.log('📊 AOI Reports: Getting all reports...');
      
      const { data: allCalls, error } = await supabaseAdmin
        .from('vdp_calls')
        .select('*')
        .order('Date', { ascending: false })
        .limit(100);
      
      if (error) {
        console.error('❌ Error fetching all calls:', error);
        throw error;
      }
      
      // Calculate days since call for each
      const enrichedCalls = allCalls?.map(call => {
        const callDate = new Date(call.Date + 'T' + (call.Time || '00:00:00'));
        return {
          ...call,
          days_since_call: Math.floor((new Date().getTime() - callDate.getTime()) / (1000 * 60 * 60 * 24)),
          phone_number: call.Phone,
          customer_name: call.firstname && call.lastname ? `${call.firstname} ${call.lastname}` : null,
          agent_email: call.Agent || call.agent_email,
          created_at: callDate.toISOString(),
          call_duration: parseInt(call.duration) || 0
        }
      }) || [];
      
      console.log(`📊 Found ${enrichedCalls.length} total reports`);
      res.json(enrichedCalls);
      
    } catch (error) {
      console.error('❌ AOI Reports all error:', error);
      res.status(500).json([]);
    }
  });

  // Resolve a call with two-stage accountability
  app.put("/api/aoi-reports/resolve/:callId", async (req, res) => {
    try {
      const { callId } = req.params;
      const { cnresolution, resolution_notes, appointmentDate, callbackDate, appointmentType, appointmentDetails, source, saleAlp } = req.body;
      
      console.log(`📝 AOI Reports: Resolving call ${callId} with status: ${cnresolution}, source: ${source}`);
      
      // Use the provided source to look in the correct table
      let callData = null;
      let callSource = source;
      
      if (source === 'vdp_calls') {
        const { data: vdpCallData, error: vdpError } = await supabaseAdmin
          .from('vdp_calls')
          .select('*')
          .eq('id', callId)
          .single();
        
        if (vdpError || !vdpCallData) {
          console.error(`❌ Error: Call ${callId} not found in vdp_calls:`, vdpError);
          return res.status(404).json({ error: `Call ${callId} not found in vdp_calls` });
        }
        callData = vdpCallData;
      } else if (source === 'masterlead') {
        const { data: masterCallData, error: masterError } = await supabaseAdmin
          .from('masterlead')
          .select('*')
          .eq('id', callId)
          .single();
        
        if (masterError || !masterCallData) {
          console.error(`❌ Error: Call ${callId} not found in masterlead:`, masterError);
          return res.status(404).json({ error: `Call ${callId} not found in masterlead` });
        }
        callData = masterCallData;
        callSource = 'masterlead';
      } else {
        // Fallback: try both tables (old behavior)
        const { data: vdpCallData } = await supabaseAdmin
          .from('vdp_calls')
          .select('*')
          .eq('id', callId)
          .single();
        
        if (vdpCallData) {
          callData = vdpCallData;
          callSource = 'vdp_calls';
        } else {
          const { data: masterCallData } = await supabaseAdmin
            .from('masterlead')
            .select('*')
            .eq('id', callId)
            .single();
          
          if (masterCallData) {
            callData = masterCallData;
            callSource = 'masterlead';
          }
        }
        
        if (!callData) {
          console.error(`❌ Error: Call ${callId} not found in either vdp_calls or masterlead`);
          return res.status(404).json({ error: `Call ${callId} not found` });
        }
      }
      
      console.log(`📍 Found call ${callId} in ${callSource} table`);
      
      // Check if this resolution requires follow-up
      const requiresFollowup = ['appointment_set', 'callback_requested', 'in_progress'].includes(cnresolution);
      
      // Calculate follow-up deadline
      let followupDeadline = null;
      if (requiresFollowup) {
        if (cnresolution === 'appointment_set' && appointmentDate) {
          // For appointments, check the day after the appointment date
          followupDeadline = new Date(appointmentDate);
          followupDeadline.setDate(followupDeadline.getDate() + 1);
        } else if (cnresolution === 'appointment_set') {
          // If no specific appointment date, default to 7 days
          followupDeadline = new Date();
          followupDeadline.setDate(followupDeadline.getDate() + 7);
        } else if (cnresolution === 'callback_requested') {
          followupDeadline = new Date();
          followupDeadline.setDate(followupDeadline.getDate() + 3); // 3 days for callbacks
        } else if (cnresolution === 'in_progress') {
          followupDeadline = new Date();
          followupDeadline.setDate(followupDeadline.getDate() + 3); // 72 hours = 3 days
        }
      }
      
      // Update the appropriate table based on source
      if (callSource === 'vdp_calls') {
        console.log(`🔄 Updating vdp_calls with cnresolution: ${cnresolution}`);
        
        // Update vdp_calls with cnresolution, appointment date and ALP
        const vdpUpdateData: any = {
          cnresolution: cnresolution,
          resolution_notes: resolution_notes || '',
          resolved_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        };
        
        // Add APPTTIME if appointment date provided
        if (appointmentDate) {
          vdpUpdateData.APPTTIME = appointmentDate;
        }
        
        // Add ALP if sale amount provided
        if (saleAlp) {
          vdpUpdateData.ALP = saleAlp;
        }

        // Add callback date if provided
        if (callbackDate) {
          vdpUpdateData.callback_date = callbackDate;
        }
        
        const { error: vdpError } = await supabaseAdmin
          .from('vdp_calls')
          .update(vdpUpdateData)
          .eq('id', callId);
        
        if (vdpError) {
          console.error(`❌ CRITICAL: Could not update vdp_calls resolution:`, vdpError);
          throw vdpError;
        } else {
          console.log(`✅ Successfully updated vdp_calls ${callId} with cnresolution: ${cnresolution}`);
        }
        
        // Also update masterlead if taalk_leadid exists (vdp_calls calls often have corresponding masterlead records)
        if (callData.leadid) {
          console.log(`🔄 Also updating masterlead for taalk_lead_id: ${callData.leadid}`);
          const updateData: any = {
            cnresolution,
            updated_at: new Date().toISOString()
          };
          
          // Add APPTTIME if appointment date provided
          if (appointmentDate) {
            updateData.APPTTIME = appointmentDate;
          }
          
          // Add ALP if sale amount provided
          if (saleAlp) {
            updateData.ALP = saleAlp;
          }
          
          const { error: masterError } = await supabaseAdmin
            .from('masterlead')
            .update(updateData)
            .eq('taalk_lead_id', callData.leadid);
          
          if (masterError) {
            console.warn(`⚠️ Warning: Could not update masterlead for leadid ${callData.leadid}:`, masterError);
          } else {
            console.log(`✅ Updated masterlead for leadid: ${callData.leadid}`);
            
            // 🔥 PLANET ALTIG WEBHOOK: Send to webhook when lead is marked as BOOKED (from VDP)
            if (cnresolution === 'booked') {
              console.log(`🔥 VDP BOOKED LEAD DETECTED! Sending to Planet ALTIG webhook...`);
              
              try {
                // Use associate_id from callData if available (agent is logged in), otherwise lookup
                const agentEmail = callData.agent || callData.owner_email || callData.agent_email;
                let associateId = callData.associate_id || callData.associateId;
                
                // Only lookup if we don't already have it
                if (!associateId && agentEmail) {
                  const { data: customer } = await supabaseAdmin
                    .from('customers')
                    .select('associate_id')
                    .eq('company_email', agentEmail?.toLowerCase().trim())
                    .limit(1);
                  
                  associateId = customer && customer[0]?.associate_id 
                    ? customer[0].associate_id 
                    : null;
                } else {
                  associateId = associateId || null;
                }
                
                // Check if we have a valid associate ID
                if (!associateId) {
                  console.error(`❌ Cannot send VDP BOOKED webhook: No associate_id found for agent ${agentEmail} - LEAD WILL NOT BE SENT`);
                  return;
                }
                
                // Use taalk_lead_id (Planet expects this, not database ID)
                const leadId = callData.leadid || callData.taalk_lead_id || callData.taalkLeadId;
                
                if (!leadId) {
                  console.error(`❌ Cannot send VDP BOOKED webhook: No lead_id found for callData`, callData);
                  return;
                }
                
                const webhookPayload = {
                  lead_id: leadId.toString(), // Must be Taalk lead ID
                  associate_id: associateId
                };
                
                console.log(`📤 Sending VDP BOOKED lead webhook: lead_id=${leadId}, associate_id=${associateId}, agent=${agentEmail}`);
                
                // Send to Zapier webhook (Zapier forwards to Planet) - this is what works!
                const webhookResponse = await fetch('https://hooks.zapier.com/hooks/catch/2467580/uifcmkd/', {
                  method: 'POST',
                  headers: { 
                    'Content-Type': 'application/json'
                  },
                  body: JSON.stringify(webhookPayload)
                });
                
                if (webhookResponse.ok) {
                  console.log(`✅ VDP BOOKED lead webhook sent successfully to Planet ALTIG!`);
                  
                  // Log to hotlead_webhooks table
                  try {
                    await supabaseAdmin
                      .from('hotlead_webhooks')
                      .insert([{
                        call_sid: 'VDP_BOOKED_LEAD',
                        hotlead_id: leadId,
                        agent_email: agentEmail,
                        webhook_payload: webhookPayload,
                        webhook_status: 'sent',
                        sent_at: new Date().toISOString()
                      }]);
                  } catch (logError) {
                    console.log('⚠️ Could not log VDP webhook');
                  }
                } else {
                  console.error(`❌ VDP BOOKED lead webhook failed: ${webhookResponse.status}`);
                }
              } catch (webhookError) {
                console.error('❌ Error sending VDP BOOKED lead webhook:', webhookError);
              }
            }
          }
        }
      } else if (callSource === 'masterlead') {
        console.log(`🔄 Updating masterlead table for call ${callId} with cnresolution: ${cnresolution}`);
        const updateData: any = {
          cnresolution: cnresolution,
          resolution_notes: resolution_notes || '',
          resolved_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        };
        
        // Add APPTTIME if appointment date provided
        if (appointmentDate) {
          updateData.APPTTIME = appointmentDate;
        }
        
        // Add ALP if sale amount provided
        if (saleAlp) {
          updateData.ALP = saleAlp;
        }

        // Add callback date if provided
        if (callbackDate) {
          updateData.callback_date = callbackDate;
        }
        
        // Note: masterlead table doesn't have sale_alp column - store in disposition_notes
        if (cnresolution === 'sold' && saleAlp) {
          updateData.disposition_notes = `${resolution_notes || ''} [ALP: $${saleAlp}]`.trim();
        }
        
        const { error: masterError } = await supabaseAdmin
          .from('masterlead')
          .update(updateData)
          .eq('id', callId);
        
        if (masterError) {
          console.error('❌ Error updating masterlead:', masterError);
          throw masterError;
        }
        
        // 🔥 PLANET ALTIG WEBHOOK: Send to webhook when lead is marked as BOOKED
        if (cnresolution === 'booked') {
          console.log(`🔥 BOOKED LEAD DETECTED! Sending to Planet ALTIG webhook...`);
          
          try {
            // Use associate_id from callData if available (agent is logged in), otherwise lookup
            const agentEmail = callData.cn_email || callData.owner_email || callData.agent_email;
            let associateId = callData.associate_id || callData.associateId;
            
            // Only lookup if we don't already have it
            if (!associateId && agentEmail) {
              const { data: customer } = await supabaseAdmin
                .from('customers')
                .select('associate_id')
                .eq('company_email', agentEmail?.toLowerCase().trim())
                .limit(1);
              
              associateId = customer && customer[0]?.associate_id 
                ? customer[0].associate_id 
                : null;
            } else {
              associateId = associateId || null;
            }
            
            // Check if we have a valid associate ID - DO NOT USE 999
            if (!associateId) {
              console.error(`❌ Cannot send BOOKED webhook: No associate_id found for agent ${agentEmail} - LEAD WILL NOT BE SENT`);
              return;
            }
            
            // Use taalk_lead_id (Planet expects this, not database ID)
            const leadId = callData.taalk_lead_id || callData.taalkLeadId || callData.leadid || callData.id;
            
            if (!leadId) {
              console.error(`❌ Cannot send BOOKED webhook: No lead_id found for callData`, callData);
              return;
            }
            
            const webhookPayload = {
              lead_id: leadId.toString(), // Must be Taalk lead ID
              associate_id: associateId
            };
            
            console.log(`📤 Sending BOOKED lead webhook: lead_id=${leadId}, associate_id=${associateId}, agent=${agentEmail}`);
            
            // Send to Zapier webhook (Zapier forwards to Planet) - this is what works!
            const webhookResponse = await fetch('https://hooks.zapier.com/hooks/catch/2467580/uifcmkd/', {
              method: 'POST',
              headers: { 
                'Content-Type': 'application/json'
              },
              body: JSON.stringify(webhookPayload)
            });
            
            if (webhookResponse.ok) {
              console.log(`✅ BOOKED lead webhook sent successfully to Planet ALTIG!`);
              
              // Log to hotlead_webhooks table (if it exists)
              try {
                await supabaseAdmin
                  .from('hotlead_webhooks')
                  .insert([{
                    call_sid: 'BOOKED_LEAD',
                    hotlead_id: leadId,
                    agent_email: agentEmail,
                    webhook_payload: webhookPayload,
                    webhook_status: 'sent',
                    sent_at: new Date().toISOString()
                  }]);
              } catch (logError) {
                console.log('⚠️ Could not log webhook to hotlead_webhooks table');
              }
            } else {
              console.error(`❌ BOOKED lead webhook failed: ${webhookResponse.status} ${await webhookResponse.text()}`);
            }
          } catch (webhookError) {
            console.error('❌ Error sending BOOKED lead webhook:', webhookError);
            // Don't throw - webhook failure shouldn't block the resolution update
          }
        }
      }
      
      // Auto-complete any pending 'in_progress' follow-ups if this is a proper resolution  
      const terminalResolutions = ['sale', 'not_interested', 'do_not_call', 'wrong_number', 'appointment_set', 'callback_requested'];
      if (terminalResolutions.includes(cnresolution)) {
        console.log(`📝 Closing any pending 'in_progress' follow-ups - call properly resolved as: ${cnresolution}`);
        
        try {
          // Update follow-ups in Supabase
          let followupQuery = supabaseAdmin
            .from('aoi_followups')
            .update({
              status: 'completed',
              final_outcome: `Resolved as ${cnresolution}`,
              completed_at: new Date().toISOString(),
              completed_by: 'system'
            })
            .eq('followup_type', 'in_progress')
            .eq('status', 'pending');

          if (callSource === 'vdp_calls') {
            followupQuery = followupQuery.eq('vdp_call_id', parseInt(callId));
          } else {
            // For masterlead calls, match by taalk_leadid or leadid
            const leadId = callData.taalk_leadid || callData.leadid || callData.lead_id || callId;
            followupQuery = followupQuery.eq('taalk_leadid', leadId.toString());
          }

          const { error: followupUpdateError } = await followupQuery;
          
          if (followupUpdateError) {
            console.warn(`⚠️ Could not close in_progress follow-ups in Supabase:`, followupUpdateError);
          } else {
            console.log(`✅ Closed pending 'in_progress' follow-ups for call ${callId} in Supabase`);
          }
        } catch (error) {
          console.warn(`⚠️ Could not close in_progress follow-ups:`, error);
        }
      }

      // Create follow-up entry if required
      if (requiresFollowup) {
        console.log(`📅 Creating follow-up entry for ${cnresolution}`);
        
        const followupType = cnresolution === 'appointment_set' ? 'appointment' : 
                           cnresolution === 'callback_requested' ? 'callback' : 'in_progress';
        
        const followupData = {
          vdp_call_id: callSource === 'vdp_calls' ? parseInt(callId) : null,
          masterlead_id: callSource === 'masterlead' ? parseInt(callId) : null,
          taalk_leadid: callData.leadid || callData.taalk_leadid || '',
          agent_email: callData.agent_email || callData.Agent || callData.cn_email || '',
          followup_type: followupType,
          initial_resolution: cnresolution,
          initial_resolution_at: new Date().toISOString(),
          initial_notes: resolution_notes,
          due_date: followupDeadline.toISOString(),
          status: 'pending',
          appointment_date: appointmentDate,
          appointment_type: appointmentType,
          appointment_details: appointmentDetails,
          callback_date: callbackDate
        };
        
        // Add appointment-specific fields
        if (cnresolution === 'appointment_set') {
          followupData.appointment_date = appointmentDate ? new Date(appointmentDate).toISOString() : null;
          followupData.appointment_type = appointmentType || 'zoom';
          followupData.appointment_details = appointmentDetails || '';
        }
        
        // Add callback-specific fields
        if (cnresolution === 'callback_requested') {
          followupData.callback_date = callbackDate ? new Date(callbackDate).toISOString() : null;
          followupData.callback_phone = callData.Phone || '';
          followupData.callback_notes = resolution_notes || '';
        }
        
        const { error: followupError } = await supabaseAdmin
          .from('aoi_followups')
          .insert(followupData);
        
        if (followupError) {
          console.warn(`⚠️ Warning: Could not create follow-up entry:`, followupError);
        } else {
          console.log(`✅ Follow-up entry created for call ${callId}`);
        }
      }
      
      console.log(`✅ Call ${callId} resolved successfully with ${requiresFollowup ? 'follow-up required' : 'final resolution'}`);
      res.json({ 
        success: true, 
        call: callData,
        followup_required: requiresFollowup,
        followup_deadline: followupDeadline?.toISOString() || null
      });
      
    } catch (error) {
      console.error('❌ AOI Reports resolve error:', error);
      res.status(500).json({ error: 'Failed to resolve call' });
    }
  });

  // Master AOI Reports - ALL agents' outstanding resolutions needed (management oversight)
  app.get("/api/aoi-reports/master", async (req, res) => {
    try {
      console.log('🎯 Master AOI Reports: Getting ALL calls from VDP calls AND masterlead tables...');

      // Get all calls from both tables (VDP calls + masterlead)
      const allCalls = await storage.getAllVDPCallsNeedingResolution();
      
      console.log(`📋 Found ${allCalls.length} total calls from both tables`);

      if (!allCalls || allCalls.length === 0) {
        console.log('📋 Master AOI Reports: No calls found');
        return res.json([]);
      }

      // Group by agent for oversight
      const agentGrouped = allCalls.reduce((acc, call) => {
        const agent = call.agent_email || 'Unknown Agent';
        if (!acc[agent]) {
          acc[agent] = [];
        }
        
        // Calculate days since call
        const callDate = new Date(call.created_at);
        const daysSince = Math.floor((new Date().getTime() - callDate.getTime()) / (1000 * 60 * 60 * 24));
        
        acc[agent].push({
          id: call.id,
          customer_name: call.customer_name || 'Unknown Customer',
          phone_number: call.phone || 'Unknown',
          agent_email: call.agent_email,
          created_at: call.created_at,
          call_duration: call.call_duration,
          days_since_call: daysSince,
          status: 'Needs Resolution',
          cnresolution: call.cnresolution || null,
          resolution_notes: call.resolution_notes || null,
          market: call.market || 'Unknown Market',
          taalk_lead_id: call.taalk_leadid || 'Unknown Lead ID',
          source: call.source || 'unknown'
        });
        return acc;
      }, {});

      // Convert to array with agent summary
      const masterData = Object.entries(agentGrouped).map(([agent, calls]) => ({
        agent_email: agent,
        outstanding_count: calls.length,
        oldest_days: Math.max(...calls.map(c => c.days_since_call)),
        calls: calls.sort((a, b) => b.days_since_call - a.days_since_call) // Most overdue first
      })).sort((a, b) => b.outstanding_count - a.outstanding_count); // Most outstanding first

      console.log(`🎯 Master AOI Reports: Found ${allCalls.length} total calls across ${masterData.length} agents`);
      res.json(masterData);
    } catch (error) {
      console.error('❌ Master AOI Reports error:', error);
      res.status(500).json([]);
    }
  });

  // AOI Follow-up Management API - Two-stage accountability endpoints

  // Get pending follow-ups for an agent
  app.get("/api/aoi-followups/pending/:agentEmail", async (req, res) => {
    try {
      const { agentEmail } = req.params;
      console.log(`📅 Getting pending follow-ups for agent: ${agentEmail}`);
      
      const pendingFollowups = await storage.db
        .select()
        .from(aoiFollowups)
        .where(eq(aoiFollowups.agentEmail, agentEmail))
        .where(eq(aoiFollowups.status, 'pending'))
        .orderBy(asc(aoiFollowups.dueDate));
      
      console.log(`📅 Found ${pendingFollowups.length} pending follow-ups for ${agentEmail}`);
      res.json(pendingFollowups);
      
    } catch (error) {
      console.error('❌ Error fetching pending follow-ups:', error);
      res.status(500).json({ error: 'Failed to fetch pending follow-ups' });
    }
  });

  // Get all overdue follow-ups (management view)
  app.get("/api/aoi-followups/overdue", async (req, res) => {
    try {
      console.log('🚨 Getting overdue follow-ups...');
      
      const now = new Date();
      const overdueFollowups = await storage.db
        .select()
        .from(aoiFollowups)
        .where(eq(aoiFollowups.status, 'pending'))
        .where(lt(aoiFollowups.dueDate, now.toISOString()))
        .orderBy(asc(aoiFollowups.dueDate));
      
      console.log(`🚨 Found ${overdueFollowups.length} overdue follow-ups`);
      res.json(overdueFollowups);
      
    } catch (error) {
      console.error('❌ Error fetching overdue follow-ups:', error);
      res.status(500).json({ error: 'Failed to fetch overdue follow-ups' });
    }
  });

  // Complete a follow-up with final outcome
  app.put("/api/aoi-followups/complete/:followupId", async (req, res) => {
    try {
      const { followupId } = req.params;
      const { finalOutcome, finalNotes, completedBy } = req.body;
      
      console.log(`✅ Completing follow-up ${followupId} with outcome: ${finalOutcome}`);
      
      // Update the follow-up record
      const updatedFollowup = await storage.db
        .update(aoiFollowups)
        .set({
          finalOutcome,
          finalNotes,
          completedAt: new Date(),
          completedBy,
          status: 'completed'
        })
        .where(eq(aoiFollowups.id, parseInt(followupId)))
        .returning();
      
      if (updatedFollowup.length === 0) {
        return res.status(404).json({ error: 'Follow-up not found' });
      }
      
      const followup = updatedFollowup[0];
      
      // Update the related VDP call with final outcome
      if (followup.vdpCallId) {
        const { error: vdpError } = await supabaseAdmin
          .from('vdp_calls')
          .update({
            final_outcome: finalOutcome,
            final_outcome_notes: finalNotes,
            final_outcome_at: new Date().toISOString()
          })
          .eq('id', followup.vdpCallId);
        
        if (vdpError) {
          console.warn(`⚠️ Warning: Could not update VDP call final outcome:`, vdpError);
        }
      }
      
      // Update masterleads with final outcome
      if (followup.taalk_leadid) {
        const { error: masterError } = await supabaseAdmin
          .from('masterleads')
          .update({
            final_outcome: finalOutcome,
            final_outcome_notes: finalNotes,
            updated_at: new Date().toISOString()
          })
          .eq('taalk_lead_id', followup.taalk_leadid);
        
        if (masterError) {
          console.warn(`⚠️ Warning: Could not update masterleads final outcome:`, masterError);
        }
      }
      
      console.log(`✅ Follow-up ${followupId} completed successfully with outcome: ${finalOutcome}`);
      res.json({ 
        success: true, 
        followup: updatedFollowup[0],
        message: 'Follow-up completed and final outcome recorded'
      });
      
    } catch (error) {
      console.error('❌ Error completing follow-up:', error);
      res.status(500).json({ error: 'Failed to complete follow-up' });
    }
  });

