  // Create verification session
  app.post("/api/verification/session", async (req, res) => {
    try {
      console.log('Creating verification session with data:', req.body);
      console.log('Session data:', (req.session as any)?.user);
      console.log('Session ID:', req.sessionID);
      console.log('Session object:', Object.keys(req.session || {}));
      
      // 🔑 AUTHENTICATION: Try Supabase JWT first, then session fallback
      let agentEmail = null;
      let sessionUser = null;
      
      // Method 1: Check Authorization header for Supabase JWT token
      const authHeader = req.headers.authorization;
      if (authHeader && authHeader.startsWith('Bearer ')) {
        try {
          const token = authHeader.substring(7);
          console.log('🔑 Verifying Supabase JWT token...');
          
          const { data: userResponse, error: authError } = await supabaseAdmin.auth.getUser(token);
          if (!authError && userResponse?.user?.email) {
            agentEmail = userResponse.user.email;
            sessionUser = { id: userResponse.user.id, email: userResponse.user.email };
            console.log('✅ JWT AUTH: Authenticated user via Supabase token:', agentEmail);
          } else {
            console.log('❌ JWT AUTH: Token validation failed:', authError?.message);
          }
        } catch (jwtError) {
          console.log('❌ JWT AUTH: Token parsing error:', jwtError);
        }
      }
      
      // Method 2: Fallback to session-based authentication  
      if (!agentEmail) {
        sessionUser = (req.session as any)?.user;
        agentEmail = sessionUser?.email;
        
        // Try alternative session paths if main session doesn't work
        if (!agentEmail) {
          console.log('⚠️ Main session.user not found, checking alternative paths');
          sessionUser = (req.session as any)?.passport?.user || req.session;
          agentEmail = sessionUser?.email || sessionUser?.user_email;
        }
        
        // Try headers as backup
        if (!agentEmail) {
          console.log('⚠️ No session email found, checking headers');
          agentEmail = req.headers['x-user-email'] as string || req.headers['user-email'] as string;
        }
        
        if (agentEmail) {
          console.log('✅ SESSION AUTH: Authenticated user via session:', agentEmail);
        }
      }
      
      // FAIL FAST - Don't create sessions without proper authentication
      if (!agentEmail) {
        console.error('❌ AUTHENTICATION FAILED: No user email found in JWT token, session, or headers');
        return res.status(401).json({
          error: 'Authentication required',
          message: 'You must be logged in to create a verification session'
        });
      }
      
      console.log('🎯 AUTH: Using agent email for verification session:', agentEmail);

      // Get agent profile from Supabase
      const agentProfile = await storage.getAgentProfileByEmail(agentEmail);
      if (!agentProfile) {
        console.log('⚠️ No agent profile found, creating verification session without agent data');
      } else {
        console.log('✅ Using agent data from Supabase:', agentProfile.firstName, agentProfile.lastName);
      }
      
      // Ensure language is included (default to 'en' if not provided)
      if (!req.body.language) {
        req.body.language = 'en';
      }
      
      const clientInfo = clientInfoSchema.parse(req.body);
      
      // 🚨 CRITICAL: GET AGENT PROFILE FROM agent_profiles TABLE (CORRECT TABLE)
      let associateId = null;
      let agentProfileData = null;
      let producerData = null;
      
      try {
        console.log(`🔍 Getting agent profile from agent_profiles table for: ${agentEmail}`);
        
        // Normalize email for better matching
        const normalizedEmail = agentEmail.trim().toLowerCase();
        
        // 🔧 FIX: Look in agent_profiles table first (where the agent actually exists)
        const { data: agentData, error: agentLookupError } = await supabaseAdmin
          .from('agent_profiles')
          .select('id, email, first_name, last_name, phone, mga_team, rga_team, zoom_id, zoom_password')
          .eq('email', normalizedEmail)
          .single();
        
        if (agentLookupError) {
          console.error(`❌ Agent not found in agent_profiles for ${agentEmail}:`, agentLookupError);
          
          // Log detailed information for debugging where this email is coming from
          console.error('AGENT_LOOKUP_MISS - Detailed debug info:', {
            requestPath: req.path,
            method: req.method,
            agentEmail: agentEmail,
            userAgent: req.headers['user-agent'],
            referer: req.headers.referer,
            xUserEmail: req.headers['x-user-email'],
            authHeader: req.headers.authorization ? 'present' : 'absent',
            sessionUser: sessionUser ? { id: sessionUser.id, email: sessionUser.email } : null,
            timestamp: new Date().toISOString(),
            body: {
              agentFirstName: req.body.agentFirstName,
              agentLastName: req.body.agentLastName,
              agentPhone: req.body.agentPhone
            }
          });
          
          // Return 422 with structured error details instead of hard failure
          return res.status(422).json({
            code: 'AGENT_NOT_FOUND',
            error: 'Agent not found',
            message: `No agent profile found for ${agentEmail}. Please ensure your email is registered in the system.`,
            details: {
              email: agentEmail,
              suggestions: [
                'Verify the email address is correct',
                'Contact your administrator to add this email to the system',
                'Check if you should be using a different email address'
              ]
            }
          });
        }
        
        agentProfileData = agentData;
        console.log(`✅ Found agent profile: ${agentData.first_name} ${agentData.last_name} (${agentData.email})`);
        
        // Now try to get associate_id from producerlist table using company_email
        const { data: producerListData, error: lookupError } = await supabaseAdmin
          .from('producerlist')
          .select('associate_id, company_email, first_name, last_name, mga')
          .eq('company_email', normalizedEmail)
          .single();
        
        if (lookupError) {
          console.warn(`⚠️ Associate_id not found in producerlist table for ${agentEmail} (but agent profile exists):`, lookupError);
          console.log(`ℹ️ Agent profile found but no producerlist associate_id - proceeding with verification session creation`);
          // Associate ID is optional for verification sessions - agent profile is what matters
          associateId = null;
        } else {
          producerData = producerListData;
          associateId = producerData?.associate_id;
          console.log(`✅ Found associate_id: ${associateId} for ${agentEmail} from producerlist`);
        }
      } catch (vdpError) {
        console.error('❌ Critical error getting associate_id from customers table:', vdpError);
        return res.status(500).json({
          error: 'Database error',
          message: 'Unable to verify agent credentials. Please try again.'
        });
      }
      
      // USE AGENT DATA FROM SUPABASE agent_profiles TABLE 
      const sessionWithAgent = {
        ...clientInfo,
        sessionType: req.body.sessionType || 'live', // "demo" or "live" - default to live
        agentFirstName: req.body.agentFirstName || agentProfileData?.first_name || '',
        agentLastName: req.body.agentLastName || agentProfileData?.last_name || '',
        agentPhone: req.body.agentPhone || agentProfileData?.phone || '',
        agentMgaTeam: producerData?.mga || agentProfileData?.mga_team || '', // Use MGA from producerlist
        agentRgaTeam: agentProfileData?.rga_team || '',
        zoomRoomId: req.body.zoomRoomId || agentProfileData?.zoom_id || '',
        zoomPassword: req.body.zoomPassword || agentProfileData?.zoom_password || '1',
        associateId: associateId, // Optional for billing integration
        companyEmail: agentEmail // Store the user's email for searching
      };
      
      console.log(`🔧 Creating verification session with associate_id: ${associateId}`);
      const session = await storage.createVerificationSession(sessionWithAgent);
      console.log('Session created with agent data from Supabase:', session.language);

      // Generate verification URLs for session creation webhook
      const replitDomain = process.env.REPLIT_DEV_DOMAIN;
      const host = req.get('host');
      const baseUrl = replitDomain 
        ? `https://${replitDomain}` 
        : host && host.includes('replit.dev') 
          ? `https://${host}` 
          : `https://${host}`;
      const agentVerificationUrl = `${baseUrl}/agent-verify/${session.sessionId}`;
      const clientVerificationUrl = `${baseUrl}/client-verify/${session.sessionId}`;

      // Webhook removed - only send on specific events, not session creation

      res.json(session);
    } catch (error: any) {
      console.error('Failed to create verification session:', error);
      if (error instanceof z.ZodError) {
        console.error('Zod validation errors:', error.errors);
        return res.status(400).json({ message: "Invalid client information", errors: error.errors });
      }
      console.error('Unexpected error:', error.message || error);
      res.status(500).json({ message: "Failed to create verification session", error: error.message || 'Unknown error' });
    }
  });

  // Get verification session
  app.get("/api/verification/session/:sessionId", async (req, res) => {
    try {
      const { sessionId } = req.params;
      const session = await storage.getVerificationSession(sessionId);

      if (!session) {
        return res.status(404).json({ message: "Verification session not found" });
      }

      // Storage layer already returns camelCase, just send it
      res.json(session);
    } catch (error) {
      res.status(500).json({ message: "Failed to retrieve verification session" });
    }
  });

  // Add endpoint for Step 2 initiation webhook (simpler route path)
  app.post("/api/step2-webhook/:sessionId", async (req, res) => {
    try {
      const { sessionId } = req.params;
      const session = await storage.getVerificationSession(sessionId);

      if (!session) {
        return res.status(404).json({ message: "Verification session not found" });
      }

      // Use current AO Intelligence domain for verification URLs
      const baseUrl = 'https://aoirail-production.up.railway.app';
      const agentVerificationUrl = `${baseUrl}/agent-verify/${sessionId}`;
      const clientVerificationUrl = `${baseUrl}/client-verify/${sessionId}`;

      // Create language-specific SMS messages for client
      const clientName = `${session.firstName} ${session.lastName}`;
      const language = session.language || 'en';
      
      const smsMessages = {
        en: {
          title: "AO Precheck",
          greeting: `Hello ${session.firstName},`,
          message: "Your agent needs your approval to continue with your policy verification.",
          instruction: "Ready to Proceed",
          action: "Click approve to continue with verification.",
          button: "I Agree and Approve"
        },
        es: {
          title: "AO Precheck",
          greeting: `Hola ${session.firstName},`,
          message: "Su agente necesita su aprobación para continuar con la verificación de su póliza.",
          instruction: "Listo para Proceder",
          action: "Haga clic en aprobar para continuar con la verificación.",
          button: "Acepto y Apruebo"
        }
      };

      const clientSmsContent = smsMessages[language as keyof typeof smsMessages] || smsMessages.en;

      // Send Step 2 initiation webhook to Zapier
      const zapierPayload = {
        sessionId: session.sessionId,
        eventType: 'step2_initiated',
        language: language,
        clientInfo: {
          firstName: session.firstName,
          lastName: session.lastName,
          spouseName: session.spouseName,
          phone: session.phone,
          city: session.city,
          state: session.state,
          premium: session.premium,
          verificationMethod: session.verificationMethod
        },
        verificationLinks: {
          agentUrl: agentVerificationUrl,
          clientUrl: clientVerificationUrl,
          qrCodeFor: "agent_mobile_access"
        },
        smsContent: clientSmsContent,
        message: `Step 2 started for ${session.firstName} ${session.lastName} - Ready for verification method selection and QR code generation`,
        timestamp: new Date().toISOString()
      };

      console.log('Sending Step 2 initiation data to Zapier:', zapierPayload);

      try {
        await fetch('https://hooks.zapier.com/hooks/catch/2467580/uu5qnr4/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(zapierPayload)
        });
        console.log('Successfully sent Step 2 data to Zapier');
      } catch (webhookError) {
        console.error('Failed to send Step 2 webhook:', webhookError);
      }

      res.json({ success: true, message: "Step 2 webhook sent" });
    } catch (error: any) {
      console.error('Step 2 webhook error:', error);
      res.status(500).json({ message: "Failed to send Step 2 webhook" });
    }
  });

