      const { hotleadSyncService } = await import('./hotlead-sync-service');
      const status = hotleadSyncService.getSyncStatus();
      
      // Also get current hotlead counts
      const { data: hotleadStats } = await supabase
        .from('masterlead')
        .select('status, assigned_to')
        .not('status', 'eq', 'CONVERTED');
      
      const stats = {
        totalActive: hotleadStats?.length || 0,
        assigned: hotleadStats?.filter(h => h.assigned_to).length || 0,
        unassigned: hotleadStats?.filter(h => !h.assigned_to).length || 0,
        syncInProgress: status.inProgress
      };
      
      res.json({ success: true, stats });
    } catch (error) {
      res.status(500).json({
        success: false,
        error: error instanceof Error ? error.message : 'Unknown error'
      });
    }
  });

  // Direct hotlead insertion endpoint (bypasses schema cache issues)
  app.post("/api/supabase/hotleads", async (req, res) => {
    try {
      console.log('🔥 Direct hotlead insertion requested');
      const hotleadsData = req.body;
      
      // Use direct SQL to bypass schema cache issues
      const insertSQL = `
        INSERT INTO hotleads (
          first_name, last_name, phone, email, state, city, call_date, call_time, 
          duration_seconds, hot_lead_reason, priority_score, taalk_market, 
          taalk_groupname, status, cn_email, transferred, transfer_duration_ms
        ) VALUES ${hotleadsData.map((_, i) => `($${i*17+1}, $${i*17+2}, $${i*17+3}, $${i*17+4}, $${i*17+5}, $${i*17+6}, $${i*17+7}, $${i*17+8}, $${i*17+9}, $${i*17+10}, $${i*17+11}, $${i*17+12}, $${i*17+13}, $${i*17+14}, $${i*17+15}, $${i*17+16}, $${i*17+17})`).join(', ')}
        RETURNING id, first_name, last_name, phone, priority_score, created_at;
      `;

      const values = hotleadsData.flatMap(hotlead => [
        hotlead.first_name || 'UNKNOWN',
        hotlead.last_name || 'HOTLEAD', 
        hotlead.phone,
        hotlead.email || '',
        hotlead.state || 'TX',
        hotlead.city || 'Dallas',
        hotlead.call_date || new Date().toISOString().split('T')[0],
        hotlead.call_time || '12:00:00',
        hotlead.duration_seconds || 60,
        hotlead.hot_lead_reason || 'Transfer Lost Quickly',
        hotlead.priority_score || 8,
        hotlead.taalk_market || 'Veteran',
        hotlead.taalk_groupname || 'Hot Lead', 
        hotlead.status || 'NEW',
        hotlead.cn_email || 'cnsysop@aoglobelife.com',
        hotlead.transferred || true,
        hotlead.transfer_duration_ms || 3000
      ]);

      const result = await pool.query(insertSQL, values);
      
      console.log(`✅ Successfully inserted ${result.rows.length} hotleads via SQL`);
      res.json({ 
        success: true, 
        count: result.rows.length,
        hotleads: result.rows 
      });
    } catch (error) {
      console.error('❌ Error in direct hotlead insertion:', error);
      res.status(500).json({
        success: false,
        error: error instanceof Error ? error.message : 'Unknown error'
      });
    }
  });

  app.post("/api/callbacks", async (req, res) => {
    try {
      const { agentEmail } = req.body;
      
      if (!agentEmail) {
        return res.status(400).json({ error: 'Agent email required' });
      }

      console.log(`📞 Fetching callbacks for ${agentEmail} from Supabase`);

      // Query Supabase masterlead table for callbacks/follow-ups - Mark Julius should appear here
      const { data: callbacks, error } = await supabase
        .from('masterlead')
        .select(`
          id,
          first_name,
          last_name,
          phone,
          state,
          cnresolution,
          updated_at,
          created_at,
          last_contacted,
          cn_email,
          try_count,
          answered
        `)
        .eq('cn_email', agentEmail)
        .in('cnresolution', ['callback', 'call back', 'follow up', 'schedule callback', 'call back tomorrow', 'call back later'])
        .order('updated_at', { ascending: false })
        .limit(20);

      if (error) {
        console.error('❌ Supabase callbacks error:', error);
        throw error;
      }

      console.log(`📞 Raw Supabase callbacks result:`, callbacks?.length || 0, 'records');

      // Transform the data to match expected format
      const transformedCallbacks = (callbacks || []).map(callback => ({
        id: callback.id.toString(),
        leadName: `${callback.first_name} ${callback.last_name}`,
        leadPhone: callback.phone,
        leadState: callback.state,
        notes: callback.cnresolution || 'Follow-up needed - lead previously contacted',
        scheduledFor: callback.last_contacted || callback.updated_at,
        status: 'pending',
        agentEmail: callback.cn_email,
        createdAt: callback.updated_at,
        priority: (() => {
          const daysSince = Math.floor((new Date().getTime() - new Date(callback.updated_at).getTime()) / (1000 * 60 * 60 * 24));
          if (daysSince > 2) return 'high';
          if (daysSince > 1) return 'medium';
          return 'low';
        })()
      }));
      
      console.log(`📞 Found ${transformedCallbacks.length} callbacks for ${agentEmail} from Supabase`);
      
      res.json({
        success: true,
        callbacks: transformedCallbacks
      });

    } catch (error: any) {
      console.error('❌ Error fetching callbacks:', error);
      res.status(500).json({ 
        success: false, 
        error: 'Failed to fetch callbacks',
        details: error.message 
      });
    }
  });

