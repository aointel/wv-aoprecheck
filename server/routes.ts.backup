  // Real Supabase Admin API endpoints for agent management
  app.get('/api/admin/supabase-agents', async (req, res) => {
    try {
      console.log('🔍 Fetching ALL agent data from Supabase customers table...');
      console.log('🔑 Supabase Admin available:', !!supabaseAdmin);
      
      if (!supabaseAdmin) {
        console.error('❌ Supabase admin client not available - check SUPABASE_SERVICE_KEY');
        return res.status(500).json({ error: 'Supabase admin not configured' });
      }
      
      // Get ALL records with actual populated data (removed limit for full search capability)
      const { data, error } = await supabaseAdmin
        .from('customers')
        .select('*')
        .not('associate_id', 'is', null)
        .not('first_name', 'is', null)
        .order('created_at', { ascending: false });

      if (error) {
        console.error('❌ Supabase admin error:', error);
        return res.status(500).json({ error: 'Failed to fetch agent data from Supabase', details: error.message });
      }

      console.log(`✅ Retrieved ALL ${data.length} populated agents from Supabase customers table (no limit)`);
      if (data.length > 0) {
        console.log('📊 Sample agent data structure:', JSON.stringify(data[0], null, 2));
        console.log(`🔍 Admin can now search through all ${data.length} users`);
      }
      
      // Get Call Connector Pro access settings from agent_profiles table
      console.log('🔍 Fetching Call Connector Pro access settings from agent_profiles...');
      const { data: agentProfiles, error: profilesError } = await supabase
        .from('agent_profiles')
        .select('email, call_connector_pro_access');

      if (profilesError) {
        console.error('❌ Error fetching agent profiles:', profilesError);
      }

      // Create a map of email -> callConnectorProAccess for quick lookup
      const callConnectorProMap = new Map();
      if (agentProfiles) {
        agentProfiles.forEach(profile => {
          callConnectorProMap.set(profile.email, profile.call_connector_pro_access || false);
        });
      }
      console.log(`✅ Loaded Call Connector Pro settings for ${callConnectorProMap.size} agents`);

      // Map Supabase field names to admin panel format
      const mappedAgents = data.map(agent => {
        const email = agent.company_email?.trim() || '';
        // Use actual database setting from agent_profiles, default to false if not found
        const callConnectorProAccess = callConnectorProMap.get(email) || false;
        
        return {
          COMPANY_EMAIL: email,
          FIRST_NAME: agent.first_name || '',
          LAST_NAME: agent.last_name || '',
          PHONE: agent.phone || '',
          STATUS: agent.status || 'ACTIVE',
          AGENTTYPE: 'AGENT',
          MARKET: agent.primary_market || (Array.isArray(agent.market) ? agent.market[0] : ''),
          TEAM: agent.mga || 'N/A',
          RECRUITING_TRAINING_TYPE: 'N/A',
          PLUSACTIVE: agent.PLUSACTIVE || 'INACTIVE',
          RECRUITACTIVE: agent.RECRUITACTIVE || 'INACTIVE',
          CREATED_DATE: agent.created_at,
          UPDATED_DATE: agent.created_at,
          MANAGER_EMAIL: agent.mga || '',
          REGION: agent.rga || 'N/A',
          STATE: Array.isArray(agent.states) ? agent.states.join(', ') : (agent.life_and_health_states || 'N/A'),
          ASSOCIATE_ID: agent.associate_id?.toString() || '',
          VDPACTIVE: agent.VDPACTIVE || 'INACTIVE',
          AOICONNECT: agent.AOICONNECT || 'INACTIVE',
          PRIMARY_MARKET: agent.primary_market || '',
          SECONDARY_MARKET: agent.secondary_market || '',
          STATES: Array.isArray(agent.states) ? agent.states : [],
          MARKETS: Array.isArray(agent.market) ? agent.market : [],
          PERSONAL_EMAIL: agent.personal_email || '',
          AGENT_NAME: agent.agent_name || `${agent.first_name || ''} ${agent.last_name || ''}`.trim(),
          MGA: agent.mga || '',
          RGA: agent.rga || '',
          DESIGNATED_MARKET: agent.designated_market || '',
          callConnectorProAccess: callConnectorProAccess // Use actual database setting
        };
      });
      
      res.json({
        success: true,
        agents: mappedAgents,
        count: mappedAgents.length
      });
    } catch (error) {
      console.error('❌ Error fetching Supabase agents:', error);
      res.status(500).json({ error: 'Failed to fetch agent data' });
    }
  });

