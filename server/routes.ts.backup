      if (emailList.length === 0) {
        return res.json([]);
      }

      const teamData = await db
        .select({
          email: agentProfiles.email,
          mgaTeam: agentProfiles.mgaTeam,
          rgaTeam: agentProfiles.rgaTeam
        })
        .from(agentProfiles)
        .where(sql`${agentProfiles.email} = ANY(${emailList})`);

      res.json(teamData);
    } catch (error) {
      console.error('❌ Error fetching agent teams:', error);
      res.status(500).json({ error: 'Failed to fetch agent teams' });
    }
  });

