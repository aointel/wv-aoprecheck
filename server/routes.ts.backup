        return res.status(403).json({ error: 'Admin access required' });
      }

      const { email } = req.params;

      // Remove role and cascade delete assignments
      const deleteAssignmentsQuery = `DELETE FROM quality_manager_assignments WHERE qm_email = '${email}'`;
      const deleteRoleQuery = `DELETE FROM quality_manager_roles WHERE email = '${email}'`;
      
      await db.execute(sql.raw(deleteAssignmentsQuery));
      await db.execute(sql.raw(deleteRoleQuery));
      
      res.json({ success: true, message: 'Quality Manager role revoked successfully' });
      
    } catch (error) {
