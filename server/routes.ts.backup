          .from('verification_sessions')
          .update({ taalk_call_url: storedUrl })
          .eq('id', session.id);
        
        console.log(`✅ Stored recording at ${storedUrl}`);
        return res.json({ success: true, url: storedUrl });
      }
      
      // Primary auth worked
