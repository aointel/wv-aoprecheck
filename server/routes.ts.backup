      // Log the VDP disconnect event for tracking
      await db.execute(sql`
        INSERT INTO agent_vdp_events (agent_email, event_type, reason, timestamp)
        VALUES (${agentEmail}, 'disconnect', ${reason || 'live_call'}, CURRENT_TIMESTAMP)
        ON CONFLICT (agent_email, event_type) 
        DO UPDATE SET reason = EXCLUDED.reason, timestamp = CURRENT_TIMESTAMP
      `);

      res.json({
        success: true,
        message: `VDP disconnected for ${agentEmail}`,
        action: 'disconnect',
        reason: reason || 'live_call'
      });

