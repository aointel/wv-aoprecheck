<Response>
  <Say voice="alice">Hello! This is AO Precheck verification. You have a verification call for ${clientName}. The client phone number is ${clientPhone}. Please proceed with the verification process.</Say>
  <Pause length="2"/>
  <Say voice="alice">Press any key when verification is complete.</Say>
