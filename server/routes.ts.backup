  app.post("/api/inbound-calls/decline", async (req, res) => {
    try {
      const { callSid, agentEmail } = req.body;
      console.log(`📞 Agent ${agentEmail} declining call ${callSid}`);

      // Update call status to declined
      await db
        .update(schema.incomingCalls)
        .set({
          status: 'declined',
          assignedAgentEmail: agentEmail,
          endedAt: new Date()
        })
        .where(eq(schema.incomingCalls.twilioCallSid, callSid));

      // Optionally use Twilio to send to voicemail
      console.log(`❌ Call ${callSid} declined by ${agentEmail}`);
      
      res.json({ success: true, message: 'Call declined successfully' });

    } catch (error) {
