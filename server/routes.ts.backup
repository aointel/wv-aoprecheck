  // Debug endpoint to check agent leads in Supabase
  app.get("/api/debug/agent-leads", async (req, res) => {
    try {
      if (!supabaseAdmin) {
        return res.json({ error: 'Supabase admin not available' });
      }
      
      const { email } = req.query;
      if (!email) {
        return res.json({ error: 'Email parameter required' });
      }
      
      const emails = [email as string];
      
      const results = {};
      
      for (const email of emails) {
        const { data, error, count } = await supabaseAdmin
          .from('masterlead')
          .select('*', { count: 'exact' })
          .eq('cn_email', email)
          .limit(5);
        
        results[email] = {
          count: count || 0,
          error: error?.message || null,
          sample: data?.[0] || null
        };
      }
      
      // Check for similar patterns
      const { data: similarLeads, error: similarError } = await supabaseAdmin
        .from('masterlead')
        .select('cn_email, first_name, last_name, taalk_market')
        .or('cn_email.ilike.%lafond%,cn_email.ilike.%chris%,first_name.ilike.%chris%,last_name.ilike.%lafond%')
        .limit(10);
      
      // Get total count
      const { count: totalCount, error: countError } = await supabaseAdmin
        .from('masterlead')
        .select('*', { count: 'exact', head: true });
      
      res.json({
        email_results: results,
        similar_leads: similarLeads || [],
        similar_error: similarError?.message || null,
        total_masterlead_count: totalCount || 0,
        count_error: countError?.message || null
      });
      
    } catch (error) {
      console.error('Debug Chris leads error:', error);
      res.status(500).json({ error: error.message });
    }
  });

